    def _setup_bridge(
        self,
        planned_network_info: Optional[NetworkInfo] = None,
    ) -> bool:
        """Setup new bridge with networking"""
        # Find unused network
        network_info = planned_network_info or self._find_unused_network()
        if not network_info:
            print("E: Could not find unused network in 10.0.0.0/8 range")
            return False

        network, network_cidr, gateway = network_info
        if planned_network_info is not None:
            if (
                not _validate_ip_address(network)
                or not _validate_network_cidr(network_cidr)
                or not _validate_ip_address(gateway)
            ):
                print("E: Refusing invalid planned bridge network")
                return False
            try:
                planned_network = ipaddress.ip_network(network_cidr, strict=True)
                if str(planned_network.network_address) != network:
                    print("E: Refusing inconsistent planned bridge network")
                    return False
                if ipaddress.ip_address(gateway) not in planned_network:
                    print("E: Refusing planned bridge gateway outside network")
                    return False
            except ValueError:
                print("E: Refusing invalid planned bridge network")
                return False
            if self._check_network_conflict(network_cidr):
                print(f"E: Planned bridge network conflicts: {network_cidr}")
                return False
        print(f"I: Selected network: {network_cidr}")

        # Create bridge
        if not self._create_bridge():
            return False

        # Enable IP forwarding
        self._enable_ip_forwarding()

        # Enable net.ipv4.conf.<bridge>.route_localnet
        self._enable_route_localnet()

        # Configure bridge IP
        if not self._configure_bridge_ip(gateway):
            return False

        # Setup firewall rules based on available backend
        if self.firewall_backend == "iptables":
            # Setup iptables chains
            if not self._setup_iptables_chains(network_cidr):
                return False

            # Configure NAT rules
            if not self._setup_ipv4_firewall_ipt(network_cidr):
                return False

            # Setup IPv6 firewall (container isolation)
            self._setup_ipv6_firewall_ipt()

        elif self.firewall_backend == "nftables":
            # Setup nftables IPv4 firewall
            if not self._setup_ipv4_firewall_nft(network_cidr):
                return False

            # Setup nftables IPv6 firewall
            self._setup_ipv6_firewall_nft()

        else:
            print("W: No firewall backend available, network isolation disabled")
            # Continue without firewall rules - basic connectivity will work

        # Store configuration
        self.network = network
        self.network_cidr = network_cidr
        self.gateway = gateway

        return True

    def cleanup(self):
        """Remove bridge and firewall rules"""
        if not self._bridge_exists():
            print("I: Bridge does not exist, nothing to clean up")
            return

        success = True

        # Remove firewall rules first
        if self.firewall_backend == "iptables":
            print("I: Removing iptables rules...")
            # Remove chains from filter and nat tables
            if self._iptables_chain_exists("sandy-fwd"):
                # Remove jump rule from FORWARD chain
                _run_secure_subprocess(
                    [
                        "iptables",
                        "-D",
                        "FORWARD",
                        "-i",
                        self.bridge_name,
                        "-s",
                        self.network_cidr,
                        "-j",
                        "sandy-fwd",
                    ],
                    capture_output=True,
                    check=False,
                )
                # Flush and delete the chain
                self._run_iptables("-F", "sandy-fwd", error_prefix="Flush sandy-fwd")
                self._run_iptables("-X", "sandy-fwd", error_prefix="Delete sandy-fwd")

            # Remove sandy-rej chain if it exists
            if self._iptables_chain_exists("sandy-rej"):
                # Flush and delete the chain
                self._run_iptables("-F", "sandy-rej", error_prefix="Flush sandy-rej")
                self._run_iptables("-X", "sandy-rej", error_prefix="Delete sandy-rej")

            # Remove sandy-out chain if it exists
            if self._iptables_chain_exists("sandy-out"):
                # Remove jump rules from OUTPUT chain
                if self.gateway:
                    # Remove bridge interface rule
                    _run_secure_subprocess(
                        [
                            "iptables",
                            "-D",
                            "OUTPUT",
                            "-o",
                            self.bridge_name,
                            "-s",
                            self.gateway,
                            "-d",
                            self.network_cidr,
                            "-j",
                            "sandy-out",
                        ],
                        capture_output=True,
                        check=False,
                    )
                # Flush and delete the chain
                self._run_iptables("-F", "sandy-out", error_prefix="Flush sandy-out")
                self._run_iptables("-X", "sandy-out", error_prefix="Delete sandy-out")

            if self._iptables_chain_exists("sandy-nat-post", "nat"):
                # Remove jump rule from POSTROUTING chain
                if self.network_cidr:
                    _run_secure_subprocess(
                        [
                            "iptables",
                            "-t",
                            "nat",
                            "-D",
                            "POSTROUTING",
                            "-s",
                            self.network_cidr,
                            "-j",
                            "sandy-nat-post",
                        ],
                        capture_output=True,
                        check=False,
                    )

                    _run_secure_subprocess(
                        [
                            "iptables",
                            "-t",
                            "nat",
                            "-D",
                            "POSTROUTING",
                            "-o",
                            self.bridge_name,
                            "-s",
                            "127.0.0.1/8",
                            "-j",
                            "sandy-nat-post",
                        ],
                        capture_output=True,
                        check=False,
                    )

                # Flush and delete the chain
                self._run_iptables(
                    "-F",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Flush sandy-nat-post",
                )
                self._run_iptables(
                    "-X",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Delete sandy-nat-post",
                )

            # Remove sandy-nat-out chain if it exists
            if self._iptables_chain_exists("sandy-nat-out", "nat"):
                # Remove jump rule from OUTPUT chain
                _run_secure_subprocess(
                    [
                        "iptables",
                        "-t",
                        "nat",
                        "-D",
                        "OUTPUT",
                        "-j",
                        "sandy-nat-out",
                    ],
                    capture_output=True,
                    check=False,
                )
                # Flush and delete the chain
                self._run_iptables(
                    "-F",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Flush sandy-nat-out",
                )
                self._run_iptables(
                    "-X",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Delete sandy-nat-out",
                )

            # Remove sandy-nat-pre chain if it exists
            if self._iptables_chain_exists("sandy-nat-pre", "nat"):
                # Remove jump rule from PREROUTING chain
                _run_secure_subprocess(
                    [
                        "iptables",
                        "-t",
                        "nat",
                        "-D",
                        "PREROUTING",
                        "-j",
                        "sandy-nat-pre",
                    ],
                    capture_output=True,
                    check=False,
                )
                # Flush and delete the chain
                self._run_iptables(
                    "-F",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Flush sandy-nat-pre",
                )
                self._run_iptables(
                    "-X",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Delete sandy-nat-pre",
                )

            # Remove IPv6 rules if they exist
            if self.has_ip6tables:
                if self._ip6tables_chain_exists("sandy-fwd6"):
                    # Remove jump rule from FORWARD chain
                    _run_secure_subprocess(
                        [
                            "ip6tables",
                            "-D",
                            "FORWARD",
                            "-i",
                            self.bridge_name,
                            "-j",
                            "sandy-fwd6",
                        ],
                        capture_output=True,
                        check=False,
                    )
                    # Flush and delete the chain
                    self._run_ip6tables(
                        "-F", "sandy-fwd6", error_prefix="Flush sandy-fwd6"
                    )
                    self._run_ip6tables(
                        "-X", "sandy-fwd6", error_prefix="Delete sandy-fwd6"
                    )

                # Remove sandy-rej6 chain if it exists
                if self._ip6tables_chain_exists("sandy-rej6"):
                    # Flush and delete the chain
                    self._run_ip6tables(
                        "-F", "sandy-rej6", error_prefix="Flush sandy-rej6"
                    )
                    self._run_ip6tables(
                        "-X", "sandy-rej6", error_prefix="Delete sandy-rej6"
                    )

        elif self.firewall_backend == "nftables":
            print("I: Removing nftables rules...")
            # Remove nftables tables
            if self._nft_table_exists("ip", "sandy"):
                self._run_nft(
                    "delete",
                    "table",
                    "ip",
                    "sandy",
                    error_prefix="Delete IPv4 table",
                )
            if self._nft_table_exists("ip6", "sandy"):
                self._run_nft(
                    "delete",
                    "table",
                    "ip6",
                    "sandy",
                    error_prefix="Delete IPv6 table",
                )

        # Remove the bridge interface
        print(f"I: Removing bridge {self.bridge_name}...")
        result = _run_secure_subprocess(
            ["ip", "link", "delete", self.bridge_name],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            print(
                f"W: Failed to remove bridge: {_terminal_safe_repr(str(result.stderr))}"
            )
            success = False
        else:
            print(f"I: Bridge {self.bridge_name} removed successfully")

        if success:
            self.configured = False
            self.network = None
            self.network_cidr = None
            self.gateway = None


def _require_root():
    """Reject non-root execution before accessing root-owned host state."""
    if os.getuid() != 0:
        print("E: Must run as root")
        sys.exit(1)


class Sandy:
    def __init__(self):
        self.container = "ai-dev"
        self.workspace = "workspace"
        self.shared = None
        self.user = "developer"
        self.user_home = f"/home/{self.user}"

        # Set script directory and tool availability
        self.script_dir = os.path.dirname(os.path.abspath(__file__))
        self.has_debootstrap = shutil.which("debootstrap") is not None
        self.has_skopeo = shutil.which("skopeo") is not None
        self.has_umoci = shutil.which("umoci") is not None

        # Keep this guard for callers that construct Sandy outside main().
        _require_root()

        # Initialize network as None - will be setup in run_up if needed
        self.network = None

        # Port mappings: list of (proto, host_port, container_port) tuples
        self.port_mappings = []

        # Check systemd version for feature support
        self.systemd_version = _check_systemd_version()

        # Check required scripts and tools
        self._check_required_scripts()
        self._check_required_tools()

        # Determine bootstrap method
        self._set_bootstrap_method()

    def _check_required_tools(self):
        """Check that required systemd tools are available"""
        required_tools = [
            "ip",
            "machinectl",
            "sysctl",
            "systemctl",
            "systemd-machine-id-setup",
            "systemd-nspawn",
            "systemd-run",
        ]

        missing_tools = []
        for tool in required_tools:
            if not shutil.which(tool):
                missing_tools.append(tool)

        if missing_tools:
            print(f"E: Missing required tools: {', '.join(missing_tools)}")
            sys.exit(1)

        # Check for firewall tools (iptables preferred, nftables as fallback)
        has_iptables = shutil.which("iptables") is not None
        has_nft = shutil.which("nft") is not None

        if not has_iptables and not has_nft:
            print(
                "W: Neither iptables nor nftables available - network isolation will be disabled"
            )
            # Continue without error - basic networking will still work

        # Check for container image creation tools
        if not self.has_debootstrap and not (self.has_skopeo and self.has_umoci):
            print(
                "E: Need either 'debootstrap' or both 'skopeo' and 'umoci' for container creation"
            )
            sys.exit(1)

    def _check_required_scripts(self):
        """Check that required *.sh scripts are available and set paths"""
        # Check debootstrap.sh
        self.cn_debootstrap = os.path.join(self.script_dir, "debootstrap.sh")
        if not os.path.exists(self.cn_debootstrap):
            print("E: Missing required script: debootstrap.sh")
            sys.exit(1)

        # Check oci.sh
        self.cn_oci = os.path.join(self.script_dir, "oci.sh")
        if not os.path.exists(self.cn_oci):
            print("E: Missing required script: oci.sh")
            sys.exit(1)

        # Check sandy-keepalive.sh
        self.cn_keepalive = os.path.join(self.script_dir, KEEPALIVE_SCRIPT_FILENAME)
        if not os.path.exists(self.cn_keepalive):
            print(f"E: Missing required script: {KEEPALIVE_SCRIPT_FILENAME}")
            sys.exit(1)

        # Check setup-container.sh
        self.cn_setup_container = os.path.join(self.script_dir, "setup-container.sh")
        if not os.path.exists(self.cn_setup_container):
            print("E: Missing required script: setup-container.sh")
            sys.exit(1)

    def _set_bootstrap_method(self):
        """Determine bootstrap method based on environment variable or auto-detection"""
        method_raw = os.environ.get("SANDY_BOOTSTRAP", "")

        # Validate environment variable
        if method_raw and not _validate_env_var(
            method_raw, {"oci", "debootstrap", ""}, 16
        ):
            print(f"E: Invalid bootstrap method environment variable")
            sys.exit(1)

        method = method_raw.lower()

        if method == "oci":
            if not (self.has_skopeo and self.has_umoci):
                print("E: OCI method requested but skopeo and/or umoci not available")
                sys.exit(1)
            self.bootstrap_method = "OCI"
            self.bootstrap_script = self.cn_oci
            self.base_image = "debian:trixie-slim"
        elif method == "debootstrap":
            if not self.has_debootstrap:
                print("E: debootstrap method requested but debootstrap not available")
                sys.exit(1)
            self.bootstrap_method = "debootstrap"
            self.bootstrap_script = self.cn_debootstrap
            self.base_image = "debian:trixie"
        elif method == "":
            # Auto-detect: prefer OCI if available
            if self.has_skopeo and self.has_umoci:
                self.bootstrap_method = "OCI"
                self.bootstrap_script = self.cn_oci
                self.base_image = "debian:trixie-slim"
            else:
                self.bootstrap_method = "debootstrap"
                self.bootstrap_script = self.cn_debootstrap
                self.base_image = "debian:trixie"
        else:
            print(
                f"E: Invalid bootstrap method '{_strip_control_characters(method)}'. Use 'oci' or 'debootstrap'"
            )
            sys.exit(1)

        # Check for base image override with validation
        base_override = os.environ.get("SANDY_BOOTSTRAP_BASE", "")
        if base_override:
            if not _validate_image_name(base_override):
                print(
                    f"E: Invalid base image '{_strip_control_characters(base_override)}' - must be valid image name"
                )
                sys.exit(1)
            self.base_image = base_override

    def _confirm(self, prompt_text):
        """Prompt user for confirmation. Returns True if user confirms."""
        try:
            response = input(f"{prompt_text}? [y/N]: ")
            return response.lower() in ["y", "yes"]
        except (EOFError, KeyboardInterrupt):
            print()  # Add newline after Ctrl+C
            return False

    def _plan_mounts(self) -> list:
        """Check the workspace and shared directories before any host change.

        A directory that does not exist is skipped with a warning. Exit when
        root owns a directory, or when the kernel or the file system of a
        directory cannot do an ID-mapped mount.
        """
        plans = []
        for label, host_rel in (("workspace", self.workspace), ("shared", self.shared)):
            if not host_rel:
                continue
            source = os.path.realpath(host_rel)
            if not os.path.isdir(source):
                print(
                    f"W: Could not find '{_strip_control_characters(host_rel)}' "
                    f"on the host, skipping {label} mount"
                )
                continue
            try:
                plans.append(_plan_mount(label, source, f"{self.user_home}/{label}"))
                self._warn_about_submounts(label, source)
            except _MountError as exc:
                print(
                    f"E: Cannot mount '{_strip_control_characters(source)}' as the "
                    f"{label} directory: {_strip_control_characters(str(exc))}"
                )
                sys.exit(1)
        return plans

    def _warn_about_submounts(self, label: str, source: str) -> None:
        """Warn when the host has mounts below a directory that up will mount.

        The container does not see them (see _idmapped_tree): it sees the
        directories below them. The warning is advice only. If the mount table
        cannot be read, say so and go on; the mount itself does not depend on it.
        """
        try:
            below = _mounts_below(source, _read_mountinfo())
        except (OSError, ValueError) as exc:
            print(
                f"W: Could not check for mounts below the {label} directory: "
                f"{_terminal_safe_repr(str(exc))}"
            )
            return
        if not below:
            return
        shown = ", ".join(
            f"'{_strip_control_characters(path)}'" for path in below[:SUBMOUNT_LIST_MAX]
        )
        more = (
            f" and {len(below) - SUBMOUNT_LIST_MAX} more"
            if len(below) > SUBMOUNT_LIST_MAX
            else ""
        )
        print(
            f"W: The {label} directory '{_strip_control_characters(source)}' has "
            f"mounts below it: {shown}{more}"
        )
        print("   The container does not see these mounts")

    def _prepare_image_mounts(
        self, machine_fd: int, plans: list
    ) -> Tuple[Tuple[MountPlan, ...], Tuple[int, int]]:
        """Keep the plans whose target exists in the image; read the user's ids.

        Return the plans to mount and the uid and gid of the container user.
        Exit when a target or the ids cannot be read. The ids map the owner
        of each host directory to the user (see _mount_one).

        The check opens each target below the image root, with no link in
        its path, as the mount does (see _move_mount_in_namespace). So a link
        in the image never leads to a host path. A target that is missing or
        is not a directory is skipped. A link in its path ends the command
        before the start, with the error of the mount.
        """
        kept = []
        for plan in plans:
            try:
                os.close(
                    _openat2_no_links(
                        plan.target, os.O_PATH | os.O_DIRECTORY, root_fd=machine_fd
                    )
                )
            except (OSError, ValueError) as exc:
                error = exc.errno if isinstance(exc, OSError) else None
                if error in (errno.ENOENT, errno.ENOTDIR):
                    print(
                        f"W: Could not find '{plan.target}' in the container. "
                        f"Skipping {plan.label} mount"
                    )
                    continue
                # A link in the path gives ELOOP, and the mount refuses it too.
                reason = (
                    _mount_step_error("openat2", error)
                    if isinstance(exc, OSError)
                    else "the path is not valid"
                )
                print(
                    f"E: Could not mount '{_strip_control_characters(plan.source)}' "
                    f"on '{_strip_control_characters(plan.target)}': {reason}"
                )
                sys.exit(1)
            print(
                f"I: Mounting '{_strip_control_characters(plan.source)}' "
                f"on '{plan.target}'"
            )
            kept.append(plan)
        if not kept:
            return (), (0, 0)
        try:
            image_ids = _read_image_user_ids(machine_fd, self.user)
        except (OSError, ValueError) as exc:
            print(
                f"E: Could not read the uid and gid of '{self.user}' in the "
                f"container image: {_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        return tuple(kept), image_ids

    def _machine_poweroff(
        self,
        container_name: Optional[str] = None,
        port_lock_timeout: Optional[float] = None,
        stop_timeout: float = 2 * CONTAINER_POWEROFF_TIMEOUT,
        quiet: bool = False,
    ) -> bool:
        """Stop the container if it's running.

        Return True when the container is stopped or did not run, and False
        when it did not stop. With port_lock_timeout, raise TimeoutError when
        the port mapping lock is not free in that time. That comes before any
        change: the container keeps running, with its port rules and state.
        The poweroff and the terminate, with their machinectl commands and
        waits, take at most stop_timeout in all after the port cleanup. With
        quiet, machinectl gets /dev/null for its output, for a caller that
        holds back its own output.
        """
        if container_name is None:
            container_name = self.container

        pid = self._is_container_running(container_name)
        if not pid:
            print(f"W: Container '{container_name}' not found or not running")
            return True

        # Clean up port forwarding rules before stopping container
        self._cleanup_port_mappings_for_container(
            container_name, lock_timeout=port_lock_timeout
        )

        # Actually stop the container. After a successful poweroff, the
        # machine is gone and terminate would fail, so terminate only a
        # container that did not stop in time. Wait until the scope is gone
        # too, so that a following up can start the same name. The poweroff
        # gets the first half of stop_timeout, and the terminate the rest.
        deadline = time.monotonic() + stop_timeout
        poweroff_deadline = deadline - stop_timeout / 2
        output: Dict[str, int] = (
            {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
            if quiet
            else {}
        )
        _run_secure_subprocess(
            ["machinectl", "poweroff", container_name],
            timeout=_query_timeout_until(poweroff_deadline),
            **output,
        )
        if self._wait_for_container_stop(
            container_name, max(poweroff_deadline - time.monotonic(), 0.0)
        ):
            return True
        _run_secure_subprocess(
            ["machinectl", "terminate", container_name],
            timeout=_query_timeout_until(deadline),
            **{**output, "stderr": subprocess.DEVNULL},
        )
        if self._wait_for_container_stop(
            container_name, max(deadline - time.monotonic(), 0.0)
        ):
            return True
        print(f"W: Container '{container_name}' did not stop")
        return False

    def _wait_for_container_stop(
        self, container_name: str, timeout: float = CONTAINER_POWEROFF_TIMEOUT
    ) -> bool:
        """Wait until the machine and its Sandy scope are gone.

        The queries end by the deadline too, so a query that does not answer
        does not make the wait longer.
        """
        deadline = time.monotonic() + timeout
        while True:
            try:
                if not self._is_container_running(
                    container_name, timeout=_query_timeout_until(deadline)
                ) and not _supervisor_unit_loaded(
                    container_name, timeout=_query_timeout_until(deadline)
                ):
                    return True
            except (ValueError, subprocess.SubprocessError):
                # A stop that cannot be confirmed is not a stop.
                pass
            if time.monotonic() >= deadline:
                return False
            time.sleep(CONTAINER_STOP_POLL_INTERVAL)

    def _get_machine_dir(self):
        return os.path.join(SYSTEMD_MACHINES, f"sandy.{self.container}")

    def _remove_machine_dir(self, mdir, prompt=True):
        """Remove a machine directory with safety checks"""
        try:
            con = _container_name_from_machine_path(mdir)
        except ValueError as exc:
            print(
                "E: Refusing to remove invalid Sandy machine entry "
                f"{_terminal_safe_repr(mdir)}: {_terminal_safe_repr(str(exc))}"
            )
            return

        safe_con = _terminal_safe_repr(con)
        safe_mdir = _terminal_safe_repr(mdir)

        # Prompt for confirmation unless disabled
        if prompt:
            if not self._confirm(f"Remove container {safe_con} ({safe_mdir})"):
                print(f"I: Skipped removal of {safe_con}")
                return

        try:
            _remove_managed_tree(mdir)
            print(f"I: Removed container {safe_con} ({safe_mdir})")
        except Exception as e:
            print(f"E: Problem removing {safe_con}: {_terminal_safe_repr(str(e))}")

    def _is_container_running(
        self, container_name=None, timeout: float = QUERY_COMMAND_TIMEOUT
    ):
        """Check if container is running and return PID if so, None otherwise

        A query that does not answer in timeout raises
        subprocess.TimeoutExpired, and a query that fails for another reason
        than an unknown machine raises _MachineQueryError: neither one means
        "not running".
        """
        if container_name is None:
            container_name = self.container

        try:
            result = _run_secure_subprocess(
                ["machinectl", "show", container_name, "-p", "Leader", "--value"],
                capture_output=True,
                text=True,
                check=True,
                timeout=timeout,
                env=_c_locale_environment(),
            )
        except subprocess.CalledProcessError as exc:
            # machinectl exits 1 for each failure, also when the system bus
            # is gone. Only the error of machined for this name means that
            # the machine does not run (measured on systemd 249 and 257).
            stderr = exc.stderr if isinstance(exc.stderr, str) else ""
            if exc.returncode == 1 and f"No machine '{container_name}' known" in stderr:
                return None
            raise _MachineQueryError(
                container_name, stderr.strip() or f"exit status {exc.returncode}"
            ) from exc
        pid = result.stdout.strip()
        return pid if pid else None

    def _get_running_sandy_containers(self):
        """Get list of all running sandy containers"""
        running = []

        # Check all sandy.* directories
        if os.path.exists(SYSTEMD_MACHINES):
            for mdir in glob.glob(f"{SYSTEMD_MACHINES}/sandy.*"):
                # Skip cache directory
                if mdir.endswith(".__cache"):
                    continue

                try:
                    container_name = _container_name_from_machine_path(mdir)
                except ValueError:
                    continue

                # Check if this container is running
                if self._is_container_running(container_name):
                    running.append(container_name)

        return running

    def _get_cache_dir(self):
        """Get the cache directory path"""
        cache_dir = os.path.join(SYSTEMD_MACHINES, "sandy.__cache")
        if os.path.exists(cache_dir):
            _verify_safe_dir(cache_dir)

        return cache_dir

    def _get_port_mappings_path(self):
        """Return the path to the persistent port mapping state file."""
        return os.path.join(self._get_cache_dir(), PORT_MAPPINGS_FILENAME)

    def _get_port_mappings_lock_path(self):
        """Return the path to the stable port mapping transaction lock."""
        return os.path.join(self._get_cache_dir(), PORT_MAPPINGS_LOCK_FILENAME)

    def _ensure_cache_dir(self):
        """Ensure the cache directory exists with restrictive permissions."""
        cache_dir = self._get_cache_dir()
        if not os.path.exists(cache_dir):
            try:
                _mkdir(cache_dir)
            except FileExistsError:
                # A concurrent state transaction may have created it first.
                _verify_safe_dir(cache_dir)
        else:
            _verify_safe_dir(cache_dir)
        os.chmod(cache_dir, 0o700, follow_symlinks=False)
        return cache_dir

    # The thread that holds the port mapping lock exclusively through this
    # instance, or None.
    _port_mapping_lock_holder: Optional[int] = None

    @contextmanager  # ensures flock acquisition/release is paired at the call site
    def _port_mapping_lock(self, exclusive: bool, timeout: Optional[float] = None):
        """
        Acquire the stable port mapping coordination lock.

        Args:
            exclusive: When True, take an exclusive lock suitable for writes.
            timeout: When set, raise TimeoutError if the lock is not free in
                this many seconds. Without it, wait as long as it takes.

        Inside an exclusive hold of the same thread through this instance, do
        not lock again: a second flock(2) on a new open of the lock file would
        wait for that hold. Open the current state file only, because a write
        in the hold replaces it. up holds the lock from the publish of its
        ports until it has pinned its supervisor and made the markers that
        it needs (see run_up).
        """
        if self._port_mapping_lock_holder == threading.get_ident():
            state_handle = _open_existing_managed_text_file(
                self._get_port_mappings_path()
            )
            try:
                yield state_handle
            finally:
                if state_handle is not None:
                    state_handle.close()
            return
        self._ensure_cache_dir()
        with _locked_state_file(
            self._get_port_mappings_lock_path(),
            self._get_port_mappings_path(),
            exclusive,
            timeout,
            "port mapping",
        ) as state_handle:
            self._port_mapping_lock_holder = (
                threading.get_ident() if exclusive else None
            )
            try:
                yield state_handle
            finally:
                self._port_mapping_lock_holder = None

    def _get_shared_limits_path(self) -> str:
        """Return the path of the saved shared limits."""
        return os.path.join(self._get_cache_dir(), SHARED_LIMITS_FILENAME)

    def _get_shared_limits_lock_path(self) -> str:
        """Return the path of the stable lock of the shared limits."""
        return os.path.join(self._get_cache_dir(), SHARED_LIMITS_LOCK_FILENAME)

    @contextmanager  # ensures flock acquisition/release is paired at the call site
    def _shared_limits_lock(self) -> Iterator[Optional[Any]]:
        """Hold the shared limits lock; yield the saved limits file or None.

        up and update --shared read the saved limits and set them on
        sandy.slice under this lock, so the last saved limits apply.
        """
        self._ensure_cache_dir()
        with _locked_state_file(
            self._get_shared_limits_lock_path(),
            self._get_shared_limits_path(),
            exclusive=True,
        ) as state_handle:
            yield state_handle

    def _set_shared_limits(
        self,
        facts: HostFacts,
        changes: Optional[Dict[str, Any]] = None,
        reset: bool = False,
    ) -> Tuple[GroupLimits, SavedGroupLimits]:
        """Set the saved or the default shared limits on sandy.slice, or exit.

        With changes or reset, change the saved limits, and save them after
        sandy.slice has them. Without reset, a malformed saved file stops the
        call: up must not start a container with limits that root did not
        choose.
        """
        try:
            with self._shared_limits_lock() as handle:
                if reset:
                    saved = SavedGroupLimits()
                else:
                    try:
                        saved = _read_saved_group_limits(handle, facts.online_cpus)
                    except ValueError as exc:
                        print(f"E: {exc}. {SHARED_LIMITS_RESET_HINT}")
                        sys.exit(1)
                    saved = saved._replace(**(changes or {}))
                group = _effective_group_limits(_default_group_limits(facts), saved)
                try:
                    _sync_group_limits(group)
                except (OSError, ValueError, subprocess.SubprocessError) as exc:
                    print(
                        f"E: Could not set the limits of {SUPERVISOR_SLICE}: "
                        f"{_terminal_safe_repr(str(exc))}"
                    )
                    sys.exit(1)
                if changes or reset:
                    try:
                        _write(
                            self._get_shared_limits_path(),
                            _serialize_shared_limits(saved),
                            mode=0o600,
                        )
                    except (OSError, ValueError) as exc:
                        print(
                            "E: Could not save the shared limits: "
                            f"{_terminal_safe_repr(str(exc))}"
                        )
                        print(
                            "   They apply now, but the next up sets the saved "
                            "limits again"
                        )
                        sys.exit(1)
        except (OSError, ValueError) as exc:
            print(
                "E: Could not read the saved shared limits: "
                f"{_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        return group, saved

    def _serialize_port_mapping_state(self, state: Dict[str, Any]) -> str:
        """Serialize the in-memory state to JSON."""
        return json.dumps(state, separators=(",", ":")) + "\n"

    def _load_port_mapping_state(
        self, handle: Optional[Any]
    ) -> Dict[str, Dict[str, Any]]:
        """Load and sanitize persisted port mapping state."""
        if handle is None:
            return {}
        handle.seek(0)
        raw_state = self._parse_port_mapping_state(handle.read())
        sanitized_state: Dict[str, Dict[str, Any]] = {}
        for key, entry in raw_state.items():
            sanitized_entry = self._sanitize_state_entry(key, entry)
            if sanitized_entry:
                sanitized_state[key] = sanitized_entry
        return sanitized_state

    def _serialize_port_state_for_storage(
        self, state: Dict[str, Dict[str, Any]]
    ) -> Dict[str, Dict[str, Any]]:
        serialized: Dict[str, Dict[str, Any]] = {}
        for key, entry in state.items():
            sanitized_entry = self._sanitize_state_entry(key, entry)
            if not sanitized_entry:
                continue
            stored_entry: Dict[str, Any] = {
                "container": sanitized_entry["container"],
                "container_port": sanitized_entry["container_port"],
            }
            if sanitized_entry["ip"]:
                stored_entry["ip"] = sanitized_entry["ip"]
            serialized[key] = stored_entry
        return serialized

    def _persist_port_mapping_state(self, state: Dict[str, Dict[str, Any]]):
        """Persist state to disk or remove the file when empty."""
        path = self._get_port_mappings_path()
        serialized_state = self._serialize_port_state_for_storage(state)
        if serialized_state:
            self._ensure_cache_dir()
            serialized = self._serialize_port_mapping_state(serialized_state)
            _write(path, serialized, mode=0o0600)
        else:
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass

    def _sanitize_state_entry(
        self, key: str, entry: object
    ) -> Optional[Dict[str, Any]]:
        """Validate a persisted flat entry and return canonical dict."""
        if not isinstance(key, str) or ":" not in key:
            return None
        if not isinstance(entry, dict):
            return None

        proto, host_port_str = key.split(":", 1)
        container_name = entry.get("container")
        container_port = entry.get("container_port")

        if not isinstance(container_name, str) or not _validate_container_name(
            container_name
        ):
            return None

        mapping_spec = f"{proto}:{host_port_str}:{container_port}"
        validated = _validate_port_mapping(mapping_spec)
        if validated is None:
            return None

        proto_val, host_port_val, container_port_val = validated
        ip_value = entry.get("ip", "")
        if isinstance(ip_value, str) and _validate_ip_address(ip_value):
            sanitized_ip = ip_value
        else:
            sanitized_ip = ""

        return {
            "proto": proto_val,
            "host_port": host_port_val,
            "container_port": container_port_val,
            "container": container_name,
            "ip": sanitized_ip,
        }

    def _extract_ports_from_state(self, entries):
        """Return sanitized tuples and preferred IP from stored entries."""
        sanitized = []
        container_ip = ""
        for entry in entries or []:
            proto = entry.get("proto")
            host_port = entry.get("host_port")
            container_port = entry.get("container_port")
            ip_value = entry.get("ip", "")
            if proto and isinstance(host_port, int) and isinstance(container_port, int):
                sanitized.append((proto, host_port, container_port))
                if not container_ip and ip_value:
                    container_ip = ip_value
        return sanitized, container_ip

    def _parse_port_mapping_state(self, raw: str) -> dict:
        """Parse state content."""
        if not raw:
            return {}
        try:
            data = json.loads(raw)
        except json.JSONDecodeError as exc:
            print(
                f"W: Port mapping state is invalid JSON: {_terminal_safe_repr(str(exc))}"
            )
            return {}
        if not isinstance(data, dict):
            return {}
        return data

    def _remove_port_mappings_from_state(
        self, container_name: str, lock_timeout: Optional[float] = None
    ) -> list:
        """Remove a container's entry from state and return its ports.

        With lock_timeout, raise TimeoutError when the port mapping lock is
        not free in that time; the state then stays as it was.
        """
        with self._port_mapping_lock(exclusive=True, timeout=lock_timeout) as handle:
            if handle is None:
                return []

            state = self._load_port_mapping_state(handle)
            targeted = [
                entry.copy()
                for entry in state.values()
                if entry.get("container") == container_name
            ]
            if not targeted and not state:
                return []

            # Drop any entries for this container.
            state = {
                key: entry
                for key, entry in state.items()
                if entry.get("container") != container_name
            }

            self._persist_port_mapping_state(state)
        return targeted

    def _clear_port_mapping_state(self):
        """Remove the entire port mapping state file, if present."""
        with self._port_mapping_lock(exclusive=True) as handle:
            if handle is None:
                return
            self._persist_port_mapping_state({})

    def _dedupe_port_mappings(self, mappings):
        """Remove duplicate host port mappings while preserving order."""
        deduped = []
        seen = set()
        for proto, host_port, container_port in mappings:
            key = (proto, host_port)
            if key in seen:
                continue
            seen.add(key)
            deduped.append((proto, host_port, container_port))
        return deduped

    def _existing_network(self) -> "SandyNet":
        """Return the Sandy network as it exists now; never create any of it.

        Reuse self.network when it is configured. Otherwise only inspect the
        host, so that a cleanup cannot create the bridge, change sysctls, or
        install the firewall base (for example, during `up --network host`).
        """
        if self.network and self.network.configured:
            return self.network
        return SandyNet(create=False)

    def _update_port_mapping_state(self, container_name: str, container_ip: str):
        """Update persistent state for the container, aborting on port conflicts."""
        deduped = self._dedupe_port_mappings(self.port_mappings)
        sanitized_ip = ""
        if container_ip and _validate_ip_address(container_ip):
            sanitized_ip = container_ip

        with self._port_mapping_lock(exclusive=True) as handle:
            if handle is None and not deduped:
                return

            state = self._load_port_mapping_state(handle)

            # Remove stale or invalid entries owned by this container so we can rewrite them cleanly.
            keys_to_clear = [
                key
                for key, entry in state.items()
                if entry.get("container") == container_name
            ]
            for key in keys_to_clear:
                state.pop(key, None)

            if not deduped:
                self._persist_port_mapping_state(state)
                return

            for proto, host_port, container_port in deduped:
                key = f"{proto}:{host_port}"
                existing = state.get(key)
                if existing and existing.get("container") != container_name:
                    print(
                        "E: Port "
                        f"{_strip_control_characters(proto)}:{_strip_control_characters(str(host_port))} "
                        f"is already allocated to container "
                        f"'{_strip_control_characters(existing['container'])}'"
                    )
                    print("   Stop the existing container or choose a different port")
                    sys.exit(1)

                state[key] = {
                    "proto": proto,
                    "host_port": host_port,
                    "container_port": container_port,
                    "container": container_name,
                }
                if sanitized_ip:
                    state[key]["ip"] = sanitized_ip

            self._persist_port_mapping_state(state)

    def _cleanup_port_mappings_for_container(
        self, container_name: str, lock_timeout: Optional[float] = None
    ) -> None:
        """Remove firewall rules and state for a specific container.

        Use only the network that exists now. When the bridge is gone (for
        example, after a host reboot), remove the state; nftables rules are
        deleted by comment, which needs no bridge. iptables rules need the
        gateway of the bridge to rebuild their text, so they stay until the
        next bridge setup, which flushes every Sandy chain, or `rm --network`.

        With lock_timeout, raise TimeoutError when the port mapping lock is
        not free in that time; the state and the rules then stay as they were.
        """
        saved_container = self.container
        saved_mappings = list(self.port_mappings)
        # Restore the caller's network. A network left here that is not
        # configured would make a later lenient `up` skip its own setup.
        saved_network = self.network
        try:
            self.container = container_name
            state_ports = self._remove_port_mappings_from_state(
                container_name, lock_timeout
            )
            if not state_ports:
                return

            sanitized, container_ip = self._extract_ports_from_state(state_ports)
            if not sanitized:
                return

            if not container_ip:
                container_ip = self._get_container_ip()

            if not container_ip:
                print(
                    f"W: Could not determine IP for '{_strip_control_characters(container_name)}' during cleanup"
                )
                return

            self.port_mappings = sanitized
            self.network = self._existing_network()
            backend = self.network.firewall_backend
            if backend == "iptables":
                if self.network.configured:
                    self._cleanup_port_forwarding_ipt(container_ip)
            elif backend == "nftables":
                # The bridge setup does not flush the DNAT chains, so delete
                # these rules whenever the table exists.
                if self.network._nft_table_exists("ip", "sandy"):
                    self._cleanup_port_forwarding_nft(container_ip)
        finally:
            self.container = saved_container
            self.port_mappings = saved_mappings
            self.network = saved_network

    def _create_manifest_content(self):
        """Create manifest content for cache identification"""
        return [
            f"bootstrap_method={self.bootstrap_method}",
            f"base_image={self.base_image}",
            f"user={self.user}",
            f"bootstrap_script_hash={self._hash_file(self.bootstrap_script)}",
            f"setup_script_hash={self._hash_file(self._get_setup_script_path())}",
        ]

    def _compute_cache_key(self):
        """Compute cache key by hashing manifest content"""
        manifest_content = "\n".join(self._create_manifest_content()) + "\n"
        return hashlib.sha256(manifest_content.encode("utf-8")).hexdigest()

    def _hash_file(self, filepath):
        """Compute SHA256 hash of a file"""
        hasher = hashlib.sha256()
        with open(filepath, "rb") as f:
            hasher.update(f.read())
        return hasher.hexdigest()

    def _get_setup_script_path(self):
        """Get path to setup script (custom or default)"""
        custom_setup = os.environ.get("SANDY_SETUP_SCRIPT", "")
        if custom_setup and os.path.exists(custom_setup):
            return custom_setup
        else:
            return self.cn_setup_container

    def _get_cache_path(self):
        """Get full path to cache file"""
        cache_dir = self._get_cache_dir()
        cache_key = self._compute_cache_key()
        return os.path.join(cache_dir, f"{cache_key}.tar")

    def _create_cache(self, srcdir):
        """Create cache tar file from built container directory"""
        _verify_safe_dir(srcdir)

        # Ensure cache directory exists
        self._ensure_cache_dir()
        cache_path = self._get_cache_path()

        # Create manifest with all cached parameters
        manifest_path = os.path.join(srcdir, ".sandy.manifest")
        assert not os.path.exists(manifest_path)  # should never happen
        manifest_content = "\n".join(self._create_manifest_content()) + "\n"
        print(f"I: Creating cache '{cache_path}' with manifest:\n{manifest_content}")

        _write(manifest_path, manifest_content)

        # Create tar with full preservation of all attributes
        # --numeric-owner preserves exact uid/gid
        # --preserve-permissions preserves all permission bits
        # --xattrs preserves extended attributes (including SELinux)
        # --acls preserves POSIX ACLs
        # --sparse handles sparse files efficiently
        # Exclude machine-id and hosts since they need to be unique per container
        cmd = [
            "tar",
            "--create",
            "--file",
            cache_path,
            "--directory",
            srcdir,
            "--numeric-owner",
            "--preserve-permissions",
            "--xattrs",
            "--acls",
            "--sparse",
            "--exclude=etc/machine-id",
            "--exclude=etc/hosts",
            ".",
        ]

        result = _run_secure_subprocess(cmd)
        if result.returncode != 0:
            print(f"W: Failed to create cache file")
            # Remove partial cache file
            if os.path.exists(cache_path):
                os.unlink(cache_path)

        # Clean up manifest file
        if os.path.exists(manifest_path):
            os.unlink(manifest_path)

    def _clear_cache_contents(
        self, preserve_state: bool = True, *, temporary_files: bool = False
    ) -> bool:
        """Clear cache contents while preserving transaction coordination.

        A temporary file of an atomic write (see _write) can belong to an
        update of the port mapping state in flight. So with temporary_files,
        remove only those files, under the port mapping lock of the caller;
        without it, remove everything else, and leave those files.
        """
        cache_dir = self._get_cache_dir()
        if not os.path.exists(cache_dir):
            return False

        removed_any = False
        for entry in os.listdir(cache_dir):
            entry_path = os.path.join(cache_dir, entry)
            if entry in (
                PORT_MAPPINGS_LOCK_FILENAME,
                LIFECYCLE_LOCK_FILENAME,
                SHARED_LIMITS_LOCK_FILENAME,
                ADDRESSES_LOCK_FILENAME,
                PURGE_LOCK_FILENAME,
            ) or _is_up_lock_filename(entry):
                # Each lock inode is permanent. Removing one could split
                # queued and new processes across different locks.
                continue
            if entry == SHARED_LIMITS_FILENAME:
                # Configuration that root saved, not a cache.
                continue
            if preserve_state and entry == PORT_MAPPINGS_FILENAME:
                continue
            if bool(WRITE_TEMPORARY_PATTERN.fullmatch(entry)) != temporary_files:
                continue
            try:
                entry_stat = os.lstat(entry_path)
            except FileNotFoundError:
                continue

            if stat.S_ISDIR(entry_stat.st_mode):
                _remove_managed_tree(entry_path)
            else:
                try:
                    os.remove(entry_path)
                except FileNotFoundError:
                    continue
            removed_any = True
        return removed_any

    def _guest_network_config(
        self,
        planned_guest_network: Optional[GuestNetwork],
    ) -> Tuple[Optional[str], Optional[str]]:
        """Return guest network files data from a preview or configured bridge."""
        if planned_guest_network is not None:
            return planned_guest_network

        if self.network and self.network.configured:
            if self.network._ensure_gateway():
                return self.network.network_cidr, self.network.gateway
            print(
                f"W: Could not refresh network configuration for '{_strip_control_characters(self.network.bridge_name)}', creating guest files without network init"
            )
        return None, None

    def _new_machine_from_cache(
        self,
        cache_path: str,
        mdir: str,
        planned_guest_network: Optional[GuestNetwork] = None,
    ) -> None:
        """Create new machine from cache template"""
        _verify_safe_dir(os.path.dirname(cache_path))

        print(f"I: Creating new machine from cache: {cache_path}")

        # we need to create the directory to untar to it with -C/--directory
        _mkdir(mdir)

        # Extract tar with full preservation of all attributes
        cmd = [
            "tar",
            "--extract",
            "--file",
            cache_path,
            "--directory",
            mdir,
            "--numeric-owner",
            "--preserve-permissions",
            "--xattrs",
            "--acls",
            "--sparse",
        ]

        result = _run_secure_subprocess(cmd)
        if result.returncode != 0:
            print(f"E: Failed to create new machine from cache")
            sys.exit(1)

        # Generate new machine ID for the new container instance
        machine_fd = _open_verified_dir(mdir)
        try:
            _run_secure_subprocess(
                [
                    "systemd-machine-id-setup",
                    f"--root={_proc_self_fd_path(machine_fd)}",
                ],
                pass_fds=(machine_fd,),
            )
        finally:
            os.close(machine_fd)

        # Create fresh /etc/hosts file with container name
        network_cidr, gateway = self._guest_network_config(planned_guest_network)
        _create_guest_files(mdir, self.container, network_cidr, gateway)

        print(f"I: Successfully created new machine from cache")

    def _new_machine_from_scratch(
        self,
        mdir: str,
        cache_enabled: bool = False,
        planned_guest_network: Optional[GuestNetwork] = None,
    ) -> None:
        """Build new machine from scratch using bootstrap method"""
        setup_environment = _container_environment("root", "/root")
        print(
            f"I: Using {self.bootstrap_method} method to create '{self.base_image}' container"
        )
        cmd = [self.bootstrap_script, mdir, self.base_image]
        result = _run_secure_subprocess(cmd)
        if result.returncode != 0:
            print(f"E: Bootstrap script failed, cleaning up '{mdir}'")
            self._remove_machine_dir(mdir, prompt=False)
            sys.exit(1)
        _verify_safe_dir(mdir)

        setup_script = os.path.join(mdir, "root", "setup-container.sh")
        setup_script_exists = os.path.exists(setup_script)
        if setup_script_exists:
            print(f"W: '{setup_script}' exists, skipping setup")
        else:
            source_script = self._get_setup_script_path()

            # Copy and substitute placeholders
            with open(source_script, "r") as f:
                content = f.read()

            # Substitute placeholders
            content = content.replace("%%MACHINE_USER%%", self.user)

            _write(setup_script, content, mode=0o0755)

        machine_fd = _open_verified_dir(mdir)
        try:
            machine_root = _proc_self_fd_path(machine_fd)
            _run_secure_subprocess(
                [
                    "systemd-machine-id-setup",
                    f"--root={machine_root}",
                ],
                pass_fds=(machine_fd,),
            )

            # run without --ephemeral, --private-users and restrictive
            # networking (need to do this at least once without --private-users
            # to setup the container properly). Also run with:
            # --directory=/proc/self/fd/<machine-fd>
            # --machine=foo  # this makes it show up as 'foo', not 'sandy.foo'
            # --timezone=off # needed if self.cn_setup_container upgrades
            #                # tzdata since nspawn otherwise bind mounts this
            #                # file into the container. Omitting this allows
            #                # the upgrade to work (up will omit this)
            if not setup_script_exists:
                cmd = [
                    "systemd-nspawn",
                    f"--directory={machine_root}",
                    f"--machine={self.container}",
                    "--tmpfs=/tmp:mode=1777",
                    "--as-pid2",
                    "--timezone=off",
                    "--user=root",
                    os.path.join("/root", os.path.basename(setup_script)),
                ]
                _run_secure_subprocess(
                    cmd,
                    env=setup_environment,
                    pass_fds=(machine_fd,),
                )
        finally:
            os.close(machine_fd)

        if not setup_script_exists:
            # Create fresh /etc/hosts file with container name
            network_cidr, gateway = self._guest_network_config(planned_guest_network)
            _create_guest_files(mdir, self.container, network_cidr, gateway)

            # Create cache if enabled and setup completed successfully
            if cache_enabled:
                self._create_cache(mdir)

    def _purge_cache(self):
        """Remove cache payloads while retaining stable coordination state."""
        cache_dir = self._get_cache_dir()
        if os.path.exists(cache_dir):
            # One purge at a time: two removals of one tree would fail. Only
            # purges wait for this lock, so the removal of the payload, which
            # can take long, holds no lock that up or an attach waits for.
            with _purge_lock():
                removed_any = self._clear_cache_contents(preserve_state=True)
                # Then the temporary files of atomic writes, under the port
                # mapping lock: one can belong to an update of the port
                # mapping state in flight. This step is short.
                with self._port_mapping_lock(exclusive=True):
                    if self._clear_cache_contents(
                        preserve_state=True, temporary_files=True
                    ):
                        removed_any = True
            if removed_any:
                print(
                    f"I: Purged cache directory ('{cache_dir}') except coordination state and saved shared limits"
                )
            else:
                print(
                    f"I: Cache directory retained only coordination state and saved shared limits ('{cache_dir}')"
                )
        else:
            print(f"I: No cache directory to purge")

    def _entry_request(
        self,
        leader: str,
        user: str,
        user_home: str,
        kind: str,
        command: str,
        *,
        use_workspace: bool,
    ) -> EntryRequest:
        """Build the entry request for the running container.

        With use_workspace, the working directory is the workspace when it
        exists. Otherwise it is "/", where the nsenter path started (measured).
        """
        workdir = "/"
        workspace = f"{user_home}/workspace"
        if (
            use_workspace
            and self.workspace
            and os.path.isdir(os.path.join(self._get_machine_dir(), workspace[1:]))
        ):
            workdir = workspace
        request = EntryRequest(
            machine=self.container,
            leader_pid=_parse_leader_pid(leader),
            parent_pid=os.getpid(),
            attach_leaf=_new_attach_leaf(),
            user=user,
            home=user_home,
            workdir=workdir,
            kind=kind,
            command=command,
        )
        # Reject what the helper would reject before any host setup.
        _entry_request_args(request)
        return request

    @contextmanager  # closes the script descriptor and ends the attach leaf
    def _entry_helper_command(
        self, request: EntryRequest
    ) -> Iterator[Tuple[list, int]]:
        """Yield the entry helper argv and the script descriptor to pass to it.

        After the helper exits, kill what is left in its attach leaf, such as
        background jobs of the session, and remove the leaf. Raise
        _EntrySetupError when the helper cannot be prepared.
        """
        try:
            # The helper takes the lifecycle lock, which lives in the cache
            # directory.
            self._ensure_cache_dir()
            script_fd = _open_entry_script()
        except (OSError, ValueError) as exc:
            raise _EntrySetupError(str(exc)) from exc
        try:
            yield _entry_helper_argv(script_fd, request), script_fd
        finally:
            try:
                os.close(script_fd)
            finally:
                self._end_attach_leaf(request.attach_leaf)

    def _end_attach_leaf(self, attach_leaf: str) -> None:
        """End and remove an attach leaf; warn if that fails."""
        try:
            _remove_attach_leaf(self.container, attach_leaf)
        except (OSError, ValueError) as exc:
            print(
                f"W: Could not remove attach cgroup {attach_leaf}: "
                f"{_terminal_safe_repr(str(exc))}"
            )

    def _exec(
        self,
        command: Optional[str],
        *,
        login_shell: bool = False,
        console: bool = False,
        sigint: Optional[_DeferredSigint] = None,
    ) -> int:
        """Run a command or a login shell in the container as self.user.

        The entry helper applies the container payload's seccomp filters and
        capability bounding set. When login_shell is True, spawn a single
        interactive login shell so that startup files execute only once
        (mirrors `ssh -tt` behaviour). up passes the SIGINT that it holds
        back; a Ctrl-C held meanwhile ends the console here.
        """
        # With console=True, this is the console of up without -d. Each way
        # out ends the console: a hangup only removes the up-console marker,
        # and each other way out is a console exit, also when the console did
        # not start. A marker that stayed would keep the container running
        # after its last attach.
        console_ended = not console
        try:
            if sigint is not None:
                sigint.release()
            container_environment = _container_environment(self.user, self.user_home)

            leader = self._is_container_running()
            if not leader:
                print(f"E: Container '{self.container}' not found or not running")
                sys.exit(1)

            if not login_shell and not command:
                print("E: Command required for container execution")
                sys.exit(1)

            exec_cmd = "exec bash --login" if login_shell else str(command)
            try:
                request = self._entry_request(
                    leader,
                    self.user,
                    self.user_home,
                    ENTRY_KIND_TTY,
                    exec_cmd,
                    use_workspace=True,
                )
            except ValueError as exc:
                print(f"E: Invalid container entry: {_terminal_safe_repr(str(exc))}")
                sys.exit(1)

            events_before = _container_memory_events(self.container)
            try:
                with self._entry_helper_command(request) as (argv, script_fd):
                    with _attach_hangup_handlers():
                        # The helper runs the command through script, which
                        # allocates a terminal from the container's devpts
                        # instance.
                        status = self._run_container_interactive(
                            argv,
                            environment=container_environment,
                            pass_fds=(script_fd,),
                        )
            except _AttachHangup as hangup:
                # Loss of the terminal ends only this attach; the attach leaf
                # is already removed. It never stops the container.
                if console:
                    console_ended = True
                    self._end_up_console()
                sys.exit(128 + hangup.signum)
            except _EntrySetupError as exc:
                print(
                    "E: Could not prepare the container entry: "
                    f"{_terminal_safe_repr(str(exc))}"
                )
                if console:
                    # The console did not start; handle it as a console exit.
                    console_ended = True
                    self._stop_if_last_attach(console=True)
                sys.exit(1)
            self._report_oom_kills(events_before)
            console_ended = True
            self._stop_if_last_attach(console=console)
            return status
        finally:
            if not console_ended:
                # For example: a machine query that failed or did not answer,
                # an invalid entry, a Ctrl-C, or another error.
                self._stop_if_last_attach(console=True)

    def _report_oom_kills(self, before: Optional[MemoryEvents]) -> None:
        """Tell the user when the kernel ended processes for lack of memory.

        The processes inside cannot see the limits, so a killed build shows
        only "Killed". Compare the memory events from before the session
        with now, and name each limit that was reached meanwhile. When no
        limit was reached, the host ran out of memory.
        """
        after = _container_memory_events(self.container)
        if before is None or after is None:
            return
        kills = after.oom_kills - before.oom_kills
        if kills <= 0:
            return
        processes = "1 process" if kills == 1 else f"{kills} processes"
        print(
            f"W: The kernel ended {processes} in '{self.container}' during this "
            "session because memory ran out"
        )
        group_limit = after.group_ooms > before.group_ooms
        own_limit = after.container_ooms > before.container_ooms
        if group_limit:
            print(
                "   The Sandy containers reached the memory limit that they "
                "share. Stop other containers, start less work at a time, or "
                "raise the limit with: sandy update --shared -m SIZE"
            )
        if own_limit:
            print("   The container reached a memory limit of its own")
        if not group_limit and not own_limit:
            print("   The host ran out of memory")

    def _stop_if_last_attach(self, console: bool = False) -> None:
        """Stop a container that up started without -d when no attach is left.

        Decide and stop under the lifecycle lock, so that a new attach cannot
        start in between and two exits cannot both stop the container. Block
        SIGHUP and SIGTERM meanwhile, so that the stop is not cut short. The
        count also removes empty attach leaves, for -d containers too. While
        the up-console marker exists, the console has not exited, so no
        stop; the console's own exit (console=True) removes the marker first.
        The output waits until the end, and machinectl gets no terminal: a
        terminal write can block.
        """
        blocked = threading.current_thread() is threading.main_thread()
        # A terminal write can block, for example after the STOP character,
        # and each attach waits for the lifecycle lock. So hold back the
        # output of the decision and the stop, and write it at the end: with
        # the lock free, and with SIGHUP and SIGTERM unblocked, so that they
        # can end a write that blocks.
        held_output = io.StringIO()
        if blocked:
            signal.pthread_sigmask(signal.SIG_BLOCK, ATTACH_HANGUP_SIGNALS)
        try:
            with redirect_stdout(held_output):
                try:
                    with _lifecycle_lock():
                        try:
                            unit_fd = _open_supervisor_cgroup(self.container)
                        except FileNotFoundError:
                            return
                        try:
                            if console:
                                _remove_up_console_marker(unit_fd)
                            remaining = _count_populated_attaches(unit_fd)
                            console_running = _up_console_marker_exists(unit_fd)
                        finally:
                            os.close(unit_fd)
                        if remaining or console_running:
                            return
                        if not _supervisor_started_attached(self.container):
                            return
                        print(f"I: Stopping '{self.container}': no session is attached")
                        try:
                            # Each attach waits for the lifecycle lock, so the stop
                            # itself also takes only a short time.
                            stopped = self._machine_poweroff(
                                port_lock_timeout=PORT_MAPPINGS_LOCK_TIMEOUT,
                                stop_timeout=CONTAINER_POWEROFF_TIMEOUT,
                                quiet=True,
                            )
                        except TimeoutError:
                            # Each attach waits for the lifecycle lock, so the stop
                            # waits for the port mapping lock only for a short time.
                            # Then the container keeps running with its ports: a stop
                            # that left them would make other ups refuse those ports.
                            print(
                                f"W: Did not stop '{self.container}': the port mapping "
                                "lock stayed busy"
                            )
                            stopped = False
                        except subprocess.SubprocessError as exc:
                            print(
                                f"W: Could not stop '{self.container}': "
                                f"{_terminal_safe_repr(str(exc))}"
                            )
                            stopped = False
                        if not stopped:
                            print(
                                "   Stop it with: sandy --container "
                                f"{self.container} down"
                            )
                except (OSError, ValueError, subprocess.SubprocessError) as exc:
                    print(
                        f"W: Could not check the sessions of '{self.container}': "
                        f"{_terminal_safe_repr(str(exc))}"
                    )
        finally:
            if blocked:
                signal.pthread_sigmask(signal.SIG_UNBLOCK, ATTACH_HANGUP_SIGNALS)
            _write_held_output(held_output)

    def _end_up_console(self) -> None:
        """After a console hangup: remove the marker, but never stop."""
        try:
            with _lifecycle_lock():
                unit_fd = _open_supervisor_cgroup(self.container)
                try:
                    _remove_up_console_marker(unit_fd)
                finally:
                    os.close(unit_fd)
        except FileNotFoundError:
            pass
        except (OSError, ValueError) as exc:
            print(
                f"W: Could not update the sessions of '{self.container}': "
                f"{_terminal_safe_repr(str(exc))}"
            )

    def _run_as_root(
        self, command: str, **kwargs: Any
    ) -> Optional[subprocess.CompletedProcess]:
        """Run command as container root through the entry helper.

        Return None when the container is not running.
        """
        container_environment = _container_environment("root", "/root")
        leader = self._is_container_running()
        if not leader:
            return None
        request = self._entry_request(
            leader, "root", "/root", ENTRY_KIND_SH, command, use_workspace=False
        )
        with self._entry_helper_command(request) as (argv, script_fd):
            return _run_secure_subprocess(
                argv, env=container_environment, pass_fds=(script_fd,), **kwargs
            )

    def _exec_as_root(self, command) -> subprocess.CompletedProcess:
        """Execute command in container as root through the entry helper."""
        # Validate command for basic security
        if not command or len(command) > 1024:
            print("E: Invalid command for container execution")
            sys.exit(1)

        try:
            result = self._run_as_root(command)
        except ValueError as exc:
            print(f"E: Invalid container entry: {_terminal_safe_repr(str(exc))}")
            sys.exit(1)
        except _EntrySetupError as exc:
            print(
                "E: Could not prepare the container entry: "
                f"{_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        if result is None:
            print(f"E: Container '{self.container}' not found or not running")
            sys.exit(1)
        return result

    def _run_container_interactive(
        self,
        cmd,
        environment: Mapping[str, str],
        pass_fds: Tuple[int, ...] = (),
    ) -> int:
        """Run an entry helper command under a pty that relays the terminal."""

        def master_read(fd: int) -> bytes:
            try:
                return os.read(fd, 1024)
            except OSError:
                return b""

        def stdin_read(fd: int) -> bytes:
            try:
                return os.read(fd, 1024)
            except OSError:
                return b""

        return _run_secure_subprocess_pty(
            cmd,
            master_read=master_read,
            stdin_read=stdin_read,
            environment=environment,
            pass_fds=pass_fds,
        )

    def _wait_for_container_ready(
        self,
        spinner_line_event: Optional[threading.Event] = None,
        timeout: int = CONTAINER_READY_TIMEOUT,
        supervisor: Optional[subprocess.Popen] = None,
    ) -> bool:
        """Wait for container readiness; show spinner dots only when requested.

        Return False at once when the supervisor has exited.
        """
        if not isinstance(timeout, int) or isinstance(timeout, bool) or timeout <= 0:
            return False

        spinner_active = False
        if spinner_line_event:
            spinner_active = not spinner_line_event.is_set()
        deadline = time.monotonic() + timeout

        while time.monotonic() < deadline:
            if supervisor is not None and supervisor.poll() is not None:
                return False
            # Ready means that the entry helper can confine and run a command.
            # Until the container's payload (PID 2) exists, the helper refuses
            # the attach, because the Leader's confinement may not be final
            # yet. So an early probe fails closed and is retried. An
            # _EntrySetupError does not go away by itself; it propagates.
            try:
                result = self._run_as_root("true", capture_output=True, timeout=5)
                if result is not None and result.returncode == 0:
                    return True
            except (
                subprocess.CalledProcessError,
                subprocess.TimeoutExpired,
                _MachineQueryError,
                ValueError,
            ):
                pass
            if spinner_active and spinner_line_event:
                if spinner_line_event.is_set():
                    spinner_active = False
                else:
                    print(".", end="", flush=True)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(CONTAINER_READY_INTERVAL, remaining))
        return False

    def _wait_for_mounts(
        self,
        plans: Tuple[MountPlan, ...],
        image_ids: Tuple[int, int],
        pinned: PinnedSupervisor,
        spinner_line_event: Optional[threading.Event] = None,
        timeout: int = CONTAINER_READY_TIMEOUT,
        supervisor: Optional[subprocess.Popen] = None,
    ) -> bool:
        """Mount the directories as soon as the container has its payload.

        Return False when the supervisor exits or the wait times out. Raise
        _MountError when a mount fails; the caller stops the container. Until
        the mounts are done, the mounts-pending marker refuses every attach.
        """
        spinner_active = False
        if spinner_line_event:
            spinner_active = not spinner_line_event.is_set()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if supervisor is not None and supervisor.poll() is not None:
                return False
            try:
                _mount_container_dirs(self.container, plans, image_ids, pinned)
                return True
            except ProcessLookupError:
                # The container is still starting, or it is gone; the
                # supervisor check above ends the wait in the second case.
                pass
            except (OSError, ValueError, subprocess.SubprocessError) as exc:
                raise _MountError(
                    f"the directories in the container: {_terminal_safe_repr(str(exc))}"
                ) from exc
            if spinner_active and spinner_line_event:
                if spinner_line_event.is_set():
                    spinner_active = False
                else:
                    print(".", end="", flush=True)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(CONTAINER_READY_INTERVAL, remaining))
        return False

    def _wait_for_keepalive_open(self, supervisor: subprocess.Popen) -> bool:
        """Wait until the payload has opened the keepalive script.

        Return False when the supervisor exits or the wait times out. A
        failed check is retried: the payload can still be in execve.
        """
        deadline = time.monotonic() + KEEPALIVE_OPEN_TIMEOUT
        while supervisor.poll() is None:
            try:
                if _payload_has_opened_keepalive(self.container):
                    return True
            except (OSError, ValueError, subprocess.SubprocessError):
                pass
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(KEEPALIVE_OPEN_INTERVAL, remaining))
        return False

    def _validate_container_ip_for_network(self, container_ip: str) -> str:
        """Verify a parsed container IP belongs to the active Sandy network."""
        network_cidr = self.network.network_cidr if self.network else None
        return _validate_container_ip_for_cidr(container_ip, network_cidr)

    def _get_container_ip(self) -> Optional[str]:
        """Extract container IP from /init.sh using contained descriptor resolution."""
        mdir = self._get_machine_dir()
        try:
            container_ip = _read_machine_container_ip(mdir)
            if container_ip is None:
                return None
            return self._validate_container_ip_for_network(container_ip)
        except Exception as e:
            print(
                "W: Could not read container IP from init script: "
                f"{_terminal_safe_repr(str(e))}"
            )

        return None

    def _setup_port_forwarding_rules(
        self,
        container_ip_override: object = CONTAINER_IP_UNSET,
    ):
        """Setup port forwarding rules after container starts"""
        if not self.port_mappings:
            return

        assert (
            self.network is not None
        ), "Network must be configured for port forwarding"

        if container_ip_override is CONTAINER_IP_UNSET:
            container_ip = self._get_container_ip()
        elif container_ip_override is None:
            container_ip = None
        elif isinstance(container_ip_override, str):
            container_ip = container_ip_override
        else:
            raise ValueError("Container IP override must be a string or None")
        if not container_ip:
            print("E: Could not determine container IP for port forwarding")
            return
        try:
            container_ip = self._validate_container_ip_for_network(container_ip)
        except PermissionError as exc:
            print(
                "E: Invalid container IP for port forwarding: "
                f"{_terminal_safe_repr(str(exc))}"
            )
            return

        self._update_port_mapping_state(self.container, container_ip)

        # Setup rules based on firewall backend
        if self.network.firewall_backend == "iptables":
            self._setup_port_forwarding_ipt(container_ip)
        elif self.network.firewall_backend == "nftables":
            self._setup_port_forwarding_nft(container_ip)
        else:
            print("W: No firewall backend available, port forwarding disabled")

    def _setup_port_forwarding_ipt(self, container_ip: str) -> bool:
        """Setup port forwarding rules for iptables - called from Sandy"""
        if not self.port_mappings:
            return True

        assert (
            self.network is not None
        ), "Network must be configured for port forwarding"
        assert self.network.network_cidr is not None, "Network CIDR must be configured"

        if not self.network._ensure_gateway():
            print(
                f"E: Could not determine gateway for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False

        if not self.network.gateway:
            print(
                f"E: Gateway value missing for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False

        try:
            for proto, host_port, container_port in self.port_mappings:
                # DNAT in OUTPUT chain (for host-generated traffic to 127.0.0.1)
                self.network._run_iptables(
                    "-A",
                    "sandy-nat-out",
                    "-p",
                    proto,
                    "-d",
                    "127.0.0.1",
                    "--dport",
                    str(host_port),
                    "-j",
                    "DNAT",
                    "--to-destination",
                    f"{container_ip}:{container_port}",
                    table="nat",
                    error_prefix=f"Add OUTPUT DNAT for {proto}:{host_port}->{container_port}",
                )

                # DNAT in PREROUTING chain (for forwarded traffic)
                self.network._run_iptables(
                    "-A",
                    "sandy-nat-pre",
                    "-p",
                    proto,
                    "-d",
                    "127.0.0.1",
                    "--dport",
                    str(host_port),
                    "-j",
                    "DNAT",
                    "--to-destination",
                    f"{container_ip}:{container_port}",
                    table="nat",
                    error_prefix=f"Add PREROUTING DNAT for {proto}:{host_port}->{container_port}",
                )

                # SNAT in POSTROUTING chain (rewrite source from 127.0.0.1 to gateway)
                # This is necessary so the container can route the response back
                self.network._run_iptables(
                    "-A",
                    "sandy-nat-post",
                    "-p",
                    proto,
                    "-s",
                    "127.0.0.1/8",
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-j",
                    "SNAT",
                    "--to-source",
                    self.network.gateway,
                    table="nat",
                    error_prefix=f"Add SNAT for {proto}:{host_port} forwarding",
                )

                # FORWARD acceptance rule (insert at beginning for priority)
                self.network._run_iptables(
                    "-I",
                    "sandy-fwd",
                    "1",
                    "-p",
                    proto,
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-m",
                    "conntrack",
                    "--ctstate",
                    "NEW,ESTABLISHED,RELATED",
                    "-j",
                    "ACCEPT",
                    error_prefix=f"Add FORWARD rule for {proto}:{container_port}",
                )

                # Allow direct access to container IP from host (insert at beginning for priority)
                self.network._run_iptables(
                    "-I",
                    "sandy-out",
                    "1",
                    "-o",
                    self.network.bridge_name,
                    "-p",
                    proto,
                    "-s",
                    self.network.gateway,
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-m",
                    "conntrack",
                    "--ctstate",
                    "NEW",
                    "-j",
                    "ACCEPT",
                    error_prefix=f"Add sandy-out rule for direct access to {proto}:{container_port}",
                )

                print(
                    f"I: Port forwarding: 127.0.0.1:{host_port} -> {container_ip}:{container_port} ({proto})"
                )

            return True
        except Exception as e:
            print(f"E: Error setting up port forwarding: {_terminal_safe_repr(str(e))}")
            return False

