    def _setup_port_forwarding_nft(self, container_ip: str) -> bool:
        """Setup port forwarding rules for nftables - called from Sandy"""
        if not self.port_mappings:
            return True

        assert (
            self.network is not None
        ), "Network must be configured for port forwarding"
        assert self.network.network_cidr is not None, "Network CIDR must be configured"

        if not self.network._ensure_gateway():
            print(
                f"E: Could not determine gateway for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False

        if not self.network.gateway:
            print(
                f"E: Gateway value missing for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False

        assert self.network is not None
        network = self.network
        gateway = network.gateway
        if gateway is None:
            return False
        bridge_name = network.bridge_name

        try:
            for proto, host_port, container_port in self.port_mappings:
                # Every rule of this mapping carries its comment, so that
                # cleanup can find exactly these rules by handle.
                comment = [
                    "comment",
                    f'"{_nft_port_rule_comment(self.container, proto, host_port)}"',
                ]
                # DNAT in output chain (for host-generated traffic to 127.0.0.1)
                destination = f"{container_ip}:{container_port}"
                self.network._run_nft(
                    "add",
                    *self._nft_dnat_rule_args("output", proto, host_port, destination),
                    *comment,
                    error_prefix=f"Add OUTPUT DNAT for {proto}:{host_port}->{container_port}",
                )

                # DNAT in prerouting chain (for forwarded traffic)
                self.network._run_nft(
                    "add",
                    *self._nft_dnat_rule_args(
                        "prerouting", proto, host_port, destination
                    ),
                    *comment,
                    error_prefix=f"Add PREROUTING DNAT for {proto}:{host_port}->{container_port}",
                )

                # SNAT in postrouting chain (rewrite source from 127.0.0.1 to gateway)
                # This is necessary so the container can route the response back
                self.network._run_nft(
                    "add",
                    *self._nft_snat_rule_args(
                        gateway, proto, container_ip, container_port
                    ),
                    *comment,
                    error_prefix=f"Add SNAT for {proto}:{host_port} forwarding",
                )

                # FORWARD acceptance rule
                self.network._run_nft(
                    "insert",
                    *self._nft_forward_accept_args(proto, container_ip, container_port),
                    *comment,
                    error_prefix=f"Add FORWARD rule for {proto}:{container_port}",
                )

                # Allow direct access to container IP from host (insert at beginning for priority)
                self.network._run_nft(
                    "insert",
                    *self._nft_output_allow_args(
                        bridge_name, gateway, proto, container_ip, container_port
                    ),
                    *comment,
                    error_prefix=f"Add output_filter rule for direct access to {proto}:{container_port}",
                )

                print(
                    f"I: Port forwarding: 127.0.0.1:{host_port} -> {container_ip}:{container_port} ({proto})"
                )

            return True
        except Exception as e:
            print(
                "E: Error setting up nftables port forwarding: "
                f"{_terminal_safe_repr(str(e))}"
            )
            return False

    def _cleanup_port_forwarding_rules(
        self, container_ip_override: Optional[str] = None
    ):
        """Clean up port forwarding rules when container exits"""
        if not self.port_mappings:
            return

        assert self.network is not None, "Network must be configured for cleanup"

        container_ip = container_ip_override or self._get_container_ip()
        if not container_ip:
            # Container not running, rules should already be gone or will fail silently
            return

        # Cleanup rules based on firewall backend
        if self.network.firewall_backend == "iptables":
            self._cleanup_port_forwarding_ipt(container_ip)
        elif self.network.firewall_backend == "nftables":
            self._cleanup_port_forwarding_nft(container_ip)

    def _cleanup_port_forwarding_ipt(self, container_ip: str) -> bool:
        """Remove port forwarding rules for iptables - called when container stops"""
        if not self.port_mappings:
            return True

        assert self.network is not None, "Network must be configured for cleanup"
        assert self.network.network_cidr is not None, "Network CIDR must be configured"

        if not self.network._ensure_gateway():
            print(
                f"E: Could not determine gateway for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False

        if not self.network.gateway:
            print(
                f"E: Gateway value missing for bridge '{_strip_control_characters(self.network.bridge_name)}'"
            )
            return False
        try:
            for proto, host_port, container_port in self.port_mappings:
                # Remove DNAT in OUTPUT chain (for host-generated traffic to 127.0.0.1)
                self.network._run_iptables(
                    "-D",
                    "sandy-nat-out",
                    "-p",
                    proto,
                    "-d",
                    "127.0.0.1",
                    "--dport",
                    str(host_port),
                    "-j",
                    "DNAT",
                    "--to-destination",
                    f"{container_ip}:{container_port}",
                    table="nat",
                    error_prefix=f"Remove OUTPUT DNAT for {proto}:{host_port}->{container_port}",
                )
                # Remove DNAT in PREROUTING chain (for forwarded traffic)
                self.network._run_iptables(
                    "-D",
                    "sandy-nat-pre",
                    "-p",
                    proto,
                    "-d",
                    "127.0.0.1",
                    "--dport",
                    str(host_port),
                    "-j",
                    "DNAT",
                    "--to-destination",
                    f"{container_ip}:{container_port}",
                    table="nat",
                    error_prefix=f"Remove PREROUTING DNAT for {proto}:{host_port}->{container_port}",
                )
                # Remove SNAT in POSTROUTING chain
                self.network._run_iptables(
                    "-D",
                    "sandy-nat-post",
                    "-p",
                    proto,
                    "-s",
                    "127.0.0.1/8",
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-j",
                    "SNAT",
                    "--to-source",
                    self.network.gateway,
                    table="nat",
                    error_prefix=f"Remove SNAT for {proto}:{host_port} forwarding",
                )
                # Remove FORWARD acceptance rule
                self.network._run_iptables(
                    "-D",
                    "sandy-fwd",
                    "-p",
                    proto,
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-m",
                    "conntrack",
                    "--ctstate",
                    "NEW,ESTABLISHED,RELATED",
                    "-j",
                    "ACCEPT",
                    error_prefix=f"Remove FORWARD rule for {proto}:{container_port}",
                )
                # Remove direct access rule from host
                self.network._run_iptables(
                    "-D",
                    "sandy-out",
                    "-o",
                    self.network.bridge_name,
                    "-p",
                    proto,
                    "-s",
                    self.network.gateway,
                    "-d",
                    container_ip,
                    "--dport",
                    str(container_port),
                    "-m",
                    "conntrack",
                    "--ctstate",
                    "NEW",
                    "-j",
                    "ACCEPT",
                    error_prefix=f"Remove sandy-out rule for direct access to {proto}:{container_port}",
                )
                print(
                    f"I: Removed port forwarding: 127.0.0.1:{host_port} -> {container_ip}:{container_port} ({proto})"
                )
            return True
        except Exception as e:
            print(
                "E: Error cleaning up iptables port forwarding: "
                f"{_terminal_safe_repr(str(e))}"
            )
            return False

    def _cleanup_port_forwarding_nft(self, container_ip: str) -> bool:
        """Remove port forwarding rules for nftables - called when container stops

        nft deletes a rule only by handle (measured with nft 1.0.2, 1.0.9, and
        1.1.3). Delete the rules that carry this mapping's comment. Rules
        added by Sandy versions without the comment stay until
        `rm --network` removes the table.
        """
        if not self.port_mappings:
            return True

        assert self.network is not None, "Network must be configured for cleanup"
        complete = True
        try:
            for proto, host_port, container_port in self.port_mappings:
                comment = _nft_port_rule_comment(self.container, proto, host_port)
                for chain in NFT_PORT_RULE_CHAINS:
                    # A chain that cannot be listed must not keep the rules of
                    # the other chains in place.
                    try:
                        handles = self._nft_port_rule_handles(chain, comment)
                    except (RuntimeError, ValueError) as exc:
                        print(f"W: {_terminal_safe_repr(str(exc))}")
                        complete = False
                        continue
                    for handle in handles:
                        self.network._run_nft(
                            "delete",
                            "rule",
                            "ip",
                            "sandy",
                            chain,
                            "handle",
                            str(handle),
                            error_prefix=(
                                f"Remove {chain} rule for {proto}:{host_port}"
                            ),
                        )
                print(
                    f"I: Removed port forwarding: 127.0.0.1:{host_port} -> {container_ip}:{container_port} ({proto})"
                )
            return complete
        except Exception as e:
            print(
                "E: Error cleaning up nftables port forwarding: "
                f"{_terminal_safe_repr(str(e))}"
            )
            return False

    def _nft_port_rule_handles(self, chain: str, comment: str) -> list:
        """Return the handles of the rules in chain that carry comment."""
        result = _run_secure_subprocess(
            ["nft", "-j", "-a", "list", "chain", "ip", "sandy", chain],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise RuntimeError(
                f"Could not list nft chain {chain}: {_terminal_safe_repr(result.stderr)}"
            )
        return _parse_nft_rule_handles(result.stdout, chain, comment)

    def _run_init_script(self, network_mode: str = "lenient") -> None:
        """Execute /init.sh as root if it exists and network is configured.

        The caller has already waited until the container is ready.
        """
        if network_mode == "host":
            # Skip init script in host networking mode
            return
        if not (self.network and self.network.configured):
            return

        mdir = self._get_machine_dir()
        init_script_path = os.path.join(mdir, "init.sh")
        if not os.path.exists(init_script_path):
            return

        result = self._exec_as_root("/bin/sh /init.sh")
        if result.returncode != 0:
            print("W: Network initialization script failed")

    def _build(
        self,
        planned_guest_network: Optional[GuestNetwork] = None,
    ) -> None:
        """Build container"""
        mdir = self._get_machine_dir()
        if os.path.exists(mdir):
            print(f"W: '{mdir}' exists, skipping container creation")
            return

        # Check if caching is disabled (enabled by default)
        cache_disabled = os.environ.get("SANDY_CONTAINER_CACHE", "").lower() in [
            "n",
            "no",
            "0",
            "false",
        ]
        cache_enabled = not cache_disabled

        if cache_enabled:
            cache_path = self._get_cache_path()
            if os.path.exists(cache_path):
                print(f"I: Using cached container")
                self._new_machine_from_cache(cache_path, mdir, planned_guest_network)
                return

        # Build container from scratch
        self._new_machine_from_scratch(mdir, cache_enabled, planned_guest_network)

    def run_up(self, args):
        """Build and start container"""
        container_environment = _container_environment(self.user, self.user_home)

        # The host values for the resource limits, before any host change.
        facts = _read_host_facts()

        # Parse and validate port mappings
        if hasattr(args, "ports") and args.ports:
            if args.network == "host":
                print(
                    "E: Port forwarding (--port) is not compatible with --network=host"
                )
                sys.exit(1)

            for port_spec in args.ports:
                validated = _validate_port_mapping(port_spec)
                if validated is None:
                    print(
                        f"E: Invalid port specification '{_strip_control_characters(port_spec)}'"
                    )
                    print(
                        "   Format: proto:host_port:container_port (e.g., tcp:8080:80)"
                    )
                    sys.exit(1)
                self.port_mappings.append(validated)
            self.port_mappings = self._dedupe_port_mappings(self.port_mappings)

        # One up of a name at a time, from this check until the container is
        # ready (see _acquire_up_lock).
        self._ensure_cache_dir()
        up_lock = _acquire_up_lock(self.container)
        if up_lock is None:
            print(f"E: Another up is starting container '{self.container}'")
            sys.exit(1)
        error = self._existing_container_error()
        if error:
            print(error)
            sys.exit(1)

        # Check the directories to mount before the other host changes. The
        # check refuses a directory that root owns, and probes ID-mapped
        # mounts.
        mounts = self._plan_mounts()

        # The first host change: the limits that all containers share. No
        # container may start outside them.
        group, saved = self._set_shared_limits(facts)
        limits = _resolve_resource_limits(args, group, facts.task_limit)

        # A container that stopped without sandy (its payload ended, or its
        # scope was stopped) leaves its port forwarding rules and state.
        # Remove only this name's Sandy-owned rules and state. No container
        # and no other up of the name owns them: the up lock and the check
        # above make sure. The cleanup uses only the network that exists now;
        # it never creates the bridge or the firewall base, which host
        # networking must not get.
        self._cleanup_port_mappings_for_container(self.container)

        mdir = self._get_machine_dir()
        planned_guest_network = None
        planned_network_info = None
        building_new_machine = args.build and not os.path.lexists(mdir)
        if building_new_machine and args.network == "lenient" and self.network is None:
            try:
                planned_guest_network, planned_network_info = (
                    SandyNet.preview_bridge_network()
                )
            except (
                OSError,
                PermissionError,
                ValueError,
                subprocess.SubprocessError,
            ) as exc:
                print(
                    "E: Could not plan lenient network: "
                    f"{_terminal_safe_repr(str(exc))}"
                )
                sys.exit(1)

        if args.build:
            self._build(planned_guest_network)

        try:
            machine_fd = _open_verified_dir(mdir)
        except FileNotFoundError:
            print(f"E: '{mdir}' does not exist. Use --build")
            sys.exit(1)
        except (OSError, PermissionError, ValueError) as exc:
            print(
                f"E: Unsafe machine image '{_terminal_safe_repr(mdir)}': "
                f"{_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        runtime_fds = [machine_fd]
        init_bind_dir: Optional[str] = None
        keepalive_dir: Optional[str] = None

        def close_runtime_fds() -> None:
            nonlocal runtime_fds
            for fd in reversed(runtime_fds):
                os.close(fd)
            runtime_fds = []

        def cleanup_init_bind() -> None:
            nonlocal init_bind_dir
            if init_bind_dir is not None:
                try:
                    _remove_init_bind_copy(init_bind_dir)
                finally:
                    init_bind_dir = None

        def cleanup_keepalive() -> None:
            nonlocal keepalive_dir
            if keepalive_dir is not None:
                try:
                    _remove_keepalive_dir(keepalive_dir)
                finally:
                    keepalive_dir = None

        def reject_unsafe_init(exc: BaseException) -> None:
            close_runtime_fds()
            cleanup_init_bind()
            print(
                "E: Unsafe machine image /init.sh: " f"{_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)

        # --directory=/proc/self/fd/<machine-fd>
        # --machine=foo           # show up as 'foo', not 'sandy.foo'
        # --keep-unit             # the systemd-run scope is the machine unit
        # --console=passive       # no console; sessions attach through the
        #                         # entry helper
        # --tmpfs=/tmp:mode=1777  # memory tmpfs, with the size of --tmp-size
        # --private-users         # user namespace - pick for >=250, fixed for <250
        # --as-pid2               # emulate docker app container (no init
        #                         # process; just minimal systemd stub init for
        #                         # signal forwarding and zombies only)
        # --timezone=bind         # bind mount host localetime into container
        # --user=root             # the keepalive payload runs as container
        #                         # root, so container users cannot signal it
        cmd = [
            "systemd-nspawn",
            f"--directory={_proc_self_fd_path(machine_fd)}",
            f"--machine={self.container}",
            "--keep-unit",
            "--console=passive",
            _tmp_tmpfs_argument(limits.tmp_size),
            "--as-pid2",
            "--timezone=bind",
            "--user=root",
        ]

        # The supervisor that this run starts, pinned until up returns.
        pinned: Optional[PinnedSupervisor] = None
        # A Ctrl-C between the start of the supervisor and a try that stops it
        # left the container running. So up holds back SIGINT from the start
        # until the try after the start, and from the end of that try until
        # the console has started (see _exec). The waits in between stay
        # open to a Ctrl-C.
        sigint = _DeferredSigint()
        # A terminal write can block, for example after the STOP character.
        # So up holds back its output while it holds the lifecycle lock or
        # the port mapping lock, and writes it after the release: after the
        # start, or on an error at the end.
        held_output = io.StringIO()
        try:
            # The mount targets and the image user's ids, before any change of
            # the network.
            mounts, image_ids = self._prepare_image_mounts(machine_fd, mounts)

            # Bind mount init.sh as read-only to protect it from modification.
            # Open it before port forwarding so IP discovery cannot follow a raw
            # image path or mutate host firewall state before validation.
            init_script_fd: Optional[int] = None
            try:
                init_script_fd = _open_optional_image_file(machine_fd, ("init.sh",))
            except (OSError, PermissionError, ValueError) as exc:
                reject_unsafe_init(exc)
            init_container_ip = None
            if init_script_fd is not None:
                init_bind_path = ""
                try:
                    init_container_ip = _parse_container_ip_from_init_fd(init_script_fd)
                    init_bind_dir, init_bind_path = _create_init_bind_copy(
                        init_script_fd,
                        CONTAINER_BASE_UID if self.systemd_version < 250 else None,
                        CONTAINER_BASE_UID if self.systemd_version < 250 else None,
                    )
                except (OSError, PermissionError, ValueError) as exc:
                    os.close(init_script_fd)
                    reject_unsafe_init(exc)
                os.close(init_script_fd)
                init_bind_options = ":idmap" if self.systemd_version >= 250 else ""
                cmd.append(f"--bind-ro={init_bind_path}:/init.sh{init_bind_options}")
                print(f"I: Bind mounting /init.sh as read-only")

            # Create the keepalive payload before any host network change.
            try:
                keepalive_dir = _create_keepalive_dir(
                    _read_keepalive_script(self.cn_keepalive)
                )
            except (OSError, PermissionError, ValueError) as exc:
                print(
                    "E: Could not prepare the keepalive payload: "
                    f"{_terminal_safe_repr(str(exc))}"
                )
                sys.exit(1)
            cmd.append(f"--bind-ro={keepalive_dir}:{KEEPALIVE_MOUNT}")

            # Setup networking based on network mode after validating the machine
            # image and init script. Network construction mutates host state.
            if args.network == "lenient":
                # Setup networking (bridge and NAT) if not already done
                if self.network is None:
                    if init_container_ip is not None:
                        try:
                            if planned_guest_network is None:
                                planned_guest_network, planned_network_info = (
                                    SandyNet.preview_bridge_network()
                                )
                            _validate_container_ip_for_cidr(
                                init_container_ip,
                                planned_guest_network[0],
                            )
                        except (
                            OSError,
                            PermissionError,
                            ValueError,
                            subprocess.SubprocessError,
                        ) as exc:
                            reject_unsafe_init(exc)
                    self.network = (
                        SandyNet(planned_network_info)
                        if planned_network_info is not None
                        else SandyNet()
                    )
                if (
                    init_container_ip is not None
                    and self.network
                    and self.network.configured
                ):
                    try:
                        self._validate_container_ip_for_network(init_container_ip)
                    except PermissionError as exc:
                        reject_unsafe_init(exc)
            elif args.network == "host":
                # Host networking - don't initialize network bridge
                if self.network is None:
                    print("I: Using host networking mode (no bridge setup)")
                else:
                    print("I: Using host networking mode (ignoring existing bridge)")

            publish_ports = False
            # Use bridge network if configured and not in host mode
            if args.network != "host" and self.network and self.network.configured:
                # --network-bridge implies --network-veth (which implies
                # --private-network). We currently setup a single bridge (sandybr0)
                # and configure it with an unused IP address in a /24 network. The
                # container's network interface shows up as 'host0' while the
                # host's side of the veth shows up as vb-<container>@ifN. Firewall
                # rules are then setup up on the bridge, external to the constainer
                # (see above).
                cmd.append(f"--network-bridge={self.network.bridge_name}")

                # Port forwarding comes just before the start, after the check
                # under the lifecycle lock (below).
                publish_ports = bool(self.port_mappings)
            else:
                print("W: Using host networking (no restrictions)")

            # nspawn gets no bind for the workspace and shared directories;
            # up mounts them after the start (see _wait_for_mounts below).
            #
            # systemd < 250 has no --private-users=pick; use a fixed UID range.
            if self.systemd_version >= 250:
                # XXX: Can this slow startup?
                cmd.append(
                    "--private-users=pick"
                )  # implies --private-users-ownership=auto
            else:
                cmd.append(f"--private-users={CONTAINER_BASE_UID}:65536")
                cmd.append(f"--private-users-ownership=auto")

            # codex' sandbox needs these landlock calls: landlock_create_ruleset,
            # landlock_add_rule, landlock_restrict_self. It was observed that both
            # the syscall names and the syscall numbers were required (Ubuntu 24.04
            # host with Debian trixie-based container). These syscall numbers were
            # confirmed to be the same number on all of these architectures:
            # $ for a in x86_64 x86 arm aarch64 ppc64 ppc64le s390x riscv64 ; do
            #     for sc in landlock_create_ruleset landlock_add_rule landlock_restrict_self ; do
            #       scmp_sys_resolver -a $a $sc
            #     done
            #   done
            if platform.machine() not in [
                "x86_64",
                "x86",
                "arm",
                "aarch64",
                "ppc64",
                "ppc64le",
                "s390x",
                "riscv64",
            ]:
                print(
                    "W: unknown architecture '%s'; hard-coded landlock syscall numbers may be incorrect"
                    % platform.machine()
                )
            cmd.append(
                "--system-call-filter='@default landlock_create_ruleset landlock_add_rule landlock_restrict_self 444 445 446'"
            )

            if not args.persistent:
                # --ephemeral affects the root namespace and not submounts. When
                # specified, all changes to the system (excepting the workspace
                # and shared mounts) are discarded.
                cmd.append("--ephemeral")

            # The payload: the image's bash, named sandy-keepalive, reads the
            # keepalive script.
            cmd.extend(
                [
                    f"{KEEPALIVE_MOUNT}/{KEEPALIVE_LINK_NAME}",
                    KEEPALIVE_SCRIPT_PATH,
                ]
            )
            scope_cmd = (
                _supervisor_scope_argv(
                    self.container, self.systemd_version, bool(args.detach), limits
                )
                + cmd
            )
            print(
                "I: Limits of all Sandy containers: "
                f"{_describe_group_limits(group, saved)}"
            )
            print(
                "I: Limits of this container: "
                f"{_describe_resource_limits(limits, facts.memory)}"
            )
            for warning in _limit_warnings(group, limits, facts.memory):
                print(warning)
            spinner_line_event = threading.Event()
            mode = " in detached state" if args.detach else ""
            # The supervisor has no terminal and its own session, and runs in
            # its own scope. A closed terminal, or a stop or an OOM kill of the
            # terminal's scope, therefore does not reach it.
            # Hold the lifecycle lock until the markers exist: the up-console
            # marker without -d, and the mounts-pending marker when there are
            # directories to mount. Every attach joins its leaf under this
            # lock. So no attach can end, and stop the container, before the
            # console starts, and no attach can start before the mounts are
            # done.
            hold_lock = not args.detach or bool(mounts)
            # Show the lines above before up waits for the lock.
            sys.stdout.flush()
            with _lifecycle_lock() if hold_lock else nullcontext(), (
                redirect_stdout(held_output) if hold_lock else nullcontext()
            ):
                if hold_lock:
                    # The up lock keeps out the other ups of this name, but not
                    # a machine or a scope of the name that another program
                    # starts while this up makes its changes and waits here.
                    error = self._existing_container_error()
                    if error:
                        print(error)
                        sys.exit(1)
                # Publish the ports only now. An up that the check above refuses
                # then adds no rule for the container of another start. No
                # container owns the port rules and state that up adds until
                # the supervisor starts. So hold the port mapping lock from
                # the publish until up has pinned the supervisor and made
                # the markers that it needs. When the start fails before
                # that, up removes the ports before it releases the lock: no
                # other process finds them, and the removal does not wait for
                # the lock again. Each attach waits for the lifecycle lock, so
                # an up that holds it waits for the port mapping lock for at
                # most PORT_MAPPINGS_LOCK_TIMEOUT. Without it, up holds only
                # its up lock, which no process waits for, so up waits for the
                # port mapping lock as long as it takes.
                port_lock_timeout = PORT_MAPPINGS_LOCK_TIMEOUT if hold_lock else None
                with ExitStack() as port_lock:
                    if publish_ports:
                        try:
                            port_lock.enter_context(
                                self._port_mapping_lock(
                                    exclusive=True, timeout=port_lock_timeout
                                )
                            )
                        except TimeoutError as exc:
                            print(
                                "E: Could not publish the ports of "
                                f"'{self.container}': {exc}"
                            )
                            sys.exit(1)
                        port_lock.enter_context(redirect_stdout(held_output))
                    started = False
                    try:
                        if publish_ports:
                            self._setup_port_forwarding_rules(init_container_ip)
                        print(
                            f"I: Starting '{self.container}'{mode} ",
                            end="",
                            flush=True,
                        )
                        # From the start until the try after the pin, a
                        # Ctrl-C must not cut the steps apart: one that
                        # comes meanwhile acts at the start of that try,
                        # whose handler stops the supervisor. A failure
                        # in between runs its stop to the end.
                        sigint.hold()
                        try:
                            # The container inherits the OOM score
                            # adjustment.
                            with _oom_score_adj_for_children(limits.oom_score_adj):
                                supervisor = _run_secure_subprocess_popen(
                                    scope_cmd,
                                    start_new_session=True,
                                    stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL,
                                    env=container_environment,
                                    pass_fds=tuple(runtime_fds),
                                )
                            # From now on, other steps remove the ports:
                            # the handler of a failed pin or marker, in
                            # this hold; _stop_failed_start, after a later
                            # failure; or the stop of the container.
                            started = True
                        except (OSError, ValueError) as exc:
                            # The value could not be set, or the start
                            # failed; the restore raises nothing. So no
                            # supervisor runs.
                            _finish_spinner_line(spinner_line_event)
                            print(
                                f"E: Could not start '{self.container}': "
                                f"{_terminal_safe_repr(str(exc))}"
                            )
                            sys.exit(1)
                        finally:
                            close_runtime_fds()
                    finally:
                        if publish_ports and not started:
                            # This removal runs in the hold of the
                            # publish, so it does not take the lock
                            # again.
                            self._cleanup_port_mappings_for_container(self.container)
                    # Pin the supervisor before anything can reap it.
                    # The markers and the mounts go only into a scope
                    # that holds it: the scope of the name can be
                    # another start's. This is still in the hold of the
                    # publish.
                    try:
                        pinned = _pin_supervisor(supervisor.pid)
                        if mounts:
                            _create_mounts_pending_marker(self.container, pinned)
                        if not args.detach:
                            _create_up_console_marker(self.container, pinned)
                    except BaseException as exc:
                        failed = isinstance(exc, (OSError, ValueError))
                        try:
                            # The start failed after all. End the
                            # "Starting" line and name the error first.
                            # While up holds a lock, stdout goes to the
                            # held output, so these lines come before the
                            # output of the removal, each on its own line.
                            # With no lock (up -d with no mounts and no
                            # ports), these writes go to the terminal and
                            # can fail; the finally below still stops the
                            # supervisor.
                            _finish_spinner_line(spinner_line_event)
                            if failed:
                                print(
                                    f"E: Container '{self.container}' did "
                                    f"not start: {_terminal_safe_repr(str(exc))}"
                                )
                            # No container owns the ports yet. Remove them
                            # in the hold, with no wait, so that no other
                            # process finds them. Without ports there is
                            # no hold, and the name has no port state: up
                            # removed it at its start.
                            if publish_ports:
                                self._cleanup_port_mappings_for_container(
                                    self.container
                                )
                        finally:
                            # Release the lock, and only then stop the
                            # supervisor. This stop runs under the
                            # lifecycle lock (without -d, or with
                            # mounts), so it takes at most
                            # CONTAINER_POWEROFF_TIMEOUT in all. The
                            # handler at the end of up writes the held
                            # output after the stop and after the release
                            # of the lifecycle lock.
                            port_lock.close()
                            self._stop_failed_start(
                                supervisor,
                                remove_ports=False,
                                term_timeout=CONTAINER_POWEROFF_TIMEOUT / 2,
                                kill_timeout=CONTAINER_POWEROFF_TIMEOUT / 2,
                            )
                        if not failed:
                            raise
                        sys.exit(1)
            try:
                # A Ctrl-C since the start acts here, so the handlers below
                # stop the container.
                sigint.release()
                # The output of the start, which up held back while it held
                # its locks. A write error stops the container below, as it
                # does for each later write.
                _write_held_output(held_output)
                # Mount the workspace and shared directories as soon as the
                # container has its payload. Until then, no attach works.
                #
                # This is one method on all systemd versions. systemd 256 or
                # later could do the same with --bind=...:owneridmap, which
                # maps the owner of the directory to the container user and
                # nothing else (as the mounts here do). Replace this code
                # with that option when Sandy drops support for systemd < 256.
                if mounts and not self._wait_for_mounts(
                    mounts,
                    image_ids,
                    pinned,
                    spinner_line_event=spinner_line_event,
                    supervisor=supervisor,
                ):
                    _finish_spinner_line(spinner_line_event)
                    self._report_failed_start(supervisor)
                    sys.exit(1)
                ready = self._wait_for_container_ready(
                    spinner_line_event=spinner_line_event, supervisor=supervisor
                )
                # A ready container proves only that the payload exists. It
                # needs the bind source until bash has opened the script;
                # after that, bash keeps the open script.
                if ready:
                    ready = self._wait_for_keepalive_open(supervisor)
                cleanup_keepalive()
                if not ready:
                    _finish_spinner_line(spinner_line_event)
                    self._report_failed_start(supervisor)
                    sys.exit(1)
                _finish_spinner_line(spinner_line_event, suffix=" done")
                self._run_init_script(network_mode=args.network)
                # The container is ready. Hold back a Ctrl-C again until the
                # console has started, or up -d returns: a Ctrl-C in the
                # cleanup below then ends the console, which stops the
                # container. Without it, the up-console marker kept the
                # container running.
                sigint.hold()
            except _EntrySetupError as exc:
                _finish_spinner_line(spinner_line_event)
                print(
                    "E: Could not prepare the container entry: "
                    f"{_terminal_safe_repr(str(exc))}"
                )
                self._stop_failed_start(supervisor)
                sys.exit(1)
            except _MountError as exc:
                _finish_spinner_line(spinner_line_event)
                print(f"E: Could not mount {_strip_control_characters(str(exc))}")
                self._stop_failed_start(supervisor)
                sys.exit(1)
            except BaseException:
                self._stop_failed_start(supervisor)
                raise
        except BaseException:
            # up fails, so a held Ctrl-C has nothing more to stop. Release
            # it first: a Ctrl-C can then end a write that blocks.
            sigint.release(discard=True)
            # The locks are free now. Show the messages of the start.
            _write_held_output(held_output)
            raise
        finally:
            try:
                try:
                    cleanup_init_bind()
                finally:
                    try:
                        cleanup_keepalive()
                    finally:
                        try:
                            close_runtime_fds()
                        finally:
                            if pinned is not None:
                                os.close(pinned.pidfd)
            except BaseException:
                sigint.release(discard=True)
                raise

        try:
            # The container is ready, so another up of the name now finds it.
            # On an error, the lock stays until up exits, after its cleanup.
            up_lock.close()
            if args.detach:
                # A Ctrl-C after the start acts now; the container stays.
                sigint.release()
                return
            # The console is one more attach. When it exits, the container
            # stops unless another attach is still running.
            status = self._exec(None, login_shell=True, console=True, sigint=sigint)
        finally:
            sigint.release(discard=True)
        _raise_for_container_status(status)

    def _existing_container_error(self) -> Optional[str]:
        """Return the error when the container runs or its scope exists.

        up checks this under its up lock, before the other host changes, and
        again under the lifecycle lock before it starts the container: another
        program can start a machine or a scope of the name in between. Fail
        closed rather than reuse or stop a unit that this run did not start.
        None means that up can go on.
        """
        try:
            running = self._is_container_running()
        except _MachineQueryError as exc:
            return f"E: {exc}"
        except subprocess.SubprocessError as exc:
            return (
                f"E: Could not query machine '{self.container}': "
                f"{_terminal_safe_repr(str(exc))}"
            )
        if running:
            return f"E: Container '{self.container}' is already running"
        unit = _supervisor_unit_name(self.container)
        try:
            unit_loaded = _supervisor_unit_loaded(self.container)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            return f"E: Could not query unit '{unit}': {_terminal_safe_repr(str(exc))}"
        if unit_loaded:
            return f"E: Unit '{unit}' already exists"
        return None

    def _report_failed_start(self, supervisor: subprocess.Popen) -> None:
        """Explain why a started container did not become ready."""
        status = supervisor.poll()
        if status is None:
            print(f"E: Container '{self.container}' did not become ready")
            return
        print(
            f"E: Container '{self.container}' exited before it was ready "
            f"(exit status {status})"
        )
        print(
            f"   The container needs {KEEPALIVE_SHELL} and 'sleep' in PATH for its "
            "keepalive payload"
        )

    def _stop_failed_start(
        self,
        supervisor: subprocess.Popen,
        remove_ports: bool = True,
        term_timeout: float = CONTAINER_STOP_TIMEOUT,
        kill_timeout: float = CONTAINER_POWEROFF_TIMEOUT,
    ) -> None:
        """Stop a supervisor that this run started, then remove its port rules.

        SIGTERM makes nspawn power off the container. After term_timeout,
        SIGKILL ends the supervisor; after kill_timeout more, give up with a
        warning. With remove_ports False, leave the port rules and state: the
        caller removed them.
        """
        if supervisor.poll() is None:
            supervisor.terminate()
            try:
                supervisor.wait(timeout=term_timeout)
            except subprocess.TimeoutExpired:
                supervisor.kill()
                try:
                    supervisor.wait(timeout=kill_timeout)
                except subprocess.TimeoutExpired:
                    print(
                        f"W: The supervisor of '{self.container}' did not stop "
                        f"(PID {supervisor.pid})"
                    )
        if remove_ports:
            self._cleanup_port_mappings_for_container(self.container)

    def run_rm(self, args, all=False, cache=False, network=False):
        """Remove container(s)"""
        # Check for incompatible options
        if cache:
            if all:
                print("E: --cache cannot be used with --all")
                sys.exit(1)
            if args.container:
                print("E: --cache cannot be used with --container")
                sys.exit(1)
            if network:
                print("E: --cache cannot be used with --network")
                sys.exit(1)

            # Just remove the cache
            cache_dir = self._get_cache_dir()
            if os.path.exists(cache_dir):
                if args.force or self._confirm(
                    f"Remove container cache ('{cache_dir}')"
                ):
                    self._purge_cache()
                else:
                    print("I: Skipped cache removal")
            else:
                print("I: No cache to remove")
            return

        if network:
            if all:
                print("E: --network cannot be used with --all")
                sys.exit(1)
            if args.container:
                print("E: --network cannot be used with --container")
                sys.exit(1)

            # Setup networking if not already done (needed for cleanup)
            if self.network is None:
                self.network = SandyNet()

            # Check if any sandy containers are running
            running_containers = self._get_running_sandy_containers()
            if running_containers:
                container_list = ", ".join(running_containers)
                print(
                    f"E: Cannot remove network while containers are running: {container_list}"
                )
                print("Stop all containers first with 'sandy down'")
                sys.exit(1)

            # Remove network bridge and firewall rules
            if args.force or self._confirm("Remove network bridge and firewall rules"):
                if self.network:
                    self.network.cleanup()
                    print("I: Network cleanup complete")
                else:
                    print("I: No network to clean up")
                self._clear_port_mapping_state()
            else:
                print("I: Skipped network removal")
            return

        # Build list of machine directories to remove
        mdirs_to_remove = []

        if all:
            if os.path.exists(SYSTEMD_MACHINES):
                for mdir in glob.glob(f"{SYSTEMD_MACHINES}/sandy.*"):
                    # Skip cache directory
                    if mdir != self._get_cache_dir():
                        mdirs_to_remove.append(mdir)
        else:
            # Single container
            mdir = self._get_machine_dir()
            if not os.path.exists(mdir):
                print(f"E: Container '{self.container}' not found")
                sys.exit(1)
            mdirs_to_remove.append(mdir)

        # Process each container directory
        not_stopped = False
        for mdir in mdirs_to_remove:
            try:
                con_name = _container_name_from_machine_path(mdir)
            except ValueError as exc:
                print(
                    "W: Skipping invalid Sandy machine entry "
                    f"{_terminal_safe_repr(mdir)}: {_terminal_safe_repr(str(exc))}"
                )
                continue
            safe_con_name = _terminal_safe_repr(con_name)

            container_was_powered_off = False
            if self._is_container_running(con_name):
                # Container is running, ask to power off
                if args.force or self._confirm(
                    f"Container {safe_con_name} is running. Power off and remove the container"
                ):
                    if not self._machine_poweroff(con_name):
                        # The container still runs on its image: keep the
                        # image, go on with the others, and exit 1 at the end.
                        print(
                            f"E: Did not remove container {safe_con_name}: "
                            "it did not stop"
                        )
                        not_stopped = True
                        continue
                    container_was_powered_off = True
                else:
                    print(f"I: Skipping removal of running container {safe_con_name}")
                    continue

            # If user already confirmed poweroff, don't prompt again for removal
            skip_removal_prompt = args.force or container_was_powered_off

            # Ensure port forwarding rules are removed before deleting files
            self._cleanup_port_mappings_for_container(con_name)

            self._remove_machine_dir(mdir, prompt=not skip_removal_prompt)
        if not_stopped:
            sys.exit(1)

    def run_down(self, args):
        """Stop the container. Exit 1 when it did not stop."""
        _ = args
        if not self._machine_poweroff():
            sys.exit(1)

    def run_bash(self, args):
        """Launch bash shell in container"""
        # Remove leading '--' if present (argparse REMAINDER captures it)
        bash_cmd = args.bash_args
        if args.bash_args and args.bash_args[0] == "--":
            bash_cmd = args.bash_args[1:]

        if not bash_cmd:
            # Drop user into a login shell that behaves like ssh -tt
            status = self._exec(None, login_shell=True)
            _raise_for_container_status(status)
            return
        else:
            # _exec() handles executing commands directly, so strip -c flags
            if "-c" in bash_cmd:
                bash_cmd = list(filter(lambda x: x != "-c", bash_cmd))
                if not bash_cmd:
                    print("E: bash requires a command")
                    sys.exit(1)
            command = " ".join(bash_cmd)

        status = self._exec(command)
        _raise_for_container_status(status)

    def run_exec(self, args):
        """Execute command in container"""
        # Remove leading '--' if present (argparse REMAINDER captures it)
        exec_cmd = args.exec_command
        if exec_cmd and exec_cmd[0] == "--":
            exec_cmd = exec_cmd[1:]

        if not exec_cmd:
            print("E: exec requires a command")
            sys.exit(1)

        command = " ".join(exec_cmd)
        status = self._exec(command)
        _raise_for_container_status(status)

    def run_status(self):
        """Check container status"""
        _run_secure_subprocess(
            ["machinectl", "status", "--no-pager", "--full", self.container]
        )
        events = _container_memory_events(self.container)
        if events is not None:
            print(
                f"OOM kills: {events.oom_kills} (memory limit reached: "
                f"{_times_text(events.group_ooms)} by all Sandy containers, "
                f"{_times_text(events.container_ooms)} inside this container)"
            )

    def run_update(self, args: argparse.Namespace) -> None:
        """Change the process limit or the OOM score adjustment of a running
        container, as docker update does, or with --shared the limits that
        all containers share."""
        if args.shared_limits:
            self._run_update_shared(args)
            return
        shared_only = [
            option
            for option, given in (
                ("--cpuset-cpus", args.cpuset_cpus is not None),
                ("--memory", args.memory is not None),
                ("--reset", args.reset),
            )
            if given
        ]
        if shared_only:
            verb = "needs" if len(shared_only) == 1 else "need"
            print(
                f"E: {', '.join(shared_only)} {verb} --shared: a container has "
                "no CPU or memory limit of its own"
            )
            sys.exit(1)
        if args.pids_limit is None and args.oom_score_adj is None:
            print(f"E: {UPDATE_NEEDS_OPTION}")
            sys.exit(1)
        unit = _supervisor_unit_name(self.container)
        if not self._is_container_running():
            print(f"E: Container '{self.container}' not found or not running")
            sys.exit(1)
        try:
            if not _supervisor_unit_loaded(self.container):
                print(f"E: Unit '{unit}' does not exist")
                sys.exit(1)
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            print(f"E: Could not query unit '{unit}': {_terminal_safe_repr(str(exc))}")
            sys.exit(1)
        if args.pids_limit is not None:
            self._update_pids_limit(unit, args.pids_limit)
        if args.oom_score_adj is not None:
            self._update_oom_score_adj(args.oom_score_adj)

    def _update_pids_limit(self, unit: str, pids_limit: int) -> None:
        """Set the process limit of the running scope unit until it stops."""
        try:
            group = _read_live_group_limits()
        except (OSError, ValueError, subprocess.SubprocessError) as exc:
            print(
                f"E: Could not query {SUPERVISOR_SLICE}: "
                f"{_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        tasks_max = None if pids_limit == -1 else pids_limit
        pids_warning = _pids_limit_warning(tasks_max, group.tasks_max)
        if pids_warning is not None:
            print(pids_warning)
        assignment = "TasksMax=" + ("infinity" if tasks_max is None else str(tasks_max))
        try:
            # Measured: the change ends with the scope. On a stopped scope,
            # set-property fails and writes nothing.
            _run_secure_subprocess(
                ["systemctl", "set-property", "--runtime", unit, assignment],
                check=True,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            print(f"E: Could not update '{unit}': {_terminal_safe_repr(str(exc))}")
            sys.exit(1)
        print(f"I: Updated '{self.container}': {assignment}")

    def _update_oom_score_adj(self, value: int) -> None:
        """Give each process of the running container the OOM score adjustment.

        Later sessions get it from nspawn. The value ends with the
        container; the next up uses its own flags.
        """
        try:
            with _lifecycle_lock():
                count = _set_scope_oom_score_adj(self.container, value)
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            print(
                "E: Could not update the OOM score adjustment of "
                f"'{self.container}': {_terminal_safe_repr(str(exc))}"
            )
            sys.exit(1)
        print(
            f"I: Updated '{self.container}': OOM score adjustment {value} "
            f"({count} processes)"
        )

    def _run_update_shared(self, args: argparse.Namespace) -> None:
        """Change, save, and set the limits that all containers share.

        This works with and without running containers. The values apply at
        once, and up sets the saved values again at each start.
        """
        if args.container is not None:
            print("E: update --shared cannot be used with --container")
            sys.exit(1)
        if args.oom_score_adj is not None:
            print(
                "E: update --shared cannot be used with --oom-score-adj: the "
                "containers have no shared OOM score adjustment"
            )
            sys.exit(1)
        values = {
            "cpus": args.cpuset_cpus,
            "memory_max": args.memory,
            "tasks_max": args.pids_limit,
        }
        given = {name: value for name, value in values.items() if value is not None}
        if args.reset and given:
            print(
                "E: --reset cannot be used with --cpuset-cpus, --memory, or "
                "--pids-limit"
            )
            sys.exit(1)
        if not args.reset and not given:
            print(f"E: {UPDATE_SHARED_NEEDS_OPTION}")
            sys.exit(1)
        facts = _read_host_facts()
        if "cpus" in given and not set(given["cpus"]) <= set(facts.online_cpus):
            print(
                "E: --cpuset-cpus must name online CPUs; the online CPUs are "
                f"{_format_cpu_list(facts.online_cpus)}"
            )
            sys.exit(1)
        group, saved = self._set_shared_limits(facts, given, reset=args.reset)
        print(
            f"I: Limits of all Sandy containers: {_describe_group_limits(group, saved)}"
        )

    def run_list(self):
        """List all containers and their status"""
        if not os.path.exists(SYSTEMD_MACHINES):
            print("No containers found")
            return

        containers = []
        for mdir in glob.glob(f"{SYSTEMD_MACHINES}/sandy.*"):
            # Skip cache directory
            if mdir == self._get_cache_dir():
                continue

            try:
                con_name = _container_name_from_machine_path(mdir)
            except ValueError:
                continue

            # Check if container is running
            is_running = self._is_container_running(con_name) is not None
            status = "running" if is_running else "stopped"

            containers.append((con_name, status, mdir))

        if not containers:
            print("No containers found")
            return

        # Calculate dynamic column width (longest name + 3, max 32, min 10)
        max_name_len = max(len(name) for name, _, _ in containers)
        col_width = max(10, min(max_name_len + 3, 32))

        # Find longest path for proper dash line length
        max_path_len = max(len(path) for _, _, path in containers)
        total_width = col_width + 1 + 10 + 1 + max_path_len  # spaces between columns

        # Print header
        print(f"{'CONTAINER':<{col_width}} {'STATUS':<10} {'PATH'}")
        print("-" * total_width)

        # Print containers
        for name, status, path in sorted(containers):
            print(f"{name:<{col_width}} {status:<10} {path}")


class _StoreOnceAction(argparse.Action):
    """Argparse action that rejects duplicate specification of an argument."""

    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, self.dest) is not None:
            parser.error(f"{option_string} can only be specified once")
        setattr(namespace, self.dest, values)


def _add_up_limit_arguments(parser: argparse.ArgumentParser) -> None:
    """Add the resource limit options of one container to up."""
    parser.add_argument(
        "--pids-limit",
        action=_StoreOnceAction,
        type=_parse_pids_limit_argument,
        help="Process limit of this container (default: 25%% of the process "
        "limit that all Sandy containers share, at least 8192 and at most half "
        "of it; -1: no limit of its own)",
    )
    parser.add_argument(
        "--tmp-size",
        action=_StoreOnceAction,
        type=_parse_tmp_size_argument,
        help="Size of the /tmp tmpfs with a unit b, k, m, or g. Files in /tmp "
        "count against the shared memory (default: 512m; 0: the tmpfs default, "
        "half of the host memory)",
    )
    parser.add_argument(
        "--oom-score-adj",
        action=_StoreOnceAction,
        type=_parse_oom_score_adj_argument,
        help="OOM score adjustment of the container and its sessions, from -999 "
        "to 1000. When the shared memory runs out, the kernel ends processes "
        "with higher values first; -500 protects a long-running container "
        "(default: the value of the sandy process)",
    )


def _add_update_arguments(parser: argparse.ArgumentParser) -> None:
    """Add the options of update, after docker update."""
    # The global -s/--shared already uses the destination "shared".
    parser.add_argument(
        "--shared",
        dest="shared_limits",
        action="store_true",
        help="Change the limits that all Sandy containers share. Sandy saves "
        "them, and they apply at once and at each up",
    )
    parser.add_argument(
        "--cpuset-cpus",
        action=_StoreOnceAction,
        type=_parse_cpuset_argument,
        help="With --shared: the CPUs that the containers share, such as 4-15 "
        "or 0,2,4-7",
    )
    parser.add_argument(
        "-m",
        "--memory",
        action=_StoreOnceAction,
        type=_parse_memory_argument,
        help="With --shared: the memory that the containers share, with a unit "
        "b, k, m, or g, such as 24g (0: no limit)",
    )
    parser.add_argument(
        "--pids-limit",
        action=_StoreOnceAction,
        type=_parse_pids_limit_argument,
        help="Process limit of the running container, or with --shared, of all "
        "containers together (-1: no limit)",
    )
    parser.add_argument(
        "--oom-score-adj",
        action=_StoreOnceAction,
        type=_parse_oom_score_adj_argument,
        help="OOM score adjustment of the running container and its sessions, "
        "from -999 to 1000. Each process of the container gets the value, also "
        "a process that set its own value",
    )
    parser.add_argument(
        "--reset",
        action="store_true",
        help="With --shared: forget the saved limits and use the defaults again",
    )


def parse_args_custom():
    """Custom argument parser to handle REMAINDER args properly"""

    subcommands = {
        "up",
        "down",
        "rm",
        "bash",
        "exec",
        "status",
        "list",
        "update",
    }
    global_value_options = {
        "-w",
        "--workspace",
        "-s",
        "--shared",
        "-c",
        "--container",
        "-u",
        "--user",
    }
    long_value_options = {
        "--workspace",
        "--shared",
        "--container",
        "--user",
    }
    short_value_options = {"-w", "-s", "-c", "-u"}

    # Find the first subcommand that is not a global option value. A simple
    # string search mistakes invocations such as "-w exec status" for an exec
    # command even though "exec" is the workspace value.
    subcommand_idx = None
    index = 1
    while index < len(sys.argv):
        arg = sys.argv[index]
        if arg in subcommands:
            subcommand_idx = index
            break
        if arg in global_value_options:
            index += 2
            continue
        if any(arg.startswith(f"{option}=") for option in long_value_options):
            index += 1
            continue
        if any(
            arg.startswith(option) and arg != option for option in short_value_options
        ):
            index += 1
            continue
        index += 1

    remaining_args = sys.argv[subcommand_idx:] if subcommand_idx is not None else []

    # Now parse the full command
    parser = argparse.ArgumentParser(
        description="Sandy CLI - Container management for ai agent development",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s                           # Launch shell
  %(prog)s -w myproject              # Mount and launch in workspace subdirectory
  %(prog)s -s shared                 # Mount shared directory
  %(prog)s up -d --build             # Build and start detached
  %(prog)s exec -- cargo test        # Run tests in container
  %(prog)s bash -c "echo hello"      # Run bash with arguments

Environment Variables:
  SANDY_BOOTSTRAP         # Bootstrap method: 'oci' or 'debootstrap'
  SANDY_BOOTSTRAP_BASE    # Base image override (eg 'debian:bookworm' or 'ubuntu:noble')
  SANDY_SETUP_SCRIPT      # Custom setup script (default: ./setup-container.sh)
  SANDY_CONTAINER_CACHE   # Disable container caching: 'n' (enabled by default)
        """,
    )

    # Add global arguments
    parser.add_argument(
        "-w",
        "--workspace",
        action=_StoreOnceAction,
        help="Workspace subdirectory to use",
    )
    parser.add_argument(
        "-s",
        "--shared",
        action=_StoreOnceAction,
        help="Shared directory to mount at ~/shared in container",
    )
    parser.add_argument("-c", "--container", help="Container name (default: ai-dev)")
    parser.add_argument(
        "-u", "--user", default="developer", help="User to run as (default: developer)"
    )

    # Create subparsers for commands
    subparsers = parser.add_subparsers(dest="command", help="Commands")

    # up command
    up_parser = subparsers.add_parser("up", help="Build and start container")
    up_parser.add_argument(
        "-b", "--build", action="store_true", help="Build even if exists"
    )
    up_parser.add_argument(
        "-d", "--detach", action="store_true", help="Run in detached mode"
    )
    up_parser.add_argument(
        "--persistent", action="store_true", help="Run in persistent mode"
    )
    up_parser.add_argument(
        "--network",
        choices=["host", "lenient"],
        default="lenient",
        help="Network mode: 'lenient' (default, isolated bridge) or 'host' (direct host networking)",
    )
    up_parser.add_argument(
        "-p",
        "--port",
        action="append",
        dest="ports",
        help="Port forwarding from host to container (format: proto:host_port:container_port, e.g., tcp:8080:80)",
    )
    # Resource limits with the names and units of docker run and podman run.
    # The CPU and memory limits are on sandy.slice, which all containers
    # share; update --shared changes them.
    _add_up_limit_arguments(up_parser)

    # update command. No abbreviations: --cpus, the CPU count of docker
    # update, would otherwise be taken as --cpuset-cpus, a CPU list.
    update_parser = subparsers.add_parser(
        "update",
        help="Change the process limit of a running container, or with "
        "--shared the limits that all containers share",
        allow_abbrev=False,
    )
    _add_update_arguments(update_parser)

    # down command
    down_parser = subparsers.add_parser("down", help="Stop and remove container")
    down_parser.add_argument(
        "--force", action="store_true", help="Force removal without confirmation"
    )
    down_parser.add_argument(
        "--purge", action="store_true", help="Purge container cache"
    )

    # rm command
    rm_parser = subparsers.add_parser("rm", help="Remove container(s)")
    rm_parser.add_argument("--all", action="store_true", help="Remove all containers")
    rm_parser.add_argument(
        "--force", action="store_true", help="Force removal without confirmation"
    )
    rm_parser.add_argument(
        "--cache",
        action="store_true",
        help="Remove container cache only (incompatible with --all and --container)",
    )
    rm_parser.add_argument(
        "--network",
        action="store_true",
        help="Remove network bridge and firewall rules only",
    )

    # bash command - special handling
    subparsers.add_parser("bash", help="Launch bash shell", add_help=False)

    # exec command - special handling
    subparsers.add_parser("exec", help="Execute command in container", add_help=False)

    # status command
    subparsers.add_parser("status", help="Check container status")

    # list command
    subparsers.add_parser("list", help="List all containers and their status")

    # For bash and exec commands, manually handle the rest
    if (
        remaining_args
        and subcommand_idx is not None
        and remaining_args[0] in ["bash", "exec"]
    ):
        # Parse only up to the command
        args = parser.parse_args(sys.argv[1 : subcommand_idx + 1])

        # Get everything after the command as remainder
        remainder = (
            sys.argv[subcommand_idx + 1 :] if len(sys.argv) > subcommand_idx + 1 else []
        )

        if remaining_args[0] == "bash":
            args.bash_args = remainder
        elif remaining_args[0] == "exec":
            args.exec_command = remainder
    else:
        # Normal parsing for other commands
        args = parser.parse_args()

    return args


def main():
    # The internal entry helper takes no user-facing arguments. Dispatch it
    # before argparse so that no CLI option can reach it.
    if len(sys.argv) > 1 and sys.argv[1] == ENTRY_HELPER_MODE:
        sys.exit(_entry_helper_main(sys.argv))

    # Parse arguments with custom handling
    args = parse_args_custom()

    if args.command in (None, "up", "bash", "exec"):
        try:
            _validated_terminal_type()
        except ValueError:
            print("E: Invalid TERM environment variable")
            sys.exit(1)

    # Parsing deliberately comes first: --help and argument errors do not
    # require root or access to root-owned machine state.
    _require_root()
    _verify_safe_dir(SYSTEMD_MACHINES)

    # Create Sandy instance
    sandy = Sandy()

    # Set global options with proper validation
    if args.workspace:
        if not _validate_workspace_path(args.workspace):
            print(
                f"E: Invalid workspace path '{_strip_control_characters(args.workspace)}'"
            )
            sys.exit(1)
        sandy.workspace = args.workspace

    if args.shared:
        if not _validate_workspace_path(args.shared):
            print(f"E: Invalid shared path '{_strip_control_characters(args.shared)}'")
            sys.exit(1)
        sandy.shared = args.shared

    if args.container:
        if not _validate_container_name(args.container):
            print(
                f"E: Invalid container name '{_strip_control_characters(args.container)}'"
            )
            sys.exit(1)
        sandy.container = args.container
    else:
        # Validate default container name too
        if not _validate_container_name(sandy.container):
            print(
                f"E: Invalid default container name '{_strip_control_characters(sandy.container)}'"
            )
            sys.exit(1)

    if args.user:
        if not _validate_username(args.user):
            print(f"E: Invalid username '{_strip_control_characters(args.user)}'")
            sys.exit(1)
        sandy.user = args.user
        sandy.user_home = "/root" if sandy.user == "root" else f"/home/{sandy.user}"
    else:
        # Validate default username too
        if not _validate_username(sandy.user):
            print(
                f"E: Invalid default username '{_strip_control_characters(sandy.user)}'"
            )
            sys.exit(1)

    # Execute command. A query that does not answer in QUERY_COMMAND_TIMEOUT,
    # or a machine query that fails, ends the command, after the cleanup of
    # the command has run.
    try:
        if args.command == "up":
            sandy.run_up(args)
        elif args.command == "down":
            sandy.run_down(args)
        elif args.command == "rm":
            sandy.run_rm(args, all=args.all, cache=args.cache, network=args.network)
        elif args.command == "bash":
            sandy.run_bash(args)
        elif args.command == "exec":
            sandy.run_exec(args)
        elif args.command == "status":
            sandy.run_status()
        elif args.command == "update":
            sandy.run_update(args)
        elif args.command == "list":
            sandy.run_list()
        else:
            # No command specified, run default (bash)
            status = sandy._exec(None, login_shell=True)
            _raise_for_container_status(status)
    except subprocess.TimeoutExpired as exc:
        program = exc.cmd[0] if isinstance(exc.cmd, list) and exc.cmd else exc.cmd
        print(
            f"E: '{_strip_control_characters(str(program))}' did not answer in "
            f"{exc.timeout:g} seconds"
        )
        sys.exit(1)
    except _MachineQueryError as exc:
        print(f"E: {exc}")
        sys.exit(1)


if __name__ == "__main__":
    main()
