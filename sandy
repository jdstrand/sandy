# Input validation functions
def _validate_container_name(name: str) -> bool:
    """Validate container name according to RFC hostname standards (for machinectl)"""
    if not name or len(name) > 63:  # RFC 1123 hostname length limit
        return False
    if name.startswith("-") or name.endswith("-"):  # Cannot start or end with hyphen
        return False
    # RFC hostname: start with letter, contain only letters, digits, hyphens
    # No underscores allowed in hostnames (unlike previous version)
    return (
        bool(re.match(r"^[a-z][a-z0-9-]*[a-z0-9]$", name))
        if len(name) > 1
        else bool(re.match(r"^[a-z]$", name))
    )


def _validate_username(username: str) -> bool:
    """Validate username according to strict POSIX/Linux standards"""
    if not username or len(username) > 32:  # Linux USERNAME_MAX is typically 32
        return False
    if username.startswith(
        "-"
    ):  # Cannot start with hyphen (could be mistaken for option)
        return False
    # Strict POSIX username: start with lowercase letter or underscore,
    # followed by lowercase letters, digits, underscores, or hyphens
    # Note: $ is allowed as final character for Samba machine accounts, but we exclude it for security
    return bool(re.match(r"^[a-z_][a-z0-9_-]*$", username))


def _validate_workspace_path(path: str) -> bool:
    """Validate workspace path to prevent directory traversal"""
    if not isinstance(path, str) or not path or len(path) > 4096:
        return False

    if any(char in path for char in ("\x00", "\n", "\r")):
        return False

    if os.path.isabs(path):
        return False

    # Check the original path components. Normalizing first would turn
    # "workspace/../secret" into "secret" and hide the traversal attempt.
    if ".." in path.split(os.sep):
        return False

    return True


def _strip_control_characters(message: str) -> str:
    """Return message text with C0, DEL, and C1 control characters removed."""
    return CONTROL_CHARACTER_PATTERN.sub("", str(message))


def _terminal_safe_repr(value: str) -> str:
    """Return an ASCII representation safe for terminal diagnostics."""
    return ascii(value)


def _contains_control_character(value: str) -> bool:
    """Return whether text contains a C0, DEL, or C1 control character."""
    return CONTROL_CHARACTER_PATTERN.search(value) is not None


def _finish_spinner_line(spinner_event: Optional[threading.Event], suffix: str = ""):
    """Ensure spinner line is closed exactly once with CRLF, optionally adding suffix."""
    if spinner_event and spinner_event.is_set():
        return

    if suffix:
        sys.stdout.write(suffix)
    sys.stdout.write("\r\n")
    sys.stdout.flush()

    if spinner_event:
        spinner_event.set()


def _validate_env_var(
    value: str, allowed_values: set = set(), max_length: int = 256
) -> bool:
    """Validate environment variable value"""
    if not value:
        return False
    if len(value) > max_length:
        return False
    if allowed_values and value not in allowed_values:
        return False
    # Prevent dangerous characters in env vars
    if any(char in value for char in ["\x00", "\n", "\r"]):
        return False
    return True


def _validated_terminal_type() -> str:
    """Return the terminal type allowed to cross the container boundary."""
    terminal_type = os.environ.get("TERM")
    if terminal_type in (None, ""):
        return DEFAULT_CONTAINER_TERM
    if not TERMINAL_TYPE_PATTERN.fullmatch(terminal_type):
        raise ValueError("Invalid TERM environment variable")
    return terminal_type


def _container_environment(user: str, user_home: str) -> Dict[str, str]:
    """Build the complete allow-listed launch defaults for a container process.

    Container and user shell startup files may intentionally replace these
    defaults after entry.
    """
    if not _validate_username(user):
        raise ValueError("Invalid container username")

    expected_home = "/root" if user == "root" else f"/home/{user}"
    if user_home != expected_home:
        raise ValueError("Invalid container home directory")

    return {
        "HOME": expected_home,
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "LOGNAME": user,
        "PATH": CONTAINER_PATH,
        "SHELL": "/bin/bash",
        "SYSTEMD_COLORS": "0",
        "TERM": _validated_terminal_type(),
        "USER": user,
    }


def _validated_subprocess_environment(
    environment: Optional[Mapping[str, str]],
) -> Dict[str, str]:
    """Copy and validate an explicit subprocess environment."""
    if environment is None:
        raise ValueError("Subprocess environment is required")
    if len(environment) > 64:
        raise ValueError("Subprocess environment is too large")

    validated = {}
    for key, value in environment.items():
        if not isinstance(key, str) or not ENVIRONMENT_KEY_PATTERN.fullmatch(key):
            raise ValueError("Invalid subprocess environment key")
        if (
            not isinstance(value, str)
            or len(value) > 4096
            or any(character in value for character in ("\x00", "\n", "\r"))
        ):
            raise ValueError("Invalid subprocess environment value")
        validated[key] = value
    return validated


def _container_exit_code(status: int) -> int:
    """Convert a PTY process status into a portable CLI exit code."""
    if not isinstance(status, int) or isinstance(status, bool):
        return 1
    if status < 0:
        return min(128 + abs(status), 255)
    if status > 255:
        return 1
    return status


def _raise_for_container_status(status: int) -> None:
    """Exit the CLI when a container command did not succeed."""
    exit_code = _container_exit_code(status)
    if exit_code != 0:
        raise SystemExit(exit_code)


def _validate_image_name(image: str) -> bool:
    """Validate container image name"""
    if not image or len(image) > 128:
        return False
    # OCI image name validation (simplified)
    return bool(re.match(r"^[a-z][a-z0-9._:-]{0,127}$", image))


def _validate_network_cidr(cidr: str) -> bool:
    """Validate network CIDR notation"""
    try:
        network = ipaddress.ip_network(cidr, strict=True)
        # Only allow private networks for security
        return network.is_private
    except (ValueError, ipaddress.AddressValueError):
        return False


def _validate_ip_address(ip: str) -> bool:
    """Validate IP address"""
    try:
        addr = ipaddress.ip_address(ip)
        # Only allow private IP addresses for security
        return addr.is_private
    except (ValueError, ipaddress.AddressValueError):
        return False


def _validate_port_mapping(port_spec: str) -> Optional[Tuple[str, int, int]]:
    """
    Validate port mapping specification and return parsed tuple.

    Args:
        port_spec: String in format "proto:host_port:container_port"

    Returns:
        Tuple of (proto, host_port, container_port) or None if invalid
    """
    if not port_spec or not isinstance(port_spec, str):
        return None

    parts = port_spec.split(":")
    if len(parts) != 3:
        return None

    proto, host_port, container_port = parts

    # Validate protocol
    if proto not in ["tcp", "udp"]:
        return None

    # Validate ports are integers in valid range
    try:
        hport = int(host_port)
        cport = int(container_port)

        if not (1 <= hport <= 65535):
            return None
        if not (1 <= cport <= 65535):
            return None

        return (proto, hport, cport)
    except (ValueError, OverflowError):
        return None


def _validate_inherited_fds(pass_fds: Any) -> Tuple[int, ...]:
    """Validate descriptors deliberately inherited across a subprocess exec."""
    if pass_fds is None:
        return ()
    try:
        inherited_fds = tuple(pass_fds)
    except TypeError as exc:
        raise ValueError("Inherited file descriptors must be iterable") from exc

    seen = set()
    for fd in inherited_fds:
        if not isinstance(fd, int) or isinstance(fd, bool) or fd < 0 or fd in seen:
            raise ValueError("Invalid inherited file descriptor")
        os.fstat(fd)
        seen.add(fd)
    return inherited_fds


def _validate_subprocess_fd_policy(kwargs: Dict[str, Any]) -> None:
    """Validate explicit subprocess FD inheritance without broadening it."""
    if "pass_fds" not in kwargs:
        return

    inherited_fds = _validate_inherited_fds(kwargs["pass_fds"])
    if inherited_fds and kwargs.get("close_fds") is False:
        raise ValueError("Inherited file descriptors require close_fds=True")
    kwargs["pass_fds"] = inherited_fds


def _proc_self_fd_path(fd: int) -> str:
    """Return a Linux procfs path for an open descriptor after validating it."""
    _validate_inherited_fds((fd,))
    return f"/proc/self/fd/{fd}"


def _run_secure_subprocess(cmd: list, **kwargs) -> subprocess.CompletedProcess:
    """Run subprocess with security hardening.

    Captured stdout and stderr are preserved verbatim. Callers that display
    command output must sanitize it at the terminal or log boundary.
    """
    if kwargs.get("shell") not in (None, False):
        raise ValueError("Shell execution is not permitted")
    kwargs["shell"] = False

    _validate_command_args(cmd)
    _validate_subprocess_fd_policy(kwargs)

    return subprocess.run(cmd, **kwargs)


def _run_secure_subprocess_popen(cmd: list, **kwargs) -> subprocess.Popen:
    """Run subprocess.Popen with security hardening"""
    if kwargs.get("shell") not in (None, False):
        raise ValueError("Shell execution is not permitted")
    kwargs["shell"] = False

    _validate_command_args(cmd)
    _validate_subprocess_fd_policy(kwargs)

    return subprocess.Popen(cmd, **kwargs)


def _validate_command_args(cmd: list):
    """Validate subprocess command arguments."""
    if not cmd or not all(isinstance(arg, str) and arg for arg in cmd):
        raise ValueError("Invalid command arguments")


class _AttachHangup(Exception):
    """The terminal of an attach went away (SIGHUP) or sandy got SIGTERM."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


@contextmanager  # installs and restores the hangup handlers around an attach
def _attach_hangup_handlers() -> Iterator[None]:
    """Turn SIGHUP and SIGTERM into _AttachHangup in the main thread.

    After the first signal both stay ignored, so that the attach cleanup
    that follows is not interrupted.
    """
    if threading.current_thread() is not threading.main_thread():
        yield
        return

    def hangup(signum: int, frame: Any) -> None:
        _ = frame
        for other in ATTACH_HANGUP_SIGNALS:
            signal.signal(other, signal.SIG_IGN)
        raise _AttachHangup(signum)

    previous = {
        signum: signal.signal(signum, hangup) for signum in ATTACH_HANGUP_SIGNALS
    }
    hung_up = False
    try:
        yield
    except _AttachHangup:
        hung_up = True
        raise
    finally:
        if not hung_up:
            for signum, handler in previous.items():
                signal.signal(signum, handler)


def _close_inherited_fds(keep: Tuple[int, ...]) -> None:
    """Close every open descriptor except stdin, stdout, stderr, and keep.

    pty.fork() keeps each descriptor of the parent that has no close-on-exec
    flag, and execve keeps them too. subprocess closes them (close_fds=True);
    do the same, so that a child gets only what its caller passes. The entry
    helper refuses to run with any other descriptor.
    """
    for fd in sorted(_open_fds() - {0, 1, 2} - set(keep)):
        os.close(fd)


def _run_secure_subprocess_pty(
    cmd: list,
    *,
    environment: Mapping[str, str],
    master_read: Optional[Callable[[int], bytes]] = None,
    stdin_read: Optional[Callable[[int], bytes]] = None,
    pass_fds: Tuple[int, ...] = (),
) -> int:
    """Run a subprocess inside a PTY with argument validation and terminal size handling."""
    _validate_command_args(cmd)
    child_environment = _validated_subprocess_environment(environment)
    inherited_fds = _validate_inherited_fds(pass_fds)

    if master_read is None:
        raise ValueError("master_read must be callable")
    if stdin_read is None:
        raise ValueError("stdin_read must be callable")

    def set_winsize(fd: int):
        """Set PTY window size from current terminal size."""
        try:
            size = os.get_terminal_size()
            rows, cols = size.lines, size.columns
        except OSError:
            rows, cols = 24, 80
        winsize = struct.pack("HHHH", rows, cols, 0, 0)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)

    # Fork with PTY
    pid, master_fd = pty.fork()

    if pid == 0:
        # Child process - exec the command
        try:
            _close_inherited_fds(inherited_fds)
            for fd in inherited_fds:
                os.set_inheritable(fd, True)
            os.execvpe(cmd[0], cmd, child_environment)
        except OSError as exc:
            sys.stderr.write(
                "Failed to execute "
                f"{_terminal_safe_repr(cmd[0])}: {_terminal_safe_repr(str(exc))}\n"
            )
            os._exit(1)

    # Parent process - get the PTY peer path for signaling on resize
    pty_peer_path: Optional[str] = None
    try:
        buf = array.array("i", [0])
        fcntl.ioctl(master_fd, 0x80045430, buf)  # TIOCGPTN
        pty_peer_path = f"/dev/pts/{buf[0]}"
    except OSError:
        # Resize still works for outer PTY; just can't propagate to container
        pass

    def signal_pty_processes():
        """Find and signal all processes using the PTY peer (best-effort).

        Safe across containers: pty_peer_path is in the host's devpts namespace,
        so only processes with our specific host PTY are signaled.
        """
        if pty_peer_path is None:
            return
        for proc_pid in os.listdir("/proc"):
            if not proc_pid.isdigit():
                continue
            try:
                fd_dir = f"/proc/{proc_pid}/fd"
                for fd in os.listdir(fd_dir):
                    if os.readlink(f"{fd_dir}/{fd}") == pty_peer_path:
                        os.kill(int(proc_pid), signal.SIGWINCH)
                        break
            except (OSError, PermissionError):
                continue

    sigwinch_received = False

    def handle_sigwinch(signum, frame):
        _ = signum
        _ = frame
        nonlocal sigwinch_received
        sigwinch_received = True

    # Set initial window size
    set_winsize(master_fd)

    # Save and set terminal to raw mode
    old_settings = None
    try:
        old_settings = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())
    except termios.error:
        pass

    # Only install SIGWINCH handler in main thread
    in_main_thread = threading.current_thread() is threading.main_thread()
    old_handler = None
    if in_main_thread:
        old_handler = signal.signal(signal.SIGWINCH, handle_sigwinch)

    try:
        stdin_fd = sys.stdin.fileno()
        while True:
            # Handle any pending SIGWINCH
            if sigwinch_received:
                sigwinch_received = False
                set_winsize(master_fd)
                signal_pty_processes()

            # Wait for data from stdin or master
            try:
                rfds, _, _ = select.select([stdin_fd, master_fd], [], [])
            except InterruptedError:
                continue

            if stdin_fd in rfds:
                data = stdin_read(stdin_fd)
                if data:
                    os.write(master_fd, data)

            if master_fd in rfds:
                try:
                    data = master_read(master_fd)
                    if data:
                        os.write(sys.stdout.fileno(), data)
                    else:
                        break
                except OSError:
                    break
    finally:
        if old_settings is not None:
            try:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSAFLUSH, old_settings)
            except termios.error:
                pass

        if in_main_thread and old_handler is not None:
            signal.signal(signal.SIGWINCH, old_handler)

        os.close(master_fd)

    # Wait for child and return exit status
    _, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    elif os.WIFSIGNALED(status):
        return -os.WTERMSIG(status)
    return -1


# Helper functions
def _managed_path_components(path: str, *, allow_managed_root: bool) -> Tuple[str, ...]:
    """Validate a normalized absolute path in Sandy's managed filesystem scope."""
    if (
        not isinstance(path, str)
        or not path
        or len(path) > 4096
        or _contains_control_character(path)
    ):
        raise ValueError("Invalid managed path")

    managed_root = os.path.normpath(SYSTEMD_MACHINES)
    if (
        not os.path.isabs(SYSTEMD_MACHINES)
        or SYSTEMD_MACHINES != managed_root
        or path != os.path.normpath(path)
        or not os.path.isabs(path)
    ):
        raise ValueError("Managed paths must be normalized absolute paths")

    root_components = tuple(
        component for component in managed_root.split(os.sep) if component
    )
    path_components = tuple(component for component in path.split(os.sep) if component)
    if path_components[: len(root_components)] != root_components:
        raise ValueError(f"Managed path is outside '{SYSTEMD_MACHINES}'")

    relative_components = path_components[len(root_components) :]
    if not relative_components:
        if not allow_managed_root:
            raise ValueError(f"Refusing to target managed root '{SYSTEMD_MACHINES}'")
        return path_components

    managed_name = relative_components[0]
    if not managed_name.startswith("sandy.") or len(managed_name) <= len("sandy."):
        raise ValueError("Managed path must begin with a Sandy-owned directory")

    return path_components


def _verify_owned_directory(directory_stat: os.stat_result, label: str) -> None:
    """Verify directory type, ownership, and non-writable trust boundary."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise PermissionError(f"Path component {safe_label} is not a directory")
    if directory_stat.st_uid != 0 or directory_stat.st_gid != 0:
        raise PermissionError(f"Directory {safe_label} has unexpected ownership")
    if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError(f"Directory {safe_label} is writable by other users")


def _verify_owned_symlink(link_stat: os.stat_result, label: str) -> None:
    """Verify that a symlink is an administrator-controlled filesystem entry."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISLNK(link_stat.st_mode):
        raise PermissionError(f"Path component {safe_label} is not a symlink")
    if link_stat.st_uid != 0 or link_stat.st_gid != 0:
        raise PermissionError(f"Symlink {safe_label} has unexpected ownership")


def _read_verified_symlink(
    parent_fd: int,
    component: str,
) -> Tuple[str, os.stat_result]:
    """Read a symlink through a pinned no-follow descriptor."""
    link_fd = os.open(
        component,
        PATH_OPEN_FLAGS,
        dir_fd=parent_fd,
    )
    try:
        link_stat = os.fstat(link_fd)
        _verify_owned_symlink(link_stat, component)
        target = os.readlink("", dir_fd=link_fd)
    finally:
        os.close(link_fd)

    if not target or len(target) > 4096 or _contains_control_character(target):
        safe_component = _terminal_safe_repr(component)
        raise PermissionError(f"Symlink {safe_component} has an invalid target")
    return target, link_stat


def _open_verified_host_directory(path: str) -> int:
    """Open a normalized host directory without following path-component links."""
    if (
        not isinstance(path, str)
        or not path
        or len(path) > 4096
        or not os.path.isabs(path)
        or path != os.path.normpath(path)
        or _contains_control_character(path)
    ):
        raise ValueError("Invalid host directory path")

    path_components = tuple(component for component in path.split(os.sep) if component)
    current_fd = os.open("/", DIRECTORY_OPEN_FLAGS)
    root_stat = os.fstat(current_fd)
    try:
        _verify_owned_directory(root_stat, "/")
        for component in path_components:
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    safe_component = _terminal_safe_repr(component)
                    raise PermissionError(
                        f"Unsafe managed path component {safe_component}"
                    ) from exc
                raise

            try:
                _verify_owned_directory(os.fstat(next_fd), component)
            except Exception:
                os.close(next_fd)
                raise
            os.close(current_fd)
            current_fd = next_fd

        if _same_inode(root_stat, os.fstat(current_fd)):
            raise PermissionError("Refusing to use the host root as a machine image")
        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_machine_image_symlink(managed_root_fd: int, managed_name: str) -> int:
    """Resolve systemd's documented administrator-controlled image symlink."""
    if managed_name == "sandy.__cache":
        raise PermissionError("The Sandy cache directory may not be a symlink")

    target, _ = _read_verified_symlink(managed_root_fd, managed_name)
    if os.path.isabs(target):
        target_path = os.path.normpath(target)
    else:
        target_path = os.path.normpath(os.path.join(SYSTEMD_MACHINES, target))

    # machinectl(1) explicitly supports image links in /var/lib/machines. The
    # one administrator-controlled image link is followed here, while target
    # path components and the shared cache remain strictly no-follow.
    managed_root = os.path.normpath(SYSTEMD_MACHINES)
    if target_path == managed_root or managed_root.startswith(f"{target_path}/"):
        raise PermissionError("Machine image symlink targets a managed-root ancestor")

    target_fd = _open_verified_host_directory(target_path)
    if _same_inode(os.fstat(target_fd), os.fstat(managed_root_fd)):
        os.close(target_fd)
        raise PermissionError("Machine image symlink targets the managed root")
    return target_fd


def _image_symlink_components(
    resolved_components: Tuple[str, ...],
    target: str,
    pending_components: Tuple[str, ...],
) -> Tuple[str, ...]:
    """Resolve symlink text with chroot-style semantics inside an image root."""
    if os.path.isabs(target):
        combined = []
    else:
        combined = list(resolved_components)

    for component in target.split(os.sep):
        if component in ("", "."):
            continue
        if component == "..":
            if combined:
                combined.pop()
            continue
        combined.append(component)

    combined.extend(pending_components)
    return tuple(combined)


def _open_image_directory(image_root_fd: int, components: Tuple[str, ...]) -> int:
    """Resolve an image directory while containing symlinks inside its root."""
    image_root_stat = os.fstat(image_root_fd)
    image_mount_id = _fd_mount_id(image_root_fd)
    current_fd = os.dup(image_root_fd)
    resolved_components: Tuple[str, ...] = ()
    pending_components = components
    symlink_count = 0

    try:
        while pending_components:
            component = pending_components[0]
            pending_components = pending_components[1:]
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno not in (errno.ELOOP, errno.ENOTDIR):
                    raise

                target, _ = _read_verified_symlink(current_fd, component)
                symlink_count += 1
                if symlink_count > MAX_SYMLINK_RESOLUTIONS:
                    raise PermissionError("Too many symlinks in machine image path")

                pending_components = _image_symlink_components(
                    resolved_components,
                    target,
                    pending_components,
                )
                os.close(current_fd)
                current_fd = os.dup(image_root_fd)
                resolved_components = ()
                continue

            try:
                next_stat = os.fstat(next_fd)
                _verify_owned_directory(next_stat, component)
                if next_stat.st_dev != image_root_stat.st_dev:
                    raise PermissionError(
                        "Refusing to cross an image filesystem boundary"
                    )
                if _fd_mount_id(next_fd) != image_mount_id:
                    raise PermissionError("Refusing to cross an image mount boundary")
            except Exception:
                os.close(next_fd)
                raise

            os.close(current_fd)
            current_fd = next_fd
            resolved_components = (*resolved_components, component)

        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _verify_owned_image_file(file_stat: os.stat_result, label: str) -> None:
    """Verify a contained image file before exposing it as a host bind source."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISREG(file_stat.st_mode):
        raise PermissionError(f"Image file {safe_label} is not a regular file")
    if file_stat.st_uid != os.geteuid() or file_stat.st_gid != os.getegid():
        raise PermissionError(f"Image file {safe_label} has unexpected ownership")
    if file_stat.st_nlink != 1:
        raise PermissionError(f"Image file {safe_label} has multiple links")
    if file_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError(f"Image file {safe_label} is writable by other users")


def _open_image_file(image_root_fd: int, components: Tuple[str, ...]) -> int:
    """Open a regular file through a pinned image root without following it."""
    if not components:
        raise ValueError("Image file path must include a file name")

    image_root_stat = os.fstat(image_root_fd)
    image_mount_id = _fd_mount_id(image_root_fd)
    parent_components = components[:-1]
    basename = components[-1]
    parent_fd = (
        _open_image_directory(image_root_fd, parent_components)
        if parent_components
        else os.dup(image_root_fd)
    )
    file_fd: Optional[int] = None
    try:
        try:
            file_fd = os.open(
                basename,
                READ_FILE_OPEN_FLAGS,
                dir_fd=parent_fd,
            )
        except OSError as exc:
            if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                safe_basename = _terminal_safe_repr(basename)
                raise PermissionError(
                    f"Unsafe image file path component {safe_basename}"
                ) from exc
            raise

        file_stat = os.fstat(file_fd)
        _verify_owned_image_file(file_stat, basename)
        if file_stat.st_dev != image_root_stat.st_dev:
            raise PermissionError("Refusing to cross an image filesystem boundary")
        if _fd_mount_id(file_fd) != image_mount_id:
            raise PermissionError("Refusing to cross an image mount boundary")
        return file_fd
    except Exception:
        if file_fd is not None:
            os.close(file_fd)
        raise
    finally:
        os.close(parent_fd)


def _open_optional_image_file(
    image_root_fd: int,
    components: Tuple[str, ...],
) -> Optional[int]:
    """Open an optional image file, returning None only when it is absent."""
    try:
        return _open_image_file(image_root_fd, components)
    except FileNotFoundError:
        return None


def _parse_container_ip_from_init_fd(init_script_fd: int) -> Optional[str]:
    """Read CONTAINER_IP from a verified regular init script descriptor."""
    _validate_inherited_fds((init_script_fd,))
    raw_content = os.pread(init_script_fd, INIT_SCRIPT_MAX_BYTES + 1, 0)
    if len(raw_content) > INIT_SCRIPT_MAX_BYTES:
        raise PermissionError("Container init script is too large")
    try:
        content = raw_content.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise PermissionError("Container init script is not valid UTF-8") from exc

    match = re.search(
        r'(?m)^CONTAINER_IP="([0-9]{1,3}(?:\.[0-9]{1,3}){3})"$',
        content,
    )
    if not match:
        return None

    container_ip = match.group(1)
    if not _validate_ip_address(container_ip):
        raise PermissionError("Container init script contains an invalid IP address")
    return container_ip


def _create_init_bind_copy(
    init_script_fd: int,
    owner_uid: Optional[int] = None,
    owner_gid: Optional[int] = None,
) -> Tuple[str, str]:
    """Copy a verified init script into a private file nspawn can bind mount."""
    _validate_inherited_fds((init_script_fd,))
    if (owner_uid is None) != (owner_gid is None):
        raise PermissionError("Init bind copy owner must include uid and gid")
    if owner_uid is not None and (
        owner_uid < 0
        or owner_gid is None
        or owner_gid < 0
        or owner_uid > 0xFFFFFFFF
        or owner_gid > 0xFFFFFFFF
    ):
        raise PermissionError("Init bind copy owner is outside the uid/gid range")
    temporary_dir = tempfile.mkdtemp(prefix="sandy-init-")
    bind_path = os.path.join(temporary_dir, "init.sh")
    bind_fd: Optional[int] = None
    try:
        raw_content = os.pread(init_script_fd, INIT_SCRIPT_MAX_BYTES + 1, 0)
        if len(raw_content) > INIT_SCRIPT_MAX_BYTES:
            raise PermissionError("Container init script is too large")
        bind_fd = os.open(
            bind_path,
            TEMPORARY_FILE_OPEN_FLAGS,
            0o600,
        )
        remaining = memoryview(raw_content)
        while remaining:
            written = os.write(bind_fd, remaining)
            if written <= 0:
                raise OSError("Temporary init bind copy write made no progress")
            remaining = remaining[written:]
        if owner_uid is not None and owner_gid is not None:
            os.fchown(bind_fd, owner_uid, owner_gid)
        # Mode 0500 is intentional: the bind is read-only, and the owner maps
        # to container root either through an idmapped bind mount on modern
        # systemd or the fixed pre-250 private-user uid range. Avoid granting
        # group/world access to this transient host-side copy.
        os.fchmod(bind_fd, 0o500)
        os.fsync(bind_fd)
        return temporary_dir, bind_path
    except Exception:
        shutil.rmtree(temporary_dir, ignore_errors=True)
        raise
    finally:
        if bind_fd is not None:
            os.close(bind_fd)


def _remove_init_bind_copy(temporary_dir: str) -> None:
    """Remove the exact private temporary directory used for an init bind copy."""
    normalized_dir = os.path.normpath(temporary_dir)
    expected_parent = os.path.normpath(tempfile.gettempdir())
    basename = os.path.basename(normalized_dir)
    if os.path.dirname(normalized_dir) != expected_parent or not basename.startswith(
        "sandy-init-"
    ):
        raise PermissionError("Refusing to remove unexpected init bind directory")
    directory_stat = os.lstat(normalized_dir)
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise PermissionError("Init bind copy path is not a directory")
    if directory_stat.st_uid != os.geteuid() or directory_stat.st_gid != os.getegid():
        raise PermissionError("Init bind copy directory has unexpected ownership")
    if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError("Init bind copy directory has unsafe permissions")
    shutil.rmtree(normalized_dir)


def _read_keepalive_script(path: str) -> bytes:
    """Read the keepalive script that Sandy installs next to itself."""
    fd = os.open(path, READ_FILE_OPEN_FLAGS)
    try:
        # Sandy runs as root, so the owner of its own files is trusted as
        # much as Sandy is. No other user may change the script.
        _verify_entry_script(os.fstat(fd))
        content = os.pread(fd, KEEPALIVE_SCRIPT_MAX_BYTES + 1, 0)
    finally:
        os.close(fd)
    if not content or len(content) > KEEPALIVE_SCRIPT_MAX_BYTES:
        raise PermissionError("Keepalive script has an unexpected size")
    if not content.isascii() or b"\x00" in content:
        raise PermissionError("Keepalive script is not ASCII text")
    return content


def _create_keepalive_dir(script: bytes) -> str:
    """Create the private directory that nspawn binds at KEEPALIVE_MOUNT.

    It holds exactly a symlink to the image's bash and a copy of the script.
    The container resolves the symlink in its own mount namespace, so the
    host directory holds no binary. bash only reads the script, so the bind
    source may be noexec.
    """
    temporary_dir = tempfile.mkdtemp(prefix=KEEPALIVE_DIR_PREFIX)
    script_fd: Optional[int] = None
    try:
        os.symlink(KEEPALIVE_SHELL, os.path.join(temporary_dir, KEEPALIVE_LINK_NAME))
        script_fd = os.open(
            os.path.join(temporary_dir, KEEPALIVE_COPY_NAME),
            TEMPORARY_FILE_OPEN_FLAGS,
            0o600,
        )
        remaining = memoryview(script)
        while remaining:
            written = os.write(script_fd, remaining)
            if written <= 0:
                raise OSError("Keepalive script write made no progress")
            remaining = remaining[written:]
        # Container root reads the copy through a read-only bind. Below
        # systemd 250 host root maps to the overflow uid in the container, so
        # the copy must be world-readable.
        os.fchmod(script_fd, 0o644)
        os.fsync(script_fd)
        os.chmod(temporary_dir, 0o755)
        return temporary_dir
    except BaseException:
        shutil.rmtree(temporary_dir, ignore_errors=True)
        raise
    finally:
        if script_fd is not None:
            os.close(script_fd)


def _remove_keepalive_dir(temporary_dir: str) -> None:
    """Remove the exact keepalive directory and only its two known entries."""
    normalized_dir = os.path.normpath(temporary_dir)
    expected_parent = os.path.normpath(tempfile.gettempdir())
    basename = os.path.basename(normalized_dir)
    if os.path.dirname(normalized_dir) != expected_parent or not basename.startswith(
        KEEPALIVE_DIR_PREFIX
    ):
        raise PermissionError("Refusing to remove unexpected keepalive directory")
    directory_fd = os.open(normalized_dir, DIRECTORY_OPEN_FLAGS)
    try:
        directory_stat = os.fstat(directory_fd)
        if (
            directory_stat.st_uid != os.geteuid()
            or directory_stat.st_gid != os.getegid()
        ):
            raise PermissionError("Keepalive directory has unexpected ownership")
        if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise PermissionError("Keepalive directory has unsafe permissions")
        entries = set(os.listdir(directory_fd))
        if not entries <= {KEEPALIVE_LINK_NAME, KEEPALIVE_COPY_NAME}:
            raise PermissionError("Keepalive directory has unexpected entries")
        for name in sorted(entries):
            os.unlink(name, dir_fd=directory_fd)
    finally:
        os.close(directory_fd)
    os.rmdir(normalized_dir)


def _supervisor_unit_name(machine_name: str) -> str:
    """Return the name of the transient scope that runs a container."""
    if not _validate_container_name(machine_name):
        raise ValueError("Invalid container name")
    return f"{SUPERVISOR_UNIT_PREFIX}{machine_name}.scope"


def _supervisor_description(machine_name: str, detached: bool) -> str:
    """Return the scope description, which records how up started it."""
    mode = "detached" if detached else "attached"
    return f"Sandy container {machine_name} ({mode})"


def _supervisor_scope_argv(
    machine_name: str, systemd_version: int, detached: bool
) -> list:
    """Return the systemd-run prefix that starts nspawn in its own scope.

    systemd-run --scope execs its command, so nspawn inherits the machine
    directory descriptor. machined sets TasksMax=16384 on the scopes that it
    creates, and a systemd-run scope gets DefaultTasksMax instead, so set it.
    Scope units accept OOMPolicy= only from systemd 253.
    """
    argv = [
        "systemd-run",
        "--scope",
        "--quiet",
        f"--unit={_supervisor_unit_name(machine_name)}",
        f"--slice={SUPERVISOR_SLICE}",
        f"--description={_supervisor_description(machine_name, detached)}",
        "--property=Delegate=yes",
    ]
    if systemd_version >= 253:
        argv.append("--property=OOMPolicy=continue")
    argv.extend([f"--property=TasksMax={SUPERVISOR_TASKS_MAX}", "--"])
    return argv


def _systemctl_show_value(unit: str, prop: str) -> str:
    """Return one property value of unit from systemctl show."""
    result = _run_secure_subprocess(
        ["systemctl", "show", unit, "-p", prop, "--value"],
        capture_output=True,
        text=True,
        check=True,
    )
    output = result.stdout
    if output.endswith("\n"):
        output = output[:-1]
    if len(output) > SYSTEMCTL_VALUE_MAX_LENGTH or _contains_control_character(output):
        raise ValueError(f"Malformed {prop} of {unit}")
    return output


def _supervisor_detached(machine_name: str) -> Optional[bool]:
    """Return whether up started the container with -d, from its scope.

    Return None when the scope does not exist or has another description.
    Only root can set the description of a system unit.
    """
    description = _systemctl_show_value(
        _supervisor_unit_name(machine_name), "Description"
    )
    for detached in (True, False):
        if description == _supervisor_description(machine_name, detached):
            return detached
    return None


def _supervisor_unit_loaded(machine_name: str) -> bool:
    """Return whether systemd knows the container's scope in any state."""
    load_state = _systemctl_show_value(_supervisor_unit_name(machine_name), "LoadState")
    if load_state == "not-found":
        return False
    if not UNIT_STATE_PATTERN.fullmatch(load_state):
        raise ValueError("Malformed LoadState of the container scope")
    return True


def _validate_container_ip_for_cidr(
    container_ip: str,
    network_cidr: Optional[str],
) -> str:
    """Verify a parsed container IP belongs to a known Sandy network."""
    if not _validate_ip_address(container_ip):
        raise PermissionError("Container init script contains an invalid IP address")
    if network_cidr:
        try:
            network = ipaddress.ip_network(network_cidr, strict=True)
            address = ipaddress.ip_address(container_ip)
        except ValueError as exc:
            raise PermissionError("Invalid Sandy network configuration") from exc
        if address not in network:
            raise PermissionError(
                "Container init script IP is outside the Sandy network"
            )
    return container_ip


def _open_verified_dir(path: str) -> int:
    """Open a managed directory with image-root-contained symlink resolution."""
    path_components = _managed_path_components(path, allow_managed_root=True)
    managed_root_components = tuple(
        component
        for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
        if component
    )
    relative_components = path_components[len(managed_root_components) :]

    current_fd = os.open("/", DIRECTORY_OPEN_FLAGS)
    root_stat = os.fstat(current_fd)
    try:
        _verify_owned_directory(root_stat, "/")
        for component in managed_root_components:
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    safe_component = _terminal_safe_repr(component)
                    raise PermissionError(
                        f"Unsafe managed-root component {safe_component}"
                    ) from exc
                raise

            try:
                _verify_owned_directory(os.fstat(next_fd), component)
            except Exception:
                os.close(next_fd)
                raise
            os.close(current_fd)
            current_fd = next_fd

        if not relative_components:
            return current_fd

        managed_name = relative_components[0]
        try:
            image_fd = os.open(
                managed_name,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=current_fd,
            )
        except OSError as exc:
            if exc.errno not in (errno.ELOOP, errno.ENOTDIR):
                raise
            image_fd = _open_machine_image_symlink(current_fd, managed_name)
        else:
            try:
                image_stat = os.fstat(image_fd)
                _verify_owned_directory(image_stat, managed_name)
                if _same_inode(image_stat, root_stat):
                    raise PermissionError(
                        "Refusing to use the host root as a machine image"
                    )
            except Exception:
                os.close(image_fd)
                raise

        if len(relative_components) == 1:
            os.close(current_fd)
            return image_fd

        try:
            resolved_fd = _open_image_directory(
                image_fd,
                relative_components[1:],
            )
        finally:
            os.close(image_fd)
        os.close(current_fd)
        return resolved_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_verified_parent(path: str) -> Tuple[int, str]:
    """Open a target's verified parent and return its descriptor and basename."""
    _managed_path_components(path, allow_managed_root=False)
    parent_path = os.path.dirname(path)
    basename = os.path.basename(path)
    return _open_verified_dir(parent_path), basename


def _container_name_from_machine_path(path: str) -> str:
    """Extract and validate a Sandy container name from a managed machine path."""
    path_components = _managed_path_components(path, allow_managed_root=False)
    managed_root_components = tuple(
        component
        for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
        if component
    )
    relative_components = path_components[len(managed_root_components) :]
    if len(relative_components) != 1:
        raise ValueError("Machine path is not a top-level Sandy container")

    basename = relative_components[0]
    prefix = "sandy."
    container_name = basename.removeprefix(prefix)
    if not _validate_container_name(container_name):
        raise ValueError("Machine path contains an invalid Sandy container name")
    return container_name


def _verify_safe_dir(path: str) -> None:
    """Verify a managed directory through contained descriptor resolution."""
    directory_fd = _open_verified_dir(path)
    os.close(directory_fd)


def _same_inode(first: os.stat_result, second: os.stat_result) -> bool:
    """Return whether two stat results identify the same filesystem object."""
    return first.st_dev == second.st_dev and first.st_ino == second.st_ino


def _fd_mount_id(fd: int) -> int:
    """Read and strictly validate the kernel mount ID for an open descriptor."""
    if not isinstance(fd, int) or isinstance(fd, bool) or fd < 0:
        raise ValueError("Invalid file descriptor")

    mount_id: Optional[int] = None
    with open(f"/proc/self/fdinfo/{fd}", "r", encoding="ascii") as fdinfo:
        for line in fdinfo:
            if not line.startswith("mnt_id:"):
                continue
            value = line.removeprefix("mnt_id:").strip()
            if (
                mount_id is not None
                or not value.isascii()
                or not value.isdecimal()
                or len(value) > 20
            ):
                raise PermissionError("Invalid descriptor mount metadata")
            mount_id = int(value)

    if mount_id is None or mount_id <= 0:
        raise PermissionError("Missing descriptor mount metadata")
    return mount_id


def _remove_directory_contents(
    directory_fd: int,
    root_device: int,
    root_mount_id: int,
) -> None:
    """Recursively remove entries relative to an already verified directory."""
    for entry in os.listdir(directory_fd):
        entry_stat = os.stat(entry, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISDIR(entry_stat.st_mode):
            if entry_stat.st_dev != root_device:
                raise PermissionError("Refusing to cross a filesystem boundary")

            child_fd = os.open(
                entry,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=directory_fd,
            )
            try:
                opened_stat = os.fstat(child_fd)
                if not _same_inode(entry_stat, opened_stat):
                    raise PermissionError(
                        "Directory changed during descriptor-anchored removal"
                    )
                if _fd_mount_id(child_fd) != root_mount_id:
                    raise PermissionError("Refusing to cross a mount boundary")
                _remove_directory_contents(
                    child_fd,
                    root_device,
                    root_mount_id,
                )
            finally:
                os.close(child_fd)

            current_stat = os.stat(
                entry,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
            if not _same_inode(entry_stat, current_stat):
                raise PermissionError(
                    "Directory changed during descriptor-anchored removal"
                )
            os.rmdir(entry, dir_fd=directory_fd)
        else:
            entry_fd = os.open(
                entry,
                PATH_OPEN_FLAGS,
                dir_fd=directory_fd,
            )
            try:
                opened_stat = os.fstat(entry_fd)
                if not _same_inode(entry_stat, opened_stat):
                    raise PermissionError(
                        "Entry changed during descriptor-anchored removal"
                    )
                if _fd_mount_id(entry_fd) != root_mount_id:
                    raise PermissionError("Refusing to cross a mount boundary")
            finally:
                os.close(entry_fd)

            current_stat = os.stat(
                entry,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
            if not _same_inode(entry_stat, current_stat):
                raise PermissionError(
                    "Entry changed during descriptor-anchored removal"
                )
            os.unlink(entry, dir_fd=directory_fd)
    os.fsync(directory_fd)


def _remove_managed_tree(path: str) -> None:
    """Remove a Sandy-owned tree without post-verification path operations."""
    parent_fd, basename = _open_verified_parent(path)
    target_fd: Optional[int] = None
    try:
        target_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if stat.S_ISLNK(target_stat.st_mode):
            path_components = _managed_path_components(
                path,
                allow_managed_root=False,
            )
            managed_root_components = tuple(
                component
                for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
                if component
            )
            if (
                len(path_components) != len(managed_root_components) + 1
                or basename == "sandy.__cache"
            ):
                raise PermissionError("Refusing to remove a non-image managed symlink")

            _, opened_link_stat = _read_verified_symlink(parent_fd, basename)
            current_stat = os.stat(
                basename,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
            if not _same_inode(opened_link_stat, current_stat):
                raise PermissionError("Machine image symlink changed before removal")

            # Removing a systemd image link removes only Sandy's reference.
            # Recursively deleting its administrator-owned target would turn a
            # supported storage indirection into an unsafe deletion primitive.
            os.unlink(basename, dir_fd=parent_fd)
            os.fsync(parent_fd)
            return
        if not stat.S_ISDIR(target_stat.st_mode):
            raise PermissionError("Managed removal target is not a directory")
        _verify_owned_directory(target_stat, basename)

        target_fd = os.open(
            basename,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=parent_fd,
        )
        opened_stat = os.fstat(target_fd)
        if not _same_inode(target_stat, opened_stat):
            raise PermissionError("Managed removal target changed during open")
        parent_mount_id = _fd_mount_id(parent_fd)
        target_mount_id = _fd_mount_id(target_fd)
        if target_mount_id != parent_mount_id:
            raise PermissionError("Refusing to remove a mounted managed target")

        _remove_directory_contents(
            target_fd,
            opened_stat.st_dev,
            target_mount_id,
        )
        os.close(target_fd)
        target_fd = None

        current_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(opened_stat, current_stat):
            raise PermissionError("Managed removal target changed before removal")
        os.rmdir(basename, dir_fd=parent_fd)
        os.fsync(parent_fd)
    finally:
        if target_fd is not None:
            os.close(target_fd)
        os.close(parent_fd)


def _mkdir(path: str) -> None:
    """Create and verify a Sandy-owned directory relative to its parent."""
    parent_fd, basename = _open_verified_parent(path)
    created = False
    try:
        os.mkdir(basename, mode=0o700, dir_fd=parent_fd)
        created = True
        directory_fd = os.open(
            basename,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=parent_fd,
        )
        try:
            _verify_owned_directory(os.fstat(directory_fd), basename)
        finally:
            os.close(directory_fd)
        os.fsync(parent_fd)
    except Exception:
        if created:
            try:
                os.rmdir(basename, dir_fd=parent_fd)
            except OSError:
                pass
        raise
    finally:
        os.close(parent_fd)


def _validate_existing_write_target(parent_fd: int, basename: str) -> None:
    """Reject unsafe existing destinations before atomic replacement."""
    try:
        destination_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        return

    # Parent-directory symlinks have already been resolved inside the pinned
    # image root. The final destination is deliberately not followed: Sandy
    # owns this exact file, and following it would restore the host-write bug.
    if not stat.S_ISREG(destination_stat.st_mode):
        raise PermissionError("Existing write destination is not a regular file")
    if (
        destination_stat.st_uid != os.geteuid()
        or destination_stat.st_gid != os.getegid()
    ):
        raise PermissionError("Existing write destination has unexpected ownership")
    if destination_stat.st_nlink != 1:
        raise PermissionError("Existing write destination has multiple links")


def _write(path: str, content: str, mode: int = 0o0600) -> None:
    """Atomically write a file relative to a verified managed directory."""
    if not isinstance(content, str):
        raise ValueError("Managed file content must be text")
    if not isinstance(mode, int) or isinstance(mode, bool) or mode < 0 or mode & ~0o777:
        raise ValueError("Invalid managed file mode")

    parent_fd, basename = _open_verified_parent(path)
    temporary_fd: Optional[int] = None
    temporary_name: Optional[str] = None
    try:
        _validate_existing_write_target(parent_fd, basename)

        for _ in range(16):
            candidate = f".sandy-{secrets.token_hex(16)}.tmp"
            try:
                temporary_fd = os.open(
                    candidate,
                    TEMPORARY_FILE_OPEN_FLAGS,
                    0o600,
                    dir_fd=parent_fd,
                )
                temporary_name = candidate
                break
            except FileExistsError:
                continue
        if temporary_fd is None or temporary_name is None:
            raise FileExistsError("Could not create an unpredictable temporary file")

        temporary_stat = os.fstat(temporary_fd)
        if (
            not stat.S_ISREG(temporary_stat.st_mode)
            or temporary_stat.st_uid != os.geteuid()
            or temporary_stat.st_gid != os.getegid()
            or temporary_stat.st_nlink != 1
        ):
            raise PermissionError("Temporary write destination failed validation")

        remaining = memoryview(content.encode("utf-8"))
        while remaining:
            written = os.write(temporary_fd, remaining)
            if written <= 0:
                raise OSError("Managed file write made no progress")
            remaining = remaining[written:]

        os.fchmod(temporary_fd, mode)
        os.fsync(temporary_fd)
        os.replace(
            temporary_name,
            basename,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )

        destination_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(temporary_stat, destination_stat):
            raise PermissionError("Atomic write destination identity mismatch")
        os.fsync(parent_fd)
    finally:
        if temporary_fd is not None:
            os.close(temporary_fd)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
        os.close(parent_fd)


def _verify_owned_regular_file(
    file_stat: os.stat_result,
    label: str,
    *,
    expected_mode: int,
) -> None:
    """Verify a single-link regular file owned by the effective identity."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISREG(file_stat.st_mode):
        raise PermissionError(f"Managed file {safe_label} is not a regular file")
    if file_stat.st_uid != os.geteuid() or file_stat.st_gid != os.getegid():
        raise PermissionError(f"Managed file {safe_label} has unexpected ownership")
    if file_stat.st_nlink != 1:
        raise PermissionError(f"Managed file {safe_label} has multiple links")
    if stat.S_IMODE(file_stat.st_mode) != expected_mode:
        raise PermissionError(f"Managed file {safe_label} has unsafe permissions")


def _open_stable_lock_file(path: str) -> Any:
    """Open or create a stable managed lock inode without following links."""
    parent_fd, basename = _open_verified_parent(path)
    lock_fd: Optional[int] = None
    try:
        lock_fd = os.open(
            basename,
            LOCK_FILE_OPEN_FLAGS,
            0o600,
            dir_fd=parent_fd,
        )
        lock_stat = os.fstat(lock_fd)
        _verify_owned_regular_file(lock_stat, basename, expected_mode=0o600)
        current_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(lock_stat, current_stat):
            raise PermissionError("Managed lock file changed during open")
        os.fsync(parent_fd)
        handle = os.fdopen(lock_fd, "r+", encoding="utf-8")
        lock_fd = None
        return handle
    finally:
        if lock_fd is not None:
            os.close(lock_fd)
        os.close(parent_fd)


def _open_existing_managed_text_file(path: str) -> Optional[Any]:
    """Open an existing managed text file through its verified parent."""
    parent_fd, basename = _open_verified_parent(path)
    file_fd: Optional[int] = None
    try:
        try:
            file_fd = os.open(
                basename,
                READ_FILE_OPEN_FLAGS,
                dir_fd=parent_fd,
            )
        except FileNotFoundError:
            return None
        file_stat = os.fstat(file_fd)
        _verify_owned_regular_file(file_stat, basename, expected_mode=0o600)
        handle = os.fdopen(file_fd, "r", encoding="utf-8")
        file_fd = None
        return handle
    finally:
        if file_fd is not None:
            os.close(file_fd)
        os.close(parent_fd)


# Kernel interfaces for confined container entry. Python 3.10 has no os.setns,
# and glibc declares ptrace and prctl as variadic, so every call goes through
# syscall(2) with a fixed argument count. Only 64-bit x86_64 and aarch64 are
# supported; any other architecture fails closed.
ENTRY_SYSCALL_NUMBERS: Final[Mapping[str, Mapping[str, int]]] = {
    "x86_64": {"ptrace": 101, "prctl": 157, "setns": 308, "seccomp": 317},
    "aarch64": {"ptrace": 117, "prctl": 167, "setns": 268, "seccomp": 277},
}
SYSCALL_ARGUMENT_COUNT: Final = 6
PTRACE_DETACH: Final = 17
PTRACE_SEIZE: Final = 0x4206
PTRACE_INTERRUPT: Final = 0x4207
# __WALL: wait for a tracee that is not a child of the caller.
WAIT_ALL: Final = 0x40000000
SIGNAL_MAX: Final = 64
PTRACE_SECCOMP_GET_FILTER: Final = 0x420C
PR_CAPBSET_READ: Final = 23
PR_CAPBSET_DROP: Final = 24
PR_SET_CHILD_SUBREAPER: Final = 36
PR_SET_PDEATHSIG: Final = 1
SECCOMP_SET_MODE_FILTER: Final = 1
# The kernel limits one classic BPF program to BPF_MAXINSNS instructions.
BPF_MAXINSNS: Final = 4096
# MAX_INSNS_PER_PATH in kernel/seccomp.c bounds the instructions of all
# filters of a task, so it also bounds the filter index.
SECCOMP_MAX_INSNS_PER_PATH: Final = 32768
# PID_MAX_LIMIT on 64-bit kernels; a valid PID is always below it.
PID_MAX_LIMIT: Final = 4194304
# Capability numbers are bits in the 64-bit CapBnd mask.
CAPABILITY_MAX: Final = 63
# Namespace types in the only order that works for entry: the user namespace
# is last, because joining it drops the host capabilities that the other
# setns calls need.
CLONE_NEWNS: Final = 0x00020000
CLONE_NEWCGROUP: Final = 0x02000000
CLONE_NEWUTS: Final = 0x04000000
CLONE_NEWIPC: Final = 0x08000000
CLONE_NEWUSER: Final = 0x10000000
CLONE_NEWPID: Final = 0x20000000
CLONE_NEWNET: Final = 0x40000000
NAMESPACE_ENTRY_ORDER: Final[Tuple[Tuple[str, int], ...]] = (
    ("cgroup", CLONE_NEWCGROUP),
    ("ipc", CLONE_NEWIPC),
    ("uts", CLONE_NEWUTS),
    ("net", CLONE_NEWNET),
    ("pid", CLONE_NEWPID),
    ("mnt", CLONE_NEWNS),
    ("user", CLONE_NEWUSER),
)
_LIBC: Optional[Any] = None


class _SockFilter(ctypes.Structure):
    """struct sock_filter from linux/filter.h: one classic BPF instruction."""

    _fields_ = [
        ("code", ctypes.c_uint16),
        ("jt", ctypes.c_uint8),
        ("jf", ctypes.c_uint8),
        ("k", ctypes.c_uint32),
    ]


class _SockFprog(ctypes.Structure):
    """struct sock_fprog from linux/filter.h: a classic BPF program."""

    _fields_ = [
        ("len", ctypes.c_ushort),
        ("filter", ctypes.POINTER(_SockFilter)),
    ]


SOCK_FILTER_SIZE: Final = ctypes.sizeof(_SockFilter)


def _libc() -> Any:
    """Return the process C library, loaded once with errno capture."""
    global _LIBC
    if _LIBC is None:
        # CDLL(None) uses the symbols already loaded in this process. It does
        # not search library paths or run helper programs.
        libc = ctypes.CDLL(None, use_errno=True)
        libc.syscall.argtypes = [ctypes.c_long] * (SYSCALL_ARGUMENT_COUNT + 1)
        libc.syscall.restype = ctypes.c_long
        _LIBC = libc
    return _LIBC


def _entry_syscall_number(name: str) -> int:
    """Return the syscall number for this architecture, or fail closed."""
    machine = platform.machine()
    numbers = ENTRY_SYSCALL_NUMBERS.get(machine)
    if numbers is None or ctypes.sizeof(ctypes.c_void_p) != 8:
        raise OSError(
            errno.ENOSYS,
            f"Unsupported architecture for container entry: {_terminal_safe_repr(machine)}",
        )
    if name not in numbers:
        raise ValueError(f"Unsupported container entry syscall: {name!r}")
    return numbers[name]


def _require_int_in_range(value: Any, label: str, minimum: int, maximum: int) -> int:
    """Return value if it is an int (not bool) in the inclusive range."""
    if (
        not isinstance(value, int)
        or isinstance(value, bool)
        or value < minimum
        or value > maximum
    ):
        raise ValueError(f"Invalid {label}")
    return value


def _entry_syscall(name: str, *args: int) -> int:
    """Call one container entry syscall and raise OSError on failure."""
    number = _entry_syscall_number(name)
    if len(args) > SYSCALL_ARGUMENT_COUNT:
        raise ValueError(f"Too many arguments for {name}")
    for arg in args:
        # Each argument fits in a C long; pointers are passed as addresses.
        _require_int_in_range(arg, f"{name} argument", -(2**63), 2**63 - 1)
    padded = tuple(args) + (0,) * (SYSCALL_ARGUMENT_COUNT - len(args))
    result = _libc().syscall(number, *padded)
    if result == -1:
        err = ctypes.get_errno() or errno.EIO
        raise OSError(err, f"{name} failed: {os.strerror(err)}")
    return result


def _require_pid(pid: Any) -> int:
    """Return a validated positive process ID."""
    return _require_int_in_range(pid, "process ID", 1, PID_MAX_LIMIT - 1)


def _ptrace_seize(pid: int) -> None:
    """Attach to pid with PTRACE_SEIZE, which does not stop it or queue SIGSTOP."""
    _entry_syscall("ptrace", PTRACE_SEIZE, _require_pid(pid), 0, 0)


def _ptrace_interrupt(pid: int) -> None:
    """Ask a seized tracee to stop. The caller must wait for the stop."""
    _entry_syscall("ptrace", PTRACE_INTERRUPT, _require_pid(pid), 0, 0)


def _ptrace_detach(pid: int, signal_number: int = 0) -> None:
    """Detach from a stopped tracee and deliver signal_number, if not 0."""
    signal_number = _require_int_in_range(signal_number, "signal", 0, SIGNAL_MAX)
    _entry_syscall("ptrace", PTRACE_DETACH, _require_pid(pid), 0, signal_number)


def _ptrace_get_seccomp_filter(pid: int, index: int) -> bytes:
    """Return the classic BPF program of one seccomp filter of a stopped tracee.

    Index 0 is the oldest filter (measured on kernels 5.15, 6.8, and 6.12).
    OSError with ENOENT means that no filter exists at index.
    """
    pid = _require_pid(pid)
    index = _require_int_in_range(
        index, "seccomp filter index", 0, SECCOMP_MAX_INSNS_PER_PATH
    )
    count = _entry_syscall("ptrace", PTRACE_SECCOMP_GET_FILTER, pid, index, 0)
    _require_int_in_range(count, "seccomp filter length", 1, BPF_MAXINSNS)
    program = (_SockFilter * count)()
    copied = _entry_syscall(
        "ptrace",
        PTRACE_SECCOMP_GET_FILTER,
        pid,
        index,
        ctypes.addressof(program),
    )
    if copied != count:
        raise OSError(errno.EIO, "Seccomp filter length changed during read")
    return bytes(program)


def _capbset_read(capability: int) -> bool:
    """Return whether capability is in the calling thread's bounding set."""
    capability = _require_int_in_range(capability, "capability", 0, CAPABILITY_MAX)
    result = _entry_syscall("prctl", PR_CAPBSET_READ, capability, 0, 0, 0)
    if result not in (0, 1):
        raise OSError(errno.EIO, "Unexpected PR_CAPBSET_READ result")
    return result == 1


def _capbset_drop(capability: int) -> None:
    """Remove capability from the calling thread's bounding set."""
    capability = _require_int_in_range(capability, "capability", 0, CAPABILITY_MAX)
    _entry_syscall("prctl", PR_CAPBSET_DROP, capability, 0, 0, 0)


def _set_child_subreaper() -> None:
    """Make this process the reaper of orphaned descendants in its PID namespace."""
    _entry_syscall("prctl", PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)


def _set_parent_death_signal(signum: int) -> None:
    """Have the kernel send signum to this process when its parent thread exits."""
    _require_int_in_range(signum, "signal", 1, SIGNAL_MAX)
    _entry_syscall("prctl", PR_SET_PDEATHSIG, signum, 0, 0, 0)


def _setns(fd: int, nstype: int) -> None:
    """Join the namespace of fd; nstype must name exactly that namespace type."""
    fd = _require_int_in_range(fd, "namespace descriptor", 0, 2**31 - 1)
    # A zero nstype would accept any namespace type. Require an explicit one.
    if nstype not in {flag for _, flag in NAMESPACE_ENTRY_ORDER}:
        raise ValueError("Invalid namespace type")
    _entry_syscall("setns", fd, nstype)


def _seccomp_set_mode_filter(program: bytes) -> None:
    """Install one classic BPF seccomp program on the calling thread.

    No flags are passed, so the filter applies to this thread only. The caller
    must be single-threaded and hold CAP_SYS_ADMIN in its user namespace, or
    have set no_new_privs.
    """
    if not isinstance(program, bytes):
        raise ValueError("Seccomp program must be bytes")
    count, remainder = divmod(len(program), SOCK_FILTER_SIZE)
    if remainder or count < 1 or count > BPF_MAXINSNS:
        raise ValueError("Invalid seccomp program length")
    instructions = (_SockFilter * count).from_buffer_copy(program)
    fprog = _SockFprog(count, instructions)
    _entry_syscall(
        "seccomp",
        SECCOMP_SET_MODE_FILTER,
        0,
        ctypes.addressof(fprog),
    )


@contextmanager  # ensures flock acquisition/release is paired at the call site
def _lifecycle_lock(timeout: float = LIFECYCLE_LOCK_TIMEOUT) -> Iterator[None]:
    """Hold the global lifecycle lock exclusively, or fail after timeout.

    The cache directory must already exist. The kernel releases the flock when
    its holder exits, so a killed holder leaves no stale lock. A bounded wait
    keeps a holder that does not return from blocking every later caller.
    """
    lock_path = os.path.join(SYSTEMD_MACHINES, "sandy.__cache", LIFECYCLE_LOCK_FILENAME)
    lock_handle = _open_stable_lock_file(lock_path)
    try:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise TimeoutError(
                        "Timed out waiting for the Sandy lifecycle lock"
                    ) from None
                time.sleep(LIFECYCLE_LOCK_RETRY_INTERVAL)
        try:
            yield
        finally:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        lock_handle.close()


LEADER_PID_PATTERN: Final = re.compile(r"[1-9][0-9]{0,6}")
# Each attach runs in its own leaf cgroup in the container's scope, next to
# nspawn's payload and supervisor cgroups.
CGROUP_ROOT: Final = "/sys/fs/cgroup"
ATTACH_LEAF_PREFIX: Final = "attach-"
ATTACH_LEAF_PATTERN: Final = re.compile(r"attach-[0-9a-f]{32}")
ATTACH_LEAF_KILL_TIMEOUT: Final = 5
ATTACH_LEAF_POLL_INTERVAL: Final = 0.02
CGROUP_EVENTS_MAX_BYTES: Final = 4096
# While this empty cgroup exists in the scope of a container that up started
# without -d, the console has not exited yet, and no attach exit stops the
# container. up creates it under the lifecycle lock before any attach can
# exist; the console's own exit removes it.
CONSOLE_PENDING_CGROUP: Final = "console-pending"
CONSOLE_PENDING_TIMEOUT: Final = 5
CONSOLE_PENDING_POLL_INTERVAL: Final = 0.01
PROC_CGROUP_MAX_BYTES: Final = 4096
PROC_CGROUP_PATTERN: Final = re.compile(r"0::(/[^\n]*)\n")
CAPBND_LINE_PATTERN: Final = re.compile(r"CapBnd:\t([0-9a-f]{16})")
PROC_STATUS_MAX_BYTES: Final = 65536


class LeaderConfinement(NamedTuple):
    """Pinned Leader descriptors and the confinement read from the host side."""

    pidfd: int
    # One descriptor for each entry of NAMESPACE_ENTRY_ORDER, in that order.
    namespace_fds: Tuple[int, ...]
    # Oldest first, which is the order in which to install them.
    seccomp_filters: Tuple[bytes, ...]
    capability_bounding_set: int
    # cgroup.kill of the attach leaf that this process joined.
    attach_kill_fd: int


def _parse_leader_pid(value: str) -> int:
    """Parse a machine Leader PID from machinectl output."""
    if not isinstance(value, str) or not LEADER_PID_PATTERN.fullmatch(value):
        raise ValueError("Invalid container Leader PID")
    pid = _require_pid(int(value))
    # The host init is never the Leader of a container.
    if pid == 1:
        raise ValueError("Invalid container Leader PID")
    return pid


def _query_machine_leader(machine_name: str) -> int:
    """Return the Leader PID that systemd-machined reports for machine_name."""
    if not _validate_container_name(machine_name):
        raise ValueError("Invalid container name")
    result = _run_secure_subprocess(
        ["machinectl", "show", machine_name, "-p", "Leader", "--value"],
        capture_output=True,
        text=True,
        check=True,
    )
    output = result.stdout
    if output.endswith("\n"):
        output = output[:-1]
    return _parse_leader_pid(output)


def _parse_capability_bounding_set(status_text: str) -> int:
    """Return the CapBnd mask from /proc/<pid>/status text, or fail closed."""
    values = [line for line in status_text.split("\n") if line.startswith("CapBnd:")]
    if len(values) != 1:
        raise ValueError("Expected exactly one CapBnd line")
    match = CAPBND_LINE_PATTERN.fullmatch(values[0])
    if match is None:
        raise ValueError("Malformed CapBnd line")
    return int(match.group(1), 16)


def _read_capability_bounding_set(proc_fd: int) -> int:
    """Read CapBnd from the status file of an open host /proc/<pid> directory."""
    status_fd = os.open("status", READ_FILE_OPEN_FLAGS, dir_fd=proc_fd)
    try:
        chunks = []
        size = 0
        while True:
            chunk = os.read(status_fd, 4096)
            if not chunk:
                break
            size += len(chunk)
            if size > PROC_STATUS_MAX_BYTES:
                raise ValueError("Process status is too large")
            chunks.append(chunk)
    finally:
        os.close(status_fd)
    return _parse_capability_bounding_set(
        b"".join(chunks).decode("ascii", errors="replace")
    )


def _pidfd_process_alive(pidfd: int) -> bool:
    """Return whether the process of pidfd has not exited."""
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)
    # A pidfd becomes readable when its process exits. Any event means exit.
    return not poller.poll(0)


def _read_process_cgroup(proc_fd: int) -> str:
    """Return the cgroup v2 path of an open host /proc/<pid> directory."""
    cgroup_fd = os.open("cgroup", READ_FILE_OPEN_FLAGS, dir_fd=proc_fd)
    try:
        data = os.read(cgroup_fd, PROC_CGROUP_MAX_BYTES + 1)
    finally:
        os.close(cgroup_fd)
    text = data.decode("ascii", errors="replace")
    match = PROC_CGROUP_PATTERN.fullmatch(text)
    if len(data) > PROC_CGROUP_MAX_BYTES or match is None:
        raise ValueError("Malformed process cgroup (Sandy requires cgroup v2)")
    return match.group(1)


def _open_supervisor_cgroup(machine_name: str) -> int:
    """Open the cgroup directory of the container's scope.

    The path comes from the validated container name, not from container
    data. FileNotFoundError means that the scope does not exist.
    """
    unit = _supervisor_unit_name(machine_name)
    fd = os.open(CGROUP_ROOT, DIRECTORY_OPEN_FLAGS)
    try:
        root_dev = os.fstat(fd).st_dev
        for component in (SUPERVISOR_SLICE, unit):
            next_fd = os.open(component, DIRECTORY_OPEN_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            component_stat = os.fstat(fd)
            if component_stat.st_uid != 0 or component_stat.st_dev != root_dev:
                raise PermissionError(f"Unexpected cgroup directory {component}")
    except BaseException:
        os.close(fd)
        raise
    return fd


def _write_cgroup_file(dir_fd: int, name: str, value: bytes) -> None:
    """Write one value to a cgroup interface file of an open cgroup."""
    fd = os.open(name, os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        if os.write(fd, value) != len(value):
            raise OSError(f"Short write to cgroup {name}")
    finally:
        os.close(fd)


def _cgroup_populated(dir_fd: int) -> bool:
    """Return whether an open cgroup or any of its descendants has processes."""
    fd = os.open("cgroup.events", READ_FILE_OPEN_FLAGS, dir_fd=dir_fd)
    try:
        data = os.read(fd, CGROUP_EVENTS_MAX_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > CGROUP_EVENTS_MAX_BYTES:
        raise ValueError("Malformed cgroup.events")
    values = [
        line.split(" ")
        for line in data.decode("ascii", errors="replace").split("\n")
        if line
    ]
    if any(len(fields) != 2 for fields in values):
        raise ValueError("Malformed cgroup.events")
    populated = [fields[1] for fields in values if fields[0] == "populated"]
    if len(populated) != 1 or populated[0] not in ("0", "1"):
        raise ValueError("Malformed cgroup.events")
    return populated[0] == "1"


def _join_attach_leaf(machine_name: str, attach_leaf: str) -> int:
    """Create attach_leaf in the container's scope and move this process in.

    The caller holds the lifecycle lock. Return a descriptor for the leaf's
    cgroup.kill. The leaf is a sibling of nspawn's payload cgroup, so the
    container cannot see or change it.
    """
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    unit_fd = _open_supervisor_cgroup(machine_name)
    try:
        # The name is random; an existing entry is never reused.
        os.mkdir(attach_leaf, 0o755, dir_fd=unit_fd)
        leaf_fd: Optional[int] = None
        kill_fd: Optional[int] = None
        try:
            leaf_fd = os.open(attach_leaf, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
            kill_fd = os.open(
                "cgroup.kill",
                os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=leaf_fd,
            )
            # "0" moves the writing process.
            _write_cgroup_file(leaf_fd, "cgroup.procs", b"0")
        except BaseException:
            if kill_fd is not None:
                os.close(kill_fd)
            try:
                os.rmdir(attach_leaf, dir_fd=unit_fd)
            except OSError:
                pass
            raise
        finally:
            if leaf_fd is not None:
                os.close(leaf_fd)
    finally:
        os.close(unit_fd)
    return kill_fd


def _end_attach_leaf(unit_fd: int, attach_leaf: str) -> None:
    """Kill every process of attach_leaf, wait until it is empty, remove it."""
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    try:
        leaf_fd = os.open(attach_leaf, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
    except FileNotFoundError:
        return
    try:
        _write_cgroup_file(leaf_fd, "cgroup.kill", b"1")
        deadline = time.monotonic() + ATTACH_LEAF_KILL_TIMEOUT
        while _cgroup_populated(leaf_fd):
            if time.monotonic() >= deadline:
                raise TimeoutError("Attach cgroup did not become empty")
            time.sleep(ATTACH_LEAF_POLL_INTERVAL)
    except FileNotFoundError:
        # Another attach's count removed the leaf meanwhile. cgroupfs removes
        # only an empty cgroup, so nothing of this attach is left.
        return
    finally:
        os.close(leaf_fd)
    try:
        os.rmdir(attach_leaf, dir_fd=unit_fd)
    except FileNotFoundError:
        pass


def _remove_attach_leaf(machine_name: str, attach_leaf: str) -> None:
    """End and remove an attach leaf; do nothing when the scope is gone.

    When the scope stops, systemd kills its processes and removes the whole
    cgroup tree, leaves included.
    """
    try:
        unit_fd = _open_supervisor_cgroup(machine_name)
    except FileNotFoundError:
        return
    try:
        _end_attach_leaf(unit_fd, attach_leaf)
    finally:
        os.close(unit_fd)


def _count_populated_attaches(unit_fd: int) -> int:
    """Count the attach leaves that have processes; remove the empty ones.

    The caller holds the lifecycle lock. A helper creates and joins its leaf
    under that lock, so an empty leaf here belongs to an attach that ended,
    for example one whose sandy process got SIGKILL.
    """
    count = 0
    for name in os.listdir(unit_fd):
        if not ATTACH_LEAF_PATTERN.fullmatch(name):
            continue
        try:
            leaf_fd = os.open(name, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
        except FileNotFoundError:
            continue
        try:
            populated = _cgroup_populated(leaf_fd)
        finally:
            os.close(leaf_fd)
        if populated:
            count += 1
            continue
        try:
            os.rmdir(name, dir_fd=unit_fd)
        except OSError:
            pass
    return count


def _create_console_pending(machine_name: str) -> None:
    """Create the console-pending marker as soon as the scope's cgroup exists.

    The caller holds the lifecycle lock. Raise TimeoutError when the scope
    does not appear in time.
    """
    deadline = time.monotonic() + CONSOLE_PENDING_TIMEOUT
    while True:
        try:
            unit_fd = _open_supervisor_cgroup(machine_name)
            break
        except FileNotFoundError:
            if time.monotonic() >= deadline:
                raise TimeoutError("The container scope did not appear") from None
            time.sleep(CONSOLE_PENDING_POLL_INTERVAL)
    try:
        os.mkdir(CONSOLE_PENDING_CGROUP, 0o755, dir_fd=unit_fd)
    except FileExistsError:
        pass
    finally:
        os.close(unit_fd)


def _remove_console_pending(unit_fd: int) -> None:
    """Remove the console-pending marker of an open scope cgroup."""
    try:
        os.rmdir(CONSOLE_PENDING_CGROUP, dir_fd=unit_fd)
    except FileNotFoundError:
        pass


def _console_pending(unit_fd: int) -> bool:
    """Return whether the console-pending marker exists."""
    try:
        marker = os.stat(CONSOLE_PENDING_CGROUP, dir_fd=unit_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    return stat.S_ISDIR(marker.st_mode)


def _new_attach_leaf() -> str:
    """Return a new random attach leaf name."""
    return f"{ATTACH_LEAF_PREFIX}{secrets.token_hex(16)}"


def _stop_seized_tracee(pid: int) -> int:
    """Interrupt a seized tracee, wait for its stop, and return the detach signal."""
    _ptrace_interrupt(pid)
    _, status = os.waitpid(pid, WAIT_ALL)
    if not os.WIFSTOPPED(status):
        # A seized tracee reports only stops and its exit.
        raise ProcessLookupError("Container Leader exited during extraction")
    if status >> 16 == 0:
        # A signal-delivery-stop took the signal off the queue. Detach must
        # deliver it again, or the Leader loses it (for example, a poweroff).
        return os.WSTOPSIG(status)
    # A PTRACE_EVENT_STOP (the interrupt, or a group-stop) holds no signal.
    return 0


def _collect_seccomp_filters(pid: int) -> Tuple[bytes, ...]:
    """Read every seccomp filter of a stopped tracee, oldest first."""
    filters = []
    for index in range(SECCOMP_MAX_INSNS_PER_PATH + 1):
        try:
            filters.append(_ptrace_get_seccomp_filter(pid, index))
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                break
            raise
    else:
        raise OSError(errno.E2BIG, "Too many seccomp filters on container Leader")
    if not filters:
        # Sandy always starts the payload with a filter. None means that this
        # process is not a confined Sandy Leader.
        raise PermissionError("Container Leader has no seccomp filter")
    # Index 0 is the oldest filter, so index order is installation order
    # (measured on kernels 5.15, 6.8, and 6.12).
    return tuple(filters)


def _read_seccomp_filters(pid: int) -> Tuple[bytes, ...]:
    """Return the seccomp filters of pid, oldest first, and always detach.

    If the Leader never reaches a stop, it has exited. If an unexpected error
    leaves it seized, the caller must fail, and the tracer's exit removes the
    ptrace link.
    """
    _ptrace_seize(pid)
    detach_signal = _stop_seized_tracee(pid)
    try:
        filters = _collect_seccomp_filters(pid)
    except BaseException:
        try:
            _ptrace_detach(pid, detach_signal)
        except OSError:
            pass
        raise
    _ptrace_detach(pid, detach_signal)
    return filters


def _close_fds(fds: Tuple[int, ...]) -> None:
    """Close each descriptor, and ignore descriptors that are already closed."""
    for fd in fds:
        try:
            os.close(fd)
        except OSError:
            pass


def _close_leader_confinement(confinement: LeaderConfinement) -> None:
    """Close the descriptors of a LeaderConfinement."""
    _close_fds(
        (confinement.pidfd,) + confinement.namespace_fds + (confinement.attach_kill_fd,)
    )


def _extract_leader_confinement(
    machine_name: str, leader_pid: int, attach_leaf: str
) -> LeaderConfinement:
    """Pin the Leader, read its filters and CapBnd, and join the attach leaf.

    Hold the lifecycle lock for the whole extraction and for the creation of
    the leaf, so that a stop decision cannot interleave with a new attach.
    Every read uses the host /proc, before any setns, so the container cannot
    change what Sandy reads. The caller owns the returned descriptors.
    """
    pid = _require_pid(leader_pid)
    unit = _supervisor_unit_name(machine_name)
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    opened = []
    with _lifecycle_lock():
        try:
            pidfd = os.pidfd_open(pid)
            opened.append(pidfd)
            # The pidfd pins one process. Confirm that this process is the
            # Leader of the machine now, not a later user of the same PID.
            if _query_machine_leader(machine_name) != pid:
                raise PermissionError("Container Leader changed during extraction")
            proc_fd = os.open(f"/proc/{pid}", DIRECTORY_OPEN_FLAGS)
            try:
                namespace_fds = []
                for name, _ in NAMESPACE_ENTRY_ORDER:
                    # ns/<name> are kernel magic links, anchored at the pinned
                    # /proc/<pid> descriptor. setns checks the type later.
                    ns_fd = os.open(
                        f"ns/{name}", os.O_RDONLY | os.O_CLOEXEC, dir_fd=proc_fd
                    )
                    opened.append(ns_fd)
                    namespace_fds.append(ns_fd)
                seccomp_filters = _read_seccomp_filters(pid)
                capability_bounding_set = _read_capability_bounding_set(proc_fd)
                leader_cgroup = _read_process_cgroup(proc_fd)
            finally:
                os.close(proc_fd)
            # The process was alive from pidfd_open to here, so the PID
            # referred to it for every read above.
            if not _pidfd_process_alive(pidfd):
                raise ProcessLookupError("Container Leader exited during extraction")
            # Only host root can create cgroups outside the container's
            # delegated payload subtree. So a Leader below the payload of
            # the Sandy scope proves that the scope runs this container.
            payload = f"/{SUPERVISOR_SLICE}/{unit}/payload"
            if leader_cgroup != payload and not leader_cgroup.startswith(payload + "/"):
                raise PermissionError(
                    f"Container is not running in {unit}; restart it with this "
                    "version of Sandy"
                )
            attach_kill_fd = _join_attach_leaf(machine_name, attach_leaf)
        except BaseException:
            _close_fds(tuple(opened))
            raise
    return LeaderConfinement(
        pidfd=pidfd,
        namespace_fds=tuple(namespace_fds),
        seccomp_filters=seccomp_filters,
        capability_bounding_set=capability_bounding_set,
        attach_kill_fd=attach_kill_fd,
    )


# Internal mode for confined container entry. The parent starts it as
# [python, -I, /proc/self/fd/<pinned sandy>, ENTRY_HELPER_MODE, ...] with only
# stdin, stdout, stderr, and the pinned script descriptor open.
ENTRY_HELPER_MODE: Final = "__sandy-entry-helper"
ENTRY_HELPER_ARGC: Final = 11
ENTRY_HELPER_FAILURE: Final = 125
ENTRY_KIND_TTY: Final = "tty"
ENTRY_KIND_SH: Final = "sh"
ENTRY_COMMAND_MAX_BYTES: Final = 131072
ENTRY_MAX_GROUPS: Final = 64
CONTAINER_ACCOUNT_FILE_MAX_BYTES: Final = 1048576
# IDs inside the container's 65536-ID user namespace; 65535 is the overflow ID.
CONTAINER_ID_MAX: Final = 65534
CONTAINER_ID_PATTERN: Final = re.compile(r"0|[1-9][0-9]{0,4}")
PINNED_SCRIPT_PATTERN: Final = re.compile(r"/proc/self/fd/([3-9]|[1-9][0-9]{1,3})")
CAP_LAST_CAP_PATTERN: Final = re.compile(r"([0-9]{1,2})\n")
# On these the helper ends its whole attach. It ignores SIGINT and SIGQUIT
# while it waits, as system(3) does, because a terminal sends those to the
# whole foreground process group.
ENTRY_END_SIGNALS: Final = (signal.SIGHUP, signal.SIGTERM)
ENTRY_WAIT_IGNORED_SIGNALS: Final = (signal.SIGINT, signal.SIGQUIT)
# Python ignores SIGPIPE and SIGXFSZ, and an ignored signal stays ignored after
# execve. Restore the defaults, as subprocess does with restore_signals.
ENTRY_RESET_SIGNALS: Final = (
    signal.SIGHUP,
    signal.SIGINT,
    signal.SIGQUIT,
    signal.SIGTERM,
    signal.SIGPIPE,
    signal.SIGXFSZ,
)


class EntryRequest(NamedTuple):
    """Validated parameters of one confined container entry."""

    machine: str
    leader_pid: int
    # The sandy process that starts the helper, for the parent-death check.
    parent_pid: int
    attach_leaf: str
    user: str
    home: str
    workdir: str
    kind: str
    command: str


def _parse_container_id(value: str, label: str) -> int:
    """Parse a uid or gid inside the container user namespace."""
    if not isinstance(value, str) or not CONTAINER_ID_PATTERN.fullmatch(value):
        raise ValueError(f"Invalid container {label}")
    return _require_int_in_range(int(value), f"container {label}", 0, CONTAINER_ID_MAX)


def _account_file_entries(text: str, field_count: int, label: str) -> list:
    """Split passwd or group text into entries; reject malformed lines.

    Empty lines and lines that start with "#" are skipped, as nss_files does.
    """
    entries = []
    for line in text.split("\n"):
        if not line or line.startswith("#"):
            continue
        fields = line.split(":")
        if len(fields) != field_count:
            raise ValueError(f"Malformed container {label} entry")
        entries.append(fields)
    return entries


def _resolve_container_identity(
    user: str, passwd_text: str, group_text: str
) -> Tuple[int, int, Tuple[int, ...]]:
    """Return uid, gid, and supplementary groups for user, as nspawn sets them.

    Measured with systemd 249, 255, and 257: nspawn gives root no
    supplementary groups. For other users it sets exactly the groups that
    list the user as a member (getent initgroups), without the primary gid
    unless that group lists the user.
    """
    matches = [
        fields
        for fields in _account_file_entries(passwd_text, 7, "passwd")
        if fields[0] == user
    ]
    if len(matches) != 1:
        raise ValueError("Container user must have exactly one passwd entry")
    uid = _parse_container_id(matches[0][2], "uid")
    gid = _parse_container_id(matches[0][3], "gid")
    if (user == "root") != (uid == 0):
        raise ValueError("Container uid 0 must be the root user")
    groups: list = []
    for fields in _account_file_entries(group_text, 4, "group"):
        group_id = _parse_container_id(fields[2], "group")
        if user == "root" or user not in fields[3].split(","):
            continue
        if group_id not in groups:
            groups.append(group_id)
    if len(groups) > ENTRY_MAX_GROUPS:
        raise ValueError("Too many container groups")
    return uid, gid, tuple(groups)


def _read_container_account_file(path: str) -> str:
    """Read a regular account file inside the container's mount namespace.

    O_NONBLOCK keeps a FIFO from blocking the open; the file is then rejected.
    """
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOCTTY)
    try:
        file_stat = os.fstat(fd)
        if not stat.S_ISREG(file_stat.st_mode):
            raise ValueError(f"Container {path} is not a regular file")
        chunks = []
        size = 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            size += len(chunk)
            if size > CONTAINER_ACCOUNT_FILE_MAX_BYTES:
                raise ValueError(f"Container {path} is too large")
            chunks.append(chunk)
    finally:
        os.close(fd)
    return b"".join(chunks).decode("utf-8", "surrogateescape")


def _validate_container_path(path: str) -> bool:
    """Return whether path is a normalized absolute path inside the container."""
    if not isinstance(path, str) or not path.startswith("/") or len(path) > 4096:
        return False
    if _contains_control_character(path) or os.path.normpath(path) != path:
        return False
    # normpath keeps a leading "//", which POSIX leaves implementation-defined.
    return not path.startswith("//")


def _parse_entry_request(args: list) -> EntryRequest:
    """Parse the helper arguments that follow ENTRY_HELPER_MODE."""
    if len(args) != ENTRY_HELPER_ARGC - 2:
        raise ValueError("Invalid entry helper argument count")
    machine, leader, parent, attach_leaf, user, home, workdir, kind, command = args
    if not _validate_container_name(machine):
        raise ValueError("Invalid container name")
    if not isinstance(parent, str) or not LEADER_PID_PATTERN.fullmatch(parent):
        raise ValueError("Invalid parent PID")
    if not isinstance(attach_leaf, str) or not ATTACH_LEAF_PATTERN.fullmatch(
        attach_leaf
    ):
        raise ValueError("Invalid attach cgroup name")
    if not _validate_username(user):
        raise ValueError("Invalid container username")
    request = EntryRequest(
        machine=machine,
        leader_pid=_parse_leader_pid(leader),
        parent_pid=_require_pid(int(parent)),
        attach_leaf=attach_leaf,
        user=user,
        home=home,
        workdir=workdir,
        kind=kind,
        command=command,
    )
    expected_home = "/root" if user == "root" else f"/home/{user}"
    if home != expected_home:
        raise ValueError("Invalid container home directory")
    if not _validate_container_path(workdir):
        raise ValueError("Invalid container working directory")
    if kind not in (ENTRY_KIND_TTY, ENTRY_KIND_SH):
        raise ValueError("Invalid container entry kind")
    if not isinstance(command, str) or not command:
        raise ValueError("Invalid container command")
    if len(command.encode("utf-8", "surrogateescape")) > ENTRY_COMMAND_MAX_BYTES:
        raise ValueError("Container command is too long")
    return request


def _entry_request_args(request: EntryRequest) -> list:
    """Return the helper arguments for request; reject what the helper rejects."""
    args = [
        request.machine,
        str(request.leader_pid),
        str(request.parent_pid),
        request.attach_leaf,
        request.user,
        request.home,
        request.workdir,
        request.kind,
        request.command,
    ]
    # Build only what the helper accepts.
    if _parse_entry_request(args) != request:
        raise ValueError("Entry request does not survive helper argument parsing")
    return args


def _entry_helper_argv(script_fd: int, request: EntryRequest) -> list:
    """Return the argv that starts the entry helper for request."""
    args = _entry_request_args(request)
    return [
        sys.executable,
        "-I",
        _proc_self_fd_path(script_fd),
        ENTRY_HELPER_MODE,
    ] + args


def _entry_exec_argv(request: EntryRequest) -> list:
    """Return the in-container argv for request."""
    if request.kind == ENTRY_KIND_TTY:
        # script allocates a terminal from the container's devpts instance.
        return [
            "/bin/bash",
            "-c",
            f"script -qec {shlex.quote(request.command)} /dev/null",
        ]
    return ["/bin/sh", "-c", request.command]


def _open_fds() -> set:
    """Return the descriptors open in this process."""
    fds = set()
    # listdir uses a descriptor of its own, which is closed when it returns.
    for name in os.listdir("/proc/self/fd"):
        fd = int(name)
        try:
            os.fstat(fd)
        except OSError:
            continue
        fds.add(fd)
    return fds


def _verify_entry_helper_fds(script_path: str) -> int:
    """Require the pinned script descriptor and the standard streams only."""
    match = PINNED_SCRIPT_PATTERN.fullmatch(script_path)
    if match is None:
        raise PermissionError("Entry helper must run from a pinned script descriptor")
    script_fd = int(match.group(1))
    if _open_fds() != {0, 1, 2, script_fd}:
        raise PermissionError("Entry helper has unexpected file descriptors")
    _verify_entry_script(os.fstat(script_fd))
    return script_fd


def _verify_entry_script(script_stat: os.stat_result) -> None:
    """Require a regular script file that only its owner can write.

    The parent already runs this file as root, so its owner is trusted as
    much as the parent is. No other user may change it.
    """
    if not stat.S_ISREG(script_stat.st_mode) or script_stat.st_mode & 0o022:
        raise PermissionError(
            "Sandy script must be a regular file that only its owner can write"
        )


def _open_entry_script() -> int:
    """Open the running sandy script for the entry helper and verify it."""
    fd = os.open(os.path.realpath(__file__), READ_FILE_OPEN_FLAGS)
    try:
        _verify_entry_script(os.fstat(fd))
    except BaseException:
        os.close(fd)
        raise
    return fd


def _read_cap_last_cap() -> int:
    """Read the highest capability number from the host procfs."""
    fd = os.open("/proc/sys/kernel/cap_last_cap", READ_FILE_OPEN_FLAGS)
    try:
        data = os.read(fd, 16)
    finally:
        os.close(fd)
    match = CAP_LAST_CAP_PATTERN.fullmatch(data.decode("ascii", errors="replace"))
    if match is None:
        raise ValueError("Malformed cap_last_cap")
    return _require_int_in_range(int(match.group(1)), "cap_last_cap", 0, CAPABILITY_MAX)


CHILD_PIDS_PATTERN: Final = re.compile(r"(?:[1-9][0-9]{0,6} )*")


def _read_child_pids() -> Tuple[int, ...]:
    """Return the children of this process from the host procfs.

    The list includes children that have exited but are not reaped yet.
    """
    pid = os.getpid()
    fd = os.open(f"/proc/{pid}/task/{pid}/children", READ_FILE_OPEN_FLAGS)
    try:
        data = os.read(fd, 4096)
    finally:
        os.close(fd)
    text = data.decode("ascii", errors="replace")
    if len(data) >= 4096 or not CHILD_PIDS_PATTERN.fullmatch(text):
        raise ValueError("Malformed process children list")
    return tuple(_require_pid(int(value)) for value in text.split())


def _entry_error(exc: BaseException) -> None:
    """Report a container entry failure on stderr without control characters."""
    try:
        sys.stderr.write(
            f"E: Container entry failed: {_terminal_safe_repr(str(exc))}\n"
        )
        sys.stderr.flush()
    except (OSError, ValueError):
        pass


def _wait_ending_attach_on_signal(child: int, attach_kill_fd: int) -> int:
    """Wait for child; on SIGHUP or SIGTERM end the whole attach.

    SIGHUP means that the terminal is gone. SIGTERM also comes from the
    parent-death signal when the sandy process that started this helper
    exits. Both end every process in the attach leaf, this one included. If
    the kill fails, pass the signal on to the child.

    The caller blocks ENTRY_END_SIGNALS before it forks, so a signal that
    arrives before the handler exists stays pending until the unblock below.
    """

    def end_attach(signum: int, frame: Any) -> None:
        _ = frame
        try:
            os.write(attach_kill_fd, b"1")
        except OSError:
            try:
                os.kill(child, signum)
            except ProcessLookupError:
                pass

    for signum in ENTRY_END_SIGNALS:
        signal.signal(signum, end_attach)
    signal.pthread_sigmask(signal.SIG_UNBLOCK, ENTRY_END_SIGNALS)
    _, status = os.waitpid(child, 0)
    return status


def _propagate_wait_status(status: int) -> int:
    """Return the exit code of status, or end this process with its signal."""
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        signum = os.WTERMSIG(status)
        # SIGKILL cannot be caught or blocked, and signal.signal() rejects it.
        if signum != signal.SIGKILL:
            signal.signal(signum, signal.SIG_DFL)
            signal.pthread_sigmask(signal.SIG_UNBLOCK, {signum})
        os.kill(os.getpid(), signum)
        # The default action of this signal does not end the process.
        return min(128 + signum, 255)
    return ENTRY_HELPER_FAILURE


def _confine_and_exec(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> NoReturn:
    """In the container PID namespace: confine this process, then exec.

    Order: bounding set, then seccomp while still namespaced root (the filters
    need CAP_SYS_ADMIN, and no_new_privs stays 0 as on the up path), then the
    ids. The filters are installed oldest first. The account files are read
    at attach time, as su and nspawn do, and only after the filters are in
    place, because container root controls them.
    """
    try:
        mask = confinement.capability_bounding_set
        for capability in range(cap_last + 1):
            if not mask & (1 << capability):
                _capbset_drop(capability)
        for capability in range(cap_last + 1):
            if _capbset_read(capability) != bool(mask & (1 << capability)):
                raise PermissionError("Capability bounding set does not match")
        for program in confinement.seccomp_filters:
            _seccomp_set_mode_filter(program)
        uid, gid, groups = _resolve_container_identity(
            request.user,
            _read_container_account_file("/etc/passwd"),
            _read_container_account_file("/etc/group"),
        )
        os.setgroups(list(groups))
        os.setresgid(gid, gid, gid)
        os.setresuid(uid, uid, uid)
        os.chdir(request.workdir)
        argv = _entry_exec_argv(request)
        for signum in ENTRY_RESET_SIGNALS:
            signal.signal(signum, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_SETMASK, set())
        os.execve(argv[0], argv, dict(environment))
    except BaseException as exc:
        _entry_error(exc)
    os._exit(ENTRY_HELPER_FAILURE)


def _enter_namespaces_and_fork(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> NoReturn:
    """Middle process: join the pinned namespaces, fork, and exit.

    The child is the first process in the container's PID namespace. This
    process exits at once, so the child is reparented to the helper, which is
    a child subreaper. Until then this process is in the host PID namespace,
    so it must not keep host uid 0, and it must not run code from the
    container's filesystem.
    """
    code = ENTRY_HELPER_FAILURE
    try:
        # After setns(CLONE_NEWNS), an import would load a module from the
        # container's filesystem, which container root controls. Nothing below
        # imports; make any later import fail instead.
        sys.meta_path.clear()
        sys.path.clear()
        # Only the helper ends the attach leaf.
        _close_fds((confinement.attach_kill_fd,))
        for fd, (_, nstype) in zip(confinement.namespace_fds, NAMESPACE_ENTRY_ORDER):
            _setns(fd, nstype)
        # setns(CLONE_NEWUSER) keeps host uid 0, which may signal every host
        # root process from this PID namespace. Become container root, which
        # keeps the capabilities that the child needs in the container's user
        # namespace.
        os.setgroups([])
        os.setresgid(0, 0, 0)
        os.setresuid(0, 0, 0)
        _close_fds((confinement.pidfd,) + confinement.namespace_fds)
        # setns(CLONE_NEWPID) applies only to children.
        child = os.fork()
        if child == 0:
            _confine_and_exec(request, environment, confinement, cap_last)
        code = 0
    except BaseException as exc:
        _entry_error(exc)
    finally:
        os._exit(code)


def _run_confined_entry(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> int:
    """Start the session through the middle process, then wait for it.

    The helper is a child subreaper, so the session becomes its child when the
    middle process exits. Orphans inside the container go to the container's
    PID 1, not to the helper. The helper, the middle process, and the session
    are all in the attach leaf. The helper keeps only the leaf's cgroup.kill
    descriptor.
    """
    signal.pthread_sigmask(signal.SIG_BLOCK, ENTRY_END_SIGNALS)
    for signum in ENTRY_WAIT_IGNORED_SIGNALS:
        signal.signal(signum, signal.SIG_IGN)
    try:
        _set_child_subreaper()
        middle = os.fork()
    except OSError as exc:
        _close_leader_confinement(confinement)
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if middle == 0:
        _enter_namespaces_and_fork(request, environment, confinement, cap_last)
    _close_fds((confinement.pidfd,) + confinement.namespace_fds)
    _, middle_status = os.waitpid(middle, 0)
    if not os.WIFEXITED(middle_status) or os.WEXITSTATUS(middle_status) != 0:
        # The middle process failed before or at its fork and reported why.
        return _propagate_wait_status(middle_status)
    try:
        children = _read_child_pids()
    except (OSError, ValueError) as exc:
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if len(children) != 1:
        # These are this process's own unreaped children, so their PIDs
        # cannot have been reused.
        for pid in children:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        _entry_error(RuntimeError("Expected exactly one container session process"))
        return ENTRY_HELPER_FAILURE
    return _propagate_wait_status(
        _wait_ending_attach_on_signal(children[0], confinement.attach_kill_fd)
    )


def _entry_helper_main(argv: list) -> int:
    """Run the internal entry helper mode and return its exit code."""
    try:
        if os.geteuid() != 0:
            raise PermissionError("Entry helper requires root")
        # fork from a threaded interpreter is unsafe, and setns(CLONE_NEWUSER)
        # fails in a multithreaded process.
        if threading.active_count() != 1:
            raise RuntimeError("Entry helper must be single-threaded")
        if len(argv) < 2 or argv[1] != ENTRY_HELPER_MODE:
            raise ValueError("Invalid entry helper mode")
        script_fd = _verify_entry_helper_fds(argv[0])
        os.close(script_fd)
        request = _parse_entry_request(argv[2:])
        # End the attach when the sandy process that started this helper
        # exits for any reason, SIGKILL included. The parent may have exited
        # before the prctl; then this process has a new parent.
        _set_parent_death_signal(signal.SIGTERM)
        if os.getppid() != request.parent_pid:
            raise ProcessLookupError("Sandy exited before the entry helper started")
        environment = _container_environment(request.user, request.home)
        cap_last = _read_cap_last_cap()
        confinement = _extract_leader_confinement(
            request.machine, request.leader_pid, request.attach_leaf
        )
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if confinement.capability_bounding_set >> (cap_last + 1):
        _close_leader_confinement(confinement)
        _entry_error(PermissionError("CapBnd has unknown capabilities"))
        return ENTRY_HELPER_FAILURE
    return _run_confined_entry(request, environment, confinement, cap_last)


def _check_systemd_version():
    """Check systemd version and return version number"""
    try:
        result = _run_secure_subprocess(
            ["systemd-nspawn", "--version"], capture_output=True, text=True, check=True
        )
        # Parse version from output like "systemd 252 (252.19-1~deb12u1)"
        for line in result.stdout.split("\n"):
            if line.startswith("systemd "):
                version_str = line.split()[1]
                version = int(version_str.split(".")[0])
                return version
    except (subprocess.CalledProcessError, ValueError, IndexError) as e:
        print(f"W: Could not determine systemd version: {_terminal_safe_repr(str(e))}")

    print(
        "W: Could not determine systemd version, assuming older version where --private-users-ownership=auto not supported"
    )
    return 0  # Return 0 if version cannot be determined


def _create_guest_files(
    mdir: str,
    container_name: str,
    network_cidr: Optional[str] = None,
    gateway: Optional[str] = None,
):
    """Create /etc/hosts file and network initialization script for container"""
    hosts_path = os.path.join(mdir, "etc", "hosts")
    hosts_content = f"127.0.0.1 localhost {container_name}\n"
    print(f"I: Creating /etc/hosts with:\n{hosts_content}")
    _write(hosts_path, hosts_content, mode=0o0644)

    # nspawn's --timezone=auto is a bit non-deterministic, so unconditionally
    # create the file in the container so we can always call with
    # --timezone=bind and have something to bind on
    localtime_path = os.path.join(mdir, "etc", "localtime")
    if not os.path.exists(localtime_path):
        utc_host_path = "/usr/share/zoneinfo/UTC"
        localtime_content = ""
        if os.path.exists(utc_host_path):
            with open(utc_host_path, "r") as f:
                localtime_content = f.read()
            print(f"I: Copying {utc_host_path} from host to /etc/localtime in guest")
        else:
            print(f"I: Creating empty /etc/localtime in guest")
        _write(localtime_path, localtime_content, mode=0o0644)

    # Create network initialization script if network configuration is provided
    if network_cidr and gateway:
        # Validate network configuration for security
        if not _validate_network_cidr(network_cidr):
            print(
                f"W: Invalid network CIDR '{_strip_control_characters(network_cidr)}', skipping /init.sh creation"
            )
            return

        if not _validate_ip_address(gateway):
            print(
                f"W: Invalid gateway IP '{_strip_control_characters(gateway)}', skipping /init.sh creation"
            )
            return

        try:
            # Parse network to get available IPs
            network = ipaddress.ip_network(network_cidr)
        except (ValueError, ipaddress.AddressValueError) as e:
            print(
                "W: Invalid network configuration, skipping /init.sh creation: "
                f"{_terminal_safe_repr(str(e))}"
            )
            return

        # Find used IP addresses by scanning existing init.sh files
        used_ips = set()
        if os.path.exists(SYSTEMD_MACHINES):
            for container_dir in glob.glob(f"{SYSTEMD_MACHINES}/sandy.*"):
                # Skip cache directory
                if container_dir.endswith(".__cache"):
                    continue

                init_script = os.path.join(container_dir, "init.sh")
                if os.path.exists(init_script):
                    try:
                        with open(init_script, "r") as f:
                            content = f.read()
                        # Look for CONTAINER_IP variable
                        match = re.search(
                            r'CONTAINER_IP="(\d+\.\d+\.\d+\.\d+)"', content
                        )
                        if match:
                            used_ip = ipaddress.ip_address(match.group(1))
                            if used_ip in network:
                                used_ips.add(used_ip)
                    except (OSError, ValueError, ipaddress.AddressValueError):
                        # Skip files we can't read or parse
                        continue

        # Find first available IP starting from .10
        container_ip = None
        for i in range(
            10, 254
        ):  # Skip .1-.9 (reserved for gateway/infrastructure), .255 (broadcast)
            candidate_ip = network.network_address + i
            if candidate_ip not in used_ips and candidate_ip != ipaddress.ip_address(
                gateway
            ):
                container_ip = str(candidate_ip)
                break

        if container_ip is None:
            print(
                "W: No available IP addresses in network range, skipping /init.sh creation"
            )
            return

        init_script_path = os.path.join(mdir, "init.sh")
        # Extract network prefix (e.g., "24" from the CIDR)
        prefix_len = network.prefixlen
        init_script_content = f"""#!/bin/sh
set -e
# Container network initialization script
# Generated automatically by sandy

# Network configuration variables
CONTAINER_IP="{container_ip}"
NETWORK_PREFIX="{prefix_len}"
GATEWAY_IP="{gateway}"

# Wait for host0 interface to appear (max 10 seconds)
RETRY_COUNT=0
MAX_RETRIES=10
while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    if ip link show host0 >/dev/null 2>&1; then
        break
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
        echo "ERROR: host0 interface not found after $MAX_RETRIES seconds" >&2
        exit 1
    fi
    sleep 1
done

ip addr add ${{CONTAINER_IP}}/${{NETWORK_PREFIX}} dev host0
ip link set host0 up
ip route add default via ${{GATEWAY_IP}}
rm -f -- /etc/resolv.conf
printf '%s\\n' 'nameserver 1.1.1.1' 'nameserver 1.0.0.1' > /etc/resolv.conf
"""
        print(f"I: Creating /init.sh with:\n{init_script_content}")
        _write(init_script_path, init_script_content, mode=0o0755)


def _nft_port_rule_comment(container_name: str, proto: str, host_port: int) -> str:
    """Return the comment that marks the nftables rules of one port mapping."""
    if not _validate_container_name(container_name):
        raise ValueError("Invalid container name")
    if proto not in ("tcp", "udp"):
        raise ValueError("Invalid port mapping protocol")
    if (
        not isinstance(host_port, int)
        or isinstance(host_port, bool)
        or not 1 <= host_port <= 65535
    ):
        raise ValueError("Invalid port mapping host port")
    return f"sandy:{container_name}:{proto}:{host_port}"


def _parse_nft_rule_handles(output: str, chain: str, comment: str) -> list:
    """Return the handles of the rules in `nft -j -a list chain ip sandy <chain>`
    output whose comment is exactly comment. Reject malformed output."""
    if len(output) > NFT_LIST_MAX_BYTES:
        raise ValueError("nft output is too large")
    try:
        document = json.loads(output)
    except ValueError as exc:
        raise ValueError("nft output is not JSON") from exc
    items = document.get("nftables") if isinstance(document, dict) else None
    if not isinstance(items, list):
        raise ValueError("nft output has no nftables list")
    handles = []
    for item in items:
        if not isinstance(item, dict) or "rule" not in item:
            continue
        rule = item["rule"]
        if not isinstance(rule, dict):
            raise ValueError("Malformed nft rule")
        if rule.get("comment") != comment:
            continue
        if (rule.get("family"), rule.get("table"), rule.get("chain")) != (
            "ip",
            "sandy",
            chain,
        ):
            raise ValueError("nft rule from an unexpected chain")
        handle = rule.get("handle")
        if not isinstance(handle, int) or isinstance(handle, bool) or handle <= 0:
            raise ValueError("Malformed nft rule handle")
        handles.append(handle)
    return handles


class SandyNet:
    """Manages network bridge and NAT configuration for containers"""

    # Private networks to block for container isolation
    PRIVATE_NETWORKS = [
        "10.0.0.0/8",  # RFC 1918
        "172.16.0.0/12",  # RFC 1918
        "192.168.0.0/16",  # RFC 1918
        "169.254.0.0/16",  # Link-local
    ]

    # IPv6 private networks to block for container isolation
    IPV6_PRIVATE_NETWORKS = [
        "fe80::/10",  # Link-local addresses
        "fc00::/7",  # Unique local addresses
    ]

    def __init__(
        self,
        planned_network_info: Optional[NetworkInfo] = None,
        *,
        create: bool = True,
    ):
        """Detect the Sandy network, and create it when create is True.

        With create=False, only inspect the host: configured is True only
        when the bridge exists, and nothing is created or changed.
        """
        self.bridge_name = "sandybr0"
        self.network: Optional[str] = None
        self.network_cidr: Optional[str] = None
        self.gateway: Optional[str] = None
        self.configured = False

        # Detect firewall backend: prefer iptables, fallback to nftables
        self.has_iptables = shutil.which("iptables") is not None
        self.has_ip6tables = shutil.which("ip6tables") is not None
        self.has_nft = shutil.which("nft") is not None

        # Determine which firewall backend to use
        if self.has_iptables:
            self.firewall_backend = "iptables"
        elif self.has_nft:
            self.firewall_backend = "nftables"
            print("I: iptables not available, using nftables")
        else:
            print("E: Neither iptables nor nftables available")
            self.firewall_backend = None

        # Check if bridge already exists
        if self._bridge_exists():
            if self._detect_existing_config():
                self.configured = True
            else:
                print(f"W: Could not detect network config for existing bridge")
            return

        if not create:
            return

        # Create and configure new bridge
        if self._setup_bridge(planned_network_info):
            self.configured = True
            print(
                f"I: Created bridge with network: {self.network_cidr} gateway: {self.gateway}"
            )
        else:
            print(f"W: Failed to setup bridge network")

    @classmethod
    def preview_bridge_network(
        cls,
    ) -> Tuple[GuestNetwork, Optional[NetworkInfo]]:
        """Return lenient guest networking data without mutating host networking."""
        preview = object.__new__(cls)
        preview.bridge_name = "sandybr0"
        preview.network = None
        preview.network_cidr = None
        preview.gateway = None
        preview.configured = False
        preview.has_iptables = False
        preview.has_ip6tables = False
        preview.has_nft = False
        preview.firewall_backend = None

        if preview._bridge_exists():
            if preview._detect_existing_config():
                if (
                    not preview.network_cidr
                    or not preview.gateway
                    or not _validate_network_cidr(preview.network_cidr)
                    or not _validate_ip_address(preview.gateway)
                ):
                    raise PermissionError("Invalid Sandy network configuration")
                return (preview.network_cidr, preview.gateway), None
            raise PermissionError("Could not detect Sandy network configuration")

        planned_network_info = preview._find_unused_network()
        if planned_network_info is None:
            raise PermissionError("Could not find unused network in 10.0.0.0/8 range")
        network, network_cidr, gateway = planned_network_info
        if (
            not _validate_ip_address(network)
            or not _validate_network_cidr(network_cidr)
            or not _validate_ip_address(gateway)
        ):
            raise PermissionError("Invalid Sandy network plan")
        return (network_cidr, gateway), planned_network_info

    def _bridge_exists(self) -> bool:
        """Check if the bridge interface already exists"""
        try:
            result = _run_secure_subprocess(
                ["ip", "link", "show", self.bridge_name],
                capture_output=True,
                text=True,
                check=False,
            )
            return result.returncode == 0
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def _detect_existing_config(self) -> bool:
        """Detect network configuration of existing bridge"""
        return self._ensure_gateway()

    def _ensure_gateway(self) -> bool:
        """Ensure bridge gateway details are populated."""
        if self.gateway and self.network_cidr:
            return True

        try:
            result = _run_secure_subprocess(
                ["ip", "-j", "addr", "show", self.bridge_name],
                capture_output=True,
                text=True,
                check=True,
            )
        except subprocess.CalledProcessError as e:
            err_output = e.stderr or e.stdout or str(e)
            print(
                f"E: Failed to query bridge '{_strip_control_characters(self.bridge_name)}' address: {_terminal_safe_repr(str(err_output))}"
            )
            return False
        except Exception as e:
            print(
                f"E: Error querying bridge '{_strip_control_characters(self.bridge_name)}' address: {_terminal_safe_repr(str(e))}"
            )
            return False

        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError as e:
            print(
                f"E: Could not decode address data for '{_strip_control_characters(self.bridge_name)}': {_terminal_safe_repr(str(e))}"
            )
            return False

        for iface in data:
            if iface.get("ifname") != self.bridge_name:
                continue
            for addr in iface.get("addr_info", []):
                if addr.get("family") != "inet":
                    continue
                local = addr.get("local")
                prefixlen = addr.get("prefixlen")
                if not local or prefixlen is None:
                    continue
                try:
                    interface = ipaddress.ip_interface(f"{local}/{prefixlen}")
                except ValueError:
                    continue
                self.gateway = str(interface.ip)
                self.network = str(interface.network.network_address)
                self.network_cidr = str(interface.network)
                return True

        print(
            f"E: No IPv4 gateway detected for bridge '{_strip_control_characters(self.bridge_name)}'"
        )
        return False

    def _get_seed_from_machine_id(self) -> int:
        """Generate seed from /etc/machine-id"""
        try:
            with open("/etc/machine-id", "r") as f:
                machine_id = f.read().strip()
            # Use first 8 chars for seed (32-bit value)
            seed_str = machine_id[:8]
            return int(seed_str, 16)
        except (FileNotFoundError, ValueError):
            # Fallback to a default seed if machine-id is unavailable
            print("W: Could not read /etc/machine-id, using fallback seed")
            return 0xDEADBEEF

    def _check_network_conflict(self, network_cidr: str) -> bool:
        """Check if a network conflicts with existing routes or addresses"""

        try:
            test_net = ipaddress.ip_network(network_cidr)
        except Exception as e:
            print(f"W: Error checking network conflict: {_terminal_safe_repr(str(e))}")
            return True  # Assume conflict on error

        # Check routing table
        result = _run_secure_subprocess(
            ["ip", "route", "show"], capture_output=True, text=True, check=True
        )

        for line in result.stdout.split("\n"):
            if line.strip():
                # Parse network from route entry
                parts = line.split()
                if parts:
                    try:
                        # First part is usually the network
                        existing_net = ipaddress.ip_network(parts[0], strict=False)
                        if existing_net.overlaps(test_net):
                            return True
                    except ValueError:
                        # Not a valid network, skip
                        continue

        # Check existing addresses
        result = _run_secure_subprocess(
            ["ip", "addr", "show"], capture_output=True, text=True, check=True
        )

        for line in result.stdout.split("\n"):
            if "inet " in line:
                parts = line.strip().split()
                if len(parts) >= 2:
                    try:
                        existing_if = ipaddress.ip_interface(parts[1])
                        if existing_if.network.overlaps(test_net):
                            return True
                    except ValueError:
                        continue

        return False

    def _find_unused_network(self) -> Optional[Tuple[str, str, str]]:
        """Find an unused /24 network in 10.0.0.0/8 range"""
        seed = self._get_seed_from_machine_id()
        rng = random.Random(seed)

        # Try up to 100 different networks
        for _ in range(100):
            # Generate 10.{128-255}.{0-255}.0/24
            octet2 = rng.randint(128, 255)
            octet3 = rng.randint(0, 255)

            network = f"10.{octet2}.{octet3}.0"
            network_cidr = f"{network}/24"
            gateway = f"10.{octet2}.{octet3}.1"

            if not self._check_network_conflict(network_cidr):
                return (network, network_cidr, gateway)

        return None

    def _create_bridge(self) -> bool:
        """Create the bridge interface"""
        try:
            # Create bridge
            result = _run_secure_subprocess(
                ["ip", "link", "add", "name", self.bridge_name, "type", "bridge"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to create bridge: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            # Bring bridge up
            result = _run_secure_subprocess(
                ["ip", "link", "set", self.bridge_name, "up"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to bring bridge up: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            return True
        except Exception as e:
            print(f"E: Error creating bridge: {_terminal_safe_repr(str(e))}")
            return False

    def _configure_bridge_ip(self, gateway: str) -> bool:
        """Add IP address to the bridge"""
        try:
            # Add IP address
            result = _run_secure_subprocess(
                ["ip", "addr", "add", f"{gateway}/24", "dev", self.bridge_name],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to add IP to bridge: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            return True
        except Exception as e:
            print(f"E: Error configuring bridge IP: {_terminal_safe_repr(str(e))}")
            return False

    def _enable_ip_forwarding(self) -> bool:
        """Enable IP forwarding"""
        try:
            result = _run_secure_subprocess(
                ["sysctl", "-w", "net.ipv4.ip_forward=1"],
                capture_output=True,
                text=True,
                check=False,
            )
