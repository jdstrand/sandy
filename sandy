# Input validation functions
def _validate_container_name(name: str) -> bool:
    """Validate container name according to RFC hostname standards (for machinectl)"""
    if not name or len(name) > 63:  # RFC 1123 hostname length limit
        return False
    if name.startswith("-") or name.endswith("-"):  # Cannot start or end with hyphen
        return False
    # RFC hostname: start with letter, contain only letters, digits, hyphens
    # No underscores allowed in hostnames (unlike previous version)
    return (
        bool(re.fullmatch(r"^[a-z][a-z0-9-]*[a-z0-9]$", name))
        if len(name) > 1
        else bool(re.fullmatch(r"^[a-z]$", name))
    )


def _validate_username(username: str) -> bool:
    """Validate username according to strict POSIX/Linux standards"""
    if not username or len(username) > 32:  # Linux USERNAME_MAX is typically 32
        return False
    if username.startswith(
        "-"
    ):  # Cannot start with hyphen (could be mistaken for option)
        return False
    # Strict POSIX username: start with lowercase letter or underscore,
    # followed by lowercase letters, digits, underscores, or hyphens
    # Note: $ is allowed as final character for Samba machine accounts, but we exclude it for security
    return bool(re.fullmatch(r"^[a-z_][a-z0-9_-]*$", username))


def _validate_workspace_path(path: str) -> bool:
    """Validate workspace path to prevent directory traversal"""
    if not isinstance(path, str) or not path or len(path) > 4096:
        return False

    if any(char in path for char in ("\x00", "\n", "\r")):
        return False

    if os.path.isabs(path):
        return False

    # Check the original path components. Normalizing first would turn
    # "workspace/../secret" into "secret" and hide the traversal attempt.
    if ".." in path.split(os.sep):
        return False

    return True


def _strip_control_characters(message: str) -> str:
    """Return message text with C0, DEL, and C1 control characters removed."""
    return CONTROL_CHARACTER_PATTERN.sub("", str(message))


def _terminal_safe_repr(value: str) -> str:
    """Return an ASCII representation safe for terminal diagnostics."""
    return ascii(value)


def _contains_control_character(value: str) -> bool:
    """Return whether text contains a C0, DEL, or C1 control character."""
    return CONTROL_CHARACTER_PATTERN.search(value) is not None


def _finish_spinner_line(spinner_event: Optional[threading.Event], suffix: str = ""):
    """Ensure spinner line is closed exactly once with CRLF, optionally adding suffix."""
    if spinner_event and spinner_event.is_set():
        return

    if suffix:
        sys.stdout.write(suffix)
    sys.stdout.write("\r\n")
    sys.stdout.flush()

    if spinner_event:
        spinner_event.set()


def _write_held_output(held: io.StringIO) -> None:
    """Write the output that was held back while a lock was held, once."""
    text = held.getvalue()
    held.seek(0)
    held.truncate()
    if text:
        sys.stdout.write(text)
        sys.stdout.flush()


def _validate_env_var(
    value: str, allowed_values: set = set(), max_length: int = 256
) -> bool:
    """Validate environment variable value"""
    if not value:
        return False
    if len(value) > max_length:
        return False
    if allowed_values and value not in allowed_values:
        return False
    # Prevent dangerous characters in env vars
    if any(char in value for char in ["\x00", "\n", "\r"]):
        return False
    return True


def _validated_terminal_type() -> str:
    """Return the terminal type allowed to cross the container boundary."""
    terminal_type = os.environ.get("TERM")
    if terminal_type in (None, ""):
        return DEFAULT_CONTAINER_TERM
    if not TERMINAL_TYPE_PATTERN.fullmatch(terminal_type):
        raise ValueError("Invalid TERM environment variable")
    return terminal_type


def _container_environment(user: str, user_home: str) -> Dict[str, str]:
    """Build the complete allow-listed launch defaults for a container process.

    Container and user shell startup files may intentionally replace these
    defaults after entry.
    """
    if not _validate_username(user):
        raise ValueError("Invalid container username")

    expected_home = "/root" if user == "root" else f"/home/{user}"
    if user_home != expected_home:
        raise ValueError("Invalid container home directory")

    return {
        "HOME": expected_home,
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "LOGNAME": user,
        "PATH": CONTAINER_PATH,
        "SHELL": "/bin/bash",
        "SYSTEMD_COLORS": "0",
        "TERM": _validated_terminal_type(),
        "USER": user,
    }


def _validated_subprocess_environment(
    environment: Optional[Mapping[str, str]],
) -> Dict[str, str]:
    """Copy and validate an explicit subprocess environment."""
    if environment is None:
        raise ValueError("Subprocess environment is required")
    if len(environment) > 64:
        raise ValueError("Subprocess environment is too large")

    validated = {}
    for key, value in environment.items():
        if not isinstance(key, str) or not ENVIRONMENT_KEY_PATTERN.fullmatch(key):
            raise ValueError("Invalid subprocess environment key")
        if (
            not isinstance(value, str)
            or len(value) > 4096
            or any(character in value for character in ("\x00", "\n", "\r"))
        ):
            raise ValueError("Invalid subprocess environment value")
        validated[key] = value
    return validated


def _container_exit_code(status: int) -> int:
    """Convert a PTY process status into a portable CLI exit code."""
    if not isinstance(status, int) or isinstance(status, bool):
        return 1
    if status < 0:
        return min(128 + abs(status), 255)
    if status > 255:
        return 1
    return status


def _raise_for_container_status(status: int) -> None:
    """Exit the CLI when a container command did not succeed."""
    exit_code = _container_exit_code(status)
    if exit_code != 0:
        raise SystemExit(exit_code)


def _validate_image_name(image: str) -> bool:
    """Validate container image name"""
    if not image or len(image) > 128:
        return False
    # OCI image name validation (simplified)
    return bool(re.fullmatch(r"^[a-z][a-z0-9._:-]{0,127}$", image))


def _validate_network_cidr(cidr: str) -> bool:
    """Validate network CIDR notation"""
    try:
        network = ipaddress.ip_network(cidr, strict=True)
        # Only allow private networks for security
        return network.is_private
    except (ValueError, ipaddress.AddressValueError):
        return False


def _validate_ip_address(ip: str) -> bool:
    """Validate IP address"""
    try:
        addr = ipaddress.ip_address(ip)
        # Only allow private IP addresses for security
        return addr.is_private
    except (ValueError, ipaddress.AddressValueError):
        return False


def _validate_port_mapping(port_spec: str) -> Optional[Tuple[str, int, int]]:
    """
    Validate port mapping specification and return parsed tuple.

    Args:
        port_spec: String in format "proto:host_port:container_port"

    Returns:
        Tuple of (proto, host_port, container_port) or None if invalid
    """
    if not port_spec or not isinstance(port_spec, str):
        return None

    parts = port_spec.split(":")
    if len(parts) != 3:
        return None

    proto, host_port, container_port = parts

    # Validate protocol
    if proto not in ["tcp", "udp"]:
        return None

    # Validate ports are integers in valid range
    try:
        hport = int(host_port)
        cport = int(container_port)

        if not (1 <= hport <= 65535):
            return None
        if not (1 <= cport <= 65535):
            return None

        return (proto, hport, cport)
    except (ValueError, OverflowError):
        return None


def _validate_inherited_fds(pass_fds: Any) -> Tuple[int, ...]:
    """Validate descriptors deliberately inherited across a subprocess exec."""
    if pass_fds is None:
        return ()
    try:
        inherited_fds = tuple(pass_fds)
    except TypeError as exc:
        raise ValueError("Inherited file descriptors must be iterable") from exc

    seen = set()
    for fd in inherited_fds:
        if not isinstance(fd, int) or isinstance(fd, bool) or fd < 0 or fd in seen:
            raise ValueError("Invalid inherited file descriptor")
        os.fstat(fd)
        seen.add(fd)
    return inherited_fds


def _validate_subprocess_fd_policy(kwargs: Dict[str, Any]) -> None:
    """Validate explicit subprocess FD inheritance without broadening it."""
    if "pass_fds" not in kwargs:
        return

    inherited_fds = _validate_inherited_fds(kwargs["pass_fds"])
    if inherited_fds and kwargs.get("close_fds") is False:
        raise ValueError("Inherited file descriptors require close_fds=True")
    kwargs["pass_fds"] = inherited_fds


def _proc_self_fd_path(fd: int) -> str:
    """Return a Linux procfs path for an open descriptor after validating it."""
    _validate_inherited_fds((fd,))
    return f"/proc/self/fd/{fd}"


def _c_locale_environment() -> Dict[str, str]:
    """Return the environment of sandy with the C locale.

    Use it for a host command whose message text sandy parses, so that a
    translation cannot change that text.
    """
    environment = dict(os.environ)
    environment.pop("LANGUAGE", None)
    environment["LANG"] = "C"
    environment["LC_ALL"] = "C"
    return environment


def _run_secure_subprocess(cmd: list, **kwargs) -> subprocess.CompletedProcess:
    """Run subprocess with security hardening.

    Captured stdout and stderr are preserved verbatim. Callers that display
    command output must sanitize it at the terminal or log boundary.
    """
    if kwargs.get("shell") not in (None, False):
        raise ValueError("Shell execution is not permitted")
    kwargs["shell"] = False

    _validate_command_args(cmd)
    _validate_subprocess_fd_policy(kwargs)

    return subprocess.run(cmd, **kwargs)


def _run_secure_subprocess_popen(cmd: list, **kwargs) -> subprocess.Popen:
    """Run subprocess.Popen with security hardening"""
    if kwargs.get("shell") not in (None, False):
        raise ValueError("Shell execution is not permitted")
    kwargs["shell"] = False

    _validate_command_args(cmd)
    _validate_subprocess_fd_policy(kwargs)

    return subprocess.Popen(cmd, **kwargs)


def _validate_command_args(cmd: list):
    """Validate subprocess command arguments."""
    if not cmd or not all(isinstance(arg, str) and arg for arg in cmd):
        raise ValueError("Invalid command arguments")


class _EntrySetupError(Exception):
    """The entry helper could not be prepared, so no attach started.

    Examples: an unsafe cache directory, or a sandy script that others can
    write. The cause does not go away by itself, so callers do not retry.
    """


class _AttachHangup(Exception):
    """The terminal of an attach went away (SIGHUP) or sandy got SIGTERM."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


class _MachineQueryError(subprocess.SubprocessError):
    """machinectl failed, so sandy cannot tell whether a machine runs.

    A failed query must not look like a stopped container: rm, for example,
    then removed the image of a running one. main reports it and exits 1.
    """

    def __init__(self, machine_name: str, detail: str) -> None:
        super().__init__(
            f"Could not query machine '{machine_name}': {_terminal_safe_repr(detail)}"
        )
        self.machine_name = machine_name


class _DeferredSigint:
    """Hold back SIGINT in a section whose steps must stay together.

    While held, a SIGINT only records itself. release() puts the previous
    handler back and, when a SIGINT came meanwhile, runs that handler: the
    KeyboardInterrupt then comes at release(), inside a try that handles it.
    A child that execve starts gets the default action, as without the hold
    (a blocked signal mask would stay blocked in the child). Only the main
    thread can change a handler, so in another thread nothing is held.
    """

    def __init__(self) -> None:
        self._previous: Any = None
        self._held = False
        self._pending = False

    def hold(self) -> None:
        """Start to hold back SIGINT, when it is not held yet."""
        if self._held or threading.current_thread() is not threading.main_thread():
            return
        self._pending = False
        previous = signal.signal(signal.SIGINT, self._record)
        self._previous = signal.SIG_DFL if previous is None else previous
        self._held = True

    def _record(self, signum: int, frame: Any) -> None:
        _ = signum, frame
        self._pending = True

    def release(self, discard: bool = False) -> None:
        """Stop to hold back SIGINT; act on a held one unless discard."""
        if not self._held:
            return
        signal.signal(signal.SIGINT, self._previous)
        self._held = False
        pending, self._pending = self._pending, False
        if pending and not discard and callable(self._previous):
            self._previous(signal.SIGINT, None)


@contextmanager  # installs and restores the hangup handlers around an attach
def _attach_hangup_handlers() -> Iterator[None]:
    """Turn SIGHUP and SIGTERM into _AttachHangup in the main thread.

    After the first signal both stay ignored, so that the attach cleanup
    that follows is not interrupted.
    """
    if threading.current_thread() is not threading.main_thread():
        yield
        return

    def hangup(signum: int, frame: Any) -> None:
        _ = frame
        for other in ATTACH_HANGUP_SIGNALS:
            signal.signal(other, signal.SIG_IGN)
        raise _AttachHangup(signum)

    previous = {
        signum: signal.signal(signum, hangup) for signum in ATTACH_HANGUP_SIGNALS
    }
    hung_up = False
    try:
        yield
    except _AttachHangup:
        hung_up = True
        raise
    finally:
        if not hung_up:
            for signum, handler in previous.items():
                signal.signal(signum, handler)


def _close_inherited_fds(keep: Tuple[int, ...]) -> None:
    """Close every open descriptor except stdin, stdout, stderr, and keep.

    pty.fork() keeps each descriptor of the parent that has no close-on-exec
    flag, and execve keeps them too. subprocess closes them (close_fds=True);
    do the same, so that a child gets only what its caller passes. The entry
    helper refuses to run with any other descriptor.
    """
    for fd in sorted(_open_fds() - {0, 1, 2} - set(keep)):
        os.close(fd)


def _run_secure_subprocess_pty(
    cmd: list,
    *,
    environment: Mapping[str, str],
    master_read: Optional[Callable[[int], bytes]] = None,
    stdin_read: Optional[Callable[[int], bytes]] = None,
    pass_fds: Tuple[int, ...] = (),
) -> int:
    """Run a subprocess inside a PTY with argument validation and terminal size handling."""
    _validate_command_args(cmd)
    child_environment = _validated_subprocess_environment(environment)
    inherited_fds = _validate_inherited_fds(pass_fds)

    if master_read is None:
        raise ValueError("master_read must be callable")
    if stdin_read is None:
        raise ValueError("stdin_read must be callable")

    def set_winsize(fd: int):
        """Set PTY window size from current terminal size."""
        try:
            size = os.get_terminal_size()
            rows, cols = size.lines, size.columns
        except OSError:
            rows, cols = 24, 80
        winsize = struct.pack("HHHH", rows, cols, 0, 0)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, winsize)

    # Fork with PTY
    pid, master_fd = pty.fork()

    if pid == 0:
        # Child process - exec the command
        try:
            _close_inherited_fds(inherited_fds)
            for fd in inherited_fds:
                os.set_inheritable(fd, True)
            os.execvpe(cmd[0], cmd, child_environment)
        except OSError as exc:
            sys.stderr.write(
                "Failed to execute "
                f"{_terminal_safe_repr(cmd[0])}: {_terminal_safe_repr(str(exc))}\n"
            )
            os._exit(1)

    # Parent process - get the PTY peer path for signaling on resize
    pty_peer_path: Optional[str] = None
    try:
        buf = array.array("i", [0])
        fcntl.ioctl(master_fd, 0x80045430, buf)  # TIOCGPTN
        pty_peer_path = f"/dev/pts/{buf[0]}"
    except OSError:
        # Resize still works for outer PTY; just can't propagate to container
        pass

    def signal_pty_processes():
        """Find and signal all processes using the PTY peer (best-effort).

        Safe across containers: pty_peer_path is in the host's devpts namespace,
        so only processes with our specific host PTY are signaled.
        """
        if pty_peer_path is None:
            return
        for proc_pid in os.listdir("/proc"):
            if not proc_pid.isdigit():
                continue
            try:
                fd_dir = f"/proc/{proc_pid}/fd"
                for fd in os.listdir(fd_dir):
                    if os.readlink(f"{fd_dir}/{fd}") == pty_peer_path:
                        os.kill(int(proc_pid), signal.SIGWINCH)
                        break
            except (OSError, PermissionError):
                continue

    sigwinch_received = False

    def handle_sigwinch(signum, frame):
        _ = signum
        _ = frame
        nonlocal sigwinch_received
        sigwinch_received = True

    # Set initial window size
    set_winsize(master_fd)

    # Save and set terminal to raw mode
    old_settings = None
    try:
        old_settings = termios.tcgetattr(sys.stdin.fileno())
        tty.setraw(sys.stdin.fileno())
    except termios.error:
        pass

    # Only install SIGWINCH handler in main thread
    in_main_thread = threading.current_thread() is threading.main_thread()
    old_handler = None
    if in_main_thread:
        old_handler = signal.signal(signal.SIGWINCH, handle_sigwinch)

    try:
        stdin_fd = sys.stdin.fileno()
        while True:
            # Handle any pending SIGWINCH
            if sigwinch_received:
                sigwinch_received = False
                set_winsize(master_fd)
                signal_pty_processes()

            # Wait for data from stdin or master
            try:
                rfds, _, _ = select.select([stdin_fd, master_fd], [], [])
            except InterruptedError:
                continue

            if stdin_fd in rfds:
                data = stdin_read(stdin_fd)
                if data:
                    os.write(master_fd, data)

            if master_fd in rfds:
                try:
                    data = master_read(master_fd)
                    if data:
                        os.write(sys.stdout.fileno(), data)
                    else:
                        break
                except OSError:
                    break
    finally:
        if old_settings is not None:
            try:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSAFLUSH, old_settings)
            except termios.error:
                pass

        if in_main_thread and old_handler is not None:
            signal.signal(signal.SIGWINCH, old_handler)

        os.close(master_fd)

    # Wait for child and return exit status
    _, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    elif os.WIFSIGNALED(status):
        return -os.WTERMSIG(status)
    return -1


# Helper functions
def _managed_path_components(path: str, *, allow_managed_root: bool) -> Tuple[str, ...]:
    """Validate a normalized absolute path in Sandy's managed filesystem scope."""
    if (
        not isinstance(path, str)
        or not path
        or len(path) > 4096
        or _contains_control_character(path)
    ):
        raise ValueError("Invalid managed path")

    managed_root = os.path.normpath(SYSTEMD_MACHINES)
    if (
        not os.path.isabs(SYSTEMD_MACHINES)
        or SYSTEMD_MACHINES != managed_root
        or path != os.path.normpath(path)
        or not os.path.isabs(path)
    ):
        raise ValueError("Managed paths must be normalized absolute paths")

    root_components = tuple(
        component for component in managed_root.split(os.sep) if component
    )
    path_components = tuple(component for component in path.split(os.sep) if component)
    if path_components[: len(root_components)] != root_components:
        raise ValueError(f"Managed path is outside '{SYSTEMD_MACHINES}'")

    relative_components = path_components[len(root_components) :]
    if not relative_components:
        if not allow_managed_root:
            raise ValueError(f"Refusing to target managed root '{SYSTEMD_MACHINES}'")
        return path_components

    managed_name = relative_components[0]
    if not managed_name.startswith("sandy.") or len(managed_name) <= len("sandy."):
        raise ValueError("Managed path must begin with a Sandy-owned directory")

    return path_components


def _verify_owned_directory(directory_stat: os.stat_result, label: str) -> None:
    """Verify directory type, ownership, and non-writable trust boundary."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise PermissionError(f"Path component {safe_label} is not a directory")
    if directory_stat.st_uid != 0 or directory_stat.st_gid != 0:
        raise PermissionError(f"Directory {safe_label} has unexpected ownership")
    if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError(f"Directory {safe_label} is writable by other users")


def _verify_owned_symlink(link_stat: os.stat_result, label: str) -> None:
    """Verify that a symlink is an administrator-controlled filesystem entry."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISLNK(link_stat.st_mode):
        raise PermissionError(f"Path component {safe_label} is not a symlink")
    if link_stat.st_uid != 0 or link_stat.st_gid != 0:
        raise PermissionError(f"Symlink {safe_label} has unexpected ownership")


def _read_verified_symlink(
    parent_fd: int,
    component: str,
) -> Tuple[str, os.stat_result]:
    """Read a symlink through a pinned no-follow descriptor."""
    link_fd = os.open(
        component,
        PATH_OPEN_FLAGS,
        dir_fd=parent_fd,
    )
    try:
        link_stat = os.fstat(link_fd)
        _verify_owned_symlink(link_stat, component)
        target = os.readlink("", dir_fd=link_fd)
    finally:
        os.close(link_fd)

    if not target or len(target) > 4096 or _contains_control_character(target):
        safe_component = _terminal_safe_repr(component)
        raise PermissionError(f"Symlink {safe_component} has an invalid target")
    return target, link_stat


def _open_verified_host_directory(path: str) -> int:
    """Open a normalized host directory without following path-component links."""
    if (
        not isinstance(path, str)
        or not path
        or len(path) > 4096
        or not os.path.isabs(path)
        or path != os.path.normpath(path)
        or _contains_control_character(path)
    ):
        raise ValueError("Invalid host directory path")

    path_components = tuple(component for component in path.split(os.sep) if component)
    current_fd = os.open("/", DIRECTORY_OPEN_FLAGS)
    root_stat = os.fstat(current_fd)
    try:
        _verify_owned_directory(root_stat, "/")
        for component in path_components:
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    safe_component = _terminal_safe_repr(component)
                    raise PermissionError(
                        f"Unsafe managed path component {safe_component}"
                    ) from exc
                raise

            try:
                _verify_owned_directory(os.fstat(next_fd), component)
            except Exception:
                os.close(next_fd)
                raise
            os.close(current_fd)
            current_fd = next_fd

        if _same_inode(root_stat, os.fstat(current_fd)):
            raise PermissionError("Refusing to use the host root as a machine image")
        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_machine_image_symlink(managed_root_fd: int, managed_name: str) -> int:
    """Resolve systemd's documented administrator-controlled image symlink."""
    if managed_name == "sandy.__cache":
        raise PermissionError("The Sandy cache directory may not be a symlink")

    target, _ = _read_verified_symlink(managed_root_fd, managed_name)
    if os.path.isabs(target):
        target_path = os.path.normpath(target)
    else:
        target_path = os.path.normpath(os.path.join(SYSTEMD_MACHINES, target))

    # machinectl(1) explicitly supports image links in /var/lib/machines. The
    # one administrator-controlled image link is followed here, while target
    # path components and the shared cache remain strictly no-follow.
    managed_root = os.path.normpath(SYSTEMD_MACHINES)
    if target_path == managed_root or managed_root.startswith(f"{target_path}/"):
        raise PermissionError("Machine image symlink targets a managed-root ancestor")

    target_fd = _open_verified_host_directory(target_path)
    if _same_inode(os.fstat(target_fd), os.fstat(managed_root_fd)):
        os.close(target_fd)
        raise PermissionError("Machine image symlink targets the managed root")
    return target_fd


def _image_symlink_components(
    resolved_components: Tuple[str, ...],
    target: str,
    pending_components: Tuple[str, ...],
) -> Tuple[str, ...]:
    """Resolve symlink text with chroot-style semantics inside an image root."""
    if os.path.isabs(target):
        combined = []
    else:
        combined = list(resolved_components)

    for component in target.split(os.sep):
        if component in ("", "."):
            continue
        if component == "..":
            if combined:
                combined.pop()
            continue
        combined.append(component)

    combined.extend(pending_components)
    return tuple(combined)


def _open_image_directory(image_root_fd: int, components: Tuple[str, ...]) -> int:
    """Resolve an image directory while containing symlinks inside its root."""
    image_root_stat = os.fstat(image_root_fd)
    image_mount_id = _fd_mount_id(image_root_fd)
    current_fd = os.dup(image_root_fd)
    resolved_components: Tuple[str, ...] = ()
    pending_components = components
    symlink_count = 0

    try:
        while pending_components:
            component = pending_components[0]
            pending_components = pending_components[1:]
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno not in (errno.ELOOP, errno.ENOTDIR):
                    raise

                target, _ = _read_verified_symlink(current_fd, component)
                symlink_count += 1
                if symlink_count > MAX_SYMLINK_RESOLUTIONS:
                    raise PermissionError("Too many symlinks in machine image path")

                pending_components = _image_symlink_components(
                    resolved_components,
                    target,
                    pending_components,
                )
                os.close(current_fd)
                current_fd = os.dup(image_root_fd)
                resolved_components = ()
                continue

            try:
                next_stat = os.fstat(next_fd)
                _verify_owned_directory(next_stat, component)
                if next_stat.st_dev != image_root_stat.st_dev:
                    raise PermissionError(
                        "Refusing to cross an image filesystem boundary"
                    )
                if _fd_mount_id(next_fd) != image_mount_id:
                    raise PermissionError("Refusing to cross an image mount boundary")
            except Exception:
                os.close(next_fd)
                raise

            os.close(current_fd)
            current_fd = next_fd
            resolved_components = (*resolved_components, component)

        return current_fd
    except Exception:
        os.close(current_fd)
        raise


def _verify_owned_image_file(file_stat: os.stat_result, label: str) -> None:
    """Verify a contained image file before exposing it as a host bind source."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISREG(file_stat.st_mode):
        raise PermissionError(f"Image file {safe_label} is not a regular file")
    if file_stat.st_uid != os.geteuid() or file_stat.st_gid != os.getegid():
        raise PermissionError(f"Image file {safe_label} has unexpected ownership")
    if file_stat.st_nlink != 1:
        raise PermissionError(f"Image file {safe_label} has multiple links")
    if file_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError(f"Image file {safe_label} is writable by other users")


def _open_image_file(image_root_fd: int, components: Tuple[str, ...]) -> int:
    """Open a regular file through a pinned image root without following it."""
    if not components:
        raise ValueError("Image file path must include a file name")

    image_root_stat = os.fstat(image_root_fd)
    image_mount_id = _fd_mount_id(image_root_fd)
    parent_components = components[:-1]
    basename = components[-1]
    parent_fd = (
        _open_image_directory(image_root_fd, parent_components)
        if parent_components
        else os.dup(image_root_fd)
    )
    file_fd: Optional[int] = None
    try:
        try:
            file_fd = os.open(
                basename,
                IMAGE_FILE_OPEN_FLAGS,
                dir_fd=parent_fd,
            )
        except OSError as exc:
            if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                safe_basename = _terminal_safe_repr(basename)
                raise PermissionError(
                    f"Unsafe image file path component {safe_basename}"
                ) from exc
            raise

        file_stat = os.fstat(file_fd)
        _verify_owned_image_file(file_stat, basename)
        if file_stat.st_dev != image_root_stat.st_dev:
            raise PermissionError("Refusing to cross an image filesystem boundary")
        if _fd_mount_id(file_fd) != image_mount_id:
            raise PermissionError("Refusing to cross an image mount boundary")
        return file_fd
    except Exception:
        if file_fd is not None:
            os.close(file_fd)
        raise
    finally:
        os.close(parent_fd)


def _open_optional_image_file(
    image_root_fd: int,
    components: Tuple[str, ...],
) -> Optional[int]:
    """Open an optional image file, returning None only when it is absent."""
    try:
        return _open_image_file(image_root_fd, components)
    except FileNotFoundError:
        return None


def _parse_container_ip_from_init_fd(init_script_fd: int) -> Optional[str]:
    """Read CONTAINER_IP from a verified regular init script descriptor."""
    _validate_inherited_fds((init_script_fd,))
    raw_content = os.pread(init_script_fd, INIT_SCRIPT_MAX_BYTES + 1, 0)
    if len(raw_content) > INIT_SCRIPT_MAX_BYTES:
        raise PermissionError("Container init script is too large")
    try:
        content = raw_content.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise PermissionError("Container init script is not valid UTF-8") from exc

    match = re.search(
        r'(?m)^CONTAINER_IP="([0-9]{1,3}(?:\.[0-9]{1,3}){3})"$',
        content,
    )
    if not match:
        return None

    container_ip = match.group(1)
    if not _validate_ip_address(container_ip):
        raise PermissionError("Container init script contains an invalid IP address")
    return container_ip


def _read_machine_container_ip(machine_dir: str) -> Optional[str]:
    """Read CONTAINER_IP from the /init.sh of a managed machine image.

    Root in the container controls the image, so the file must be a regular
    file in the pinned image root, with no link, and only its first
    INIT_SCRIPT_MAX_BYTES are read. Return None when the image has no
    /init.sh or the file names no address.
    """
    machine_fd = _open_verified_dir(machine_dir)
    try:
        init_script_fd = _open_optional_image_file(machine_fd, ("init.sh",))
        if init_script_fd is None:
            return None
        try:
            return _parse_container_ip_from_init_fd(init_script_fd)
        finally:
            os.close(init_script_fd)
    finally:
        os.close(machine_fd)


def _create_init_bind_copy(
    init_script_fd: int,
    owner_uid: Optional[int] = None,
    owner_gid: Optional[int] = None,
) -> Tuple[str, str]:
    """Copy a verified init script into a private file nspawn can bind mount."""
    _validate_inherited_fds((init_script_fd,))
    if (owner_uid is None) != (owner_gid is None):
        raise PermissionError("Init bind copy owner must include uid and gid")
    if owner_uid is not None and (
        owner_uid < 0
        or owner_gid is None
        or owner_gid < 0
        or owner_uid > 0xFFFFFFFF
        or owner_gid > 0xFFFFFFFF
    ):
        raise PermissionError("Init bind copy owner is outside the uid/gid range")
    temporary_dir = tempfile.mkdtemp(prefix="sandy-init-")
    bind_path = os.path.join(temporary_dir, "init.sh")
    bind_fd: Optional[int] = None
    try:
        raw_content = os.pread(init_script_fd, INIT_SCRIPT_MAX_BYTES + 1, 0)
        if len(raw_content) > INIT_SCRIPT_MAX_BYTES:
            raise PermissionError("Container init script is too large")
        bind_fd = os.open(
            bind_path,
            TEMPORARY_FILE_OPEN_FLAGS,
            0o600,
        )
        remaining = memoryview(raw_content)
        while remaining:
            written = os.write(bind_fd, remaining)
            if written <= 0:
                raise OSError("Temporary init bind copy write made no progress")
            remaining = remaining[written:]
        if owner_uid is not None and owner_gid is not None:
            os.fchown(bind_fd, owner_uid, owner_gid)
        # Mode 0500 is intentional: the bind is read-only, and the owner maps
        # to container root either through an idmapped bind mount on modern
        # systemd or the fixed pre-250 private-user uid range. Avoid granting
        # group/world access to this transient host-side copy.
        os.fchmod(bind_fd, 0o500)
        os.fsync(bind_fd)
        return temporary_dir, bind_path
    except Exception:
        shutil.rmtree(temporary_dir, ignore_errors=True)
        raise
    finally:
        if bind_fd is not None:
            os.close(bind_fd)


def _remove_init_bind_copy(temporary_dir: str) -> None:
    """Remove the exact private temporary directory used for an init bind copy."""
    normalized_dir = os.path.normpath(temporary_dir)
    expected_parent = os.path.normpath(tempfile.gettempdir())
    basename = os.path.basename(normalized_dir)
    if os.path.dirname(normalized_dir) != expected_parent or not basename.startswith(
        "sandy-init-"
    ):
        raise PermissionError("Refusing to remove unexpected init bind directory")
    directory_stat = os.lstat(normalized_dir)
    if not stat.S_ISDIR(directory_stat.st_mode):
        raise PermissionError("Init bind copy path is not a directory")
    if directory_stat.st_uid != os.geteuid() or directory_stat.st_gid != os.getegid():
        raise PermissionError("Init bind copy directory has unexpected ownership")
    if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise PermissionError("Init bind copy directory has unsafe permissions")
    shutil.rmtree(normalized_dir)


def _read_keepalive_script(path: str) -> bytes:
    """Read the keepalive script that Sandy installs next to itself."""
    fd = os.open(path, READ_FILE_OPEN_FLAGS)
    try:
        # Sandy runs as root, so the owner of its own files is trusted as
        # much as Sandy is. No other user may change the script.
        _verify_entry_script(os.fstat(fd))
        content = os.pread(fd, KEEPALIVE_SCRIPT_MAX_BYTES + 1, 0)
    finally:
        os.close(fd)
    if not content or len(content) > KEEPALIVE_SCRIPT_MAX_BYTES:
        raise PermissionError("Keepalive script has an unexpected size")
    if not content.isascii() or b"\x00" in content:
        raise PermissionError("Keepalive script is not ASCII text")
    return content


def _create_keepalive_dir(script: bytes) -> str:
    """Create the private directory that nspawn binds at KEEPALIVE_MOUNT.

    It holds exactly a symlink to the image's bash and a copy of the script.
    The container resolves the symlink in its own mount namespace, so the
    host directory holds no binary. bash only reads the script, so the bind
    source may be noexec.
    """
    temporary_dir = tempfile.mkdtemp(prefix=KEEPALIVE_DIR_PREFIX)
    script_fd: Optional[int] = None
    try:
        os.symlink(KEEPALIVE_SHELL, os.path.join(temporary_dir, KEEPALIVE_LINK_NAME))
        script_fd = os.open(
            os.path.join(temporary_dir, KEEPALIVE_COPY_NAME),
            TEMPORARY_FILE_OPEN_FLAGS,
            0o600,
        )
        remaining = memoryview(script)
        while remaining:
            written = os.write(script_fd, remaining)
            if written <= 0:
                raise OSError("Keepalive script write made no progress")
            remaining = remaining[written:]
        # Container root reads the copy through a read-only bind. Below
        # systemd 250 host root maps to the overflow uid in the container, so
        # the copy must be world-readable.
        os.fchmod(script_fd, 0o644)
        os.fsync(script_fd)
        os.chmod(temporary_dir, 0o755)
        return temporary_dir
    except BaseException:
        shutil.rmtree(temporary_dir, ignore_errors=True)
        raise
    finally:
        if script_fd is not None:
            os.close(script_fd)


def _remove_keepalive_dir(temporary_dir: str) -> None:
    """Remove the exact keepalive directory and only its two known entries."""
    normalized_dir = os.path.normpath(temporary_dir)
    expected_parent = os.path.normpath(tempfile.gettempdir())
    basename = os.path.basename(normalized_dir)
    if os.path.dirname(normalized_dir) != expected_parent or not basename.startswith(
        KEEPALIVE_DIR_PREFIX
    ):
        raise PermissionError("Refusing to remove unexpected keepalive directory")
    directory_fd = os.open(normalized_dir, DIRECTORY_OPEN_FLAGS)
    try:
        directory_stat = os.fstat(directory_fd)
        if (
            directory_stat.st_uid != os.geteuid()
            or directory_stat.st_gid != os.getegid()
        ):
            raise PermissionError("Keepalive directory has unexpected ownership")
        if directory_stat.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise PermissionError("Keepalive directory has unsafe permissions")
        entries = set(os.listdir(directory_fd))
        if not entries <= {KEEPALIVE_LINK_NAME, KEEPALIVE_COPY_NAME}:
            raise PermissionError("Keepalive directory has unexpected entries")
        for name in sorted(entries):
            os.unlink(name, dir_fd=directory_fd)
    finally:
        os.close(directory_fd)
    os.rmdir(normalized_dir)


def _supervisor_unit_name(machine_name: str) -> str:
    """Return the name of the transient scope that runs a container."""
    if not _validate_container_name(machine_name):
        raise ValueError("Invalid container name")
    return f"{SUPERVISOR_UNIT_PREFIX}{machine_name}.scope"


def _supervisor_description(machine_name: str, detached: bool) -> str:
    """Return the scope description, which records how up started it."""
    mode = "detached" if detached else "attached"
    return f"Sandy container {machine_name} ({mode})"


class GroupLimits(NamedTuple):
    """Limits of sandy.slice, which all Sandy containers share.

    None means no limit.
    """

    # AllowedCPUs: the host keeps the other online CPUs.
    cpus: Tuple[int, ...]
    memory_max: Optional[int]
    tasks_max: Optional[int]


class SavedGroupLimits(NamedTuple):
    """The shared limits that root saved with update --shared.

    None means the default. A memory_max of 0 and a tasks_max of -1 mean no
    limit, as on the command line.
    """

    cpus: Optional[Tuple[int, ...]] = None
    memory_max: Optional[int] = None
    tasks_max: Optional[int] = None


class HostFacts(NamedTuple):
    """The host values that the default limits come from."""

    online_cpus: Tuple[int, ...]
    memory: int
    # The smallest of kernel.threads-max and kernel.pid_max.
    task_limit: int


class ResourceLimits(NamedTuple):
    """Limits of one container, inside the limits of sandy.slice."""

    # None means no process limit of its own.
    tasks_max: Optional[int]
    # None means the tmpfs default: half of the host memory.
    tmp_size: Optional[int]
    # None means that the container keeps the value of up.
    oom_score_adj: Optional[int]


def _parse_size_argument(value: str) -> int:
    """Parse a size in the syntax of docker run, such as 512m or 2g, to bytes."""
    match = SIZE_PATTERN.fullmatch(value)
    if match is None:
        raise argparse.ArgumentTypeError(
            f"invalid size {_terminal_safe_repr(value)}: use a number with an "
            "optional unit b, k, m, or g"
        )
    size = int(match.group(1)) * SIZE_UNITS[match.group(2).lower()]
    if size > SIZE_MAX:
        raise argparse.ArgumentTypeError(
            f"size {_terminal_safe_repr(value)} is too large"
        )
    return size


def _parse_memory_argument(value: str) -> int:
    """Parse --memory of update --shared: 0 (no limit) or at least 64m."""
    size = _parse_size_argument(value)
    if 0 < size < MEMORY_LIMIT_MIN:
        raise argparse.ArgumentTypeError(
            f"invalid memory limit {_terminal_safe_repr(value)}: the smallest "
            "limit is 64m (0: no limit)"
        )
    return size


def _parse_tmp_size_argument(value: str) -> int:
    """Parse --tmp-size: 0 (the tmpfs default) or at least 1m."""
    size = _parse_size_argument(value)
    if 0 < size < TMP_SIZE_MIN:
        raise argparse.ArgumentTypeError(
            f"invalid /tmp size {_terminal_safe_repr(value)}: the smallest size "
            "is 1m (0: the tmpfs default)"
        )
    return size


def _parse_pids_limit_argument(value: str) -> int:
    """Parse --pids-limit: -1 (no limit) or a positive number of tasks."""
    if PIDS_LIMIT_PATTERN.fullmatch(value) is None or int(value) >= PID_MAX_LIMIT:
        raise argparse.ArgumentTypeError(
            f"invalid process limit {_terminal_safe_repr(value)}: use -1 or a "
            f"number from 1 to {PID_MAX_LIMIT - 1}"
        )
    return int(value)


def _parse_oom_score_adj_argument(value: str) -> int:
    """Parse --oom-score-adj, from -999 to 1000.

    The kernel never kills a process with -1000, so a memory shortage in
    sandy.slice could then find no process to kill.
    """
    if OOM_SCORE_ADJ_PATTERN.fullmatch(value) is None or not (
        OOM_SCORE_ADJ_MIN <= int(value) <= OOM_SCORE_ADJ_MAX
    ):
        raise argparse.ArgumentTypeError(
            f"invalid OOM score adjustment {_terminal_safe_repr(value)}: use a "
            f"number from {OOM_SCORE_ADJ_MIN} to {OOM_SCORE_ADJ_MAX}"
        )
    return int(value)


def _parse_cpu_list(text: str) -> Tuple[int, ...]:
    """Parse a kernel CPU list, such as 0-3,8, to sorted CPU numbers."""
    if CPU_LIST_PATTERN.fullmatch(text) is None:
        raise ValueError("Malformed CPU list")
    cpus = set()
    for part in text.split(","):
        first, _, last = part.partition("-")
        low, high = int(first), int(last or first)
        if low > high or high > CPU_NUMBER_MAX:
            raise ValueError("Malformed CPU list")
        cpus.update(range(low, high + 1))
    return tuple(sorted(cpus))


def _parse_cpuset_argument(value: str) -> Tuple[int, ...]:
    """Parse --cpuset-cpus, a CPU list in the syntax of docker run."""
    if len(value) > CPU_LIST_MAX_BYTES:
        raise argparse.ArgumentTypeError("CPU list is too long")
    try:
        return _parse_cpu_list(value)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"invalid CPU list {_terminal_safe_repr(value)}: use CPU numbers and "
            "ranges, such as 4-15 or 0,2,4-7"
        ) from None


def _format_cpu_list(cpus: Tuple[int, ...]) -> str:
    """Return sorted CPU numbers as a kernel CPU list, such as 0-3,8."""
    parts = []
    start = previous = cpus[0]
    for cpu in cpus[1:] + (-1,):
        if cpu == previous + 1:
            previous = cpu
            continue
        parts.append(str(start) if start == previous else f"{start}-{previous}")
        start = previous = cpu
    return ",".join(parts)


def _read_small_text_file(path: str, max_bytes: int) -> str:
    """Read a whole kernel text file of at most max_bytes."""
    fd = os.open(path, READ_FILE_OPEN_FLAGS)
    try:
        data = os.read(fd, max_bytes + 1)
    finally:
        os.close(fd)
    if len(data) > max_bytes or not data.endswith(b"\n"):
        raise ValueError(f"Malformed {path}")
    return data[:-1].decode("ascii", errors="replace")


def _host_online_cpus() -> Tuple[int, ...]:
    """Return the online CPUs of the host."""
    return _parse_cpu_list(_read_small_text_file(ONLINE_CPUS_PATH, CPU_LIST_MAX_BYTES))


def _host_memory_bytes() -> int:
    """Return the physical memory of the host."""
    pages = os.sysconf("SC_PHYS_PAGES")
    page_size = os.sysconf("SC_PAGE_SIZE")
    if pages <= 0 or page_size <= 0:
        raise ValueError("Could not find the size of the host memory")
    return pages * page_size


def _host_task_limit() -> int:
    """Return the system task limit: the smaller of threads-max and pid_max.

    systemd computes its TasksMax percentages from the same limit.
    """
    limits = []
    for path in (THREADS_MAX_PATH, PID_MAX_PATH):
        text = _read_small_text_file(path, KERNEL_NUMBER_MAX_BYTES)
        if KERNEL_NUMBER_PATTERN.fullmatch(text) is None:
            raise ValueError(f"Malformed {path}")
        limits.append(int(text))
    return min(limits)


def _read_host_facts() -> HostFacts:
    """Return the host values for the limits, or exit with an error."""
    try:
        return HostFacts(_host_online_cpus(), _host_memory_bytes(), _host_task_limit())
    except (OSError, ValueError) as exc:
        print(
            "E: Could not read the CPUs, the memory, or the task limit of the "
            f"host: {_terminal_safe_repr(str(exc))}"
        )
        sys.exit(1)


def _default_group_limits(facts: HostFacts) -> GroupLimits:
    """Return the default limits that all Sandy containers share.

    The host keeps its 4 lowest-numbered CPUs when it has 16 or more, 2 when
    it has 8 or more, and 1 otherwise; the containers get at least 1 CPU.
    The host keeps 25% of its memory, at least 4 GiB, but never more than
    half. The containers get the same share of the system task limit, which
    grows with the memory too.
    """
    count = len(facts.online_cpus)
    if count >= 16:
        reserved = 4
    elif count >= 8:
        reserved = 2
    else:
        reserved = 1
    shared = max(1, count - reserved)
    reserve = min(
        max(facts.memory * HOST_MEMORY_RESERVE_PERCENT // 100, HOST_MEMORY_RESERVE_MIN),
        facts.memory // 2,
    )
    memory = (facts.memory - reserve) // MIB * MIB
    tasks = max(1, facts.task_limit * memory // facts.memory)
    return GroupLimits(facts.online_cpus[count - shared :], memory, tasks)


def _effective_group_limits(
    defaults: GroupLimits, saved: SavedGroupLimits
) -> GroupLimits:
    """Return the shared limits: the saved values, otherwise the defaults."""
    cpus = defaults.cpus if saved.cpus is None else saved.cpus
    memory_max = defaults.memory_max
    if saved.memory_max is not None:
        memory_max = saved.memory_max or None
    tasks_max = defaults.tasks_max
    if saved.tasks_max is not None:
        tasks_max = None if saved.tasks_max == -1 else saved.tasks_max
    return GroupLimits(cpus, memory_max, tasks_max)


def _parse_shared_limits(text: str, online_cpus: Tuple[int, ...]) -> SavedGroupLimits:
    """Parse the saved shared limits. Unknown fields are discarded.

    Raise ValueError for a malformed file or value: an up must not start a
    container with limits that root did not choose.
    """
    if not text:
        return SavedGroupLimits()
    try:
        data = json.loads(text)
    except (ValueError, RecursionError):
        # ValueError includes JSONDecodeError and the limit on the digits of
        # an int; deep nesting gives RecursionError.
        raise ValueError("The saved shared limits are not valid JSON") from None
    if not isinstance(data, dict):
        raise ValueError("The saved shared limits are not a JSON object")
    cpus = data.get("cpus")
    if cpus is not None:
        if not isinstance(cpus, str) or len(cpus) > CPU_LIST_MAX_BYTES:
            raise ValueError("The saved shared CPUs are invalid")
        try:
            cpus = _parse_cpu_list(cpus)
        except ValueError:
            raise ValueError("The saved shared CPUs are invalid") from None
        if not set(cpus) <= set(online_cpus):
            raise ValueError(
                f"The saved shared CPUs {_format_cpu_list(cpus)} are not all online"
            )
    memory = data.get("memory")
    if memory is not None and (
        type(memory) is not int
        or not (memory == 0 or MEMORY_LIMIT_MIN <= memory <= SIZE_MAX)
    ):
        raise ValueError("The saved shared memory is invalid")
    tasks = data.get("tasks")
    if tasks is not None and (
        type(tasks) is not int or not (tasks == -1 or 1 <= tasks < PID_MAX_LIMIT)
    ):
        raise ValueError("The saved shared process limit is invalid")
    return SavedGroupLimits(cpus, memory, tasks)


def _serialize_shared_limits(saved: SavedGroupLimits) -> str:
    """Return the JSON text of saved shared limits, with only the set fields."""
    data: Dict[str, Any] = {}
    if saved.cpus is not None:
        data["cpus"] = _format_cpu_list(saved.cpus)
    if saved.memory_max is not None:
        data["memory"] = saved.memory_max
    if saved.tasks_max is not None:
        data["tasks"] = saved.tasks_max
    return json.dumps(data, separators=(",", ":")) + "\n"


def _container_tasks_default(group: GroupLimits, task_limit: int) -> int:
    """Return the default process limit of one container.

    25% of the shared process limit, at least 8192, but never more than half
    of it, so that one container cannot use all the shared tasks. Without a
    shared limit, the base is the system task limit.
    """
    base = group.tasks_max or task_limit
    share = max(base * PIDS_LIMIT_DEFAULT_PERCENT // 100, PIDS_LIMIT_DEFAULT_MIN)
    return max(1, min(share, base // 2))


def _resolve_resource_limits(
    args: argparse.Namespace, group: GroupLimits, task_limit: int
) -> ResourceLimits:
    """Return the limits of one container from its options and the group.

    The parser has checked each value.
    """
    if args.pids_limit is None:
        tasks_max: Optional[int] = _container_tasks_default(group, task_limit)
    elif args.pids_limit == -1:
        tasks_max = None
    else:
        tasks_max = args.pids_limit
    if args.tmp_size is None:
        tmp_size: Optional[int] = TMP_SIZE_DEFAULT
    else:
        tmp_size = args.tmp_size or None
    return ResourceLimits(tasks_max, tmp_size, args.oom_score_adj)


def _pids_limit_warning(
    tasks_max: Optional[int], group_tasks_max: Optional[int]
) -> Optional[str]:
    """Return a warning for a process limit above the shared one, or None."""
    if tasks_max is None or group_tasks_max is None or tasks_max <= group_tasks_max:
        return None
    return (
        f"W: --pids-limit {tasks_max} is above the process limit that all Sandy "
        f"containers share ({group_tasks_max}), which applies too"
    )


def _limit_warnings(
    group: GroupLimits, limits: ResourceLimits, host_memory: int
) -> list:
    """Return the warnings for container limits above the shared limits."""
    warnings = []
    pids_warning = _pids_limit_warning(limits.tasks_max, group.tasks_max)
    if pids_warning is not None:
        warnings.append(pids_warning)
    tmp_size = host_memory // 2 if limits.tmp_size is None else limits.tmp_size
    if group.memory_max is not None and tmp_size > group.memory_max:
        # Measured: tmpfs pages count against the memory limit, and a write
        # past it gets an OOM kill instead of ENOSPC.
        warnings.append(
            f"W: /tmp ({_format_size(tmp_size)}) is larger than the memory that "
            f"all Sandy containers share ({_format_size(group.memory_max)}). "
            "Files in /tmp count against it, so a full /tmp ends processes"
        )
    return warnings


def _format_size(size: int) -> str:
    """Return size in GiB or MiB, for messages."""
    if size >= GIB:
        return f"{size / GIB:.1f} GiB"
    return f"{size / MIB:.1f} MiB"


def _times_text(count: int) -> str:
    """Return a number of times for messages."""
    return "1 time" if count == 1 else f"{count} times"


def _describe_group_limits(group: GroupLimits, saved: SavedGroupLimits) -> str:
    """Return one line that states the shared limits; mark the saved ones."""

    def mark(value: object) -> str:
        return "" if value is None else " (saved)"

    memory = (
        "no memory limit"
        if group.memory_max is None
        else f"memory {_format_size(group.memory_max)}"
    )
    tasks = (
        "no process limit" if group.tasks_max is None else f"{group.tasks_max} tasks"
    )
    return (
        f"CPUs {_format_cpu_list(group.cpus)}{mark(saved.cpus)}, "
        f"{memory}{mark(saved.memory_max)}, {tasks}{mark(saved.tasks_max)}"
    )


def _describe_resource_limits(limits: ResourceLimits, host_memory: int) -> str:
    """Return one line that states the limits of one container."""
    tasks = (
        "no process limit of its own"
        if limits.tasks_max is None
        else f"{limits.tasks_max} tasks"
    )
    tmp_size = host_memory // 2 if limits.tmp_size is None else limits.tmp_size
    text = f"{tasks}, /tmp {_format_size(tmp_size)}, no swap"
    if limits.oom_score_adj is not None:
        text += f", OOM score adjustment {limits.oom_score_adj}"
    return text


def _scope_limit_properties(limits: ResourceLimits) -> list:
    """Return the systemd-run --property options of limits.

    The container gets no swap. The memory and CPU limits are on
    sandy.slice.
    """
    tasks = "infinity" if limits.tasks_max is None else str(limits.tasks_max)
    return [f"--property=TasksMax={tasks}", "--property=MemorySwapMax=0"]


def _group_limit_properties(group: GroupLimits) -> list:
    """Return the systemctl set-property assignments of the shared limits."""

    def value(limit: Optional[int]) -> str:
        return "infinity" if limit is None else str(limit)

    return [
        f"AllowedCPUs={_format_cpu_list(group.cpus)}",
        f"MemoryMax={value(group.memory_max)}",
        f"TasksMax={value(group.tasks_max)}",
    ]


def _apply_group_limits(group: GroupLimits) -> None:
    """Set the shared limits on sandy.slice, also before it exists (measured).

    The values go to runtime drop-ins, which the next boot discards; Sandy
    saves the values of update --shared itself. A change applies at once to
    every running container too.
    """
    _run_secure_subprocess(
        [
            "systemctl",
            "set-property",
            "--runtime",
            SUPERVISOR_SLICE,
            *_group_limit_properties(group),
        ],
        check=True,
    )


def _parse_systemd_limit(text: str) -> Optional[int]:
    """Parse a MemoryMax or TasksMax value of systemctl show; None for infinity."""
    if text == "infinity":
        return None
    if SYSTEMD_LIMIT_PATTERN.fullmatch(text) is None:
        raise ValueError(f"Malformed limit of {SUPERVISOR_SLICE}")
    return int(text)


def _parse_systemd_cpu_list(text: str) -> Tuple[int, ...]:
    """Parse AllowedCPUs of systemctl show, such as 0-3 8; empty when unset.

    systemctl separates the ranges with spaces, not commas (measured on
    systemd 249, 255, and 257).
    """
    if not text:
        return ()
    if "," in text:
        raise ValueError(f"Malformed AllowedCPUs of {SUPERVISOR_SLICE}")
    return _parse_cpu_list(text.replace(" ", ","))


def _read_live_group_limits() -> GroupLimits:
    """Return the limits of sandy.slice now, from one systemctl show.

    A slice that does not exist has no limits: no CPUs in AllowedCPUs, and
    infinity for MemoryMax and TasksMax (measured).
    """
    command = ["systemctl", "show", SUPERVISOR_SLICE]
    for name in GROUP_LIMIT_PROPERTIES:
        command.extend(["-p", name])
    output = _run_secure_subprocess(
        command, capture_output=True, text=True, check=True
    ).stdout
    if len(output) > SYSTEMCTL_VALUE_MAX_LENGTH + CPU_LIST_MAX_BYTES:
        raise ValueError(f"Malformed limits of {SUPERVISOR_SLICE}")
    values: Dict[str, str] = {}
    for line in output.split("\n"):
        if not line:
            continue
        name, separator, value = line.partition("=")
        if (
            not separator
            or name not in GROUP_LIMIT_PROPERTIES
            or name in values
            or _contains_control_character(value)
        ):
            raise ValueError(f"Malformed limits of {SUPERVISOR_SLICE}")
        values[name] = value
    if len(values) != len(GROUP_LIMIT_PROPERTIES):
        raise ValueError(f"Malformed limits of {SUPERVISOR_SLICE}")
    return GroupLimits(
        _parse_systemd_cpu_list(values["AllowedCPUs"]),
        _parse_systemd_limit(values["MemoryMax"]),
        _parse_systemd_limit(values["TasksMax"]),
    )


def _sync_group_limits(group: GroupLimits) -> None:
    """Set the shared limits on sandy.slice unless it has them already.

    This also restores the limits after an outside change or a reboot, and
    follows a change of the host.
    """
    if _read_live_group_limits() != group:
        _apply_group_limits(group)


def _read_saved_group_limits(
    handle: Optional[Any], online_cpus: Tuple[int, ...]
) -> SavedGroupLimits:
    """Read the saved shared limits from an open file, or none without a file.

    Raise ValueError for a malformed file.
    """
    if handle is None:
        return SavedGroupLimits()
    try:
        text = handle.read(SHARED_LIMITS_MAX_BYTES + 1)
    except UnicodeDecodeError:
        raise ValueError("The saved shared limits are not valid text") from None
    if len(text) > SHARED_LIMITS_MAX_BYTES:
        raise ValueError("The saved shared limits are too large")
    return _parse_shared_limits(text, online_cpus)


def _tmp_tmpfs_argument(tmp_size: Optional[int]) -> str:
    """Return the nspawn --tmpfs option of /tmp with its size."""
    if tmp_size is None:
        return "--tmpfs=/tmp:mode=1777"
    return f"--tmpfs=/tmp:mode=1777,size={tmp_size}"


def _parse_oom_score_adj(text: str) -> int:
    """Parse the text of an oom_score_adj file, from -1000 to 1000."""
    if not text.endswith("\n") or OOM_SCORE_ADJ_PATTERN.fullmatch(text[:-1]) is None:
        raise ValueError("Malformed oom_score_adj")
    value = int(text[:-1])
    if not -1000 <= value <= OOM_SCORE_ADJ_MAX:
        raise ValueError("Malformed oom_score_adj")
    return value


def _write_own_oom_score_adj(value: int) -> None:
    """Set the OOM score adjustment of this process.

    As root, this also sets the lowest value that this process and its
    children can set later (measured: a container cannot go lower).
    """
    _write_oom_score_adj(OWN_OOM_SCORE_ADJ_PATH, value)


def _write_oom_score_adj(path: str, value: int, dir_fd: Optional[int] = None) -> None:
    """Write an OOM score adjustment to an oom_score_adj file."""
    fd = os.open(path, os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        data = f"{value}\n".encode("ascii")
        if os.write(fd, data) != len(data):
            raise OSError("Short write to oom_score_adj")
    finally:
        os.close(fd)


@contextmanager  # ensures the value is restored at the call site
def _oom_score_adj_for_children(value: Optional[int]) -> Iterator[None]:
    """Give the children that start meanwhile an OOM score adjustment.

    nspawn's --oom-score-adjust fails with --private-users (measured), so the
    container inherits the value from the process that starts it.
    """
    if value is None:
        yield
        return
    fd = os.open(OWN_OOM_SCORE_ADJ_PATH, READ_FILE_OPEN_FLAGS)
    try:
        original = _parse_oom_score_adj(
            os.read(fd, OOM_SCORE_ADJ_MAX_BYTES).decode("ascii", "replace")
        )
    finally:
        os.close(fd)
    _write_own_oom_score_adj(value)
    try:
        yield
    finally:
        try:
            _write_own_oom_score_adj(original)
        except OSError:
            # Only this sandy process keeps the value. Each later attach
            # sets its own value from the container (see _entry_helper_main).
            pass


def _supervisor_scope_argv(
    machine_name: str, systemd_version: int, detached: bool, limits: ResourceLimits
) -> list:
    """Return the systemd-run prefix that starts nspawn in its own scope.

    systemd-run --scope execs its command, so nspawn inherits the machine
    directory descriptor. machined sets TasksMax=16384 on the scopes that it
    creates, and a systemd-run scope gets DefaultTasksMax instead, so always
    set it. The scope holds the supervisor, the container, and every attach,
    so its limits cover all of them. Scope units accept OOMPolicy= only from
    systemd 253.
    """
    argv = [
        "systemd-run",
        "--scope",
        "--quiet",
        f"--unit={_supervisor_unit_name(machine_name)}",
        f"--slice={SUPERVISOR_SLICE}",
        f"--description={_supervisor_description(machine_name, detached)}",
        "--property=Delegate=yes",
    ]
    if systemd_version >= 253:
        argv.append("--property=OOMPolicy=continue")
    argv.extend(_scope_limit_properties(limits))
    argv.append("--")
    return argv


def _systemctl_show_value(
    unit: str, prop: str, timeout: float = QUERY_COMMAND_TIMEOUT
) -> str:
    """Return one property value of unit from systemctl show."""
    result = _run_secure_subprocess(
        ["systemctl", "show", unit, "-p", prop, "--value"],
        capture_output=True,
        text=True,
        check=True,
        timeout=timeout,
    )
    output = result.stdout
    if output.endswith("\n"):
        output = output[:-1]
    if len(output) > SYSTEMCTL_VALUE_MAX_LENGTH or _contains_control_character(output):
        raise ValueError(f"Malformed {prop} of {unit}")
    return output


def _supervisor_started_attached(machine_name: str) -> bool:
    """Return whether up started the container without -d, from its scope.

    Only the exact description that up sets without -d counts. Any other value
    (up -d, another description, or no scope) gives False, and then no attach
    exit stops the container. Only root can set the description of a system
    unit.
    """
    description = _systemctl_show_value(
        _supervisor_unit_name(machine_name), "Description"
    )
    return description == _supervisor_description(machine_name, detached=False)


def _query_timeout_until(deadline: float) -> float:
    """Return the timeout of a query or command that must end at deadline.

    It is at most QUERY_COMMAND_TIMEOUT, and at least
    CONTAINER_STOP_POLL_INTERVAL, so that a step at the deadline still gets
    one short chance.
    """
    return min(
        QUERY_COMMAND_TIMEOUT,
        max(deadline - time.monotonic(), CONTAINER_STOP_POLL_INTERVAL),
    )


def _supervisor_unit_loaded(
    machine_name: str, timeout: float = QUERY_COMMAND_TIMEOUT
) -> bool:
    """Return whether systemd knows the container's scope in any state."""
    load_state = _systemctl_show_value(
        _supervisor_unit_name(machine_name), "LoadState", timeout=timeout
    )
    if load_state == "not-found":
        return False
    if not UNIT_STATE_PATTERN.fullmatch(load_state):
        raise ValueError("Malformed LoadState of the container scope")
    return True


def _validate_container_ip_for_cidr(
    container_ip: str,
    network_cidr: Optional[str],
) -> str:
    """Verify a parsed container IP belongs to a known Sandy network."""
    if not _validate_ip_address(container_ip):
        raise PermissionError("Container init script contains an invalid IP address")
    if network_cidr:
        try:
            network = ipaddress.ip_network(network_cidr, strict=True)
            address = ipaddress.ip_address(container_ip)
        except ValueError as exc:
            raise PermissionError("Invalid Sandy network configuration") from exc
        if address not in network:
            raise PermissionError(
                "Container init script IP is outside the Sandy network"
            )
    return container_ip


def _open_verified_dir(path: str) -> int:
    """Open a managed directory with image-root-contained symlink resolution."""
    path_components = _managed_path_components(path, allow_managed_root=True)
    managed_root_components = tuple(
        component
        for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
        if component
    )
    relative_components = path_components[len(managed_root_components) :]

    current_fd = os.open("/", DIRECTORY_OPEN_FLAGS)
    root_stat = os.fstat(current_fd)
    try:
        _verify_owned_directory(root_stat, "/")
        for component in managed_root_components:
            try:
                next_fd = os.open(
                    component,
                    DIRECTORY_OPEN_FLAGS,
                    dir_fd=current_fd,
                )
            except OSError as exc:
                if exc.errno in (errno.ELOOP, errno.ENOTDIR):
                    safe_component = _terminal_safe_repr(component)
                    raise PermissionError(
                        f"Unsafe managed-root component {safe_component}"
                    ) from exc
                raise

            try:
                _verify_owned_directory(os.fstat(next_fd), component)
            except Exception:
                os.close(next_fd)
                raise
            os.close(current_fd)
            current_fd = next_fd

        if not relative_components:
            return current_fd

        managed_name = relative_components[0]
        try:
            image_fd = os.open(
                managed_name,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=current_fd,
            )
        except OSError as exc:
            if exc.errno not in (errno.ELOOP, errno.ENOTDIR):
                raise
            image_fd = _open_machine_image_symlink(current_fd, managed_name)
        else:
            try:
                image_stat = os.fstat(image_fd)
                _verify_owned_directory(image_stat, managed_name)
                if _same_inode(image_stat, root_stat):
                    raise PermissionError(
                        "Refusing to use the host root as a machine image"
                    )
            except Exception:
                os.close(image_fd)
                raise

        if len(relative_components) == 1:
            os.close(current_fd)
            return image_fd

        try:
            resolved_fd = _open_image_directory(
                image_fd,
                relative_components[1:],
            )
        finally:
            os.close(image_fd)
        os.close(current_fd)
        return resolved_fd
    except Exception:
        os.close(current_fd)
        raise


def _open_verified_parent(path: str) -> Tuple[int, str]:
    """Open a target's verified parent and return its descriptor and basename."""
    _managed_path_components(path, allow_managed_root=False)
    parent_path = os.path.dirname(path)
    basename = os.path.basename(path)
    return _open_verified_dir(parent_path), basename


def _container_name_from_machine_path(path: str) -> str:
    """Extract and validate a Sandy container name from a managed machine path."""
    path_components = _managed_path_components(path, allow_managed_root=False)
    managed_root_components = tuple(
        component
        for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
        if component
    )
    relative_components = path_components[len(managed_root_components) :]
    if len(relative_components) != 1:
        raise ValueError("Machine path is not a top-level Sandy container")

    basename = relative_components[0]
    prefix = "sandy."
    container_name = basename.removeprefix(prefix)
    if not _validate_container_name(container_name):
        raise ValueError("Machine path contains an invalid Sandy container name")
    return container_name


def _verify_safe_dir(path: str) -> None:
    """Verify a managed directory through contained descriptor resolution."""
    directory_fd = _open_verified_dir(path)
    os.close(directory_fd)


def _same_inode(first: os.stat_result, second: os.stat_result) -> bool:
    """Return whether two stat results identify the same filesystem object."""
    return first.st_dev == second.st_dev and first.st_ino == second.st_ino


def _fd_mount_id(fd: int) -> int:
    """Read and strictly validate the kernel mount ID for an open descriptor."""
    if not isinstance(fd, int) or isinstance(fd, bool) or fd < 0:
        raise ValueError("Invalid file descriptor")

    mount_id: Optional[int] = None
    with open(f"/proc/self/fdinfo/{fd}", "r", encoding="ascii") as fdinfo:
        for line in fdinfo:
            if not line.startswith("mnt_id:"):
                continue
            value = line.removeprefix("mnt_id:").strip()
            if (
                mount_id is not None
                or not value.isascii()
                or not value.isdecimal()
                or len(value) > 20
            ):
                raise PermissionError("Invalid descriptor mount metadata")
            mount_id = int(value)

    if mount_id is None or mount_id <= 0:
        raise PermissionError("Missing descriptor mount metadata")
    return mount_id


def _remove_directory_contents(
    directory_fd: int,
    root_device: int,
    root_mount_id: int,
) -> None:
    """Recursively remove entries relative to an already verified directory."""
    for entry in os.listdir(directory_fd):
        entry_stat = os.stat(entry, dir_fd=directory_fd, follow_symlinks=False)
        if stat.S_ISDIR(entry_stat.st_mode):
            if entry_stat.st_dev != root_device:
                raise PermissionError("Refusing to cross a filesystem boundary")

            child_fd = os.open(
                entry,
                DIRECTORY_OPEN_FLAGS,
                dir_fd=directory_fd,
            )
            try:
                opened_stat = os.fstat(child_fd)
                if not _same_inode(entry_stat, opened_stat):
                    raise PermissionError(
                        "Directory changed during descriptor-anchored removal"
                    )
                if _fd_mount_id(child_fd) != root_mount_id:
                    raise PermissionError("Refusing to cross a mount boundary")
                _remove_directory_contents(
                    child_fd,
                    root_device,
                    root_mount_id,
                )
            finally:
                os.close(child_fd)

            current_stat = os.stat(
                entry,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
            if not _same_inode(entry_stat, current_stat):
                raise PermissionError(
                    "Directory changed during descriptor-anchored removal"
                )
            os.rmdir(entry, dir_fd=directory_fd)
        else:
            entry_fd = os.open(
                entry,
                PATH_OPEN_FLAGS,
                dir_fd=directory_fd,
            )
            try:
                opened_stat = os.fstat(entry_fd)
                if not _same_inode(entry_stat, opened_stat):
                    raise PermissionError(
                        "Entry changed during descriptor-anchored removal"
                    )
                if _fd_mount_id(entry_fd) != root_mount_id:
                    raise PermissionError("Refusing to cross a mount boundary")
            finally:
                os.close(entry_fd)

            current_stat = os.stat(
                entry,
                dir_fd=directory_fd,
                follow_symlinks=False,
            )
            if not _same_inode(entry_stat, current_stat):
                raise PermissionError(
                    "Entry changed during descriptor-anchored removal"
                )
            os.unlink(entry, dir_fd=directory_fd)
    os.fsync(directory_fd)


def _remove_managed_tree(path: str) -> None:
    """Remove a Sandy-owned tree without post-verification path operations."""
    parent_fd, basename = _open_verified_parent(path)
    target_fd: Optional[int] = None
    try:
        target_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if stat.S_ISLNK(target_stat.st_mode):
            path_components = _managed_path_components(
                path,
                allow_managed_root=False,
            )
            managed_root_components = tuple(
                component
                for component in os.path.normpath(SYSTEMD_MACHINES).split(os.sep)
                if component
            )
            if (
                len(path_components) != len(managed_root_components) + 1
                or basename == "sandy.__cache"
            ):
                raise PermissionError("Refusing to remove a non-image managed symlink")

            _, opened_link_stat = _read_verified_symlink(parent_fd, basename)
            current_stat = os.stat(
                basename,
                dir_fd=parent_fd,
                follow_symlinks=False,
            )
            if not _same_inode(opened_link_stat, current_stat):
                raise PermissionError("Machine image symlink changed before removal")

            # Removing a systemd image link removes only Sandy's reference.
            # Recursively deleting its administrator-owned target would turn a
            # supported storage indirection into an unsafe deletion primitive.
            os.unlink(basename, dir_fd=parent_fd)
            os.fsync(parent_fd)
            return
        if not stat.S_ISDIR(target_stat.st_mode):
            raise PermissionError("Managed removal target is not a directory")
        _verify_owned_directory(target_stat, basename)

        target_fd = os.open(
            basename,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=parent_fd,
        )
        opened_stat = os.fstat(target_fd)
        if not _same_inode(target_stat, opened_stat):
            raise PermissionError("Managed removal target changed during open")
        parent_mount_id = _fd_mount_id(parent_fd)
        target_mount_id = _fd_mount_id(target_fd)
        if target_mount_id != parent_mount_id:
            raise PermissionError("Refusing to remove a mounted managed target")

        _remove_directory_contents(
            target_fd,
            opened_stat.st_dev,
            target_mount_id,
        )
        os.close(target_fd)
        target_fd = None

        current_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(opened_stat, current_stat):
            raise PermissionError("Managed removal target changed before removal")
        os.rmdir(basename, dir_fd=parent_fd)
        os.fsync(parent_fd)
    finally:
        if target_fd is not None:
            os.close(target_fd)
        os.close(parent_fd)


def _mkdir(path: str) -> None:
    """Create and verify a Sandy-owned directory relative to its parent."""
    parent_fd, basename = _open_verified_parent(path)
    created = False
    try:
        os.mkdir(basename, mode=0o700, dir_fd=parent_fd)
        created = True
        directory_fd = os.open(
            basename,
            DIRECTORY_OPEN_FLAGS,
            dir_fd=parent_fd,
        )
        try:
            _verify_owned_directory(os.fstat(directory_fd), basename)
        finally:
            os.close(directory_fd)
        os.fsync(parent_fd)
    except Exception:
        if created:
            try:
                os.rmdir(basename, dir_fd=parent_fd)
            except OSError:
                pass
        raise
    finally:
        os.close(parent_fd)


def _validate_existing_write_target(parent_fd: int, basename: str) -> None:
    """Reject unsafe existing destinations before atomic replacement."""
    try:
        destination_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
    except FileNotFoundError:
        return

    # Parent-directory symlinks have already been resolved inside the pinned
    # image root. The final destination is deliberately not followed: Sandy
    # owns this exact file, and following it would restore the host-write bug.
    if not stat.S_ISREG(destination_stat.st_mode):
        raise PermissionError("Existing write destination is not a regular file")
    if (
        destination_stat.st_uid != os.geteuid()
        or destination_stat.st_gid != os.getegid()
    ):
        raise PermissionError("Existing write destination has unexpected ownership")
    if destination_stat.st_nlink != 1:
        raise PermissionError("Existing write destination has multiple links")


# _write writes to a temporary file of this name in the directory of the
# target, and then renames it over the target.
WRITE_TEMPORARY_PATTERN: Final = re.compile(r"\.sandy-[0-9a-f]{32}\.tmp")


def _write(path: str, content: str, mode: int = 0o0600) -> None:
    """Atomically write a file relative to a verified managed directory."""
    if not isinstance(content, str):
        raise ValueError("Managed file content must be text")
    if not isinstance(mode, int) or isinstance(mode, bool) or mode < 0 or mode & ~0o777:
        raise ValueError("Invalid managed file mode")

    parent_fd, basename = _open_verified_parent(path)
    temporary_fd: Optional[int] = None
    temporary_name: Optional[str] = None
    try:
        _validate_existing_write_target(parent_fd, basename)

        for _ in range(16):
            candidate = f".sandy-{secrets.token_hex(16)}.tmp"
            try:
                temporary_fd = os.open(
                    candidate,
                    TEMPORARY_FILE_OPEN_FLAGS,
                    0o600,
                    dir_fd=parent_fd,
                )
                temporary_name = candidate
                break
            except FileExistsError:
                continue
        if temporary_fd is None or temporary_name is None:
            raise FileExistsError("Could not create an unpredictable temporary file")

        temporary_stat = os.fstat(temporary_fd)
        if (
            not stat.S_ISREG(temporary_stat.st_mode)
            or temporary_stat.st_uid != os.geteuid()
            or temporary_stat.st_gid != os.getegid()
            or temporary_stat.st_nlink != 1
        ):
            raise PermissionError("Temporary write destination failed validation")

        remaining = memoryview(content.encode("utf-8"))
        while remaining:
            written = os.write(temporary_fd, remaining)
            if written <= 0:
                raise OSError("Managed file write made no progress")
            remaining = remaining[written:]

        os.fchmod(temporary_fd, mode)
        os.fsync(temporary_fd)
        os.replace(
            temporary_name,
            basename,
            src_dir_fd=parent_fd,
            dst_dir_fd=parent_fd,
        )

        destination_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(temporary_stat, destination_stat):
            raise PermissionError("Atomic write destination identity mismatch")
        os.fsync(parent_fd)
    finally:
        if temporary_fd is not None:
            os.close(temporary_fd)
        if temporary_name is not None:
            try:
                os.unlink(temporary_name, dir_fd=parent_fd)
            except FileNotFoundError:
                pass
        os.close(parent_fd)


def _verify_owned_regular_file(
    file_stat: os.stat_result,
    label: str,
    *,
    expected_mode: int,
) -> None:
    """Verify a single-link regular file owned by the effective identity."""
    safe_label = _terminal_safe_repr(label)
    if not stat.S_ISREG(file_stat.st_mode):
        raise PermissionError(f"Managed file {safe_label} is not a regular file")
    if file_stat.st_uid != os.geteuid() or file_stat.st_gid != os.getegid():
        raise PermissionError(f"Managed file {safe_label} has unexpected ownership")
    if file_stat.st_nlink != 1:
        raise PermissionError(f"Managed file {safe_label} has multiple links")
    if stat.S_IMODE(file_stat.st_mode) != expected_mode:
        raise PermissionError(f"Managed file {safe_label} has unsafe permissions")


def _open_stable_lock_file(path: str) -> Any:
    """Open or create a stable managed lock inode without following links."""
    parent_fd, basename = _open_verified_parent(path)
    lock_fd: Optional[int] = None
    try:
        lock_fd = os.open(
            basename,
            LOCK_FILE_OPEN_FLAGS,
            0o600,
            dir_fd=parent_fd,
        )
        lock_stat = os.fstat(lock_fd)
        _verify_owned_regular_file(lock_stat, basename, expected_mode=0o600)
        current_stat = os.stat(
            basename,
            dir_fd=parent_fd,
            follow_symlinks=False,
        )
        if not _same_inode(lock_stat, current_stat):
            raise PermissionError("Managed lock file changed during open")
        os.fsync(parent_fd)
        handle = os.fdopen(lock_fd, "r+", encoding="utf-8")
        lock_fd = None
        return handle
    finally:
        if lock_fd is not None:
            os.close(lock_fd)
        os.close(parent_fd)


@contextmanager  # ensures flock acquisition/release is paired at the call site
def _locked_state_file(
    lock_path: str,
    state_path: str,
    exclusive: bool,
    timeout: Optional[float] = None,
    name: str = "state",
) -> Iterator[Optional[Any]]:
    """Hold a stable lock inode and yield its state file, or None without one.

    The state file opens only after the lock is held. Opening it before
    flock() would pin an obsolete inode while another holder atomically
    replaces the state path. Without a timeout, wait for the lock as long
    as it takes; with one, raise TimeoutError when it is not free in time.
    """
    lock_handle = _open_stable_lock_file(lock_path)
    state_handle = None
    try:
        lock_type = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
        if timeout is None:
            fcntl.flock(lock_handle.fileno(), lock_type)
        else:
            _flock_within(lock_handle.fileno(), lock_type, timeout, name)
        state_handle = _open_existing_managed_text_file(state_path)
        yield state_handle
    finally:
        if state_handle is not None:
            state_handle.close()
        try:
            fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lock_handle.close()


def _open_existing_managed_text_file(path: str) -> Optional[Any]:
    """Open an existing managed text file through its verified parent."""
    parent_fd, basename = _open_verified_parent(path)
    file_fd: Optional[int] = None
    try:
        try:
            file_fd = os.open(
                basename,
                READ_FILE_OPEN_FLAGS,
                dir_fd=parent_fd,
            )
        except FileNotFoundError:
            return None
        file_stat = os.fstat(file_fd)
        _verify_owned_regular_file(file_stat, basename, expected_mode=0o600)
        handle = os.fdopen(file_fd, "r", encoding="utf-8")
        file_fd = None
        return handle
    finally:
        if file_fd is not None:
            os.close(file_fd)
        os.close(parent_fd)


# Kernel interfaces for confined container entry and for the mounts of the
# workspace and shared directories. Python 3.10 has no os.setns or
# os.unshare, glibc declares ptrace and prctl as variadic, and glibc has no
# wrappers for the mount calls, so every call goes through syscall(2) with a
# fixed argument count. Only 64-bit x86_64 and aarch64 are supported; any
# other architecture fails closed.
# Syscall numbers from the Linux sources: x86_64 from
# arch/x86/entry/syscalls/syscall_64.tbl, and aarch64 from
# include/uapi/asm-generic/unistd.h. open_tree, move_mount, openat2, and
# mount_setattr have the same number on both architectures.
ENTRY_SYSCALL_NUMBERS: Final[Mapping[str, Mapping[str, int]]] = {
    "x86_64": {
        "ptrace": 101,
        "prctl": 157,
        "setns": 308,
        "seccomp": 317,
        "unshare": 272,
        "open_tree": 428,
        "move_mount": 429,
        "openat2": 437,
        "mount_setattr": 442,
    },
    "aarch64": {
        "ptrace": 117,
        "prctl": 167,
        "setns": 268,
        "seccomp": 277,
        "unshare": 97,
        "open_tree": 428,
        "move_mount": 429,
        "openat2": 437,
        "mount_setattr": 442,
    },
}
# syscall(2) passes at most six arguments.
SYSCALL_ARGUMENT_COUNT: Final = 6
# The values below come from the Linux UAPI headers named in each comment.
# They are part of the kernel ABI and are the same on x86_64 and aarch64.
# <linux/ptrace.h>: ptrace requests.
PTRACE_DETACH: Final = 17
PTRACE_SEIZE: Final = 0x4206
PTRACE_INTERRUPT: Final = 0x4207
PTRACE_SECCOMP_GET_FILTER: Final = 0x420C
# <linux/wait.h>: __WALL, wait for a tracee that is not a child of the caller.
WAIT_ALL: Final = 0x40000000
# _NSIG in the kernel: signal numbers are 1 to 64.
SIGNAL_MAX: Final = 64
# <linux/prctl.h>: prctl options.
PR_SET_PDEATHSIG: Final = 1
PR_CAPBSET_READ: Final = 23
PR_CAPBSET_DROP: Final = 24
PR_SET_CHILD_SUBREAPER: Final = 36
# <linux/seccomp.h>: the seccomp() operation that installs a filter.
SECCOMP_SET_MODE_FILTER: Final = 1
# <linux/bpf_common.h>: the kernel limits one classic BPF program to
# BPF_MAXINSNS instructions.
BPF_MAXINSNS: Final = 4096
# MAX_INSNS_PER_PATH in kernel/seccomp.c bounds the instructions of all
# filters of a task, so it also bounds the filter index.
SECCOMP_MAX_INSNS_PER_PATH: Final = 32768
# PID_MAX_LIMIT in include/linux/threads.h on 64-bit kernels; a valid PID is
# always below it.
PID_MAX_LIMIT: Final = 4194304
# Capability numbers are bits in the 64-bit CapBnd mask.
CAPABILITY_MAX: Final = 63
# <linux/sched.h>: the namespace type flags (CLONE_NEW*) that setns takes.
CLONE_NEWNS: Final = 0x00020000
CLONE_NEWCGROUP: Final = 0x02000000
CLONE_NEWUTS: Final = 0x04000000
CLONE_NEWIPC: Final = 0x08000000
CLONE_NEWUSER: Final = 0x10000000
CLONE_NEWPID: Final = 0x20000000
CLONE_NEWNET: Final = 0x40000000
# Namespace types in the only order that works for entry: the user namespace
# is last, because joining it drops the host capabilities that the other
# setns calls need.
NAMESPACE_ENTRY_ORDER: Final[Tuple[Tuple[str, int], ...]] = (
    ("cgroup", CLONE_NEWCGROUP),
    ("ipc", CLONE_NEWIPC),
    ("uts", CLONE_NEWUTS),
    ("net", CLONE_NEWNET),
    ("pid", CLONE_NEWPID),
    ("mnt", CLONE_NEWNS),
    ("user", CLONE_NEWUSER),
)
# The values below are part of the kernel ABI and are the same on x86_64 and
# aarch64. <fcntl.h> and <linux/fcntl.h>: AT_FDCWD and AT_EMPTY_PATH.
AT_FDCWD: Final = -100
AT_EMPTY_PATH: Final = 0x1000
# <linux/mount.h>: open_tree, move_mount, and the mount_setattr attributes.
OPEN_TREE_CLONE: Final = 1
OPEN_TREE_CLOEXEC: Final = os.O_CLOEXEC
MOVE_MOUNT_F_EMPTY_PATH: Final = 0x4
MOVE_MOUNT_T_EMPTY_PATH: Final = 0x40
MOUNT_ATTR_NOSUID: Final = 0x2
MOUNT_ATTR_NODEV: Final = 0x4
MOUNT_ATTR_IDMAP: Final = 0x100000
# <linux/mount.h>: the propagation type of mount_attr.propagation. A private
# mount is not a peer of any other mount.
MS_PRIVATE: Final = 1 << 18
# <linux/openat2.h>: openat2 resolve flags.
RESOLVE_NO_MAGICLINKS: Final = 0x02
RESOLVE_NO_SYMLINKS: Final = 0x04
RESOLVE_IN_ROOT: Final = 0x10
_LIBC: Optional[Any] = None


class _SockFilter(ctypes.Structure):
    """struct sock_filter from linux/filter.h: one classic BPF instruction."""

    _fields_ = [
        ("code", ctypes.c_uint16),
        ("jt", ctypes.c_uint8),
        ("jf", ctypes.c_uint8),
        ("k", ctypes.c_uint32),
    ]


class _SockFprog(ctypes.Structure):
    """struct sock_fprog from linux/filter.h: a classic BPF program."""

    _fields_ = [
        ("len", ctypes.c_ushort),
        ("filter", ctypes.POINTER(_SockFilter)),
    ]


SOCK_FILTER_SIZE: Final = ctypes.sizeof(_SockFilter)


class _MountAttr(ctypes.Structure):
    """struct mount_attr from linux/mount.h, version 0 (32 bytes)."""

    _fields_ = [
        ("attr_set", ctypes.c_uint64),
        ("attr_clr", ctypes.c_uint64),
        ("propagation", ctypes.c_uint64),
        ("userns_fd", ctypes.c_uint64),
    ]


class _OpenHow(ctypes.Structure):
    """struct open_how from linux/openat2.h, version 0 (24 bytes)."""

    _fields_ = [
        ("flags", ctypes.c_uint64),
        ("mode", ctypes.c_uint64),
        ("resolve", ctypes.c_uint64),
    ]


def _libc() -> Any:
    """Return the process C library, loaded once with errno capture."""
    global _LIBC
    if _LIBC is None:
        # CDLL(None) uses the symbols already loaded in this process. It does
        # not search library paths or run helper programs.
        libc = ctypes.CDLL(None, use_errno=True)
        libc.syscall.argtypes = [ctypes.c_long] * (SYSCALL_ARGUMENT_COUNT + 1)
        libc.syscall.restype = ctypes.c_long
        _LIBC = libc
    return _LIBC


def _entry_syscall_number(name: str) -> int:
    """Return the syscall number for this architecture, or fail closed."""
    machine = platform.machine()
    numbers = ENTRY_SYSCALL_NUMBERS.get(machine)
    if numbers is None or ctypes.sizeof(ctypes.c_void_p) != 8:
        raise OSError(
            errno.ENOSYS,
            f"Unsupported architecture for container entry: {_terminal_safe_repr(machine)}",
        )
    if name not in numbers:
        raise ValueError(f"Unsupported container entry syscall: {name!r}")
    return numbers[name]


def _require_int_in_range(value: Any, label: str, minimum: int, maximum: int) -> int:
    """Return value if it is an int (not bool) in the inclusive range."""
    if (
        not isinstance(value, int)
        or isinstance(value, bool)
        or value < minimum
        or value > maximum
    ):
        raise ValueError(f"Invalid {label}")
    return value


def _entry_syscall(name: str, *args: int) -> int:
    """Call one container entry syscall; return its non-negative result.

    Every failure raises OSError, so a caller never needs to check the result
    for an error. A caller that uses the result (a length or a flag) checks
    its range itself.
    """
    number = _entry_syscall_number(name)
    if len(args) > SYSCALL_ARGUMENT_COUNT:
        raise ValueError(f"Too many arguments for {name}")
    for arg in args:
        # Each argument fits in a C long; pointers are passed as addresses.
        _require_int_in_range(arg, f"{name} argument", -(2**63), 2**63 - 1)
    padded = tuple(args) + (0,) * (SYSCALL_ARGUMENT_COUNT - len(args))
    result = _libc().syscall(number, *padded)
    if result == -1:
        # syscall(2) reports every error as -1 and sets errno.
        err = ctypes.get_errno() or errno.EIO
        raise OSError(err, f"{name} failed: {os.strerror(err)}")
    if result < 0:
        # No syscall used here returns another negative value. Fail closed.
        raise OSError(errno.EIO, f"{name} returned an unexpected value")
    return result


def _require_pid(pid: Any) -> int:
    """Return a validated positive process ID."""
    return _require_int_in_range(pid, "process ID", 1, PID_MAX_LIMIT - 1)


def _ptrace_seize(pid: int) -> None:
    """Attach to pid with PTRACE_SEIZE, which does not stop it or queue SIGSTOP."""
    _entry_syscall("ptrace", PTRACE_SEIZE, _require_pid(pid), 0, 0)


def _ptrace_interrupt(pid: int) -> None:
    """Ask a seized tracee to stop. The caller must wait for the stop."""
    _entry_syscall("ptrace", PTRACE_INTERRUPT, _require_pid(pid), 0, 0)


def _ptrace_detach(pid: int, signal_number: int = 0) -> None:
    """Detach from a stopped tracee and deliver signal_number, if not 0."""
    signal_number = _require_int_in_range(signal_number, "signal", 0, SIGNAL_MAX)
    _entry_syscall("ptrace", PTRACE_DETACH, _require_pid(pid), 0, signal_number)


def _ptrace_get_seccomp_filter(pid: int, index: int) -> bytes:
    """Return the classic BPF program of one seccomp filter of a stopped tracee.

    Index 0 is the oldest filter (measured on kernels 5.15, 6.8, and 6.12).
    OSError with ENOENT means that no filter exists at index.
    """
    pid = _require_pid(pid)
    index = _require_int_in_range(
        index, "seccomp filter index", 0, SECCOMP_MAX_INSNS_PER_PATH
    )
    count = _entry_syscall("ptrace", PTRACE_SECCOMP_GET_FILTER, pid, index, 0)
    _require_int_in_range(count, "seccomp filter length", 1, BPF_MAXINSNS)
    program = (_SockFilter * count)()
    copied = _entry_syscall(
        "ptrace",
        PTRACE_SECCOMP_GET_FILTER,
        pid,
        index,
        ctypes.addressof(program),
    )
    if copied != count:
        raise OSError(errno.EIO, "Seccomp filter length changed during read")
    return bytes(program)


def _capbset_read(capability: int) -> bool:
    """Return whether capability is in the calling thread's bounding set."""
    capability = _require_int_in_range(capability, "capability", 0, CAPABILITY_MAX)
    result = _entry_syscall("prctl", PR_CAPBSET_READ, capability, 0, 0, 0)
    if result not in (0, 1):
        raise OSError(errno.EIO, "Unexpected PR_CAPBSET_READ result")
    return result == 1


def _capbset_drop(capability: int) -> None:
    """Remove capability from the calling thread's bounding set."""
    capability = _require_int_in_range(capability, "capability", 0, CAPABILITY_MAX)
    _entry_syscall("prctl", PR_CAPBSET_DROP, capability, 0, 0, 0)


def _set_child_subreaper() -> None:
    """Make this process the reaper of orphaned descendants in its PID namespace."""
    _entry_syscall("prctl", PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0)


def _set_parent_death_signal(signum: int) -> None:
    """Have the kernel send signum to this process when its parent thread exits."""
    _require_int_in_range(signum, "signal", 1, SIGNAL_MAX)
    _entry_syscall("prctl", PR_SET_PDEATHSIG, signum, 0, 0, 0)


def _setns(fd: int, nstype: int) -> None:
    """Join the namespace of fd; nstype must name exactly that namespace type."""
    fd = _require_int_in_range(fd, "namespace descriptor", 0, 2**31 - 1)
    # A zero nstype would accept any namespace type. Require an explicit one.
    if nstype not in {flag for _, flag in NAMESPACE_ENTRY_ORDER}:
        raise ValueError("Invalid namespace type")
    _entry_syscall("setns", fd, nstype)


def _seccomp_set_mode_filter(program: bytes) -> None:
    """Install one classic BPF seccomp program on the calling thread.

    No flags are passed, so the filter applies to this thread only, and the
    process must be single-threaded. A fork of the single-threaded entry
    helper is; this function checks it again. The kernel also requires
    CAP_SYS_ADMIN in the caller's user namespace or no_new_privs; without
    either, it refuses the call with EACCES, and this function raises.
    """
    if threading.active_count() != 1:
        raise RuntimeError("Seccomp filters need a single-threaded process")
    if not isinstance(program, bytes):
        raise ValueError("Seccomp program must be bytes")
    count, remainder = divmod(len(program), SOCK_FILTER_SIZE)
    if remainder or count < 1 or count > BPF_MAXINSNS:
        raise ValueError("Invalid seccomp program length")
    instructions = (_SockFilter * count).from_buffer_copy(program)
    fprog = _SockFprog(count, instructions)
    _entry_syscall(
        "seccomp",
        SECCOMP_SET_MODE_FILTER,
        0,
        ctypes.addressof(fprog),
    )


# The mounts of the workspace and shared directories (see _mount_container_dirs)
# use two kinds of short-lived helper child: one makes a user namespace, and
# one joins the container's mount namespace. A child reports "ok", or the
# failed step and its errno, such as "move_mount 22", through a pipe.
MOUNT_HELPER_TIMEOUT: Final = 5
HELPER_MESSAGE_MAX_BYTES: Final = 64
HELPER_FAILURE_PATTERN: Final = re.compile(r"([a-z][a-z0-9_]{0,15}) ([0-9]{1,5})")


class _MountError(Exception):
    """A step that mounts a host directory in the container failed.

    The message names the step and the errno, such as "move_mount failed:
    Invalid argument (errno 22)". The caller stops the container.
    """


def _mount_step_error(step: str, error: Optional[int]) -> _MountError:
    """Return the _MountError for a failed step with an errno."""
    error = errno.EIO if error is None else error
    return _MountError(f"{step} failed: {os.strerror(error)} (errno {error})")


def _openat2_no_links(path: str, flags: int, root_fd: Optional[int] = None) -> int:
    """Open an absolute path that has no link in any of its components.

    openat2 with RESOLVE_NO_SYMLINKS rejects a symbolic link in every
    component, parents included, and RESOLVE_NO_MAGICLINKS rejects the
    /proc style links. Either gives ELOOP. The path starts at the root of
    the calling process, or at root_fd when it is given: RESOLVE_IN_ROOT
    then keeps the whole path below root_fd. Use O_PATH in flags when only
    a handle is needed.
    """
    # The rules for a path in the container also fit a host path: normalized,
    # absolute, and without control characters. A NUL byte would end the C
    # string early and make the kernel open another path.
    if not _validate_container_path(path):
        raise ValueError("Invalid path")
    encoded = ctypes.create_string_buffer(os.fsencode(path))
    resolve = RESOLVE_NO_SYMLINKS | RESOLVE_NO_MAGICLINKS
    if root_fd is not None:
        resolve |= RESOLVE_IN_ROOT
    how = _OpenHow(flags | os.O_CLOEXEC, 0, resolve)
    return _entry_syscall(
        "openat2",
        AT_FDCWD if root_fd is None else root_fd,
        ctypes.addressof(encoded),
        ctypes.addressof(how),
        ctypes.sizeof(how),
    )


def _read_helper_message(fd: int, timeout: float) -> bytes:
    """Read the short message of a helper child; b"" when none comes in time."""
    ready, _, _ = select.select([fd], [], [], timeout)
    if not ready:
        return b""
    return os.read(fd, HELPER_MESSAGE_MAX_BYTES)


def _end_helper_child(pid: int) -> None:
    """Kill a helper child of this process and reap it.

    The kill bounds the wait. A child that already exited is a zombie until
    the wait, so the kill finds it.
    """
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    os.waitpid(pid, 0)


def _check_helper_result(message: bytes) -> None:
    """Return when a helper child reported success; raise _MountError if not."""
    if message == b"ok":
        return
    match = HELPER_FAILURE_PATTERN.fullmatch(message.decode("ascii", "replace"))
    if match is None:
        raise _MountError("helper process gave no result")
    raise _mount_step_error(match.group(1), int(match.group(2)))


def _write_id_map(pid: int, name: str, line: str) -> None:
    """Write the one map line of a child's new user namespace.

    Host root writes it from the parent namespace, so the second column is a
    host id. The kernel takes the whole map in one write.
    """
    if name not in ("uid_map", "gid_map"):
        raise ValueError("Invalid map file")
    data = line.encode("ascii")
    fd = os.open(f"/proc/{_require_pid(pid)}/{name}", os.O_WRONLY | os.O_CLOEXEC)
    try:
        if os.write(fd, data) != len(data):
            raise OSError(errno.EIO, f"Short write to {name}")
    finally:
        os.close(fd)


def _new_idmap_userns(uid_line: str, gid_line: str) -> int:
    """Return a descriptor of a new user namespace with exactly these maps.

    unshare(CLONE_NEWUSER) puts the caller into the namespace, so a helper
    child does it. This process, as host root, then writes the child's maps
    and opens its ns/user file. The descriptor keeps the namespace after the
    child ends. The child also ends when this process does, because the
    pipe that it waits on then closes.
    """
    ready_read, ready_write = os.pipe()
    done_read, done_write = os.pipe()
    try:
        pid = os.fork()
    except BaseException:
        _close_fds((ready_read, ready_write, done_read, done_write))
        raise
    if pid == 0:
        code = 1
        try:
            _close_fds((ready_read, done_write))
            try:
                _entry_syscall("unshare", CLONE_NEWUSER)
                os.write(ready_write, b"ok")
                # Wait until the parent has opened the namespace and ends
                # this process; the read also returns when the parent is gone.
                os.read(done_read, 1)
                code = 0
            except OSError as exc:
                os.write(ready_write, f"unshare {exc.errno}".encode("ascii"))
        finally:
            os._exit(code)
    _close_fds((ready_write, done_read))
    try:
        _check_helper_result(_read_helper_message(ready_read, MOUNT_HELPER_TIMEOUT))
        for name, line in (("uid_map", uid_line), ("gid_map", gid_line)):
            try:
                _write_id_map(pid, name, line)
            except OSError as exc:
                raise _mount_step_error(f"write of {name}", exc.errno) from exc
        try:
            return os.open(f"/proc/{pid}/ns/user", os.O_RDONLY | os.O_CLOEXEC)
        except OSError as exc:
            raise _mount_step_error("open of ns/user", exc.errno) from exc
    finally:
        _close_fds((ready_read, done_write))
        _end_helper_child(pid)


def _idmapped_tree(source_fd: int, userns_fd: int) -> int:
    """Return a detached, ID-mapped, nosuid, nodev, private clone of a directory.

    open_tree with OPEN_TREE_CLONE makes a bind mount of the directory that
    source_fd holds. The mount is not in any mount namespace yet, so nothing
    on the host changes until move_mount attaches it. The caller closes the
    returned descriptor. Mounts below the directory are not included.

    The clone is private. A clone of a shared host mount (the host's root is
    shared on systemd hosts) is otherwise a peer of it: a mount that root in
    the container made below the directory then appeared on the host, and a
    mount that the host made later appeared in the container (measured on
    Linux 5.15, 6.1, and 6.12). The clone has no mounts below it, so private
    is enough; the recursive form (rprivate) would change nothing.
    """
    empty = ctypes.create_string_buffer(b"")
    tree_fd = _entry_syscall(
        "open_tree",
        source_fd,
        ctypes.addressof(empty),
        OPEN_TREE_CLONE | OPEN_TREE_CLOEXEC | AT_EMPTY_PATH,
    )
    try:
        attr = _MountAttr(
            MOUNT_ATTR_IDMAP | MOUNT_ATTR_NOSUID | MOUNT_ATTR_NODEV,
            0,
            MS_PRIVATE,
            userns_fd,
        )
        _entry_syscall(
            "mount_setattr",
            tree_fd,
            ctypes.addressof(empty),
            AT_EMPTY_PATH,
            ctypes.addressof(attr),
            ctypes.sizeof(attr),
        )
    except BaseException:
        os.close(tree_fd)
        raise
    return tree_fd


def _move_mount_in_namespace(mnt_ns_fd: int, tree_fd: int, target: str) -> None:
    """Attach a detached mount at target in another mount namespace.

    A child process does the work, because setns changes the mount namespace
    of the caller for good. The child opens the target with no link in its
    path, so a link that the container controls cannot lead the mount
    elsewhere, and it mounts on the descriptor, not on the path.
    """
    if not _validate_container_path(target):
        raise _MountError("Invalid mount target")
    empty = ctypes.create_string_buffer(b"")
    result_read, result_write = os.pipe()
    try:
        pid = os.fork()
    except BaseException:
        _close_fds((result_read, result_write))
        raise
    if pid == 0:
        code = 1
        try:
            os.close(result_read)
            # After setns, an import would load code from the container's
            # file system. Nothing below imports; make any import fail.
            sys.meta_path.clear()
            sys.path.clear()
            step = "setns"
            try:
                _setns(mnt_ns_fd, CLONE_NEWNS)
                step = "openat2"
                target_fd = _openat2_no_links(target, os.O_PATH | os.O_DIRECTORY)
                step = "move_mount"
                _entry_syscall(
                    "move_mount",
                    tree_fd,
                    ctypes.addressof(empty),
                    target_fd,
                    ctypes.addressof(empty),
                    MOVE_MOUNT_F_EMPTY_PATH | MOVE_MOUNT_T_EMPTY_PATH,
                )
                os.write(result_write, b"ok")
                code = 0
            except OSError as exc:
                os.write(result_write, f"{step} {exc.errno}".encode("ascii"))
        finally:
            os._exit(code)
    os.close(result_write)
    try:
        message = _read_helper_message(result_read, MOUNT_HELPER_TIMEOUT)
    finally:
        os.close(result_read)
        _end_helper_child(pid)
    _check_helper_result(message)


def _flock_within(fd: int, operation: int, timeout: float, name: str) -> None:
    """Take a flock, or raise TimeoutError when it is not free within timeout."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, operation | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise TimeoutError(
                    f"Timed out waiting for the Sandy {name} lock"
                ) from None
            time.sleep(LIFECYCLE_LOCK_RETRY_INTERVAL)


@contextmanager  # ensures flock acquisition/release is paired at the call site
def _lifecycle_lock(timeout: float = LIFECYCLE_LOCK_TIMEOUT) -> Iterator[None]:
    """Hold the global lifecycle lock exclusively, or fail after timeout.

    The cache directory must already exist. The kernel releases the flock when
    its holder exits, so a killed holder leaves no stale lock. A bounded wait
    keeps a holder that does not return from blocking every later caller.
    """
    lock_path = os.path.join(SYSTEMD_MACHINES, "sandy.__cache", LIFECYCLE_LOCK_FILENAME)
    lock_handle = _open_stable_lock_file(lock_path)
    try:
        _flock_within(lock_handle.fileno(), fcntl.LOCK_EX, timeout, "lifecycle")
        try:
            yield
        finally:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        lock_handle.close()


@contextmanager  # ensures flock acquisition/release is paired at the call site
def _addresses_lock() -> Iterator[None]:
    """Hold the lock of the container addresses exclusively.

    The cache directory must already exist: up takes its up lock there
    first. A holder only reads the /init.sh files and writes one, and no
    holder of the lifecycle lock waits for this lock, so the wait has no
    limit.
    """
    lock_path = os.path.join(SYSTEMD_MACHINES, "sandy.__cache", ADDRESSES_LOCK_FILENAME)
    lock_handle = _open_stable_lock_file(lock_path)
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        lock_handle.close()


@contextmanager  # ensures flock acquisition/release is paired at the call site
def _purge_lock() -> Iterator[None]:
    """Hold the lock of the cache purge exclusively.

    The cache directory must already exist. Only rm --cache takes this lock,
    so a purge waits only for another purge, and the wait has no limit.
    """
    lock_path = os.path.join(SYSTEMD_MACHINES, "sandy.__cache", PURGE_LOCK_FILENAME)
    lock_handle = _open_stable_lock_file(lock_path)
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            try:
                fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass
    finally:
        lock_handle.close()


def _up_lock_filename(machine_name: str) -> str:
    """Return the name of the up lock file of a container name."""
    if not _validate_container_name(machine_name):
        raise ValueError("Invalid container name")
    return f"{UP_LOCK_FILENAME_PREFIX}{machine_name}{UP_LOCK_FILENAME_SUFFIX}"


def _is_up_lock_filename(name: str) -> bool:
    """Return whether name is the up lock file of a valid container name."""
    return (
        name.startswith(UP_LOCK_FILENAME_PREFIX)
        and name.endswith(UP_LOCK_FILENAME_SUFFIX)
        and _validate_container_name(
            name[len(UP_LOCK_FILENAME_PREFIX) : -len(UP_LOCK_FILENAME_SUFFIX)]
        )
    )


def _acquire_up_lock(machine_name: str) -> Optional[Any]:
    """Take the up lock of a container name; return None when it is held.

    up holds this lock from its first check until the container is ready.
    So a second up of the name cannot check, build, or change the port
    state of the name in between. It does not wait: it fails at once.
    Return the open lock file; the lock lasts until it closes. The kernel
    releases the flock when its holder exits. The cache directory must
    already exist. The file stays, as the other lock files do: a removal
    could put two holders on two different inodes.
    """
    lock_path = os.path.join(
        SYSTEMD_MACHINES, "sandy.__cache", _up_lock_filename(machine_name)
    )
    lock_handle = _open_stable_lock_file(lock_path)
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock_handle.close()
        return None
    except BaseException:
        lock_handle.close()
        raise
    return lock_handle


LEADER_PID_PATTERN: Final = re.compile(r"[1-9][0-9]{0,6}")
# systemd-run --scope creates the container's scope cgroup,
# /sys/fs/cgroup/sandy.slice/sandy-<name>.scope, when up starts the scope
# (see _supervisor_scope_argv), and systemd removes it when the scope stops.
# nspawn --keep-unit creates its payload and supervisor cgroups in it. Each
# attach runs in its own leaf cgroup there, next to them.
CGROUP_ROOT: Final = "/sys/fs/cgroup"
ATTACH_LEAF_PREFIX: Final = "attach-"
ATTACH_LEAF_PATTERN: Final = re.compile(r"attach-[0-9a-f]{32}")
ATTACH_LEAF_KILL_TIMEOUT: Final = 5
ATTACH_LEAF_POLL_INTERVAL: Final = 0.02
CGROUP_EVENTS_MAX_BYTES: Final = 4096
CGROUP_FREEZE_TIMEOUT: Final = 5
CGROUP_FREEZE_POLL_INTERVAL: Final = 0.01
CGROUP_FREEZE_MAX_BYTES: Final = 16
CGROUP_THAWED_MESSAGE: Final = (
    "Another program thawed the container during the update; run the update again"
)
CGROUP_CHANGED_MESSAGE: Final = (
    "The cgroups of the container changed during the update; if it is still "
    "starting, run the update again"
)
CGROUP_PROCS_MAX_BYTES: Final = 65536
# The up-console marker: an empty cgroup in the scope of a container that up
# started without -d. It exists from the start of up until the console of that
# up ends, in any way (see _exec). While it exists, no attach exit stops the
# container.
# up creates it under the lifecycle lock before any attach can exist.
UP_CONSOLE_CGROUP: Final = "up-console"
UP_CONSOLE_TIMEOUT: Final = 5
UP_CONSOLE_POLL_INTERVAL: Final = 0.01
# The mounts-pending marker works in the same way: an empty cgroup in the
# scope of a container whose workspace and shared directories up has not
# mounted yet. While it exists, the entry helper refuses every attach, so no
# session sees the empty directories of the image. up creates it under the
# lifecycle lock before any attach can exist, and removes it, under the same
# lock, after the last mount.
MOUNTS_PENDING_CGROUP: Final = "mounts-pending"
PROC_CGROUP_MAX_BYTES: Final = 4096
CGROUP_COUNTERS_MAX_BYTES: Final = 4096
CGROUP_COUNTER_PATTERN: Final = re.compile(r"([a-z_]{1,32}) ([0-9]{1,20})")
PROC_CGROUP_PATTERN: Final = re.compile(r"0::(/[^\n]*)\n")
CAPBND_LINE_PATTERN: Final = re.compile(r"CapBnd:\t([0-9a-f]{16})")
PPID_LINE_PATTERN: Final = re.compile(r"PPid:\t(0|[1-9][0-9]{0,6})")
NSPID_LINE_PATTERN: Final = re.compile(r"NSpid:((?:\t[1-9][0-9]{0,6})+)")
SECCOMP_FILTERS_LINE_PATTERN: Final = re.compile(
    r"Seccomp_filters:\t(0|[1-9][0-9]{0,4})"
)
PROC_STATUS_MAX_BYTES: Final = 65536
PROC_READ_CHUNK_BYTES: Final = 4096
PROC_FD_NAME_PATTERN: Final = re.compile(r"0|[1-9][0-9]{0,9}")
PROC_FD_MAX_ENTRIES: Final = 1024
# nspawn --as-pid2 --user=root starts the payload as PID 2 of the container.
CONTAINER_PAYLOAD_PID: Final = 2


class LeaderConfinement(NamedTuple):
    """Pinned Leader descriptors and the confinement read from the host side."""

    pidfd: int
    # One descriptor for each entry of NAMESPACE_ENTRY_ORDER, in that order.
    namespace_fds: Tuple[int, ...]
    # Oldest first, which is the order in which to install them.
    seccomp_filters: Tuple[bytes, ...]
    capability_bounding_set: int
    # cgroup.kill of the attach leaf that this process joined.
    attach_kill_fd: int


class ProcessConfinement(NamedTuple):
    """The seccomp filter count and CapBnd of a process, from its host status."""

    seccomp_filter_count: int
    capability_bounding_set: int


def _parse_leader_pid(value: str) -> int:
    """Parse a machine Leader PID from machinectl output."""
    if not isinstance(value, str) or not LEADER_PID_PATTERN.fullmatch(value):
        raise ValueError("Invalid container Leader PID")
    pid = _require_pid(int(value))
    # The host init is never the Leader of a container.
    if pid == 1:
        raise ValueError("Invalid container Leader PID")
    return pid


def _query_machine_leader(machine_name: str) -> int:
    """Return the Leader PID that systemd-machined reports for machine_name."""
    if not _validate_container_name(machine_name):
        raise ValueError("Invalid container name")
    result = _run_secure_subprocess(
        ["machinectl", "show", machine_name, "-p", "Leader", "--value"],
        capture_output=True,
        text=True,
        check=True,
        timeout=QUERY_COMMAND_TIMEOUT,
    )
    output = result.stdout
    if output.endswith("\n"):
        output = output[:-1]
    return _parse_leader_pid(output)


def _parse_status_value(status_text: str, name: str, pattern: re.Pattern[str]) -> str:
    """Return the value of the one name line of /proc/<pid>/status text.

    pattern matches the whole line and captures the value. Fail closed when
    the line is missing, repeated, or malformed.
    """
    values = [line for line in status_text.split("\n") if line.startswith(f"{name}:")]
    if len(values) != 1:
        raise ValueError(f"Expected exactly one {name} line")
    match = pattern.fullmatch(values[0])
    if match is None:
        raise ValueError(f"Malformed {name} line")
    return match.group(1)


def _parse_capability_bounding_set(status_text: str) -> int:
    """Return the CapBnd mask from /proc/<pid>/status text, or fail closed."""
    return int(_parse_status_value(status_text, "CapBnd", CAPBND_LINE_PATTERN), 16)


def _read_proc_file(dir_fd: int, name: str, max_bytes: int) -> bytes:
    """Read a whole file below an open host procfs or cgroupfs directory.

    Fail when the file has more than max_bytes.
    """
    fd = os.open(name, READ_FILE_OPEN_FLAGS, dir_fd=dir_fd)
    try:
        chunks = []
        size = 0
        while True:
            chunk = os.read(fd, PROC_READ_CHUNK_BYTES)
            if not chunk:
                break
            size += len(chunk)
            if size > max_bytes:
                raise ValueError(f"Process file {name} is too large")
            chunks.append(chunk)
    finally:
        os.close(fd)
    return b"".join(chunks)


def _read_process_status(proc_fd: int) -> str:
    """Return the status text of an open host /proc/<pid> directory."""
    data = _read_proc_file(proc_fd, "status", PROC_STATUS_MAX_BYTES)
    return data.decode("ascii", errors="replace")


def _read_capability_bounding_set(proc_fd: int) -> int:
    """Read CapBnd from the status file of an open host /proc/<pid> directory."""
    return _parse_capability_bounding_set(_read_process_status(proc_fd))


def _read_oom_score_adj(proc_fd: int) -> int:
    """Read oom_score_adj of an open host /proc/<pid> directory."""
    data = _read_proc_file(proc_fd, "oom_score_adj", OOM_SCORE_ADJ_MAX_BYTES)
    return _parse_oom_score_adj(data.decode("ascii", errors="replace"))


def _open_process_dir(pid: int) -> int:
    """Open the host /proc/<pid> directory of pid."""
    return os.open(f"/proc/{_require_pid(pid)}", DIRECTORY_OPEN_FLAGS)


def _parse_payload_status(
    status_text: str, pid: int, leader_pid: int
) -> Optional[ProcessConfinement]:
    """Return the confinement in status_text if pid is the container payload.

    The payload is PID 2 of the Leader's PID namespace. Require the Leader as
    the parent, and exactly two NSpid entries: pid in the host namespace and
    2 in the container's. Return None for any other process, such as an
    orphan that the Leader adopted. Host PID 2 (kthreadd) has one entry, and
    a process of a PID namespace inside the container has more than two.
    """
    parent = int(_parse_status_value(status_text, "PPid", PPID_LINE_PATTERN))
    nspid = _parse_status_value(status_text, "NSpid", NSPID_LINE_PATTERN)
    namespace_pids = [int(value) for value in nspid.split("\t")[1:]]
    if parent != leader_pid or namespace_pids != [pid, CONTAINER_PAYLOAD_PID]:
        return None
    filters = _parse_status_value(
        status_text, "Seccomp_filters", SECCOMP_FILTERS_LINE_PATTERN
    )
    return ProcessConfinement(
        seccomp_filter_count=int(filters),
        capability_bounding_set=_parse_capability_bounding_set(status_text),
    )


def _find_payload(proc_fd: int, leader_pid: int) -> Tuple[int, ProcessConfinement]:
    """Return the host PID and the confinement of the container payload.

    nspawn starts the payload only after it has installed the filters and set
    the bounding set on the Leader. So while no payload exists, the container
    is still starting, and the Leader's confinement may not be final. proc_fd
    is the Leader's host /proc/<pid> directory. A child that exits meanwhile
    is skipped. Only one process can be PID 2 of the container, so the search
    stops at the first match. It reads neither the status of later children
    nor the rest of the list: the payload is the Leader's first child, and
    the orphans that the Leader adopts come after it.
    """
    with closing(_iter_child_pids(proc_fd, leader_pid)) as children:
        for child in children:
            try:
                child_fd = _open_process_dir(child)
            except FileNotFoundError:
                continue
            try:
                status_text = _read_process_status(child_fd)
            except (FileNotFoundError, ProcessLookupError):
                continue
            finally:
                os.close(child_fd)
            payload = _parse_payload_status(status_text, child, leader_pid)
            if payload is not None:
                return child, payload
    raise ProcessLookupError("Container is still starting; try again")


def _process_has_open_path(proc_fd: int, path: str) -> bool:
    """Return whether the process of a host /proc/<pid> directory has path open.

    Compare the target of each /proc/<pid>/fd link with path. readlink does
    not open or stat the target, so no file of the container can make this
    read block. The target is the path in the process's mount namespace.
    """
    fd_dir = os.open("fd", DIRECTORY_OPEN_FLAGS, dir_fd=proc_fd)
    try:
        names = os.listdir(fd_dir)
        if len(names) > PROC_FD_MAX_ENTRIES:
            raise ValueError("Process has too many open descriptors")
        for name in names:
            if not PROC_FD_NAME_PATTERN.fullmatch(name):
                raise ValueError("Malformed process descriptor entry")
            try:
                target = os.readlink(name, dir_fd=fd_dir)
            except FileNotFoundError:
                # The process closed this descriptor after the listing.
                continue
            if target == path:
                return True
    finally:
        os.close(fd_dir)
    return False


def _payload_has_opened_keepalive(machine_name: str) -> bool:
    """Return whether the container payload has the keepalive script open.

    Until then, the payload needs the keepalive files: execve resolves the
    symlink, and bash opens the script after it starts. A ready container
    proves only that the payload exists (see _find_payload).
    """
    leader_pid = _query_machine_leader(machine_name)
    leader_fd = _open_process_dir(leader_pid)
    try:
        payload_pid, _ = _find_payload(leader_fd, leader_pid)
    finally:
        os.close(leader_fd)
    payload_fd = _open_process_dir(payload_pid)
    try:
        # The payload can exit, and its PID can go to a new process, after
        # the search. The status read through payload_fd confirms that the
        # descriptor is the payload's, so the fd listing below is too.
        status_text = _read_process_status(payload_fd)
        if _parse_payload_status(status_text, payload_pid, leader_pid) is None:
            raise ProcessLookupError("Container payload changed")
        return _process_has_open_path(payload_fd, KEEPALIVE_SCRIPT_PATH)
    finally:
        os.close(payload_fd)


def _pidfd_process_alive(pidfd: int) -> bool:
    """Return whether the process of pidfd has not exited."""
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)
    # A pidfd becomes readable when its process exits. Any event means exit.
    return not poller.poll(0)


def _read_process_cgroup(proc_fd: int) -> str:
    """Return the cgroup v2 path of an open host /proc/<pid> directory."""
    cgroup_fd = os.open("cgroup", READ_FILE_OPEN_FLAGS, dir_fd=proc_fd)
    try:
        data = os.read(cgroup_fd, PROC_CGROUP_MAX_BYTES + 1)
    finally:
        os.close(cgroup_fd)
    text = data.decode("ascii", errors="replace")
    match = PROC_CGROUP_PATTERN.fullmatch(text)
    if len(data) > PROC_CGROUP_MAX_BYTES or match is None:
        raise ValueError("Malformed process cgroup (Sandy requires cgroup v2)")
    return match.group(1)


def _open_supervisor_cgroup(machine_name: str) -> int:
    """Open the cgroup directory of the container's scope.

    systemd-run --scope creates this directory when up starts the scope, and
    systemd removes it when the scope stops. The path comes from the validated
    container name, not from container data. FileNotFoundError means that the
    scope does not exist.
    """
    return _open_cgroup_path((SUPERVISOR_SLICE, _supervisor_unit_name(machine_name)))


def _open_cgroup_path(components: Tuple[str, ...]) -> int:
    """Open a cgroup directory below the cgroup root, one component at a time.

    Each component must be a root-owned directory on the cgroup file system.
    """
    fd = os.open(CGROUP_ROOT, DIRECTORY_OPEN_FLAGS)
    try:
        root_dev = os.fstat(fd).st_dev
        for component in components:
            next_fd = os.open(component, DIRECTORY_OPEN_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = next_fd
            component_stat = os.fstat(fd)
            if component_stat.st_uid != 0 or component_stat.st_dev != root_dev:
                raise PermissionError(f"Unexpected cgroup directory {component}")
    except BaseException:
        os.close(fd)
        raise
    return fd


def _write_cgroup_file(dir_fd: int, name: str, value: bytes) -> None:
    """Write one value to a cgroup interface file of an open cgroup."""
    fd = os.open(name, os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=dir_fd)
    try:
        if os.write(fd, value) != len(value):
            raise OSError(f"Short write to cgroup {name}")
    finally:
        os.close(fd)


def _read_cgroup_counters(dir_fd: int, name: str) -> Dict[str, int]:
    """Return the counters of a flat-keyed cgroup file, such as memory.events."""
    data = _read_proc_file(dir_fd, name, CGROUP_COUNTERS_MAX_BYTES)
    counters = {}
    for line in data.decode("ascii", errors="replace").split("\n"):
        if not line:
            continue
        match = CGROUP_COUNTER_PATTERN.fullmatch(line)
        if match is None:
            raise ValueError(f"Malformed {name}")
        counters[match.group(1)] = int(match.group(2))
    return counters


class MemoryEvents(NamedTuple):
    """OOM counters of a container's scope and of sandy.slice."""

    # Processes of the container that an OOM killer ended, at any limit or
    # when the host ran out of memory.
    oom_kills: int
    # The times that a memory limit of the container's scope, or of a cgroup
    # inside the container, was reached. Sandy sets no such limit; container
    # root can set one in its delegated cgroups.
    container_ooms: int
    # The times that the containers reached the memory limit that they share.
    group_ooms: int


def _container_memory_events(machine_name: str) -> Optional[MemoryEvents]:
    """Return the memory events of the container, or None when unknown.

    memory.events counts the events of a cgroup and of its descendants, so
    the slice's own count comes from memory.events.local. An event inside
    one container then does not count as an event of the shared limit.
    """
    try:
        slice_fd = _open_cgroup_path((SUPERVISOR_SLICE,))
    except (OSError, ValueError):
        return None
    try:
        group = _read_cgroup_counters(slice_fd, "memory.events.local")
        unit_fd = _open_supervisor_cgroup(machine_name)
        try:
            container = _read_cgroup_counters(unit_fd, "memory.events")
        finally:
            os.close(unit_fd)
    except (OSError, ValueError):
        return None
    finally:
        os.close(slice_fd)
    return MemoryEvents(
        container.get("oom_kill", 0), container.get("oom", 0), group.get("oom", 0)
    )


def _cgroup_populated(dir_fd: int) -> bool:
    """Return whether an open cgroup or any of its descendants has processes."""
    return _cgroup_event(dir_fd, "populated")


def _cgroup_frozen(dir_fd: int) -> bool:
    """Return whether an open cgroup and all of its descendants are frozen."""
    return _cgroup_event(dir_fd, "frozen")


def _cgroup_event(dir_fd: int, key: str) -> bool:
    """Return the 0 or 1 value of key in cgroup.events of an open cgroup."""
    fd = os.open("cgroup.events", READ_FILE_OPEN_FLAGS, dir_fd=dir_fd)
    try:
        data = os.read(fd, CGROUP_EVENTS_MAX_BYTES + 1)
    finally:
        os.close(fd)
    if len(data) > CGROUP_EVENTS_MAX_BYTES:
        raise ValueError("Malformed cgroup.events")
    values = [
        line.split(" ")
        for line in data.decode("ascii", errors="replace").split("\n")
        if line
    ]
    if any(len(fields) != 2 for fields in values):
        raise ValueError("Malformed cgroup.events")
    found = [fields[1] for fields in values if fields[0] == key]
    if len(found) != 1 or found[0] not in ("0", "1"):
        raise ValueError("Malformed cgroup.events")
    return found[0] == "1"


@contextmanager  # ensures the child cgroups are thawed at the call site
def _frozen_cgroup(dir_fd: int) -> Iterator[None]:
    """Freeze each child cgroup of an open scope cgroup, and thaw them again.

    dir_fd is the cgroup of a container's scope. The processes of the scope
    are in its child cgroups: nspawn's supervisor and payload cgroups, and
    the attach leaves. While those are frozen, no process of the scope runs,
    so none can start a process or change a value. A process that does not
    freeze in time, such as one in an uninterruptible sleep, makes the
    freeze fail.

    This never writes cgroup.freeze of the scope itself. That file belongs to
    systemctl freeze and to the administrator: cgroup.freeze has no
    compare-and-set, so a write there could undo a freeze that another
    writer made meanwhile. A freeze of the scope before or during the update
    therefore stays, and a thaw of the scope does not thaw the children.
    The thaw undoes only the child freezes that this function set. A child
    that is frozen already stays frozen.

    Only host root can create a child of the scope or move a process into
    the scope's own cgroup. Sandy does both only under the lifecycle lock,
    which the caller holds. A process in the scope's own cgroup, such as the
    Leader while the container starts, or a new child, would not be frozen,
    so it makes this raise RuntimeError. A child that is removed meanwhile,
    such as the leaf of an attach that ended, needs no freeze or thaw.

    A thaw of a child by another writer lets the processes run before the
    body ends. So during the wait and after the body, each child that this
    froze must still request the freeze, and after the body each child must
    still be frozen. Otherwise this raises RuntimeError.

    SIGHUP and SIGTERM end this process without the thaw, which would leave
    the children frozen. So this thread blocks them from before the freeze
    until after the thaw. A signal that comes meanwhile then acts. Call this
    from the main thread: the kernel can give a signal to a thread that does
    not block it. SIGKILL cannot be blocked. SIGINT is held back for the same
    time, so its KeyboardInterrupt comes after the thaw.
    """
    sigint = _DeferredSigint()
    sigint.hold()
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, ATTACH_HANGUP_SIGNALS)
    children: Dict[str, int] = {}
    frozen_here: list[str] = []
    try:
        try:
            for name in _child_cgroup_names(dir_fd):
                try:
                    children[name] = os.open(name, DIRECTORY_OPEN_FLAGS, dir_fd=dir_fd)
                except FileNotFoundError:
                    continue
            for name, child_fd in children.items():
                if _cgroup_freeze_set_or_none(child_fd) is False:
                    # Record the child first: the thaw after a failed write
                    # writes 0 to a child that reads 0, which changes nothing.
                    frozen_here.append(name)
                    _write_child_freeze(child_fd)
            deadline = time.monotonic() + CGROUP_FREEZE_TIMEOUT
            while not _scope_children_frozen(dir_fd, children, frozen_here):
                if time.monotonic() >= deadline:
                    raise TimeoutError("The processes of the container did not freeze")
                time.sleep(CGROUP_FREEZE_POLL_INTERVAL)
            yield
            if not _scope_children_frozen(dir_fd, children, frozen_here):
                raise RuntimeError(CGROUP_THAWED_MESSAGE)
        finally:
            _thaw_children(children, frozen_here)
    finally:
        _close_fds(tuple(children.values()))
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)
        sigint.release()


def _child_cgroup_names(dir_fd: int) -> list[str]:
    """Return the names of the child cgroups of an open cgroup.

    A child cgroup is a directory; the interface files are regular files.
    """
    names = []
    for name in os.listdir(dir_fd):
        try:
            entry = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(entry.st_mode):
            names.append(name)
    return names


def _cgroup_removed(exc: OSError) -> bool:
    """Return whether an error of a cgroup file means a removed cgroup."""
    return exc.errno in (errno.ENOENT, errno.ENODEV)


def _cgroup_freeze_set_or_none(dir_fd: int) -> Optional[bool]:
    """Return _cgroup_freeze_set of an open cgroup, or None when removed."""
    try:
        return _cgroup_freeze_set(dir_fd)
    except OSError as exc:
        if _cgroup_removed(exc):
            return None
        raise


def _write_child_freeze(dir_fd: int) -> None:
    """Freeze an open child cgroup; do nothing when it was removed."""
    try:
        _write_cgroup_file(dir_fd, "cgroup.freeze", b"1")
    except OSError as exc:
        if not _cgroup_removed(exc):
            raise


def _scope_children_frozen(
    dir_fd: int, children: Dict[str, int], frozen_here: list[str]
) -> bool:
    """Return whether each child cgroup of an open scope is frozen.

    Raise RuntimeError when the scope has a new child or a process of its
    own, or when another writer thawed a child that _frozen_cgroup froze.
    """
    if set(_child_cgroup_names(dir_fd)) - set(children):
        raise RuntimeError(CGROUP_CHANGED_MESSAGE)
    if _read_proc_file(dir_fd, "cgroup.procs", CGROUP_PROCS_MAX_BYTES):
        raise RuntimeError(CGROUP_CHANGED_MESSAGE)
    frozen = True
    for name, child_fd in children.items():
        try:
            if name in frozen_here and not _cgroup_freeze_set(child_fd):
                raise RuntimeError(CGROUP_THAWED_MESSAGE)
            if not _cgroup_frozen(child_fd):
                frozen = False
        except OSError as exc:
            if not _cgroup_removed(exc):
                raise
    return frozen


def _thaw_children(children: Dict[str, int], frozen_here: list[str]) -> None:
    """Thaw each child cgroup that _frozen_cgroup froze.

    Try every child, then raise the first error. A removed child needs no
    thaw.
    """
    error: Optional[BaseException] = None
    for name in frozen_here:
        try:
            _thaw_cgroup(children[name])
        except ProcessLookupError:
            continue
        except OSError as exc:
            if error is None:
                error = exc
    if error is not None:
        raise error


def _thaw_cgroup(dir_fd: int) -> None:
    """Thaw an open cgroup; on a failure, report the state that it is in.

    A failed write and a cgroup.freeze that reads 0 mean that the cgroup is
    not frozen, for example because the freeze write failed too. A removed
    cgroup raises ProcessLookupError: it has no processes to thaw.
    """
    try:
        _write_cgroup_file(dir_fd, "cgroup.freeze", b"0")
    except OSError as exc:
        try:
            frozen = _cgroup_freeze_set(dir_fd)
        except OSError as read_exc:
            if _cgroup_removed(read_exc):
                raise ProcessLookupError("The cgroup was removed") from exc
            frozen = None
        except ValueError:
            frozen = None
        if frozen is None:
            raise OSError(
                f"Could not thaw the container, which can stay frozen: {exc}"
            ) from exc
        if frozen:
            raise OSError(
                f"Could not thaw the container, which stays frozen: {exc}"
            ) from exc


def _cgroup_freeze_set(dir_fd: int) -> bool:
    """Return whether cgroup.freeze of an open cgroup requests a freeze."""
    data = _read_proc_file(dir_fd, "cgroup.freeze", CGROUP_FREEZE_MAX_BYTES)
    if data not in (b"0\n", b"1\n"):
        raise ValueError("Malformed cgroup.freeze")
    return data == b"1\n"


def _process_in_scope(proc_fd: int, unit: str) -> bool:
    """Return whether the process of an open host /proc/<pid> directory is in
    the scope unit or in a cgroup below it.

    Only the start of the line matters. Container root names the cgroups
    below payload, so the rest of the path can be long or malformed.
    """
    cgroup_fd = os.open("cgroup", READ_FILE_OPEN_FLAGS, dir_fd=proc_fd)
    try:
        data = os.read(cgroup_fd, PROC_CGROUP_MAX_BYTES + 1)
    finally:
        os.close(cgroup_fd)
    scope = f"0::/{SUPERVISOR_SLICE}/{unit}".encode("ascii")
    return data.startswith(scope + b"\n") or data.startswith(scope + b"/")


def _set_scope_oom_score_adj(machine_name: str, value: int) -> int:
    """Give every process in the container's scope an OOM score adjustment.

    Return the number of processes. The caller holds the lifecycle lock, so
    no attach reads nspawn's value meanwhile (see
    _extract_leader_confinement). The child cgroups of the scope stay frozen
    during the scan of the host /proc (see _frozen_cgroup), so no process of the container can start a process with
    the earlier value after the scan has passed it. Each write is anchored
    at the pinned /proc/<pid> directory of the process that was checked. As
    host root, each write also sets the lowest value that the process can
    set. The processes include nspawn and the entry helpers of the scope.
    """
    unit = _supervisor_unit_name(machine_name)
    leader_pid = _query_machine_leader(machine_name)
    updated = set()
    unit_fd = _open_supervisor_cgroup(machine_name)
    try:
        with _frozen_cgroup(unit_fd):
            for name in os.listdir("/proc"):
                if not LEADER_PID_PATTERN.fullmatch(name):
                    continue
                pid = int(name)
                try:
                    proc_fd = _open_process_dir(pid)
                except FileNotFoundError:
                    continue
                try:
                    if _process_in_scope(proc_fd, unit):
                        _write_oom_score_adj("oom_score_adj", value, dir_fd=proc_fd)
                        updated.add(pid)
                except (FileNotFoundError, ProcessLookupError):
                    # The process exited after the listing.
                    continue
                finally:
                    os.close(proc_fd)
    finally:
        os.close(unit_fd)
    # Fail closed when the scan did not find the container, for example on a
    # host without cgroup v2.
    if leader_pid not in updated:
        raise ProcessLookupError("The container Leader is not in its scope")
    return len(updated)


def _join_attach_leaf(machine_name: str, attach_leaf: str) -> int:
    """Create attach_leaf in the container's scope and move this process in.

    The caller holds the lifecycle lock. Return a descriptor for the leaf's
    cgroup.kill. The leaf is a sibling of nspawn's payload cgroup, so the
    container cannot see or change it.
    """
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    unit_fd = _open_supervisor_cgroup(machine_name)
    try:
        # The name is random; an existing entry is never reused.
        os.mkdir(attach_leaf, 0o755, dir_fd=unit_fd)
        leaf_fd: Optional[int] = None
        kill_fd: Optional[int] = None
        try:
            leaf_fd = os.open(attach_leaf, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
            kill_fd = os.open(
                "cgroup.kill",
                os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=leaf_fd,
            )
            # "0" moves the writing process.
            _write_cgroup_file(leaf_fd, "cgroup.procs", b"0")
        except BaseException:
            if kill_fd is not None:
                os.close(kill_fd)
            try:
                os.rmdir(attach_leaf, dir_fd=unit_fd)
            except OSError:
                pass
            raise
        finally:
            if leaf_fd is not None:
                os.close(leaf_fd)
    finally:
        os.close(unit_fd)
    return kill_fd


def _end_attach_leaf(unit_fd: int, attach_leaf: str) -> None:
    """Kill every process of attach_leaf, wait until it is empty, remove it."""
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    try:
        leaf_fd = os.open(attach_leaf, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
    except FileNotFoundError:
        return
    try:
        _write_cgroup_file(leaf_fd, "cgroup.kill", b"1")
        deadline = time.monotonic() + ATTACH_LEAF_KILL_TIMEOUT
        while _cgroup_populated(leaf_fd):
            if time.monotonic() >= deadline:
                raise TimeoutError("Attach cgroup did not become empty")
            time.sleep(ATTACH_LEAF_POLL_INTERVAL)
    except FileNotFoundError:
        # Another attach's count removed the leaf meanwhile. cgroupfs removes
        # only an empty cgroup, so nothing of this attach is left.
        return
    finally:
        os.close(leaf_fd)
    try:
        os.rmdir(attach_leaf, dir_fd=unit_fd)
    except FileNotFoundError:
        pass


def _remove_attach_leaf(machine_name: str, attach_leaf: str) -> None:
    """End and remove an attach leaf; do nothing when the scope is gone.

    When the scope stops, systemd kills its processes and removes the whole
    cgroup tree, leaves included.
    """
    try:
        unit_fd = _open_supervisor_cgroup(machine_name)
    except FileNotFoundError:
        return
    try:
        _end_attach_leaf(unit_fd, attach_leaf)
    finally:
        os.close(unit_fd)


def _count_populated_attaches(unit_fd: int) -> int:
    """Count the attach leaves that have processes; remove the empty ones.

    The caller holds the lifecycle lock. A helper creates and joins its leaf
    under that lock, so an empty leaf here belongs to an attach that ended,
    for example one whose sandy process got SIGKILL.
    """
    count = 0
    for name in os.listdir(unit_fd):
        if not ATTACH_LEAF_PATTERN.fullmatch(name):
            continue
        try:
            leaf_fd = os.open(name, DIRECTORY_OPEN_FLAGS, dir_fd=unit_fd)
        except FileNotFoundError:
            continue
        try:
            populated = _cgroup_populated(leaf_fd)
        finally:
            os.close(leaf_fd)
        if populated:
            count += 1
            continue
        try:
            os.rmdir(name, dir_fd=unit_fd)
        except OSError:
            pass
    return count


class PinnedSupervisor(NamedTuple):
    """The supervisor that this up started: a pidfd that pins it, and its PID."""

    pidfd: int
    pid: int


def _pin_supervisor(pid: int) -> PinnedSupervisor:
    """Pin the supervisor that this up started, before anything reaps it."""
    return PinnedSupervisor(os.pidfd_open(_require_pid(pid)), pid)


def _supervisor_in_scope(machine_name: str, supervisor: PinnedSupervisor) -> bool:
    """Return whether the supervisor of this up runs in the container's scope.

    systemd-run --scope joins the scope, then execs nspawn, which can move to
    a cgroup below it. Another up of the same name can pass the first checks
    of up while this one starts; its systemd-run then fails, because the
    scope exists, and the scope of the name is not its own. The cgroup read
    refers to the supervisor only while it is alive, so raise
    ProcessLookupError when it has exited.
    """
    scope = f"/{SUPERVISOR_SLICE}/{_supervisor_unit_name(machine_name)}"
    try:
        proc_fd = _open_process_dir(supervisor.pid)
        try:
            cgroup = _read_process_cgroup(proc_fd)
        finally:
            os.close(proc_fd)
    except (OSError, ValueError):
        if not _pidfd_process_alive(supervisor.pidfd):
            raise ProcessLookupError("The container supervisor exited") from None
        raise
    if not _pidfd_process_alive(supervisor.pidfd):
        raise ProcessLookupError("The container supervisor exited")
    return cgroup == scope or cgroup.startswith(scope + "/")


def _create_scope_marker(
    machine_name: str, marker: str, supervisor: PinnedSupervisor
) -> None:
    """Create a marker cgroup in the scope of this up as soon as it exists.

    The caller holds the lifecycle lock. The scope of the name is this up's
    only when it holds this up's supervisor (see _supervisor_in_scope).
    Raise ProcessLookupError when the supervisor exits first, and
    TimeoutError when its scope does not appear in time.
    """
    deadline = time.monotonic() + UP_CONSOLE_TIMEOUT
    while True:
        try:
            unit_fd = _open_supervisor_cgroup(machine_name)
        except FileNotFoundError:
            if not _pidfd_process_alive(supervisor.pidfd):
                raise ProcessLookupError("The container supervisor exited") from None
        else:
            try:
                # unit_fd keeps the directory that was checked: a scope that
                # systemd removes and makes again is another directory.
                if _supervisor_in_scope(machine_name, supervisor):
                    try:
                        os.mkdir(marker, 0o755, dir_fd=unit_fd)
                    except FileExistsError:
                        pass
                    return
            finally:
                os.close(unit_fd)
        if time.monotonic() >= deadline:
            raise TimeoutError("The scope of this up did not appear")
        time.sleep(UP_CONSOLE_POLL_INTERVAL)


def _remove_scope_marker(unit_fd: int, marker: str) -> None:
    """Remove a marker cgroup of an open scope cgroup."""
    try:
        os.rmdir(marker, dir_fd=unit_fd)
    except FileNotFoundError:
        pass


def _scope_marker_exists(unit_fd: int, marker: str) -> bool:
    """Return whether a marker cgroup exists in an open scope cgroup."""
    try:
        entry = os.stat(marker, dir_fd=unit_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    return stat.S_ISDIR(entry.st_mode)


def _create_up_console_marker(machine_name: str, supervisor: PinnedSupervisor) -> None:
    """Create the up-console marker in this up's scope as soon as it exists."""
    _create_scope_marker(machine_name, UP_CONSOLE_CGROUP, supervisor)


def _remove_up_console_marker(unit_fd: int) -> None:
    """Remove the up-console marker of an open scope cgroup."""
    _remove_scope_marker(unit_fd, UP_CONSOLE_CGROUP)


def _up_console_marker_exists(unit_fd: int) -> bool:
    """Return whether the up-console marker exists."""
    return _scope_marker_exists(unit_fd, UP_CONSOLE_CGROUP)


def _create_mounts_pending_marker(
    machine_name: str, supervisor: PinnedSupervisor
) -> None:
    """Create the mounts-pending marker in this up's scope as soon as it exists."""
    _create_scope_marker(machine_name, MOUNTS_PENDING_CGROUP, supervisor)


def _require_no_pending_mounts(machine_name: str) -> None:
    """Refuse an attach while up has not mounted the container's directories.

    The caller holds the lifecycle lock, as does up when it creates and
    removes the marker. The error text is the one for a container that has
    no payload yet, because both mean "still starting". It also says what to
    do when up ended before it removed the marker; the marker stays until
    the container stops.
    """
    unit_fd = _open_supervisor_cgroup(machine_name)
    try:
        pending = _scope_marker_exists(unit_fd, MOUNTS_PENDING_CGROUP)
    finally:
        os.close(unit_fd)
    if pending:
        raise ProcessLookupError(
            "Container is still starting; try again "
            "(if sandy up has ended, stop the container with sandy down)"
        )


def _new_attach_leaf() -> str:
    """Return a new random attach leaf name."""
    return f"{ATTACH_LEAF_PREFIX}{secrets.token_hex(16)}"


def _stop_seized_tracee(pid: int) -> int:
    """Interrupt a seized tracee, wait for its stop, and return the detach signal."""
    _ptrace_interrupt(pid)
    _, status = os.waitpid(pid, WAIT_ALL)
    if not os.WIFSTOPPED(status):
        # A seized tracee reports only stops and its exit.
        raise ProcessLookupError("Container Leader exited during extraction")
    if status >> 16 == 0:
        # A signal-delivery-stop took the signal off the queue. Detach must
        # deliver it again, or the Leader loses it (for example, a poweroff).
        return os.WSTOPSIG(status)
    # A PTRACE_EVENT_STOP (the interrupt, or a group-stop) holds no signal.
    return 0


def _collect_seccomp_filters(pid: int) -> Tuple[bytes, ...]:
    """Read every seccomp filter of a stopped tracee, oldest first."""
    filters = []
    for index in range(SECCOMP_MAX_INSNS_PER_PATH + 1):
        try:
            filters.append(_ptrace_get_seccomp_filter(pid, index))
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                break
            raise
    else:
        raise OSError(errno.E2BIG, "Too many seccomp filters on container Leader")
    if not filters:
        # Sandy always starts the payload with a filter. None means that this
        # process is not a confined Sandy Leader.
        raise PermissionError("Container Leader has no seccomp filter")
    # Index 0 is the oldest filter, so index order is installation order
    # (measured on kernels 5.15, 6.8, and 6.12).
    return tuple(filters)


def _read_seccomp_filters(pid: int) -> Tuple[bytes, ...]:
    """Return the seccomp filters of pid, oldest first, and always detach.

    If the Leader never reaches a stop, it has exited. If an unexpected error
    leaves it seized, the caller must fail, and the tracer's exit removes the
    ptrace link.
    """
    _ptrace_seize(pid)
    detach_signal = _stop_seized_tracee(pid)
    try:
        filters = _collect_seccomp_filters(pid)
    except BaseException:
        try:
            _ptrace_detach(pid, detach_signal)
        except OSError:
            pass
        raise
    _ptrace_detach(pid, detach_signal)
    return filters


def _require_scope_payload_cgroup(leader_cgroup: str, unit: str) -> None:
    """Require that the Leader's cgroup is below the payload cgroup of unit.

    Only host root can create cgroups outside the container's delegated
    payload subtree. So a Leader below the payload of the Sandy scope proves
    that the scope runs this container. nspawn moves the Leader there from
    the scope's own cgroup after machined reports it (measured), so a Leader
    in the scope's own cgroup means that the container is still starting.
    """
    scope = f"/{SUPERVISOR_SLICE}/{unit}"
    payload = f"{scope}/payload"
    if leader_cgroup == payload or leader_cgroup.startswith(payload + "/"):
        return
    if leader_cgroup == scope:
        raise ProcessLookupError("Container is still starting; try again")
    raise PermissionError(
        f"Container is not running in {unit}; restart it with this version of Sandy"
    )


def _close_fds(fds: Tuple[int, ...]) -> None:
    """Close each descriptor, and ignore descriptors that are already closed."""
    for fd in fds:
        try:
            os.close(fd)
        except OSError:
            pass


def _close_leader_confinement(confinement: LeaderConfinement) -> None:
    """Close the descriptors of a LeaderConfinement."""
    _close_fds(
        (confinement.pidfd,) + confinement.namespace_fds + (confinement.attach_kill_fd,)
    )


NSPAWN_SUPERVISOR_CGROUP: Final = "supervisor"


def _read_supervisor_oom_score_adj(machine_name: str) -> int:
    """Return the OOM score adjustment of the container's nspawn process.

    up gives nspawn the container's value, and update writes it to nspawn
    too. The container cannot change it: nspawn is outside the container's
    PID and user namespaces. The Leader gets the same value, but it is a
    process of the container. Container root cannot write the Leader's value
    through /proc (measured), but this read does not depend on that.
    nspawn --keep-unit runs in the supervisor cgroup of the scope. A process that nspawn forks there gets its value, so every
    process there must have the same value.

    A PID of cgroup.procs that a new process reuses is not in that cgroup;
    the check and the read use the same pinned /proc/<pid> directory.
    """
    unit = _supervisor_unit_name(machine_name)
    expected = f"/{SUPERVISOR_SLICE}/{unit}/{NSPAWN_SUPERVISOR_CGROUP}"
    cgroup_fd = _open_cgroup_path((SUPERVISOR_SLICE, unit, NSPAWN_SUPERVISOR_CGROUP))
    try:
        data = _read_proc_file(cgroup_fd, "cgroup.procs", CGROUP_PROCS_MAX_BYTES)
    finally:
        os.close(cgroup_fd)
    values = set()
    for line in data.decode("ascii", errors="replace").split("\n"):
        if not line:
            continue
        if not LEADER_PID_PATTERN.fullmatch(line):
            raise ValueError("Malformed cgroup.procs")
        try:
            proc_fd = _open_process_dir(int(line))
        except FileNotFoundError:
            continue
        try:
            if _read_process_cgroup(proc_fd) == expected:
                values.add(_read_oom_score_adj(proc_fd))
        except (FileNotFoundError, ProcessLookupError):
            # The process exited after the listing.
            continue
        finally:
            os.close(proc_fd)
    if not values:
        raise ProcessLookupError("The container has no nspawn process")
    if len(values) != 1:
        raise ValueError("The nspawn processes have different OOM score adjustments")
    return values.pop()


def _extract_leader_confinement(
    machine_name: str, leader_pid: int, attach_leaf: str
) -> LeaderConfinement:
    """Pin the Leader, read its confinement, and join the attach leaf.

    The Leader is the container's PID 1 as the host sees it: nspawn's stub
    init, (sd-stubinit), because nspawn runs with --as-pid2. The payload
    (PID 2) inherits its filters and bounding set, and the kernel only lets
    both become stricter, so they are the confinement to copy. See
    specs/security-parity.md, item 1. This process also writes to itself the
    OOM score adjustment of the container (item 2), which it reads from
    nspawn (see _read_supervisor_oom_score_adj).

    machined reports the Leader before nspawn has completed its setup, and
    nspawn starts the payload only after that setup. So find the payload
    before the Leader's namespaces and filters are opened or read, and
    require the payload's filter count and CapBnd to equal the Leader's
    (item 5). Until then the container is still starting, and the attach
    fails closed. It fails closed in the same way while up has not mounted
    the workspace and shared directories (the mounts-pending marker).

    Hold the lifecycle lock for the whole extraction and for the creation of
    the leaf, so that a stop decision cannot interleave with a new attach.
    Every read uses the host /proc, before any setns, so the container cannot
    change what Sandy reads. The caller owns the returned descriptors.
    """
    pid = _require_pid(leader_pid)
    unit = _supervisor_unit_name(machine_name)
    if not ATTACH_LEAF_PATTERN.fullmatch(attach_leaf):
        raise ValueError("Invalid attach cgroup name")
    opened = []
    with _lifecycle_lock():
        try:
            pidfd = os.pidfd_open(pid)
            opened.append(pidfd)
            # The pidfd pins one process. Confirm that this process is the
            # Leader of the machine now, not a later user of the same PID.
            if _query_machine_leader(machine_name) != pid:
                raise PermissionError("Container Leader changed during extraction")
            proc_fd = _open_process_dir(pid)
            try:
                # Check the scope before the payload: a container that an
                # earlier Sandy started has no payload at PID 2, and it needs
                # a restart, not a retry.
                _require_scope_payload_cgroup(_read_process_cgroup(proc_fd), unit)
                # No session before up has mounted the directories.
                _require_no_pending_mounts(machine_name)
                _, payload = _find_payload(proc_fd, pid)
                namespace_fds = []
                for name, _ in NAMESPACE_ENTRY_ORDER:
                    # ns/<name> are kernel magic links, anchored at the pinned
                    # /proc/<pid> descriptor. setns checks the type later.
                    ns_fd = os.open(
                        f"ns/{name}", os.O_RDONLY | os.O_CLOEXEC, dir_fd=proc_fd
                    )
                    opened.append(ns_fd)
                    namespace_fds.append(ns_fd)
                seccomp_filters = _read_seccomp_filters(pid)
                capability_bounding_set = _read_capability_bounding_set(proc_fd)
            finally:
                os.close(proc_fd)
            # The process was alive from pidfd_open to here, so the PID
            # referred to it for every read above.
            if not _pidfd_process_alive(pidfd):
                raise ProcessLookupError("Container Leader exited during extraction")
            if payload != ProcessConfinement(
                seccomp_filter_count=len(seccomp_filters),
                capability_bounding_set=capability_bounding_set,
            ):
                raise PermissionError(
                    "Container payload confinement differs from the Leader"
                )
            # The session gets the container's OOM score adjustment from
            # nspawn, which is outside the container, not from the Leader. As
            # host root, the write also sets the lowest value that the
            # session can set. Read and write under the lock, so that update
            # --oom-score-adj cannot change the value between them.
            _write_own_oom_score_adj(_read_supervisor_oom_score_adj(machine_name))
            attach_kill_fd = _join_attach_leaf(machine_name, attach_leaf)
        except BaseException:
            _close_fds(tuple(opened))
            raise
    return LeaderConfinement(
        pidfd=pidfd,
        namespace_fds=tuple(namespace_fds),
        seccomp_filters=seccomp_filters,
        capability_bounding_set=capability_bounding_set,
        attach_kill_fd=attach_kill_fd,
    )


# The workspace and shared directories. nspawn starts without them; up mounts
# each one in the running container's mount namespace (_mount_container_dirs),
# with the owner of the host directory mapped to the image user. See
# specs/security-parity.md, item 6.
# The number of ids in the container's user namespace.
CONTAINER_ID_COUNT: Final = 65536
ID_MAP_PATTERN: Final = re.compile(rf" *0 +([1-9][0-9]{{0,9}}) +{CONTAINER_ID_COUNT}\n")
ID_MAP_MAX_BYTES: Final = 4096
# The warning about mounts below a directory (see _mounts_below).
MOUNTINFO_MAX_BYTES: Final = 16 * 1024 * 1024
MOUNTINFO_ESCAPE_PATTERN: Final = re.compile(r"\\([0-7]{3})")
SUBMOUNT_LIST_MAX: Final = 3
IDMAP_MOUNT_HINT: Final = (
    "ID-mapped mounts need Linux 5.12 or later and a file system that supports "
    "them (ext4, xfs, and btrfs do; tmpfs needs Linux 6.3; ramfs does not)"
)
# The highest valid uid or gid: 4294967295 is (uid_t)-1.
ID_VALUE_MAX: Final = 0xFFFFFFFE


class MountPlan(NamedTuple):
    """A host directory to mount in the container, checked before the start."""

    # "workspace" or "shared"
    label: str
    # The real path on the host, from os.path.realpath
    source: str
    # The absolute path in the container
    target: str
    # The identity of the directory at the check. The mount requires the
    # same directory.
    device: int
    inode: int


def _parse_id_map_shift(text: str, name: str) -> int:
    """Return the host id that container id 0 maps to, or fail closed.

    The container has one map line, "0 <host id> 65536", which nspawn wrote
    for --private-users. Any other map, host id 0 included, is not one
    that Sandy started.
    """
    match = ID_MAP_PATTERN.fullmatch(text)
    if match is None:
        raise ValueError(f"Unexpected {name} of the container")
    shift = int(match.group(1))
    if shift + CONTAINER_ID_COUNT - 1 > ID_VALUE_MAX:
        raise ValueError(f"Unexpected {name} of the container")
    return shift


def _read_mountinfo() -> str:
    """Return the mount table of this process, read through its /proc directory."""
    proc_fd = _open_process_dir(os.getpid())
    try:
        data = _read_proc_file(proc_fd, "mountinfo", MOUNTINFO_MAX_BYTES)
    finally:
        os.close(proc_fd)
    return data.decode("utf-8", errors="surrogateescape")


def _mounts_below(directory: str, mountinfo: str) -> list:
    """Return the mount points below a directory, sorted; not the directory.

    mountinfo is the text of /proc/<pid>/mountinfo. The fifth field of a line is
    the mount point, with a space, tab, newline, and backslash written as an
    octal escape. A malformed line fails the whole check, so that it cannot
    hide a mount.
    """
    prefix = directory.rstrip("/") + "/"
    below = set()
    for line in mountinfo.split("\n"):
        if not line:
            continue
        fields = line.split(" ")
        if len(fields) < 10 or "-" not in fields[6:]:
            raise ValueError("Malformed mountinfo line")
        mount_point = MOUNTINFO_ESCAPE_PATTERN.sub(
            lambda match: chr(int(match.group(1), 8)), fields[4]
        )
        # The root directory is its own prefix; it is not below itself.
        if mount_point.startswith(prefix) and mount_point != prefix:
            below.add(mount_point)
    return sorted(below)


def _id_map_line(inside: int, outside: int) -> str:
    """Return a map line with one id: inside maps to outside."""
    return f"{inside} {outside} 1\n"


def _as_mount_error(exc: OSError) -> _MountError:
    """Return the _MountError for an OSError of a mount step."""
    error = errno.EIO if exc.errno is None else exc.errno
    return _MountError(f"{exc.strerror or os.strerror(error)} (errno {error})")


def _check_mount_owner(label: str, source_stat: os.stat_result) -> None:
    """Refuse a directory that host root owns, as user or as group.

    The container's user maps to the owner of the directory, and its group to
    the group of the directory. A container process that writes there then
    creates files of that owner. With root as the owner or the group, it
    would create files that host root or the root group own, such as a
    setuid file that runs with those ids on the host.
    """
    if source_stat.st_uid == 0 or source_stat.st_gid == 0:
        raise _MountError(
            f"root owns the {label} directory, so files that the container "
            "creates there would belong to root. Use a directory that a "
            "regular user and group own"
        )


def _open_host_directory(path: str) -> int:
    """Open a host directory with no link in its path, as a handle (O_PATH)."""
    try:
        return _openat2_no_links(path, os.O_PATH | os.O_DIRECTORY)
    except ValueError as exc:
        raise _MountError("the path is not valid") from exc
    except OSError as exc:
        raise _as_mount_error(exc) from exc


def _probe_idmapped_mount(source_fd: int, source_stat: os.stat_result) -> None:
    """Check that an ID-mapped mount of the directory is possible.

    The probe makes the detached mount that _mount_one makes, with a map of
    the owner to itself, and drops it. It changes nothing on the host. The
    kernel needs to be 5.12 or later, and the file system needs to support
    ID-mapped mounts (measured: ramfs does not, and tmpfs needs Linux 6.3).
    """
    userns_fd = _new_idmap_userns(
        _id_map_line(source_stat.st_uid, source_stat.st_uid),
        _id_map_line(source_stat.st_gid, source_stat.st_gid),
    )
    try:
        os.close(_idmapped_tree(source_fd, userns_fd))
    except OSError as exc:
        raise _MountError(f"{_as_mount_error(exc)}. {IDMAP_MOUNT_HINT}") from exc
    finally:
        os.close(userns_fd)


def _plan_mount(label: str, source: str, target: str) -> MountPlan:
    """Check a host directory before any host change; return its plan.

    Raise _MountError when root owns the directory (see _check_mount_owner)
    or when an ID-mapped mount of it is not possible.
    """
    source_fd = _open_host_directory(source)
    try:
        try:
            source_stat = os.fstat(source_fd)
        except OSError as exc:
            raise _as_mount_error(exc) from exc
        _check_mount_owner(label, source_stat)
        _probe_idmapped_mount(source_fd, source_stat)
    finally:
        os.close(source_fd)
    return MountPlan(label, source, target, source_stat.st_dev, source_stat.st_ino)


def _mount_one(
    plan: MountPlan,
    uid_shift: int,
    gid_shift: int,
    image_ids: Tuple[int, int],
    mnt_ns_fd: int,
) -> None:
    """Mount one planned directory in the container's mount namespace.

    The directory is the one that was checked, and root does not own it. Its
    owner maps to the image user, and no other id maps: files of the host
    user belong to the image user in the container, and what the image user
    creates belongs to the host user. Every other container id, root
    included, gets EOVERFLOW when it creates a file. The mount is nosuid and
    nodev. It exists only in the mount namespace of the container.
    """
    try:
        source_fd = _open_host_directory(plan.source)
        try:
            source_stat = os.fstat(source_fd)
            if (source_stat.st_dev, source_stat.st_ino) != (plan.device, plan.inode):
                raise _MountError(f"the {plan.label} directory changed after the check")
            _check_mount_owner(plan.label, source_stat)
            userns_fd = _new_idmap_userns(
                _id_map_line(
                    source_stat.st_uid,
                    _require_int_in_range(
                        uid_shift + image_ids[0], "uid", 0, ID_VALUE_MAX
                    ),
                ),
                _id_map_line(
                    source_stat.st_gid,
                    _require_int_in_range(
                        gid_shift + image_ids[1], "gid", 0, ID_VALUE_MAX
                    ),
                ),
            )
            try:
                tree_fd = _idmapped_tree(source_fd, userns_fd)
                try:
                    _move_mount_in_namespace(mnt_ns_fd, tree_fd, plan.target)
                finally:
                    os.close(tree_fd)
            finally:
                os.close(userns_fd)
        finally:
            os.close(source_fd)
    except OSError as exc:
        raise _as_mount_error(exc) from exc
    except ValueError as exc:
        raise _MountError(str(exc)) from exc


def _mount_container_dirs(
    machine_name: str,
    plans: Tuple[MountPlan, ...],
    image_ids: Tuple[int, int],
    supervisor: PinnedSupervisor,
) -> None:
    """Mount the planned directories in the running container; end "pending".

    up calls this until it works. It finds the container as the entry helper
    does (see _extract_leader_confinement): the Leader pinned and confirmed
    with machinectl, in the payload cgroup of the scope, and with the payload
    (PID 2) present. nspawn has completed its mounts when the payload exists,
    so the mounts of this function stay. The scope must also hold the
    supervisor of this up, or the container is another start's. It raises
    ProcessLookupError while the container is still starting. Any other
    error is final; the caller stops the container. A _MountError names the
    failed step and its errno.

    The whole step is under the lifecycle lock, and it removes the
    mounts-pending marker under that lock. So no attach sees a container
    with only some of its directories.
    """
    unit = _supervisor_unit_name(machine_name)
    opened: list = []
    with _lifecycle_lock():
        try:
            try:
                leader_pid = _query_machine_leader(machine_name)
            except (subprocess.SubprocessError, ValueError) as exc:
                # machined does not report a Leader before the machine exists.
                raise ProcessLookupError("Container is still starting") from exc
            pidfd = os.pidfd_open(leader_pid)
            opened.append(pidfd)
            # The pidfd pins one process. Confirm that it is the Leader of
            # the machine now, not a later user of the same PID.
            if _query_machine_leader(machine_name) != leader_pid:
                raise PermissionError("Container Leader changed during the mounts")
            try:
                proc_fd = _open_process_dir(leader_pid)
            except FileNotFoundError as exc:
                raise ProcessLookupError("Container Leader exited") from exc
            try:
                _require_scope_payload_cgroup(_read_process_cgroup(proc_fd), unit)
                _find_payload(proc_fd, leader_pid)
                uid_shift = _parse_id_map_shift(
                    _read_proc_file(proc_fd, "uid_map", ID_MAP_MAX_BYTES).decode(
                        "ascii", errors="replace"
                    ),
                    "uid_map",
                )
                gid_shift = _parse_id_map_shift(
                    _read_proc_file(proc_fd, "gid_map", ID_MAP_MAX_BYTES).decode(
                        "ascii", errors="replace"
                    ),
                    "gid_map",
                )
                mnt_ns_fd = os.open(
                    "ns/mnt", os.O_RDONLY | os.O_CLOEXEC, dir_fd=proc_fd
                )
                opened.append(mnt_ns_fd)
            finally:
                os.close(proc_fd)
            # The process was alive from pidfd_open to here, so the PID
            # referred to it for every read above.
            if not _pidfd_process_alive(pidfd):
                raise ProcessLookupError("Container Leader exited")
            # The supervisor of this up was in the scope when up made the
            # pending marker, and the scope cannot go while it is alive. So
            # the Leader read above is in the container of this up.
            if not _supervisor_in_scope(machine_name, supervisor):
                raise PermissionError(
                    f"{unit} does not run the container that this up started"
                )
            for plan in plans:
                try:
                    _mount_one(plan, uid_shift, gid_shift, image_ids, mnt_ns_fd)
                except _MountError as exc:
                    raise _MountError(
                        f"'{_strip_control_characters(plan.source)}' on "
                        f"'{plan.target}': {exc}"
                    ) from exc
            unit_fd = _open_supervisor_cgroup(machine_name)
            try:
                _remove_scope_marker(unit_fd, MOUNTS_PENDING_CGROUP)
            finally:
                os.close(unit_fd)
        finally:
            _close_fds(tuple(opened))


# Internal mode for confined container entry. The parent starts it as
# [python, -I, /proc/self/fd/<pinned sandy>, ENTRY_HELPER_MODE, ...] with only
# stdin, stdout, stderr, and the pinned script descriptor open.
ENTRY_HELPER_MODE: Final = "__sandy-entry-helper"
ENTRY_HELPER_ARGC: Final = 11
ENTRY_HELPER_FAILURE: Final = 125
ENTRY_KIND_TTY: Final = "tty"
ENTRY_KIND_SH: Final = "sh"
ENTRY_COMMAND_MAX_BYTES: Final = 131072
ENTRY_MAX_GROUPS: Final = 64
CONTAINER_ACCOUNT_FILE_MAX_BYTES: Final = 1048576
# IDs inside the container's 65536-ID user namespace; 65535 is the overflow ID.
CONTAINER_ID_MAX: Final = 65534
CONTAINER_ID_PATTERN: Final = re.compile(r"0|[1-9][0-9]{0,4}")
PINNED_SCRIPT_PATTERN: Final = re.compile(r"/proc/self/fd/([3-9]|[1-9][0-9]{1,3})")
CAP_LAST_CAP_PATTERN: Final = re.compile(r"([0-9]{1,2})\n")
# On these the helper ends its whole attach. It ignores SIGINT and SIGQUIT
# while it waits, as system(3) does, because a terminal sends those to the
# whole foreground process group.
ENTRY_END_SIGNALS: Final = (signal.SIGHUP, signal.SIGTERM)
ENTRY_WAIT_IGNORED_SIGNALS: Final = (signal.SIGINT, signal.SIGQUIT)
# Python ignores SIGPIPE and SIGXFSZ, and an ignored signal stays ignored after
# execve. Restore the defaults, as subprocess does with restore_signals.
ENTRY_RESET_SIGNALS: Final = (
    signal.SIGHUP,
    signal.SIGINT,
    signal.SIGQUIT,
    signal.SIGTERM,
    signal.SIGPIPE,
    signal.SIGXFSZ,
)


class EntryRequest(NamedTuple):
    """Validated parameters of one confined container entry."""

    machine: str
    leader_pid: int
    # The sandy process that starts the helper, for the parent-death check.
    parent_pid: int
    attach_leaf: str
    user: str
    home: str
    workdir: str
    kind: str
    command: str


def _parse_container_id(value: str, label: str) -> int:
    """Parse a uid or gid inside the container user namespace."""
    if not isinstance(value, str) or not CONTAINER_ID_PATTERN.fullmatch(value):
        raise ValueError(f"Invalid container {label}")
    return _require_int_in_range(int(value), f"container {label}", 0, CONTAINER_ID_MAX)


def _account_file_entries(text: str, field_count: int, label: str) -> list:
    """Split passwd or group text into entries; reject malformed lines.

    Empty lines and lines that start with "#" are skipped, as nss_files does.
    """
    entries = []
    for line in text.split("\n"):
        if not line or line.startswith("#"):
            continue
        fields = line.split(":")
        if len(fields) != field_count:
            raise ValueError(f"Malformed container {label} entry")
        entries.append(fields)
    return entries


def _resolve_container_user_ids(user: str, passwd_text: str) -> Tuple[int, int]:
    """Return the uid and gid of user from passwd text, or fail closed."""
    matches = [
        fields
        for fields in _account_file_entries(passwd_text, 7, "passwd")
        if fields[0] == user
    ]
    if len(matches) != 1:
        raise ValueError("Container user must have exactly one passwd entry")
    uid = _parse_container_id(matches[0][2], "uid")
    gid = _parse_container_id(matches[0][3], "gid")
    if (user == "root") != (uid == 0):
        raise ValueError("Container uid 0 must be the root user")
    return uid, gid


def _resolve_container_identity(
    user: str, passwd_text: str, group_text: str
) -> Tuple[int, int, Tuple[int, ...]]:
    """Return uid, gid, and supplementary groups for user, as nspawn sets them.

    Measured with systemd 249, 255, and 257: nspawn gives root no
    supplementary groups. For other users it sets exactly the groups that
    list the user as a member (getent initgroups), without the primary gid
    unless that group lists the user.
    """
    uid, gid = _resolve_container_user_ids(user, passwd_text)
    groups: list = []
    for fields in _account_file_entries(group_text, 4, "group"):
        group_id = _parse_container_id(fields[2], "group")
        if user == "root" or user not in fields[3].split(","):
            continue
        if group_id not in groups:
            groups.append(group_id)
    if len(groups) > ENTRY_MAX_GROUPS:
        raise ValueError("Too many container groups")
    return uid, gid, tuple(groups)


def _read_account_fd(fd: int, path: str) -> str:
    """Read an open account file; it must be a regular file of bounded size."""
    file_stat = os.fstat(fd)
    if not stat.S_ISREG(file_stat.st_mode):
        raise ValueError(f"Container {path} is not a regular file")
    chunks = []
    size = 0
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        size += len(chunk)
        if size > CONTAINER_ACCOUNT_FILE_MAX_BYTES:
            raise ValueError(f"Container {path} is too large")
        chunks.append(chunk)
    return b"".join(chunks).decode("utf-8", "surrogateescape")


def _read_container_account_file(path: str) -> str:
    """Read a regular account file inside the container's mount namespace.

    O_NONBLOCK keeps a FIFO from blocking the open; the file is then rejected.
    """
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOCTTY)
    try:
        return _read_account_fd(fd, path)
    finally:
        os.close(fd)


def _read_image_user_ids(image_root_fd: int, user: str) -> Tuple[int, int]:
    """Return the uid and gid of user from /etc/passwd of a pinned image root.

    The file opens through the image root without following a link out of
    it. up reads the ids before the start; the entry helper resolves the
    same user from the same file at attach time.
    """
    fd = _open_image_file(image_root_fd, ("etc", "passwd"))
    try:
        text = _read_account_fd(fd, "/etc/passwd")
    finally:
        os.close(fd)
    return _resolve_container_user_ids(user, text)


def _validate_container_path(path: str) -> bool:
    """Return whether path is a normalized absolute path inside the container."""
    if not isinstance(path, str) or not path.startswith("/") or len(path) > 4096:
        return False
    if _contains_control_character(path) or os.path.normpath(path) != path:
        return False
    # normpath keeps a leading "//", which POSIX leaves implementation-defined.
    return not path.startswith("//")


def _parse_entry_request(args: list) -> EntryRequest:
    """Parse the helper arguments that follow ENTRY_HELPER_MODE."""
    if len(args) != ENTRY_HELPER_ARGC - 2:
        raise ValueError("Invalid entry helper argument count")
    machine, leader, parent, attach_leaf, user, home, workdir, kind, command = args
    if not _validate_container_name(machine):
        raise ValueError("Invalid container name")
    if not isinstance(parent, str) or not LEADER_PID_PATTERN.fullmatch(parent):
        raise ValueError("Invalid parent PID")
    if not isinstance(attach_leaf, str) or not ATTACH_LEAF_PATTERN.fullmatch(
        attach_leaf
    ):
        raise ValueError("Invalid attach cgroup name")
    if not _validate_username(user):
        raise ValueError("Invalid container username")
    request = EntryRequest(
        machine=machine,
        leader_pid=_parse_leader_pid(leader),
        parent_pid=_require_pid(int(parent)),
        attach_leaf=attach_leaf,
        user=user,
        home=home,
        workdir=workdir,
        kind=kind,
        command=command,
    )
    expected_home = "/root" if user == "root" else f"/home/{user}"
    if home != expected_home:
        raise ValueError("Invalid container home directory")
    if not _validate_container_path(workdir):
        raise ValueError("Invalid container working directory")
    if kind not in (ENTRY_KIND_TTY, ENTRY_KIND_SH):
        raise ValueError("Invalid container entry kind")
    if not isinstance(command, str) or not command:
        raise ValueError("Invalid container command")
    if len(command.encode("utf-8", "surrogateescape")) > ENTRY_COMMAND_MAX_BYTES:
        raise ValueError("Container command is too long")
    return request


def _entry_request_args(request: EntryRequest) -> list:
    """Return the helper arguments for request; reject what the helper rejects."""
    args = [
        request.machine,
        str(request.leader_pid),
        str(request.parent_pid),
        request.attach_leaf,
        request.user,
        request.home,
        request.workdir,
        request.kind,
        request.command,
    ]
    # Build only what the helper accepts.
    if _parse_entry_request(args) != request:
        raise ValueError("Entry request does not survive helper argument parsing")
    return args


def _entry_helper_argv(script_fd: int, request: EntryRequest) -> list:
    """Return the argv that starts the entry helper for request."""
    args = _entry_request_args(request)
    return [
        sys.executable,
        "-I",
        _proc_self_fd_path(script_fd),
        ENTRY_HELPER_MODE,
    ] + args


def _entry_exec_argv(request: EntryRequest) -> list:
    """Return the in-container argv for request."""
    if request.kind == ENTRY_KIND_TTY:
        # script allocates a terminal from the container's devpts instance.
        return [
            "/bin/bash",
            "-c",
            f"script -qec {shlex.quote(request.command)} /dev/null",
        ]
    return ["/bin/sh", "-c", request.command]


def _open_fds() -> set:
    """Return the descriptors open in this process."""
    fds = set()
    # listdir uses a descriptor of its own, which is closed when it returns.
    for name in os.listdir("/proc/self/fd"):
        fd = int(name)
        try:
            os.fstat(fd)
        except OSError:
            continue
        fds.add(fd)
    return fds


def _verify_entry_helper_fds(script_path: str) -> int:
    """Require the pinned script descriptor and the standard streams only."""
    match = PINNED_SCRIPT_PATTERN.fullmatch(script_path)
    if match is None:
        raise PermissionError("Entry helper must run from a pinned script descriptor")
    script_fd = int(match.group(1))
    if _open_fds() != {0, 1, 2, script_fd}:
        raise PermissionError("Entry helper has unexpected file descriptors")
    _verify_entry_script(os.fstat(script_fd))
    return script_fd


def _verify_entry_script(script_stat: os.stat_result) -> None:
    """Require a regular script file that only its owner can write.

    The parent already runs this file as root, so its owner is trusted as
    much as the parent is. No other user may change it.
    """
    if not stat.S_ISREG(script_stat.st_mode) or script_stat.st_mode & 0o022:
        raise PermissionError(
            "Sandy script must be a regular file that only its owner can write"
        )


def _open_entry_script() -> int:
    """Open the running sandy script for the entry helper and verify it."""
    fd = os.open(os.path.realpath(__file__), READ_FILE_OPEN_FLAGS)
    try:
        _verify_entry_script(os.fstat(fd))
    except BaseException:
        os.close(fd)
        raise
    return fd


def _read_cap_last_cap() -> int:
    """Read the highest capability number from the host procfs."""
    fd = os.open("/proc/sys/kernel/cap_last_cap", READ_FILE_OPEN_FLAGS)
    try:
        data = os.read(fd, 16)
    finally:
        os.close(fd)
    match = CAP_LAST_CAP_PATTERN.fullmatch(data.decode("ascii", errors="replace"))
    if match is None:
        raise ValueError("Malformed cap_last_cap")
    return _require_int_in_range(int(match.group(1)), "cap_last_cap", 0, CAPABILITY_MAX)


CHILD_PIDS_PATTERN: Final = re.compile(r"(?:[1-9][0-9]{0,6} )*")
# The digits of the longest entry, without its space.
CHILD_PID_MAX_DIGITS: Final = 7


def _iter_child_pids(proc_fd: int, pid: int) -> Generator[int, None, None]:
    """Yield the children of pid from its open host /proc/<pid> directory.

    pid must be single-threaded: the list holds the children of its main
    thread. The list includes children that have exited but are not reaped
    yet. The kernel adds a child at the end of the list, also an orphan that
    pid adopts.

    The list has no size limit. The Leader adopts the orphans of its
    container, as many as the container's process limit allows, and a limit
    here would refuse every attach. So read the list one chunk at a time,
    and check each chunk before any of its entries is used; the memory stays
    at one chunk. Close the generator to stop early; that closes the file.
    """
    fd = os.open(
        f"task/{_require_pid(pid)}/children", READ_FILE_OPEN_FLAGS, dir_fd=proc_fd
    )
    try:
        partial = b""
        while True:
            chunk = os.read(fd, PROC_READ_CHUNK_BYTES)
            if not chunk:
                break
            data = partial + chunk
            end = data.rfind(b" ") + 1
            entries, partial = data[:end], data[end:]
            if len(partial) > CHILD_PID_MAX_DIGITS or not CHILD_PIDS_PATTERN.fullmatch(
                entries.decode("ascii", errors="replace")
            ):
                raise ValueError("Malformed process children list")
            for value in entries.split():
                yield _require_pid(int(value))
        # Every entry ends with a space.
        if partial:
            raise ValueError("Malformed process children list")
    finally:
        os.close(fd)


def _read_child_pids(proc_fd: int, pid: int) -> Tuple[int, ...]:
    """Return the children of pid from its open host /proc/<pid> directory.

    See _iter_child_pids.
    """
    return tuple(_iter_child_pids(proc_fd, pid))


def _read_own_child_pids() -> Tuple[int, ...]:
    """Return the children of this process from the host procfs."""
    pid = os.getpid()
    proc_fd = _open_process_dir(pid)
    try:
        return _read_child_pids(proc_fd, pid)
    finally:
        os.close(proc_fd)


def _entry_error(exc: BaseException) -> None:
    """Report a container entry failure on stderr without control characters."""
    try:
        sys.stderr.write(
            f"E: Container entry failed: {_terminal_safe_repr(str(exc))}\n"
        )
        sys.stderr.flush()
    except (OSError, ValueError):
        pass


def _wait_ending_attach_on_signal(child: int, attach_kill_fd: int) -> int:
    """Wait for child; on SIGHUP or SIGTERM end the whole attach.

    SIGHUP means that the terminal is gone. SIGTERM also comes from the
    parent-death signal when the sandy process that started this helper
    exits. Both end every process in the attach leaf, this one included. If
    the kill fails, pass the signal on to the child.

    The caller blocks ENTRY_END_SIGNALS before it forks, so a signal that
    arrives before the handler exists stays pending until the unblock below.
    """

    def end_attach(signum: int, frame: Any) -> None:
        _ = frame
        try:
            os.write(attach_kill_fd, b"1")
        except OSError:
            try:
                os.kill(child, signum)
            except ProcessLookupError:
                pass

    for signum in ENTRY_END_SIGNALS:
        signal.signal(signum, end_attach)
    signal.pthread_sigmask(signal.SIG_UNBLOCK, ENTRY_END_SIGNALS)
    _, status = os.waitpid(child, 0)
    return status


def _propagate_wait_status(status: int) -> int:
    """Return the exit code of status, or end this process with its signal."""
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        signum = os.WTERMSIG(status)
        # SIGKILL cannot be caught or blocked, and signal.signal() rejects it.
        if signum != signal.SIGKILL:
            signal.signal(signum, signal.SIG_DFL)
            signal.pthread_sigmask(signal.SIG_UNBLOCK, {signum})
        os.kill(os.getpid(), signum)
        # The default action of this signal does not end the process.
        return min(128 + signum, 255)
    return ENTRY_HELPER_FAILURE


def _confine_and_exec(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> NoReturn:
    """In the container PID namespace: confine this process, then exec.

    Order: bounding set, then seccomp while still namespaced root (the filters
    need CAP_SYS_ADMIN, and no_new_privs stays 0 as on the up path), then the
    ids. The filters are installed oldest first. The account files are read
    at attach time, as su and nspawn do, and only after the filters are in
    place, because container root controls them.

    No step returns an error code to check: the syscall wrappers raise
    through _entry_syscall, the os functions raise OSError, and the bounding
    set is read back. Any failure reaches the except clause, which ends this
    process with ENTRY_HELPER_FAILURE before execve.
    """
    try:
        mask = confinement.capability_bounding_set
        for capability in range(cap_last + 1):
            if not mask & (1 << capability):
                _capbset_drop(capability)
        for capability in range(cap_last + 1):
            if _capbset_read(capability) != bool(mask & (1 << capability)):
                raise PermissionError("Capability bounding set does not match")
        for program in confinement.seccomp_filters:
            _seccomp_set_mode_filter(program)
        uid, gid, groups = _resolve_container_identity(
            request.user,
            _read_container_account_file("/etc/passwd"),
            _read_container_account_file("/etc/group"),
        )
        os.setgroups(list(groups))
        os.setresgid(gid, gid, gid)
        os.setresuid(uid, uid, uid)
        os.chdir(request.workdir)
        argv = _entry_exec_argv(request)
        for signum in ENTRY_RESET_SIGNALS:
            signal.signal(signum, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_SETMASK, set())
        os.execve(argv[0], argv, dict(environment))
    except BaseException as exc:
        _entry_error(exc)
    os._exit(ENTRY_HELPER_FAILURE)


def _enter_namespaces_and_fork(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> NoReturn:
    """Middle process: join the pinned namespaces, fork, and exit.

    The child is the first process in the container's PID namespace. This
    process exits at once, so the child is reparented to the helper, which is
    a child subreaper. Until then this process is in the host PID namespace,
    so it must not keep host uid 0, and it must not run code from the
    container's filesystem.
    """
    code = ENTRY_HELPER_FAILURE
    try:
        # After setns(CLONE_NEWNS), an import would load a module from the
        # container's filesystem, which container root controls. Nothing below
        # imports; make any later import fail instead.
        sys.meta_path.clear()
        sys.path.clear()
        # Only the helper ends the attach leaf.
        _close_fds((confinement.attach_kill_fd,))
        for fd, (_, nstype) in zip(confinement.namespace_fds, NAMESPACE_ENTRY_ORDER):
            _setns(fd, nstype)
        # setns(CLONE_NEWUSER) keeps host uid 0, which may signal every host
        # root process from this PID namespace. Become container root, which
        # keeps the capabilities that the child needs in the container's user
        # namespace.
        os.setgroups([])
        os.setresgid(0, 0, 0)
        os.setresuid(0, 0, 0)
        _close_fds((confinement.pidfd,) + confinement.namespace_fds)
        # setns(CLONE_NEWPID) applies only to children.
        child = os.fork()
        if child == 0:
            _confine_and_exec(request, environment, confinement, cap_last)
        code = 0
    except BaseException as exc:
        _entry_error(exc)
    finally:
        os._exit(code)


def _run_confined_entry(
    request: EntryRequest,
    environment: Mapping[str, str],
    confinement: LeaderConfinement,
    cap_last: int,
) -> int:
    """Start the session through the middle process, then wait for it.

    The helper is a child subreaper, so the session becomes its child when the
    middle process exits. Orphans inside the container go to the container's
    PID 1, not to the helper. The helper, the middle process, and the session
    are all in the attach leaf. The helper keeps only the leaf's cgroup.kill
    descriptor.
    """
    signal.pthread_sigmask(signal.SIG_BLOCK, ENTRY_END_SIGNALS)
    for signum in ENTRY_WAIT_IGNORED_SIGNALS:
        signal.signal(signum, signal.SIG_IGN)
    try:
        _set_child_subreaper()
        middle = os.fork()
    except OSError as exc:
        _close_leader_confinement(confinement)
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if middle == 0:
        _enter_namespaces_and_fork(request, environment, confinement, cap_last)
    _close_fds((confinement.pidfd,) + confinement.namespace_fds)
    _, middle_status = os.waitpid(middle, 0)
    if not os.WIFEXITED(middle_status) or os.WEXITSTATUS(middle_status) != 0:
        # The middle process failed before or at its fork and reported why.
        return _propagate_wait_status(middle_status)
    try:
        children = _read_own_child_pids()
    except (OSError, ValueError) as exc:
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if len(children) != 1:
        # These are this process's own unreaped children, so their PIDs
        # cannot have been reused.
        for pid in children:
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        _entry_error(RuntimeError("Expected exactly one container session process"))
        return ENTRY_HELPER_FAILURE
    return _propagate_wait_status(
        _wait_ending_attach_on_signal(children[0], confinement.attach_kill_fd)
    )


def _entry_helper_main(argv: list) -> int:
    """Run the internal entry helper mode and return its exit code."""
    try:
        if os.geteuid() != 0:
            raise PermissionError("Entry helper requires root")
        # fork from a threaded interpreter is unsafe, and setns(CLONE_NEWUSER)
        # fails in a multithreaded process.
        if threading.active_count() != 1:
            raise RuntimeError("Entry helper must be single-threaded")
        if len(argv) < 2 or argv[1] != ENTRY_HELPER_MODE:
            raise ValueError("Invalid entry helper mode")
        script_fd = _verify_entry_helper_fds(argv[0])
        os.close(script_fd)
        request = _parse_entry_request(argv[2:])
        # End the attach when the sandy process that started this helper
        # exits for any reason, SIGKILL included. The parent may have exited
        # before the prctl; then this process has a new parent.
        _set_parent_death_signal(signal.SIGTERM)
        if os.getppid() != request.parent_pid:
            raise ProcessLookupError("Sandy exited before the entry helper started")
        environment = _container_environment(request.user, request.home)
        cap_last = _read_cap_last_cap()
        confinement = _extract_leader_confinement(
            request.machine, request.leader_pid, request.attach_leaf
        )
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
        _entry_error(exc)
        return ENTRY_HELPER_FAILURE
    if confinement.capability_bounding_set >> (cap_last + 1):
        _close_leader_confinement(confinement)
        _entry_error(PermissionError("CapBnd has unknown capabilities"))
        return ENTRY_HELPER_FAILURE
    return _run_confined_entry(request, environment, confinement, cap_last)


def _check_systemd_version():
    """Check systemd version and return version number"""
    try:
        result = _run_secure_subprocess(
            ["systemd-nspawn", "--version"], capture_output=True, text=True, check=True
        )
        # Parse version from output like "systemd 252 (252.19-1~deb12u1)"
        for line in result.stdout.split("\n"):
            if line.startswith("systemd "):
                version_str = line.split()[1]
                version = int(version_str.split(".")[0])
                return version
    except (subprocess.CalledProcessError, ValueError, IndexError) as e:
        print(f"W: Could not determine systemd version: {_terminal_safe_repr(str(e))}")

    print(
        "W: Could not determine systemd version, assuming older version where --private-users-ownership=auto not supported"
    )
    return 0  # Return 0 if version cannot be determined


def _create_guest_files(
    mdir: str,
    container_name: str,
    network_cidr: Optional[str] = None,
    gateway: Optional[str] = None,
):
    """Create /etc/hosts file and network initialization script for container"""
    hosts_path = os.path.join(mdir, "etc", "hosts")
    hosts_content = f"127.0.0.1 localhost {container_name}\n"
    print(f"I: Creating /etc/hosts with:\n{hosts_content}")
    _write(hosts_path, hosts_content, mode=0o0644)

    # nspawn's --timezone=auto is a bit non-deterministic, so unconditionally
    # create the file in the container so we can always call with
    # --timezone=bind and have something to bind on
    localtime_path = os.path.join(mdir, "etc", "localtime")
    if not os.path.exists(localtime_path):
        utc_host_path = "/usr/share/zoneinfo/UTC"
        localtime_content = ""
        if os.path.exists(utc_host_path):
            with open(utc_host_path, "r") as f:
                localtime_content = f.read()
            print(f"I: Copying {utc_host_path} from host to /etc/localtime in guest")
        else:
            print(f"I: Creating empty /etc/localtime in guest")
        _write(localtime_path, localtime_content, mode=0o0644)

    # Create network initialization script if network configuration is provided
    if network_cidr and gateway:
        # Validate network configuration for security
        if not _validate_network_cidr(network_cidr):
            print(
                f"W: Invalid network CIDR '{_strip_control_characters(network_cidr)}', skipping /init.sh creation"
            )
            return

        if not _validate_ip_address(gateway):
            print(
                f"W: Invalid gateway IP '{_strip_control_characters(gateway)}', skipping /init.sh creation"
            )
            return

        try:
            # Parse network to get available IPs
            network = ipaddress.ip_network(network_cidr)
        except (ValueError, ipaddress.AddressValueError) as e:
            print(
                "W: Invalid network configuration, skipping /init.sh creation: "
                f"{_terminal_safe_repr(str(e))}"
            )
            return

        # Hold the address lock from the scan until the new /init.sh exists,
        # so that the scan of another build finds this address. The messages
        # wait until the release: a stopped terminal must not hold the lock.
        messages: list[str] = []
        init_script_content: Optional[str] = None
        with _addresses_lock():
            # Find used IP addresses by scanning existing init.sh files. Root
            # in each container controls its image, so read each file through
            # the pinned image root, with no link and with a size limit. A
            # file that is not safe to read reserves no address.
            used_ips = set()
            if os.path.exists(SYSTEMD_MACHINES):
                for container_dir in glob.glob(f"{SYSTEMD_MACHINES}/sandy.*"):
                    # Skip cache directory
                    if container_dir.endswith(".__cache"):
                        continue

                    try:
                        address = _read_machine_container_ip(container_dir)
                    except (OSError, ValueError) as exc:
                        init_script = os.path.join(container_dir, "init.sh")
                        messages.append(
                            "W: Did not reserve the address in "
                            f"{_terminal_safe_repr(init_script)}: "
                            f"{_terminal_safe_repr(str(exc))}"
                        )
                        continue
                    if address is not None:
                        used_ip = ipaddress.ip_address(address)
                        if used_ip in network:
                            used_ips.add(used_ip)

            # Find first available IP starting from .10
            container_ip = None
            for i in range(
                10, 254
            ):  # Skip .1-.9 (reserved for gateway/infrastructure), .255 (broadcast)
                candidate_ip = network.network_address + i
                if (
                    candidate_ip not in used_ips
                    and candidate_ip != ipaddress.ip_address(gateway)
                ):
                    container_ip = str(candidate_ip)
                    break

            if container_ip is not None:
                init_script_path = os.path.join(mdir, "init.sh")
                # Extract network prefix (e.g., "24" from the CIDR)
                prefix_len = network.prefixlen
                init_script_content = f"""#!/bin/sh
set -e
# Container network initialization script
# Generated automatically by sandy

# Network configuration variables
CONTAINER_IP="{container_ip}"
NETWORK_PREFIX="{prefix_len}"
GATEWAY_IP="{gateway}"

# Wait for host0 interface to appear (max 10 seconds)
RETRY_COUNT=0
MAX_RETRIES=10
while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
    if ip link show host0 >/dev/null 2>&1; then
        break
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
        echo "ERROR: host0 interface not found after $MAX_RETRIES seconds" >&2
        exit 1
    fi
    sleep 1
done

ip addr add ${{CONTAINER_IP}}/${{NETWORK_PREFIX}} dev host0
ip link set host0 up
ip route add default via ${{GATEWAY_IP}}
rm -f -- /etc/resolv.conf
printf '%s\\n' 'nameserver 1.1.1.1' 'nameserver 1.0.0.1' > /etc/resolv.conf
"""
                _write(init_script_path, init_script_content, mode=0o0755)

        for message in messages:
            print(message)
        if init_script_content is None:
            print(
                "W: No available IP addresses in network range, skipping /init.sh creation"
            )
            return
        print(f"I: Creating /init.sh with:\n{init_script_content}")


def _nft_port_rule_comment(container_name: str, proto: str, host_port: int) -> str:
    """Return the comment that marks the nftables rules of one port mapping."""
    if not _validate_container_name(container_name):
        raise ValueError("Invalid container name")
    if proto not in ("tcp", "udp"):
        raise ValueError("Invalid port mapping protocol")
    if (
        not isinstance(host_port, int)
        or isinstance(host_port, bool)
        or not 1 <= host_port <= 65535
    ):
        raise ValueError("Invalid port mapping host port")
    return f"sandy:{container_name}:{proto}:{host_port}"


def _parse_nft_rule_handles(output: str, chain: str, comment: str) -> list:
    """Return the handles of the rules in `nft -j -a list chain ip sandy <chain>`
    output whose comment is exactly comment. Reject malformed output."""
    if len(output) > NFT_LIST_MAX_BYTES:
        raise ValueError("nft output is too large")
    try:
        document = json.loads(output)
    except ValueError as exc:
        raise ValueError("nft output is not JSON") from exc
    items = document.get("nftables") if isinstance(document, dict) else None
    if not isinstance(items, list):
        raise ValueError("nft output has no nftables list")
    handles = []
    for item in items:
        if not isinstance(item, dict) or "rule" not in item:
            continue
        rule = item["rule"]
        if not isinstance(rule, dict):
            raise ValueError("Malformed nft rule")
        if rule.get("comment") != comment:
            continue
        if (rule.get("family"), rule.get("table"), rule.get("chain")) != (
            "ip",
            "sandy",
            chain,
        ):
            raise ValueError("nft rule from an unexpected chain")
        handle = rule.get("handle")
        if not isinstance(handle, int) or isinstance(handle, bool) or handle <= 0:
            raise ValueError("Malformed nft rule handle")
        handles.append(handle)
    return handles


class SandyNet:
    """Manages network bridge and NAT configuration for containers"""

    # Private networks to block for container isolation
    PRIVATE_NETWORKS = [
        "10.0.0.0/8",  # RFC 1918
        "172.16.0.0/12",  # RFC 1918
        "192.168.0.0/16",  # RFC 1918
        "169.254.0.0/16",  # Link-local
    ]

    # IPv6 private networks to block for container isolation
    IPV6_PRIVATE_NETWORKS = [
        "fe80::/10",  # Link-local addresses
        "fc00::/7",  # Unique local addresses
    ]

    def __init__(
        self,
        planned_network_info: Optional[NetworkInfo] = None,
        *,
        create: bool = True,
    ):
        """Detect the Sandy network, and create it when create is True.

        With create=False, only inspect the host: configured is True only
        when the bridge exists, and nothing is created or changed.
        """
        self.bridge_name = "sandybr0"
        self.network: Optional[str] = None
        self.network_cidr: Optional[str] = None
        self.gateway: Optional[str] = None
        self.configured = False

        # Detect firewall backend: prefer iptables, fallback to nftables
        self.has_iptables = shutil.which("iptables") is not None
        self.has_ip6tables = shutil.which("ip6tables") is not None
        self.has_nft = shutil.which("nft") is not None

        # Determine which firewall backend to use
        if self.has_iptables:
            self.firewall_backend = "iptables"
        elif self.has_nft:
            self.firewall_backend = "nftables"
            print("I: iptables not available, using nftables")
        else:
            print("E: Neither iptables nor nftables available")
            self.firewall_backend = None

        # Check if bridge already exists
        if self._bridge_exists():
            if self._detect_existing_config():
                self.configured = True
            else:
                print(f"W: Could not detect network config for existing bridge")
            return

        if not create:
            return

        # Create and configure new bridge
        if self._setup_bridge(planned_network_info):
            self.configured = True
            print(
                f"I: Created bridge with network: {self.network_cidr} gateway: {self.gateway}"
            )
        else:
            print(f"W: Failed to setup bridge network")

    @classmethod
    def preview_bridge_network(
        cls,
    ) -> Tuple[GuestNetwork, Optional[NetworkInfo]]:
        """Return lenient guest networking data without mutating host networking."""
        preview = object.__new__(cls)
        preview.bridge_name = "sandybr0"
        preview.network = None
        preview.network_cidr = None
        preview.gateway = None
        preview.configured = False
        preview.has_iptables = False
        preview.has_ip6tables = False
        preview.has_nft = False
        preview.firewall_backend = None

        if preview._bridge_exists():
            if preview._detect_existing_config():
                if (
                    not preview.network_cidr
                    or not preview.gateway
                    or not _validate_network_cidr(preview.network_cidr)
                    or not _validate_ip_address(preview.gateway)
                ):
                    raise PermissionError("Invalid Sandy network configuration")
                return (preview.network_cidr, preview.gateway), None
            raise PermissionError("Could not detect Sandy network configuration")

        planned_network_info = preview._find_unused_network()
        if planned_network_info is None:
            raise PermissionError("Could not find unused network in 10.0.0.0/8 range")
        network, network_cidr, gateway = planned_network_info
        if (
            not _validate_ip_address(network)
            or not _validate_network_cidr(network_cidr)
            or not _validate_ip_address(gateway)
        ):
            raise PermissionError("Invalid Sandy network plan")
        return (network_cidr, gateway), planned_network_info

    def _bridge_exists(self) -> bool:
        """Check if the bridge interface already exists"""
        try:
            result = _run_secure_subprocess(
                ["ip", "link", "show", self.bridge_name],
                capture_output=True,
                text=True,
                check=False,
            )
            return result.returncode == 0
        except (subprocess.CalledProcessError, FileNotFoundError):
            return False

    def _detect_existing_config(self) -> bool:
        """Detect network configuration of existing bridge"""
        return self._ensure_gateway()

    def _ensure_gateway(self) -> bool:
        """Ensure bridge gateway details are populated."""
        if self.gateway and self.network_cidr:
            return True

        try:
            result = _run_secure_subprocess(
                ["ip", "-j", "addr", "show", self.bridge_name],
                capture_output=True,
                text=True,
                check=True,
            )
        except subprocess.CalledProcessError as e:
            err_output = e.stderr or e.stdout or str(e)
            print(
                f"E: Failed to query bridge '{_strip_control_characters(self.bridge_name)}' address: {_terminal_safe_repr(str(err_output))}"
            )
            return False
        except Exception as e:
            print(
                f"E: Error querying bridge '{_strip_control_characters(self.bridge_name)}' address: {_terminal_safe_repr(str(e))}"
            )
            return False

        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError as e:
            print(
                f"E: Could not decode address data for '{_strip_control_characters(self.bridge_name)}': {_terminal_safe_repr(str(e))}"
            )
            return False

        for iface in data:
            if iface.get("ifname") != self.bridge_name:
                continue
            for addr in iface.get("addr_info", []):
                if addr.get("family") != "inet":
                    continue
                local = addr.get("local")
                prefixlen = addr.get("prefixlen")
                if not local or prefixlen is None:
                    continue
                try:
                    interface = ipaddress.ip_interface(f"{local}/{prefixlen}")
                except ValueError:
                    continue
                self.gateway = str(interface.ip)
                self.network = str(interface.network.network_address)
                self.network_cidr = str(interface.network)
                return True

        print(
            f"E: No IPv4 gateway detected for bridge '{_strip_control_characters(self.bridge_name)}'"
        )
        return False

    def _get_seed_from_machine_id(self) -> int:
        """Generate seed from /etc/machine-id"""
        try:
            with open("/etc/machine-id", "r") as f:
                machine_id = f.read().strip()
            # Use first 8 chars for seed (32-bit value)
            seed_str = machine_id[:8]
            return int(seed_str, 16)
        except (FileNotFoundError, ValueError):
            # Fallback to a default seed if machine-id is unavailable
            print("W: Could not read /etc/machine-id, using fallback seed")
            return 0xDEADBEEF

    def _check_network_conflict(self, network_cidr: str) -> bool:
        """Check if a network conflicts with existing routes or addresses"""

        try:
            test_net = ipaddress.ip_network(network_cidr)
        except Exception as e:
            print(f"W: Error checking network conflict: {_terminal_safe_repr(str(e))}")
            return True  # Assume conflict on error

        # Check routing table
        result = _run_secure_subprocess(
            ["ip", "route", "show"], capture_output=True, text=True, check=True
        )

        for line in result.stdout.split("\n"):
            if line.strip():
                # Parse network from route entry
                parts = line.split()
                if parts:
                    try:
                        # First part is usually the network
                        existing_net = ipaddress.ip_network(parts[0], strict=False)
                        if existing_net.overlaps(test_net):
                            return True
                    except ValueError:
                        # Not a valid network, skip
                        continue

        # Check existing addresses
        result = _run_secure_subprocess(
            ["ip", "addr", "show"], capture_output=True, text=True, check=True
        )

        for line in result.stdout.split("\n"):
            if "inet " in line:
                parts = line.strip().split()
                if len(parts) >= 2:
                    try:
                        existing_if = ipaddress.ip_interface(parts[1])
                        if existing_if.network.overlaps(test_net):
                            return True
                    except ValueError:
                        continue

        return False

    def _find_unused_network(self) -> Optional[Tuple[str, str, str]]:
        """Find an unused /24 network in 10.0.0.0/8 range"""
        seed = self._get_seed_from_machine_id()
        rng = random.Random(seed)

        # Try up to 100 different networks
        for _ in range(100):
            # Generate 10.{128-255}.{0-255}.0/24
            octet2 = rng.randint(128, 255)
            octet3 = rng.randint(0, 255)

            network = f"10.{octet2}.{octet3}.0"
            network_cidr = f"{network}/24"
            gateway = f"10.{octet2}.{octet3}.1"

            if not self._check_network_conflict(network_cidr):
                return (network, network_cidr, gateway)

        return None

    def _create_bridge(self) -> bool:
        """Create the bridge interface"""
        try:
            # Create bridge
            result = _run_secure_subprocess(
                ["ip", "link", "add", "name", self.bridge_name, "type", "bridge"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to create bridge: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            # Bring bridge up
            result = _run_secure_subprocess(
                ["ip", "link", "set", self.bridge_name, "up"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to bring bridge up: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            return True
        except Exception as e:
            print(f"E: Error creating bridge: {_terminal_safe_repr(str(e))}")
            return False

    def _configure_bridge_ip(self, gateway: str) -> bool:
        """Add IP address to the bridge"""
        try:
            # Add IP address
            result = _run_secure_subprocess(
                ["ip", "addr", "add", f"{gateway}/24", "dev", self.bridge_name],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"E: Failed to add IP to bridge: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False

            return True
        except Exception as e:
            print(f"E: Error configuring bridge IP: {_terminal_safe_repr(str(e))}")
            return False

    def _enable_ip_forwarding(self) -> bool:
        """Enable IP forwarding"""
        try:
            result = _run_secure_subprocess(
                ["sysctl", "-w", "net.ipv4.ip_forward=1"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"W: Failed to enable IP forwarding: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False
            return True
        except Exception as e:
            print(f"W: Error enabling IP forwarding: {_terminal_safe_repr(str(e))}")
            return False

    def _enable_route_localnet(self) -> bool:
        """Enable routing the localnet for this bridge"""
        try:
            result = _run_secure_subprocess(
                ["sysctl", "-w", f"net.ipv4.conf.{self.bridge_name}.route_localnet=1"],
                capture_output=True,
                text=True,
                check=False,
            )
            if result.returncode != 0:
                print(
                    f"W: Failed to enable route_localnet for '{self.bridge_name}': {_terminal_safe_repr(str(result.stderr))}"
                )
                return False
            return True
        except Exception as e:
            print(
                f"W: Error enabling route_localnet for '{self.bridge_name}': {_terminal_safe_repr(str(e))}"
            )
            return False

    def _run_iptables(
        self,
        *args,
        table: Optional[str] = None,
        error_prefix: str = "iptables operation",
    ) -> bool:
        """Helper method to run iptables commands with consistent error handling"""
        cmd = ["iptables"]
        if table:
            cmd.extend(["-t", table])
        cmd.extend(args)

        try:
            result = _run_secure_subprocess(
                cmd, capture_output=True, text=True, check=False
            )
            if result.returncode != 0:
                print(
                    f"W: {error_prefix} failed: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False
            return True
        except Exception as e:
            print(f"W: Error running {error_prefix}: {_terminal_safe_repr(str(e))}")
            return False

    def _run_ip6tables(
        self,
        *args,
        table: Optional[str] = None,
        error_prefix: str = "ip6tables operation",
    ) -> bool:
        """Helper method to run ip6tables commands with consistent error handling"""
        cmd = ["ip6tables"]
        if table:
            cmd.extend(["-t", table])
        cmd.extend(args)

        try:
            result = _run_secure_subprocess(
                cmd, capture_output=True, text=True, check=False
            )
            if result.returncode != 0:
                print(
                    f"W: {error_prefix} failed: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False
            return True
        except Exception as e:
            print(f"W: Error running {error_prefix}: {_terminal_safe_repr(str(e))}")
            return False

    def _iptables_chain_exists(self, chain: str, table: Optional[str] = None) -> bool:
        """Check if an iptables chain exists"""
        cmd = ["iptables"]
        if table:
            cmd.extend(["-t", table])
        cmd.extend(["-L", chain, "-n"])

        try:
            result = _run_secure_subprocess(
                cmd, capture_output=True, text=True, check=False
            )
            return result.returncode == 0
        except Exception:
            return False

    def _ip6tables_chain_exists(self, chain: str, table: Optional[str] = None) -> bool:
        """Check if an ip6tables chain exists"""
        cmd = ["ip6tables"]
        if table:
            cmd.extend(["-t", table])
        cmd.extend(["-L", chain, "-n"])

        try:
            result = _run_secure_subprocess(
                cmd, capture_output=True, text=True, check=False
            )
            return result.returncode == 0
        except Exception:
            return False

    def _run_nft(self, *args, error_prefix: str = "nft operation") -> bool:
        """Helper method to run nft commands with consistent error handling"""
        cmd = ["nft"] + list(args)

        try:
            result = _run_secure_subprocess(
                cmd, capture_output=True, text=True, check=False
            )
            if result.returncode != 0:
                print(
                    f"W: {error_prefix} failed: {_terminal_safe_repr(str(result.stderr))}"
                )
                return False
            return True
        except Exception as e:
            print(f"W: Error running {error_prefix}: {_terminal_safe_repr(str(e))}")
            return False

    def _nft_table_exists(self, family: str, table: str) -> bool:
        """Check if an nftables table exists"""
        try:
            result = _run_secure_subprocess(
                ["nft", "list", "table", family, table],
                capture_output=True,
                text=True,
                check=False,
            )
            return result.returncode == 0
        except Exception:
            return False

    def _nft_chain_exists(self, family: str, table: str, chain: str) -> bool:
        """Check if an nftables chain exists"""
        try:
            result = _run_secure_subprocess(
                ["nft", "list", "chain", family, table, chain],
                capture_output=True,
                text=True,
                check=False,
            )
            return result.returncode == 0
        except Exception:
            return False

    def _setup_nftables_base(self) -> bool:
        """Create base nftables tables and chains"""
        try:
            # Create table if it doesn't exist
            if not self._nft_table_exists("ip", "sandy"):
                self._run_nft(
                    "add", "table", "ip", "sandy", error_prefix="Create IPv4 table"
                )

            # Create chains for NAT
            if not self._nft_chain_exists("ip", "sandy", "postrouting"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip",
                    "sandy",
                    "postrouting",
                    "{",
                    "type",
                    "nat",
                    "hook",
                    "postrouting",
                    "priority",
                    "srcnat",
                    ";",
                    "}",
                    error_prefix="Create postrouting chain",
                )

            # Create chains for PREROUTING (for port forwarding DNAT)
            if not self._nft_chain_exists("ip", "sandy", "prerouting"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip",
                    "sandy",
                    "prerouting",
                    "{",
                    "type",
                    "nat",
                    "hook",
                    "prerouting",
                    "priority",
                    "dstnat",
                    ";",
                    "}",
                    error_prefix="Create prerouting chain",
                )

            # Create chains for OUTPUT NAT (for host-generated traffic DNAT).
            # nft 1.0.2 rejects "priority dstnat" for the output hook; -100 is
            # the same value and works with nft 1.0.2, 1.0.9, and 1.1.3.
            if not self._nft_chain_exists("ip", "sandy", "output"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip",
                    "sandy",
                    "output",
                    "{",
                    "type",
                    "nat",
                    "hook",
                    "output",
                    "priority",
                    "-100",
                    ";",
                    "}",
                    error_prefix="Create output NAT chain",
                )

            # Create chains for forwarding
            if not self._nft_chain_exists("ip", "sandy", "forward"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip",
                    "sandy",
                    "forward",
                    "{",
                    "type",
                    "filter",
                    "hook",
                    "forward",
                    "priority",
                    "filter",
                    ";",
                    "}",
                    error_prefix="Create forward chain",
                )

            # Create chains for OUTPUT filter (host->container traffic control)
            if not self._nft_chain_exists("ip", "sandy", "output_filter"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip",
                    "sandy",
                    "output_filter",
                    "{",
                    "type",
                    "filter",
                    "hook",
                    "output",
                    "priority",
                    "filter",
                    ";",
                    "}",
                    error_prefix="Create output filter chain",
                )

            # Create IPv6 table if ip6 support is needed
            if not self._nft_table_exists("ip6", "sandy"):
                self._run_nft(
                    "add", "table", "ip6", "sandy", error_prefix="Create IPv6 table"
                )

            # Create IPv6 forward chain
            if not self._nft_chain_exists("ip6", "sandy", "forward"):
                self._run_nft(
                    "add",
                    "chain",
                    "ip6",
                    "sandy",
                    "forward",
                    "{",
                    "type",
                    "filter",
                    "hook",
                    "forward",
                    "priority",
                    "filter",
                    ";",
                    "}",
                    error_prefix="Create IPv6 forward chain",
                )

            return True
        except Exception as e:
            print(f"E: Error setting up nftables base: {_terminal_safe_repr(str(e))}")
            return False

    def _setup_iptables_chains(self, network_cidr) -> bool:
        """Create or flush iptables chains"""
        if not self._ensure_gateway():
            print(
                f"E: Could not determine gateway for bridge '{_strip_control_characters(self.bridge_name)}'"
            )
            return False

        if not self.gateway:
            print(
                f"E: Gateway value missing for bridge '{_strip_control_characters(self.bridge_name)}'"
            )
            return False

        try:
            # Handle sandy-nat-post chain in NAT table
            if self._iptables_chain_exists("sandy-nat-post", "nat"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Flush sandy-nat-post chain",
                )
                self._run_iptables(
                    "-Z",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Zero sandy-nat-post chain",
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Create sandy-nat-post chain",
                )

                # Insert jump rule for -s network_cidr at top of POSTROUTING
                self._run_iptables(
                    "-I",
                    "POSTROUTING",
                    "-s",
                    network_cidr,
                    "-j",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Insert POSTROUTING jump rule",
                )

                # Insert jump rule for -o bridge_name -s 127.0.0.1/8 at top of
                # POSTROUTING for localhost
                self._run_iptables(
                    "-I",
                    "POSTROUTING",
                    "-o",
                    self.bridge_name,
                    "-s",
                    "127.0.0.1/8",
                    "-j",
                    "sandy-nat-post",
                    table="nat",
                    error_prefix="Insert POSTROUTING jump rule",
                )

            # Handle sandy-nat-out chain in NAT table (for OUTPUT DNAT)
            if self._iptables_chain_exists("sandy-nat-out", "nat"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Flush sandy-nat-out chain",
                )
                self._run_iptables(
                    "-Z",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Zero sandy-nat-out chain",
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Create sandy-nat-out chain",
                )

                # Insert jump rule at top of OUTPUT
                self._run_iptables(
                    "-I",
                    "OUTPUT",
                    "-j",
                    "sandy-nat-out",
                    table="nat",
                    error_prefix="Insert OUTPUT jump rule for NAT",
                )

            # Handle sandy-nat-pre chain in NAT table (for PREROUTING DNAT)
            if self._iptables_chain_exists("sandy-nat-pre", "nat"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Flush sandy-nat-pre chain",
                )
                self._run_iptables(
                    "-Z",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Zero sandy-nat-pre chain",
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Create sandy-nat-pre chain",
                )

                # Insert jump rule at top of PREROUTING
                self._run_iptables(
                    "-I",
                    "PREROUTING",
                    "-j",
                    "sandy-nat-pre",
                    table="nat",
                    error_prefix="Insert PREROUTING jump rule for NAT",
                )

            # Handle sandy-rej chain in filter table (for logging and rejecting)
            if self._iptables_chain_exists("sandy-rej"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F", "sandy-rej", error_prefix="Flush sandy-rej chain"
                )
                self._run_iptables(
                    "-Z", "sandy-rej", error_prefix="Zero sandy-rej chain"
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N", "sandy-rej", error_prefix="Create sandy-rej chain"
                )

            # Add LOG and REJECT rules to sandy-rej chain
            self._run_iptables(
                "-A",
                "sandy-rej",
                "-j",
                "LOG",
                "--log-prefix",
                "[SNDY-BLOCK] ",
                error_prefix="Add LOG rule to sandy-rej",
            )
            self._run_iptables(
                "-A",
                "sandy-rej",
                "-j",
                "REJECT",
                error_prefix="Add REJECT rule to sandy-rej",
            )

            # Handle sandy-fwd chain in filter table
            if self._iptables_chain_exists("sandy-fwd"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F", "sandy-fwd", error_prefix="Flush sandy-fwd chain"
                )
                self._run_iptables(
                    "-Z", "sandy-fwd", error_prefix="Zero sandy-fwd chain"
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N", "sandy-fwd", error_prefix="Create sandy-fwd chain"
                )

                # Insert jump rule at top of FORWARD
                self._run_iptables(
                    "-I",
                    "FORWARD",
                    "-i",
                    self.bridge_name,
                    "-s",
                    network_cidr,
                    "-j",
                    "sandy-fwd",
                    error_prefix="Insert FORWARD jump rule",
                )

            # Handle sandy-out chain in filter table (for host->container traffic control)
            if self._iptables_chain_exists("sandy-out"):
                # Chain exists, flush and zero it
                self._run_iptables(
                    "-F", "sandy-out", error_prefix="Flush sandy-out chain"
                )
                self._run_iptables(
                    "-Z", "sandy-out", error_prefix="Zero sandy-out chain"
                )
            else:
                # Create new chain
                self._run_iptables(
                    "-N", "sandy-out", error_prefix="Create sandy-out chain"
                )

                # Insert jump rule to OUTPUT
                # Rule for bridge interface (gateway -> container network)
                self._run_iptables(
                    "-I",
                    "OUTPUT",
                    "-o",
                    self.bridge_name,
                    "-s",
                    self.gateway,
                    "-d",
                    network_cidr,
                    "-j",
                    "sandy-out",
                    error_prefix="Append OUTPUT jump rule (bridge)",
                )

            return True
        except Exception as e:
            print(f"E: Error setting up iptables chains: {_terminal_safe_repr(str(e))}")
            return False

    # TODO: currently we setup private networking with a bridge, then add
    # firewall rules to the bridge for isolation. Currently:
    # - deny to RFC1918 networks travelling through the bridge
    # - allow everything leaving the bridge
    #
    # This provides reasonable host and local network protection, but doesn't
    # limit what agents can talk to. Eventually add some sort of configuration
    # for this (perhaps use systemd-nspawn's IPAllowList and IPDenyList,
    # perhaps not). This might look like:
    #
    # 1. creating a per-container chain named sandy-hostN (where 'N' is the
    #    last octet of the ip address
    # 2. adding per-container rules (eg, -j REJECT rule at the end with
    #    whatever ACCEPT rules are desired)
    # 3. managing sandy-fwd to '-I sandy-fwd -s 10.x.y.N -j sandy-hostN' when the
    #    container is brought up, remove it when removed, etc
    def _setup_ipv4_firewall_ipt(self, network_cidr: str) -> bool:
        """Configure NAT and forwarding rules"""
        try:
            # Add MASQUERADE rule
            # Note: The original requirement had "-o sandybr0" but for NAT we typically
            # want to masquerade on the outbound interface (not the bridge).
            # Using ! -o sandybr0 to masquerade on all interfaces except the bridge
            self._run_iptables(
                "-A",
                "sandy-nat-post",
                "-s",
                network_cidr,
                "!",
                "-d",
                network_cidr,
                "!",
                "-o",
                self.bridge_name,
                "-j",
                "MASQUERADE",
                table="nat",
                error_prefix="Add MASQUERADE rule",
            )

            # Block access to private IP ranges (insert at beginning of chain)
            rule_number = 1
            for net in self.PRIVATE_NETWORKS:
                # Jump to sandy-rej chain for logging and rejecting
                self._run_iptables(
                    "-I",
                    "sandy-fwd",
                    str(rule_number),
                    "-i",
                    self.bridge_name,
                    "-d",
                    net,
                    "-j",
                    "sandy-rej",
                    error_prefix=f"Block access to {net}",
                )
                rule_number += 1

            # Add FORWARD rules for established connections
            self._run_iptables(
                "-A",
                "sandy-fwd",
                "-m",
                "conntrack",
                "--ctstate",
                "RELATED,ESTABLISHED",
                "-i",
                self.bridge_name,
                "-j",
                "ACCEPT",
                error_prefix="Add conntrack FORWARD rule",
            )

            # Add FORWARD rule for new connections from bridge (to public IPs only)
            self._run_iptables(
                "-A",
                "sandy-fwd",
                "-i",
                self.bridge_name,
                "-s",
                network_cidr,
                "-j",
                "ACCEPT",
                error_prefix="Add bridge FORWARD rule",
            )

            # Add OUTPUT rules for host->container traffic control
            # Allow all ICMP out for ping, errors, REJECT responses, etc
            self._run_iptables(
                "-A",
                "sandy-out",
                "-p",
                "icmp",
                "-j",
                "ACCEPT",
                error_prefix="Allow ICMP echo-request in sandy-out",
            )

            # Allow established/related connections
            self._run_iptables(
                "-A",
                "sandy-out",
                "-m",
                "conntrack",
                "--ctstate",
                "RELATED,ESTABLISHED",
                "-j",
                "ACCEPT",
                error_prefix="Add conntrack OUTPUT rule to sandy-out",
            )

            # Log blocked host->container traffic
            self._run_iptables(
                "-A",
                "sandy-out",
                "-j",
                "LOG",
                "--log-prefix",
                "[SNDY-OUT-BLOCK] ",
                error_prefix="Add LOG rule to sandy-out",
            )

            # Reject all other host->container traffic
            self._run_iptables(
                "-A",
                "sandy-out",
                "-j",
                "REJECT",
                error_prefix="Add REJECT rule to sandy-out",
            )

            return True
        except Exception as e:
            print(f"E: Error configuring NAT rules: {_terminal_safe_repr(str(e))}")
            return False

    def _setup_ipv6_firewall_ipt(self) -> bool:
        """Setup IPv6 firewall rules to block container IPv6 traffic"""
        # Only proceed if ip6tables is available
        if not shutil.which("ip6tables"):
            return True  # Not an error, just skip IPv6 setup

        try:
            # Handle sandy-rej6 chain for IPv6 in filter table (for logging and rejecting)
            if self._ip6tables_chain_exists("sandy-rej6"):
                # Chain exists, flush and zero it
                self._run_ip6tables(
                    "-F", "sandy-rej6", error_prefix="Flush sandy-rej6 chain"
                )
                self._run_ip6tables(
                    "-Z", "sandy-rej6", error_prefix="Zero sandy-rej6 chain"
                )
            else:
                # Create new chain
                self._run_ip6tables(
                    "-N", "sandy-rej6", error_prefix="Create sandy-rej6 chain"
                )

                # Add LOG and REJECT rules to sandy-rej6 chain
                self._run_ip6tables(
                    "-A",
                    "sandy-rej6",
                    "-j",
                    "LOG",
                    "--log-prefix",
                    "[SNDY-BLOCK] ",
                    error_prefix="Add LOG rule to sandy-rej6",
                )
                self._run_ip6tables(
                    "-A",
                    "sandy-rej6",
                    "-j",
                    "REJECT",
                    error_prefix="Add REJECT rule to sandy-rej6",
                )

            # Handle sandy-fwd6 chain for IPv6 in filter table
            if self._ip6tables_chain_exists("sandy-fwd6"):
                # Chain exists, flush and zero it
                self._run_ip6tables(
                    "-F", "sandy-fwd6", error_prefix="Flush sandy-fwd6 chain"
                )
                self._run_ip6tables(
                    "-Z", "sandy-fwd6", error_prefix="Zero sandy-fwd6 chain"
                )
            else:
                # Create new chain and insert jump rule
                self._run_ip6tables(
                    "-N", "sandy-fwd6", error_prefix="Create sandy-fwd6 chain"
                )
                # Insert jump rule at top of FORWARD
                self._run_ip6tables(
                    "-I",
                    "FORWARD",
                    "-i",
                    self.bridge_name,
                    "-j",
                    "sandy-fwd6",
                    error_prefix="Insert IPv6 FORWARD jump rule",
                )

            # Block access to IPv6 private ranges (insert at beginning of chain)
            rule_number = 1
            for net in self.IPV6_PRIVATE_NETWORKS:
                # Jump to sandy-rej6 chain for logging and rejecting
                self._run_ip6tables(
                    "-I",
                    "sandy-fwd6",
                    str(rule_number),
                    "-i",
                    self.bridge_name,
                    "-d",
                    net,
                    "-j",
                    "sandy-rej6",
                    error_prefix=f"Block access to IPv6 {net}",
                )
                rule_number += 1

            # Add rule to reject all remaining IPv6 traffic from bridge (container isolation)
            self._run_ip6tables(
                "-A",
                "sandy-fwd6",
                "-i",
                self.bridge_name,
                "-j",
                "sandy-rej6",
                error_prefix="Add IPv6 bridge REJECT rule",
            )

            return True
        except Exception as e:
            print(
                f"W: Error setting up IPv6 firewall rules: {_terminal_safe_repr(str(e))}"
            )
            return False

    def _setup_ipv4_firewall_nft(self, network_cidr: str) -> bool:
        """Configure NAT and forwarding rules using nftables"""
        if not self._ensure_gateway():
            print(
                f"E: Could not determine gateway for bridge '{_strip_control_characters(self.bridge_name)}'"
            )
            return False

        if not self.gateway:
            print(
                f"E: Gateway value missing for bridge '{_strip_control_characters(self.bridge_name)}'"
            )
            return False

        try:
            # Ensure base tables and chains exist
            if not self._setup_nftables_base():
                return False

            # Flush existing rules in our chains
            self._run_nft(
                "flush",
                "chain",
                "ip",
                "sandy",
                "postrouting",
                error_prefix="Flush postrouting chain",
            )
            self._run_nft(
                "flush",
                "chain",
                "ip",
                "sandy",
                "forward",
                error_prefix="Flush forward chain",
            )

            # Add MASQUERADE rule for NAT
            self._run_nft(
                "add",
                "rule",
                "ip",
                "sandy",
                "postrouting",
                "ip",
                "saddr",
                network_cidr,
                "ip",
                "daddr",
                "!=",
                network_cidr,
                "oifname",
                "!=",
                f'"{self.bridge_name}"',
                "masquerade",
                error_prefix="Add MASQUERADE rule",
            )

            # Block access to private IP ranges (with logging)
            for net in self.PRIVATE_NETWORKS:
                # Add logging rule
                self._run_nft(
                    "add",
                    "rule",
                    "ip",
                    "sandy",
                    "forward",
                    "iifname",
                    f'"{self.bridge_name}"',
                    "ip",
                    "daddr",
                    net,
                    "log",
                    "prefix",
                    '"[SNDY-BLOCK] "',
                    error_prefix=f"Log access to {net}",
                )
                # Add reject rule
                self._run_nft(
                    "add",
                    "rule",
                    "ip",
                    "sandy",
                    "forward",
                    "iifname",
                    f'"{self.bridge_name}"',
                    "ip",
                    "daddr",
                    net,
                    "reject",
                    error_prefix=f"Block access to {net}",
                )

            # Add FORWARD rules for established connections
            self._run_nft(
                "add",
                "rule",
                "ip",
                "sandy",
                "forward",
                "ct",
                "state",
                "established,related",
                "iifname",
                f'"{self.bridge_name}"',
                "accept",
                error_prefix="Add conntrack FORWARD rule",
            )

            # Add FORWARD rule for new connections from bridge
            self._run_nft(
                "add",
                "rule",
                "ip",
                "sandy",
                "forward",
                "iifname",
                f'"{self.bridge_name}"',
                "ip",
                "saddr",
                network_cidr,
                "accept",
                error_prefix="Add bridge FORWARD rule",
            )

            # Setup OUTPUT firewall rules for host->container traffic control
            if not self._setup_output_firewall_nft(network_cidr):
                return False

            return True
        except Exception as e:
            print(
                f"E: Error configuring nftables NAT rules: {_terminal_safe_repr(str(e))}"
            )
            return False

